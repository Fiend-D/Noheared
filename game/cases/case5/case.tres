track = Array[ExtResource("2_bgab3")]([SubResource("Resource_sf2bs"), SubResource("Resource_yalf6"), SubResource("Resource_gp1lj"), SubResource("Resource_3wpsb"), SubResource("Resource_im7sm"), SubResource("Resource_um0h8"), SubResource("Resource_0bq50"), SubResource("Resource_l1k6p"), SubResource("Resource_ao482"), SubResource("Resource_gxkkw"), SubResource("Resource_k1xlg"), SubResource("Resource_ls1j6"), SubResource("Resource_634gk"), SubResource("Resource_lhxur"), SubResource("Resource_tgm7n"), SubResource("Resource_8llf1"), SubResource("Resource_npbo3"), SubResource("Resource_mfuyb"), SubResource("Resource_mxkbu"), SubResource("Resource_wqa86"), SubResource("Resource_tbpqs"), SubResource("Resource_ecqvw"), SubResource("Resource_0eovg"), SubResource("Resource_bfg86"), SubResource("Resource_qvq83"), SubResource("Resource_440dq"), SubResource("Resource_hjwp1"), SubResource("Resource_fse1e"), SubResource("Resource_58fx8"), SubResource("Resource_gr53y"), SubResource("Resource_s7px0"), SubResource("Resource_2h0fo"), SubResource("Resource_87pmg")])

[sub_resource type="Resource" id="Resource_8p21x"]
script = ExtResource("4_kblfa")
id = &"q1"
kind = 1
prompt = "谁杀害了陈董事长？"
options = PackedStringArray("林夫人", "赵秘书", "吴大副", "马服务员", "周医生")
answer = "马服务员"

[sub_resource type="Resource" id="Resource_xpltg"]
script = ExtResource("4_kblfa")
id = &"q2"
prompt = "陈董事长的真正死因是什么？"
options = PackedStringArray("蛋糕中的安眠药", "蜡烛上的慢性毒", "香槟中的氰化物", "食物过敏", "心脏病发作")
answer = "香槟中的氰化物"

[sub_resource type="Resource" id="Resource_kovta"]
script = ExtResource("4_kblfa")
id = &"q3"
prompt = "赵秘书在蛋糕里加了什么？"
options = PackedStringArray("氰化物", "安眠药", "慢性毒药", "花生粉", "什么都没加")
answer = "安眠药"

[sub_resource type="Resource" id="Resource_t6mfd"]
script = ExtResource("4_kblfa")
id = &"q4"
prompt = "马服务员杀害陈董事长的动机是什么？"
options = PackedStringArray("为了钱财", "报复抛弃", "被胁迫", "意外失手", "保护他人")
answer = "报复抛弃"

[sub_resource type="Resource" id="Resource_d21w0"]
script = ExtResource("4_kblfa")
id = &"q5"
prompt = "陈董事长死亡时，有哪些人也对蛋糕动了手脚？"
options = PackedStringArray("只有赵秘书", "赵秘书和吴大副", "赵秘书、吴大副和林夫人", "所有人都动了手脚", "只有马服务员")
answer = "赵秘书、吴大副和林夫人"

[sub_resource type="Resource" id="Resource_igwr7"]
script = ExtResource("7_bio7l")
speaker = &"A"
start = 8.0
duration = 6.449
stream = ExtResource("8_5xllt")
text = "各位朋友！欢迎大家来参加我陈某人的五十岁生日派对！今晚不醉不归！"

[sub_resource type="Resource" id="Resource_1vih8"]
script = ExtResource("7_bio7l")
speaker = &"J"
start = 20.0
duration = 5.764
stream = ExtResource("9_3t5us")
text = "陈董事长能选择我们'海神号'举办生日宴，是全船上下的荣幸。"

[sub_resource type="Resource" id="Resource_y2meo"]
script = ExtResource("7_bio7l")
speaker = &"B"
start = 30.0
duration = 4.156
stream = ExtResource("10_4clk6")
text = "（冷笑）是啊，真荣幸。一年比一年铺张。"

[sub_resource type="Resource" id="Resource_t820y"]
script = ExtResource("7_bio7l")
speaker = &"A"
start = 38.0
duration = 4.289
stream = ExtResource("11_frg5h")
text = "林美华，你要是不想待可以回房去，别在这扫大家的兴。"

[sub_resource type="Resource" id="Resource_vjnmv"]
script = ExtResource("7_bio7l")
speaker = &"C"
start = 48.0
duration = 4.413
stream = ExtResource("12_xybn6")
text = "董事长，夫人，今天是好日子，别伤了和气。"

[sub_resource type="Resource" id="Resource_xyglv"]
script = ExtResource("7_bio7l")
speaker = &"G"
start = 60.0
duration = 1.694
stream = ExtResource("13_3se4v")
text = "（弹奏《祝寿曲》）"

[sub_resource type="Resource" id="Resource_23an5"]
script = ExtResource("7_bio7l")
speaker = &"B"
start = 85.0
duration = 6.462
stream = ExtResource("14_f6ksg")
text = "（低声打电话）李律师，我丈夫上周真的修改了遗嘱？受益人写的是谁？"

[sub_resource type="Resource" id="Resource_ft1yb"]
script = ExtResource("7_bio7l")
speaker = &"B"
start = 97.0
duration = 3.742
stream = ExtResource("15_exgvi")
text = "什么？！赵秘书？！那个狐狸精？！"

[sub_resource type="Resource" id="Resource_hs5wn"]
script = ExtResource("7_bio7l")
speaker = &"E"
start = 105.0
duration = 3.528
stream = ExtResource("16_otlnn")
text = "（对F）今晚之后，那笔债就不用还了。"

[sub_resource type="Resource" id="Resource_akg8r"]
script = ExtResource("7_bio7l")
speaker = &"F"
start = 114.0
duration = 3.9
stream = ExtResource("17_gws0q")
text = "你确定要这么做？陈董事长可不是好惹的。"

[sub_resource type="Resource" id="Resource_clgy7"]
script = ExtResource("7_bio7l")
speaker = &"E"
start = 123.0
duration = 4.426
stream = ExtResource("18_rasbv")
text = "我已经没有选择了。三百万，他逼得太紧了。"

[sub_resource type="Resource" id="Resource_fn7xf"]
script = ExtResource("7_bio7l")
speaker = &"C"
start = 132.0
duration = 2.136
stream = ExtResource("19_b0wm4")
text = "（对E）你弄到药了吗？"

[sub_resource type="Resource" id="Resource_k0irj"]
script = ExtResource("7_bio7l")
speaker = &"E"
start = 139.0
duration = 5.669
stream = ExtResource("20_8us5j")
text = "放心，慢性毒，三天后才发作，到时候我们早下船了。"

[sub_resource type="Resource" id="Resource_wric0"]
script = ExtResource("7_bio7l")
speaker = &"C"
start = 150.0
duration = 4.106
stream = ExtResource("21_6xvx4")
text = "我只要昏迷几个小时就够了，文件拿到手就行。"

[sub_resource type="Resource" id="Resource_mr6gu"]
script = ExtResource("7_bio7l")
speaker = &"D"
start = 160.0
duration = 5.712
stream = ExtResource("22_yfxwt")
text = "（自言自语）那份医疗报告...要是被陈董事长公开，我这辈子就完了。"

[sub_resource type="Resource" id="Resource_xqlbj"]
script = ExtResource("7_bio7l")
speaker = &"I"
start = 172.0
duration = 3.011
stream = ExtResource("23_hn7qb")
text = "（端盘子经过）董事长，您的酒。"

[sub_resource type="Resource" id="Resource_1p8y6"]
script = ExtResource("7_bio7l")
speaker = &"A"
start = 179.0
duration = 2.849
stream = ExtResource("24_iesx6")
text = "小马啊，好好干，我不会亏待你的。"

[sub_resource type="Resource" id="Resource_8nqms"]
script = ExtResource("7_bio7l")
speaker = &"I"
start = 187.0
duration = 2.376
stream = ExtResource("25_6p7sm")
text = "（低声）不会亏待...哼。"

[sub_resource type="Resource" id="Resource_umyq4"]
script = ExtResource("7_bio7l")
speaker = &"H"
start = 200.0
duration = 5.599
stream = ExtResource("26_lsp21")
text = "蛋糕胚烤好了，现在开始裱花。这可是我专门定制的三层蛋糕。"

[sub_resource type="Resource" id="Resource_ybxbh"]
script = ExtResource("7_bio7l")
speaker = &"C"
start = 212.0
duration = 4.18
stream = ExtResource("27_jcwdf")
text = "刘师傅，需要帮忙吗？我学过一点烘焙。"

[sub_resource type="Resource" id="Resource_yabgv"]
script = ExtResource("7_bio7l")
speaker = &"H"
start = 221.0
duration = 4.765
stream = ExtResource("28_b5kxv")
text = "赵秘书您太客气了，不过生日蛋糕还是我自己来比较放心。"

[sub_resource type="Resource" id="Resource_vl6al"]
script = ExtResource("7_bio7l")
speaker = &"C"
start = 232.0
duration = 3.727
stream = ExtResource("29_coeuw")
text = "让我帮个忙嘛，我帮您把糖霜调一下。"

[sub_resource type="Resource" id="Resource_omf6k"]
script = ExtResource("7_bio7l")
speaker = &"H"
start = 241.0
duration = 2.909
stream = ExtResource("30_c6ejl")
text = "那...好吧，糖霜在左边柜子上。"

[sub_resource type="Resource" id="Resource_4hacu"]
script = ExtResource("7_bio7l")
speaker = &"C"
start = 249.0
duration = 3.588
stream = ExtResource("31_53won")
text = "（低声）安眠药融进去应该看不出来..."

[sub_resource type="Resource" id="Resource_ra7l4"]
script = ExtResource("7_bio7l")
speaker = &"B"
start = 265.0
duration = 2.393
stream = ExtResource("32_3knvw")
text = "厨师长，蛋糕准备好了吗？"

[sub_resource type="Resource" id="Resource_4eptn"]
script = ExtResource("7_bio7l")
speaker = &"H"
start = 273.0
duration = 3.075
stream = ExtResource("33_pslwk")
text = "快了快了，夫人。还在装饰。"

[sub_resource type="Resource" id="Resource_ovg86"]
script = ExtResource("7_bio7l")
speaker = &"B"
start = 281.0
duration = 4.311
stream = ExtResource("34_2dpcu")
text = "（拿起蜡烛端详）这蜡烛真精致，希望他能喜欢。"

[sub_resource type="Resource" id="Resource_7blqk"]
script = ExtResource("7_bio7l")
speaker = &"B"
start = 291.0
duration = 3.003
stream = ExtResource("35_xghf5")
text = "（涂毒）慢慢享受吧，陈建国。"

[sub_resource type="Resource" id="Resource_3nmmy"]
script = ExtResource("7_bio7l")
speaker = &"H"
start = 299.0
duration = 1.295
stream = ExtResource("36_nxsil")
text = "夫人您说什么？"

[sub_resource type="Resource" id="Resource_ly8is"]
script = ExtResource("7_bio7l")
speaker = &"B"
start = 305.0
duration = 2.127
stream = ExtResource("37_7hvv1")
text = "没什么，随便看看。"

[sub_resource type="Resource" id="Resource_25w57"]
script = ExtResource("7_bio7l")
speaker = &"E"
start = 320.0
duration = 6.416
stream = ExtResource("38_1edei")
text = "（趁厨房无人，从口袋拿出小瓶）加到蛋糕底层...慢性毒，无色无味。"

[sub_resource type="Resource" id="Resource_3ebtv"]
script = ExtResource("7_bio7l")
speaker = &"E"
start = 334.0
duration = 2.396
stream = ExtResource("39_ljgtv")
text = "陈建国，这是你逼我的。"

[sub_resource type="Resource" id="Resource_ugnkk"]
script = ExtResource("7_bio7l")
speaker = &"I"
start = 345.0
duration = 3.62
stream = ExtResource("40_rljtb")
text = "刘师傅，董事长让我来问问蛋糕好了没。"

[sub_resource type="Resource" id="Resource_i87hd"]
script = ExtResource("7_bio7l")
speaker = &"H"
start = 355.0
duration = 3.924
stream = ExtResource("41_kbpjs")
text = "马上好，你先去准备香槟吧，要82年的拉菲。"

[sub_resource type="Resource" id="Resource_tibcm"]
script = ExtResource("7_bio7l")
speaker = &"I"
start = 365.0
duration = 4.325
stream = ExtResource("42_00nk8")
text = "（看到配料架上的标签）花生粉...原来他过敏的是这个..."

[sub_resource type="Resource" id="Resource_xhc3u"]
script = ExtResource("7_bio7l")
speaker = &"J"
start = 380.0
duration = 4.486
stream = ExtResource("43_6pk78")
text = "各位来宾，请大家移步餐厅，生日宴会正式开始！"

[sub_resource type="Resource" id="Resource_ng6ee"]
script = ExtResource("7_bio7l")
speaker = &"G"
start = 395.0
duration = 2.609
stream = ExtResource("44_fa72c")
text = "（演奏《生日快乐》变奏曲）"

[sub_resource type="Resource" id="Resource_1nkvn"]
script = ExtResource("7_bio7l")
speaker = &"A"
start = 420.0
duration = 3.592
stream = ExtResource("45_er15c")
text = "谢谢大家！这是我过得最开心的一个生日！"

[sub_resource type="Resource" id="Resource_etqbk"]
script = ExtResource("7_bio7l")
speaker = &"J"
start = 430.0
duration = 3.531
stream = ExtResource("46_8ky5g")
text = "祝陈董事长福如东海，寿比南山！"

[sub_resource type="Resource" id="Resource_vnfli"]
script = ExtResource("7_bio7l")
speaker = &"I"
start = 440.0
duration = 4.638
stream = ExtResource("47_p7ajr")
text = "董事长，这是您最喜欢的82年拉菲，我亲自开的瓶。"

[sub_resource type="Resource" id="Resource_1xdek"]
script = ExtResource("7_bio7l")
speaker = &"A"
start = 451.0
duration = 2.619
stream = ExtResource("48_xfcy7")
text = "好！小马越来越懂事了！"

[sub_resource type="Resource" id="Resource_v14as"]
script = ExtResource("7_bio7l")
speaker = &"I"
start = 459.0
duration = 2.528
stream = ExtResource("49_cmsax")
text = "（低头）祝您...生日快乐。"

[sub_resource type="Resource" id="Resource_7wkfp"]
script = ExtResource("7_bio7l")
speaker = &"A"
start = 470.0
duration = 2.275
stream = ExtResource("50_k5nfy")
text = "来，大家一起吹蜡烛！"

[sub_resource type="Resource" id="Resource_8peec"]
script = ExtResource("7_bio7l")
speaker = &"B"
start = 477.0
duration = 4.107
stream = ExtResource("51_rfi8f")
text = "（冷笑）许愿可别许错了，有些愿望实现不了。"

[sub_resource type="Resource" id="Resource_p3bj0"]
script = ExtResource("7_bio7l")
speaker = &"A"
start = 487.0
duration = 2.761
stream = ExtResource("52_prit3")
text = "（吹蜡烛）呼——好了，切蛋糕！"

[sub_resource type="Resource" id="Resource_abbvo"]
script = ExtResource("7_bio7l")
speaker = &"C"
start = 495.0
duration = 3.155
stream = ExtResource("53_u54y6")
text = "（紧张）董事长，您先吃第一块。"

[sub_resource type="Resource" id="Resource_gcy03"]
script = ExtResource("7_bio7l")
speaker = &"A"
start = 503.0
duration = 2.333
stream = ExtResource("54_ofiii")
text = "好，第一块给我亲爱的秘书！"

[sub_resource type="Resource" id="Resource_4advb"]
script = ExtResource("7_bio7l")
speaker = &"C"
start = 512.0
duration = 2.075
stream = ExtResource("55_onwij")
text = "啊...谢谢董事长。"

[sub_resource type="Resource" id="Resource_av26j"]
script = ExtResource("7_bio7l")
speaker = &"A"
start = 520.0
duration = 3.66
stream = ExtResource("56_1ms7c")
text = "（吃蛋糕、喝酒）嗯，今年的蛋糕特别好吃。"

[sub_resource type="Resource" id="Resource_f5kpq"]
script = ExtResource("7_bio7l")
speaker = &"H"
start = 530.0
duration = 2.021
stream = ExtResource("57_oguqn")
text = "（擦汗）谢谢董事长夸奖。"

[sub_resource type="Resource" id="Resource_85hf5"]
script = ExtResource("7_bio7l")
speaker = &"A"
start = 545.0
duration = 2.307
stream = ExtResource("58_ulvsf")
text = "（扶额）怎么回事...头好晕..."

[sub_resource type="Resource" id="Resource_t2hrw"]
script = ExtResource("7_bio7l")
speaker = &"D"
start = 553.0
duration = 4.325
stream = ExtResource("59_5h7b1")
text = "陈董事长，您脸色不太好，我陪您去医务室看看。"

[sub_resource type="Resource" id="Resource_4qwki"]
script = ExtResource("7_bio7l")
speaker = &"A"
start = 563.0
duration = 2.562
stream = ExtResource("60_lp4ju")
text = "可能是喝多了...麻烦周医生了。"

[sub_resource type="Resource" id="Resource_78ccm"]
script = ExtResource("7_bio7l")
speaker = &"B"
start = 572.0
duration = 2.626
stream = ExtResource("61_rmrcv")
text = "（自言自语）这么快就有反应了？"

[sub_resource type="Resource" id="Resource_7aoml"]
script = ExtResource("7_bio7l")
speaker = &"D"
start = 585.0
duration = 5.215
stream = ExtResource("62_ygc1f")
text = "血压偏高，心跳有点快。您今天吃了什么特别的东西吗？"

[sub_resource type="Resource" id="Resource_jmixv"]
script = ExtResource("7_bio7l")
speaker = &"A"
start = 597.0
duration = 2.251
stream = ExtResource("63_gpj2q")
text = "就吃了蛋糕，喝了点酒..."

[sub_resource type="Resource" id="Resource_xa53e"]
script = ExtResource("7_bio7l")
speaker = &"D"
start = 605.0
duration = 5.223
stream = ExtResource("64_q2sad")
text = "可能是轻微食物中毒，我给您打一针止吐的，回房间休息一下吧。"

[sub_resource type="Resource" id="Resource_eyhiy"]
script = ExtResource("7_bio7l")
speaker = &"A"
start = 618.0
duration = 2.053
stream = ExtResource("65_8l4ol")
text = "好...我现在就想睡觉。"

[sub_resource type="Resource" id="Resource_oi1pk"]
script = ExtResource("7_bio7l")
speaker = &"I"
start = 630.0
duration = 2.487
stream = ExtResource("66_cepmq")
text = "董事长，我送您回房间吧。"

[sub_resource type="Resource" id="Resource_vy0mf"]
script = ExtResource("7_bio7l")
speaker = &"A"
start = 639.0
duration = 2.44
stream = ExtResource("67_5ogqu")
text = "嗯...小马啊，你真是个好孩子。"

[sub_resource type="Resource" id="Resource_rxn48"]
script = ExtResource("7_bio7l")
speaker = &"I"
start = 649.0
duration = 0.784
stream = ExtResource("68_wiygi")
text = "（沉默）..."

[sub_resource type="Resource" id="Resource_gc6vc"]
script = ExtResource("7_bio7l")
speaker = &"I"
start = 660.0
duration = 8.067
stream = ExtResource("69_t4m3v")
text = "（在套房内）陈建国，你知道我是谁吗？二十三年前，你抛弃的那个女人，她是我妈。"

[sub_resource type="Resource" id="Resource_3fa1o"]
script = ExtResource("7_bio7l")
speaker = &"I"
start = 680.0
duration = 4.691
stream = ExtResource("70_6h656")
text = "我来找你，不是想当什么服务员。我是来要一个答案的。"

[sub_resource type="Resource" id="Resource_vyl2y"]
script = ExtResource("7_bio7l")
speaker = &"A"
start = 692.0
duration = 1.57
stream = ExtResource("71_jfgu7")
text = "（虚弱）你...你说什么？"

[sub_resource type="Resource" id="Resource_m060u"]
script = ExtResource("7_bio7l")
speaker = &"I"
start = 700.0
duration = 7.255
stream = ExtResource("72_5qyt3")
text = "你说我是野种，说我不配姓陈。好，那我就让你看看，这个'野种'能做什么。"

[sub_resource type="Resource" id="Resource_ysvih"]
script = ExtResource("7_bio7l")
speaker = &"I"
start = 717.0
duration = 4.294
stream = ExtResource("73_ycvdf")
text = "（掏出氰化物，擦在香槟杯口）这是你自己选的。"

[sub_resource type="Resource" id="Resource_2xhpl"]
script = ExtResource("7_bio7l")
speaker = &"A"
start = 727.0
duration = 1.674
stream = ExtResource("74_ndsrf")
text = "你...你疯了...来人..."

[sub_resource type="Resource" id="Resource_t838m"]
script = ExtResource("7_bio7l")
speaker = &"I"
start = 735.0
duration = 4.69
stream = ExtResource("75_a2cxv")
text = "别喊了，这杯酒，是你'最喜欢'的拉菲。喝吧。"

[sub_resource type="Resource" id="Resource_jomyf"]
script = ExtResource("7_bio7l")
speaker = &"A"
start = 745.0
duration = 2.148
stream = ExtResource("76_8c44w")
text = "（被迫喝下）苦...好苦..."

[sub_resource type="Resource" id="Resource_0il1e"]
script = ExtResource("7_bio7l")
speaker = &"A"
start = 753.0
duration = 1.431
stream = ExtResource("77_6f0yg")
text = "（倒地，抽搐）"

[sub_resource type="Resource" id="Resource_8q6s1"]
script = ExtResource("7_bio7l")
speaker = &"I"
start = 760.0
duration = 3.337
stream = ExtResource("78_gigi7")
text = "（平静地整理衣服）晚安，'爸爸'。"

[sub_resource type="Resource" id="Resource_6xh36"]
script = ExtResource("7_bio7l")
speaker = &"C"
start = 775.0
duration = 6.164
stream = ExtResource("79_vf4ba")
text = "（推门进来）文件应该在这...啊！董事长！董事长你怎么了！"

[sub_resource type="Resource" id="Resource_3gqg5"]
script = ExtResource("7_bio7l")
speaker = &"C"
start = 790.0
duration = 3.99
stream = ExtResource("80_bljat")
text = "来人啊！快来人！董事长出事了！"

[sub_resource type="Resource" id="Resource_hdfod"]
script = ExtResource("7_bio7l")
speaker = &"J"
start = 800.0
duration = 3.136
stream = ExtResource("81_crtw4")
text = "所有人都到餐厅集合！马上！"

[sub_resource type="Resource" id="Resource_2d3sl"]
script = ExtResource("7_bio7l")
speaker = &"D"
start = 815.0
duration = 5.667
stream = ExtResource("82_icyog")
text = "（检查尸体）瞳孔散大，嘴唇发紫...这是氰化物中毒的特征。"

[sub_resource type="Resource" id="Resource_pv8rc"]
script = ExtResource("7_bio7l")
speaker = &"B"
start = 828.0
duration = 2.499
stream = ExtResource("83_7mt7e")
text = "（哭泣）怎么会...怎么会这样..."

[sub_resource type="Resource" id="Resource_lrvoc"]
script = ExtResource("7_bio7l")
speaker = &"E"
start = 838.0
duration = 5.994
stream = ExtResource("84_qfvj7")
text = "（心想）氰化物？不可能，我下的是慢性毒，三天后才发作啊。"

[sub_resource type="Resource" id="Resource_sl4ks"]
script = ExtResource("7_bio7l")
speaker = &"C"
start = 850.0
duration = 3.063
stream = ExtResource("85_6iapr")
text = "（发抖）我...我只是想找文件..."

[sub_resource type="Resource" id="Resource_erdfa"]
script = ExtResource("7_bio7l")
speaker = &"H"
start = 860.0
duration = 4.404
stream = ExtResource("86_k7igt")
text = "蛋糕...蛋糕不会有问题吧？我用的是最好的材料啊！"

[sub_resource type="Resource" id="Resource_17evt"]
script = ExtResource("7_bio7l")
speaker = &"I"
start = 872.0
duration = 4.455
stream = ExtResource("87_xoxte")
text = "董事长回房间前还好好的，我亲眼看到他进房间的。"

[sub_resource type="Resource" id="Resource_jf88k"]
script = ExtResource("7_bio7l")
speaker = &"G"
start = 884.0
duration = 8.0
text = "我当时一直在音乐厅演奏，什么都没听到。"

[sub_resource type="Resource" id="Resource_efp8u"]
script = ExtResource("7_bio7l")
speaker = &"J"
start = 895.0
duration = 6.414
stream = ExtResource("88_5xrf1")
text = "在真相查明之前，任何人不得离开邮轮。周医生，死因确定了吗？"

[sub_resource type="Resource" id="Resource_8l5ww"]
script = ExtResource("7_bio7l")
speaker = &"D"
start = 908.0
duration = 7.97
stream = ExtResource("89_25vld")
text = "初步判断是氰化物中毒，立刻致命的。但奇怪的是，陈董事长在餐厅时还没有症状。"

[sub_resource type="Resource" id="Resource_yncwl"]
script = ExtResource("7_bio7l")
speaker = &"D"
start = 924.0
duration = 5.256
stream = ExtResource("90_7d1kp")
text = "说明毒物是在他离开餐厅、回到房间之后才进入体内的。"

[sub_resource type="Resource" id="Resource_fjilu"]
script = ExtResource("7_bio7l")
speaker = &"B"
start = 940.0
duration = 5.559
stream = ExtResource("91_4tguy")
text = "（电话）李律师，我丈夫去世了，遗嘱现在怎么执行？...什么？！"

[sub_resource type="Resource" id="Resource_nh2w5"]
script = ExtResource("7_bio7l")
speaker = &"B"
start = 954.0
duration = 3.552
stream = ExtResource("92_r4j86")
text = "你说他上周立的遗嘱里，有一个私生子？！"

[sub_resource type="Resource" id="Resource_w2plb"]
script = ExtResource("7_bio7l")
speaker = &"I"
start = 965.0
duration = 2.855
stream = ExtResource("93_nql5v")
text = "（听到，冷笑）原来你知道了。"

[sub_resource type="Resource" id="Resource_5eqhk"]
script = ExtResource("7_bio7l")
speaker = &"E"
start = 980.0
duration = 6.161
stream = ExtResource("94_2kfrv")
text = "（对F）不对劲，慢性毒不可能立刻死。船上还有别人想让他死。"

[sub_resource type="Resource" id="Resource_62lbx"]
script = ExtResource("7_bio7l")
speaker = &"F"
start = 993.0
duration = 1.765
stream = ExtResource("95_lri33")
text = "看来不止我们动手了。"

[sub_resource type="Resource" id="Resource_x4bik"]
script = ExtResource("7_bio7l")
speaker = &"C"
start = 1000.0
duration = 6.107
stream = ExtResource("96_5q8xj")
text = "（自言自语）安眠药应该不会被查出来吧...希望那杯酒不是致命的..."

[sub_resource type="Resource" id="Resource_72ij5"]
script = ExtResource("7_bio7l")
speaker = &"H"
start = 1020.0
duration = 4.387
stream = ExtResource("97_nwaeg")
text = "（在厨房翻找）配料标签怎么换了？我没用花生粉啊..."

[sub_resource type="Resource" id="Resource_lvpd2"]
script = ExtResource("7_bio7l")
speaker = &"H"
start = 1032.0
duration = 3.881
stream = ExtResource("98_e5i87")
text = "难道是马服务员...他今天一直在厨房附近晃悠。"

[sub_resource type="Resource" id="Resource_70qu4"]
script = ExtResource("7_bio7l")
speaker = &"D"
start = 1050.0
duration = 6.036
stream = ExtResource("99_rqy5p")
text = "（在医务室翻看记录）氰化物...立刻致命...症状和食物中毒很像。"

[sub_resource type="Resource" id="Resource_e218q"]
script = ExtResource("7_bio7l")
speaker = &"D"
start = 1064.0
duration = 5.847
stream = ExtResource("100_8d21d")
text = "等等，如果是食物中毒，陈董事长在医务室就应该有明显反应了。"

[sub_resource type="Resource" id="Resource_0phw4"]
script = ExtResource("7_bio7l")
speaker = &"D"
start = 1077.0
duration = 5.072
stream = ExtResource("101_hfh1g")
text = "但他当时只是头晕和嗜睡...说明那时候毒药还没完全发作。"

[sub_resource type="Resource" id="Resource_0yny1"]
script = ExtResource("7_bio7l")
speaker = &"J"
start = 1095.0
duration = 5.254
stream = ExtResource("102_hx8yc")
text = "（对所有人）各位，我们现在是公海，我已经联系了海岸警卫队。"

[sub_resource type="Resource" id="Resource_lak72"]
script = ExtResource("7_bio7l")
speaker = &"J"
start = 1108.0
duration = 3.918
stream = ExtResource("103_xa1n0")
text = "在他们到达之前，我希望凶手能自己站出来。"

[sub_resource type="Resource" id="Resource_gsw3g"]
script = ExtResource("7_bio7l")
speaker = &"B"
start = 1118.0
duration = 3.825
stream = ExtResource("104_bu7er")
text = "凶手？这里几乎所有人都想让他死！"

[sub_resource type="Resource" id="Resource_n4w6c"]
script = ExtResource("7_bio7l")
speaker = &"E"
start = 1127.0
duration = 1.907
stream = ExtResource("105_lw125")
text = "（心虚）你什么意思？"

[sub_resource type="Resource" id="Resource_uirv6"]
script = ExtResource("7_bio7l")
speaker = &"B"
start = 1134.0
duration = 4.382
stream = ExtResource("106_kbs2i")
text = "别装了，我亲眼看到你在厨房往蛋糕里加东西。"

[sub_resource type="Resource" id="Resource_mu8ii"]
script = ExtResource("7_bio7l")
speaker = &"E"
start = 1145.0
duration = 1.664
stream = ExtResource("107_4b23q")
text = "你...你血口喷人！"

[sub_resource type="Resource" id="Resource_ov8ib"]
script = ExtResource("7_bio7l")
speaker = &"C"
start = 1153.0
duration = 7.242
stream = ExtResource("108_pesn2")
text = "（崩溃）别吵了！是我...我在糖霜里加了安眠药，但我只是想拿文件！"

[sub_resource type="Resource" id="Resource_y1857"]
script = ExtResource("7_bio7l")
speaker = &"B"
start = 1168.0
duration = 5.756
stream = ExtResource("109_pv5h2")
text = "哈！我就知道！那我在蜡烛上涂的慢性毒也不算什么了。"

[sub_resource type="Resource" id="Resource_4oaw1"]
script = ExtResource("7_bio7l")
speaker = &"D"
start = 1180.0
duration = 6.706
stream = ExtResource("110_g2p5d")
text = "等等...蛋糕里有安眠药，蜡烛上有慢性毒...但陈董事长是氰化物中毒死的。"

[sub_resource type="Resource" id="Resource_4quoc"]
script = ExtResource("7_bio7l")
speaker = &"D"
start = 1196.0
duration = 4.494
stream = ExtResource("111_shjkw")
text = "氰化物是立刻致命的，而且是在回房间后才发作。"

[sub_resource type="Resource" id="Resource_6jkas"]
script = ExtResource("7_bio7l")
speaker = &"J"
start = 1207.0
duration = 6.206
stream = ExtResource("112_a14sy")
text = "也就是说，凶手是在陈董事长离开餐厅、回到房间这段时间下毒的？"

[sub_resource type="Resource" id="Resource_alouj"]
script = ExtResource("7_bio7l")
speaker = &"I"
start = 1221.0
duration = 4.031
stream = ExtResource("113_45hem")
text = "（平静）那段时间只有赵秘书和我在房间里。"

[sub_resource type="Resource" id="Resource_t1ygs"]
script = ExtResource("7_bio7l")
speaker = &"C"
start = 1231.0
duration = 5.407
stream = ExtResource("114_tlp6g")
text = "我只是去找文件！我进去的时候董事长已经倒在地上了！"

[sub_resource type="Resource" id="Resource_mltlj"]
script = ExtResource("7_bio7l")
speaker = &"I"
start = 1244.0
duration = 2.731
stream = ExtResource("115_7j13s")
text = "（微笑）那看来，凶手就是..."

[sub_resource type="Resource" id="Resource_17nnr"]
script = ExtResource("7_bio7l")
speaker = &"G"
start = 1260.0
duration = 10.0
text = "（自言自语）陈建国...你偷了我的曲子，现在终于遭到报应了。"

[sub_resource type="Resource" id="Resource_10ot7"]
script = ExtResource("7_bio7l")
speaker = &"F"
start = 1280.0
duration = 3.303
stream = ExtResource("116_7ihpp")
text = "吴大副，你那瓶慢性毒是从哪弄来的？"

[sub_resource type="Resource" id="Resource_qb2ue"]
script = ExtResource("7_bio7l")
speaker = &"E"
start = 1289.0
duration = 4.539
stream = ExtResource("117_frinv")
text = "黑市。但我说了，慢性毒不可能立刻死人。"

[sub_resource type="Resource" id="Resource_owltm"]
script = ExtResource("7_bio7l")
speaker = &"F"
start = 1299.0
duration = 1.907
stream = ExtResource("118_mmm6s")
text = "那赵秘书的安眠药呢？"

[sub_resource type="Resource" id="Resource_gqkqd"]
script = ExtResource("7_bio7l")
speaker = &"E"
start = 1306.0
duration = 5.145
stream = ExtResource("119_1tmle")
text = "安眠药只会让人昏睡。真正致命的，是别的东西。"

[sub_resource type="Resource" id="Resource_4y3o4"]
script = ExtResource("7_bio7l")
speaker = &"D"
start = 1320.0
duration = 4.745
stream = ExtResource("120_5x606")
text = "我重新检查了陈董事长的胃内容物，确实有安眠药的成分。"

[sub_resource type="Resource" id="Resource_0ydqh"]
script = ExtResource("7_bio7l")
speaker = &"D"
start = 1333.0
duration = 5.796
stream = ExtResource("121_cwj41")
text = "但致命的确实是氰化物，而且摄入时间大约在回房间后的十分钟内。"

[sub_resource type="Resource" id="Resource_dq026"]
script = ExtResource("7_bio7l")
speaker = &"H"
start = 1350.0
duration = 5.785
stream = ExtResource("122_wn543")
text = "马服务员今天一整天都在问董事长的饮食喜好，连过敏源都问得一清二楚。"

[sub_resource type="Resource" id="Resource_7ch4x"]
script = ExtResource("7_bio7l")
speaker = &"H"
start = 1364.0
duration = 2.869
stream = ExtResource("123_t0q60")
text = "而且他还问了我...花生粉放在哪。"

[sub_resource type="Resource" id="Resource_8lkaj"]
script = ExtResource("7_bio7l")
speaker = &"I"
start = 1375.0
duration = 3.667
stream = ExtResource("124_6pmqt")
text = "（冷笑）我只是想确保董事长的饮食安全。"

[sub_resource type="Resource" id="Resource_okttk"]
script = ExtResource("7_bio7l")
speaker = &"B"
start = 1385.0
duration = 7.752
stream = ExtResource("125_nwhpl")
text = "饮食安全？那你解释一下，为什么建国上周刚改了遗嘱，要把财产留给一个'私生子'？"

[sub_resource type="Resource" id="Resource_i4em6"]
script = ExtResource("7_bio7l")
speaker = &"B"
start = 1401.0
duration = 2.659
stream = ExtResource("126_30ssr")
text = "那个私生子...该不会就是你吧？"

[sub_resource type="Resource" id="Resource_81eak"]
script = ExtResource("7_bio7l")
speaker = &"I"
start = 1410.0
duration = 3.268
stream = ExtResource("127_sy5fe")
text = "（沉默良久）...是。我是他的儿子。"

[sub_resource type="Resource" id="Resource_t1fdp"]
script = ExtResource("7_bio7l")
speaker = &"I"
start = 1421.0
duration = 4.185
stream = ExtResource("128_42d0b")
text = "但他宁愿把钱捐给慈善机构，也不愿承认我。"

[sub_resource type="Resource" id="Resource_1buki"]
script = ExtResource("7_bio7l")
speaker = &"I"
start = 1432.0
duration = 3.039
stream = ExtResource("129_jn4ce")
text = "他当着我的面说：'野种不配姓陈'。"

[sub_resource type="Resource" id="Resource_n5mv1"]
script = ExtResource("7_bio7l")
speaker = &"J"
start = 1442.0
duration = 1.85
stream = ExtResource("130_g7k5k")
text = "所以你就杀了他？"

[sub_resource type="Resource" id="Resource_aprus"]
script = ExtResource("7_bio7l")
speaker = &"I"
start = 1449.0
duration = 3.683
stream = ExtResource("131_6k4nt")
text = "我没想杀他。我只是想让他承认我。"

[sub_resource type="Resource" id="Resource_3jeky"]
script = ExtResource("7_bio7l")
speaker = &"I"
start = 1459.0
duration = 5.068
stream = ExtResource("132_iu4db")
text = "但他不肯。他说就算死，也不会让我进陈家大门。"

[sub_resource type="Resource" id="Resource_05lip"]
script = ExtResource("7_bio7l")
speaker = &"I"
start = 1472.0
duration = 1.958
stream = ExtResource("133_4u0mb")
text = "那好，我就让他死。"

[sub_resource type="Resource" id="Resource_qypke"]
script = ExtResource("7_bio7l")
speaker = &"J"
start = 1480.0
duration = 6.714
stream = ExtResource("134_pv48e")
text = "马服务员，你涉嫌谋杀陈董事长，在靠岸之前，你被拘押在船员休息室。"

[sub_resource type="Resource" id="Resource_iwvf4"]
script = ExtResource("7_bio7l")
speaker = &"I"
start = 1495.0
duration = 3.216
stream = ExtResource("135_vg2cb")
text = "（平静）我知道。我不后悔。"

[sub_resource type="Resource" id="Resource_n6x4u"]
script = ExtResource("7_bio7l")
speaker = &"E"
start = 1510.0
duration = 2.506
stream = ExtResource("136_ha6m8")
text = "（对C）看来我们都白忙活了。"

[sub_resource type="Resource" id="Resource_jhwnr"]
script = ExtResource("7_bio7l")
speaker = &"C"
start = 1518.0
duration = 2.304
stream = ExtResource("137_2q8s5")
text = "至少...文件我拿到了。"

[sub_resource type="Resource" id="Resource_yin6r"]
script = ExtResource("7_bio7l")
speaker = &"B"
start = 1526.0
duration = 7.36
stream = ExtResource("138_swkuv")
text = "（冷笑）拿到了又怎么样？遗嘱已经生效了，一半财产捐给慈善，一半给那个'野种'。"

[sub_resource type="Resource" id="Resource_lv3w7"]
script = ExtResource("7_bio7l")
speaker = &"B"
start = 1543.0
duration = 1.459
stream = ExtResource("139_ilu55")
text = "我什么都没有。"

[sub_resource type="Resource" id="Resource_p5dja"]
script = ExtResource("7_bio7l")
speaker = &"D"
start = 1555.0
duration = 5.989
stream = ExtResource("140_6cstp")
text = "（自言自语）医疗报告...现在陈董事长死了，秘密应该也不会公开了吧。"

[sub_resource type="Resource" id="Resource_52mlo"]
script = ExtResource("7_bio7l")
speaker = &"G"
start = 1570.0
duration = 4.215
stream = ExtResource("141_ng6pu")
text = "（弹奏一曲哀乐）这首曲子，终于只属于我自己了。"

[sub_resource type="Resource" id="Resource_iayir"]
script = ExtResource("7_bio7l")
speaker = &"H"
start = 1585.0
duration = 5.017
stream = ExtResource("142_lri6d")
text = "花生粉的事...幸好没人追究。不然我的职业生涯也完了。"

[sub_resource type="Resource" id="Resource_t34kc"]
script = ExtResource("7_bio7l")
speaker = &"J"
start = 1600.0
duration = 7.408
stream = ExtResource("143_c02s8")
text = "（无线电）海岸警卫队，这里是海神号，请求协助。我们船上发生了一起谋杀案。"

[sub_resource type="Resource" id="Resource_233ni"]
script = ExtResource("7_bio7l")
speaker = &"J"
start = 1617.0
duration = 3.976
stream = ExtResource("144_0ihxl")
text = "嫌疑人已确认，但动机复杂，涉及多人。"

[sub_resource type="Resource" id="Resource_remmb"]
script = ExtResource("7_bio7l")
speaker = &"F"
start = 1630.0
duration = 3.086
stream = ExtResource("145_h3oir")
text = "（对E）没想到真有人比我们更快下手。"

[sub_resource type="Resource" id="Resource_ch4m8"]
script = ExtResource("7_bio7l")
speaker = &"E"
start = 1640.0
duration = 4.263
stream = ExtResource("146_cqnu0")
text = "是啊。但我现在反而庆幸...至少不是我的手。"

[sub_resource type="Resource" id="Resource_twjem"]
script = ExtResource("7_bio7l")
speaker = &"C"
start = 1660.0
duration = 5.655
stream = ExtResource("147_ttgdi")
text = "（翻看文件）这是...陈董事长和多家公司的秘密交易记录？"

[sub_resource type="Resource" id="Resource_wbtgj"]
script = ExtResource("7_bio7l")
speaker = &"C"
start = 1674.0
duration = 4.259
stream = ExtResource("148_t3c8i")
text = "天啊，如果这些曝光，会有更多人想要他死。"

[sub_resource type="Resource" id="Resource_ijbea"]
script = ExtResource("7_bio7l")
speaker = &"B"
start = 1690.0
duration = 2.688
stream = ExtResource("149_8c1m1")
text = "建国...你到底还瞒了我多少事？"

[sub_resource type="Resource" id="Resource_etbvi"]
script = ExtResource("7_bio7l")
speaker = &"I"
start = 1700.0
duration = 3.096
stream = ExtResource("150_fj3hm")
text = "（在休息室里）妈，我替你报仇了。"

[sub_resource type="Resource" id="Resource_f3qgc"]
script = ExtResource("7_bio7l")
speaker = &"D"
start = 1715.0
duration = 6.604
stream = ExtResource("151_aeteh")
text = "完整的尸检报告出来了。氰化物摄入时间精确到晚上十一点十五分左右。"

[sub_resource type="Resource" id="Resource_adpme"]
script = ExtResource("7_bio7l")
speaker = &"D"
start = 1730.0
duration = 4.386
stream = ExtResource("152_oin6v")
text = "那段时间，确实只有马服务员和陈董事长独处。"

[sub_resource type="Resource" id="Resource_kly15"]
script = ExtResource("7_bio7l")
speaker = &"J"
start = 1745.0
duration = 6.318
stream = ExtResource("153_mu2ec")
text = "案件到此告一段落。但船上每个人的秘密...远比这桩谋杀案更可怕。"

[sub_resource type="Resource" id="Resource_6gab6"]
script = ExtResource("7_bio7l")
speaker = &"J"
start = 1760.0
duration = 2.194
stream = ExtResource("154_ylcj8")
text = "海神号，继续航行。"

