track = Array[ExtResource("2_1pl4x")]([SubResource("Resource_f0yog"), SubResource("Resource_0htev"), SubResource("Resource_d8328"), SubResource("Resource_d0ycd"), SubResource("Resource_1xva6"), SubResource("Resource_qmbjt"), SubResource("Resource_4csgu"), SubResource("Resource_g5bh1"), SubResource("Resource_h55rx"), SubResource("Resource_ebnue"), SubResource("Resource_uulii"), SubResource("Resource_ioefp"), SubResource("Resource_85p4i"), SubResource("Resource_qyjy1"), SubResource("Resource_sm5s4"), SubResource("Resource_b461l"), SubResource("Resource_v7p85"), SubResource("Resource_p6mfg"), SubResource("Resource_883t3"), SubResource("Resource_kb0gy"), SubResource("Resource_3jott"), SubResource("Resource_pnvmx"), SubResource("Resource_lkbco"), SubResource("Resource_xxjc1"), SubResource("Resource_2s2as"), SubResource("Resource_8j3ut"), SubResource("Resource_yvo48"), SubResource("Resource_dq5xe"), SubResource("Resource_6i0cl"), SubResource("Resource_n3pxi"), SubResource("Resource_jgmtc"), SubResource("Resource_tq6e4"), SubResource("Resource_fuimg"), SubResource("Resource_4gvt1"), SubResource("Resource_c7v4p"), SubResource("Resource_f1l08"), SubResource("Resource_no2so"), SubResource("Resource_rr7md"), SubResource("Resource_0o6px"), SubResource("Resource_j2ve6"), SubResource("Resource_pehcy"), SubResource("Resource_v8cc2"), SubResource("Resource_2qcse"), SubResource("Resource_pny84"), SubResource("Resource_ducb7"), SubResource("Resource_osowi"), SubResource("Resource_0x3uf"), SubResource("Resource_urxex"), SubResource("Resource_ldlsj"), SubResource("Resource_uq6nv"), SubResource("Resource_6ad12"), SubResource("Resource_jkg8u"), SubResource("Resource_8ywui"), SubResource("Resource_hqeiw"), SubResource("Resource_61n7s"), SubResource("Resource_x762o")])

[sub_resource type="Resource" id="Resource_lrmx0"]
script = ExtResource("4_w0kty")
id = &"q1"
kind = 1
prompt = "每晚打进热线的“阿默”是谁？"
options = PackedStringArray()
answer = "老潘"

[sub_resource type="Resource" id="Resource_prpmr"]
script = ExtResource("4_w0kty")
id = &"q2"
kind = 1
prompt = "是谁把阿默的电话转进直播的？"
options = PackedStringArray()
answer = "唐果"

[sub_resource type="Resource" id="Resource_gicda"]
script = ExtResource("4_w0kty")
id = &"q3"
prompt = "叶青留下的录音带藏在哪里？"
options = PackedStringArray("唱片库的唱片封套里", "机房的设备柜", "天台水箱间", "台长办公室的保险柜")
answer = "唱片库的唱片封套里"

[sub_resource type="Resource" id="Resource_4cx8q"]
script = ExtResource("4_w0kty")
id = &"q4"
prompt = "周凯今晚原本打算做什么？"
options = PackedStringArray("在直播里说出真相", "辞职离开电台", "向台长勒索", "和林夕复合")
answer = "在直播里说出真相"

[sub_resource type="Resource" id="Resource_5yoox"]
script = ExtResource("4_w0kty")
id = &"q5"
prompt = "邵台长的不在场证明为什么站不住？"
