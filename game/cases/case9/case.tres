[sub_resource type="Resource" id="Resource_xd3hy"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 2.0
duration = 6.72
stream = ExtResource("11_v1mck")
text = "这里是海城人民广播电台，调频九十三点六。现在是午夜十二点整。"

[sub_resource type="Resource" id="Resource_crygp"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 5.0
duration = 5.56
stream = ExtResource("12_8t3dj")
text = "凯哥，你又喝了？今天是最后一期，台长说不定会过来。"

[sub_resource type="Resource" id="Resource_3k2ma"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 9.12
duration = 3.12
stream = ExtResource("13_bhd03")
text = "欢迎收听《夜半有声》。我是林夕。"

[sub_resource type="Resource" id="Resource_av2xs"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 10.0
duration = 7.16
stream = ExtResource("14_xkpkm")
text = "（自言自语）合并……合并了也好。旧楼一拆，干干净净。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_rn20f"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 10.96
duration = 6.04
stream = ExtResource("15_wjkgw")
text = "最后一期了，还怕什么。（喝了一口）你没闻到吗，这屋子里五年都是这股味儿。"

[sub_resource type="Resource" id="Resource_w5avx"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 12.0
duration = 4.12
stream = ExtResource("16_y1igy")
text = "（低声）青青，再等等。今晚，就今晚。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_c7m61"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 12.64
duration = 7.72
stream = ExtResource("17_4b03d")
text = "窗外，台风“海葵”正在登陆。如果您还没睡，请关好门窗，离窗户远一点。"

[sub_resource type="Resource" id="Resource_jg7lv"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 16.52
duration = 3.32
stream = ExtResource("18_kty6u")
text = "变声器……电池换过了，线也接好了。"

[sub_resource type="Resource" id="Resource_3mp4m"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 17.4
stream = ExtResource("19_nlii2")
text = "什么味儿？"

[sub_resource type="Resource" id="Resource_6wqw5"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 18.8
duration = 3.68
stream = ExtResource("20_j5mii")
text = "潮味儿。海边的楼，墙里头全是水。"

[sub_resource type="Resource" id="Resource_d7ugi"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 20.24
duration = 6.56
stream = ExtResource("21_gyw3s")
text = "唱片库下礼拜就清空了。再不放，这盘带子就跟着废纸一起进焚化炉。"

[sub_resource type="Resource" id="Resource_i7q5e"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 20.76
duration = 6.4
stream = ExtResource("22_8n8o4")
text = "今天，是《夜半有声》的最后一期。下个月起，咱们台就要和市台合并了。"

[sub_resource type="Resource" id="Resource_yabd1"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 20.898
duration = 5.6
stream = ExtResource("23_26ei0")
text = "台长，三楼的窗户我都看过了，唱片库那扇漏雨，我拿报纸塞上了。"

[sub_resource type="Resource" id="Resource_51w7w"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 22.88
duration = 5.04
stream = ExtResource("24_awh38")
text = "凯哥，你说今晚阿默还会打来吗？他都打了六天了。"

[sub_resource type="Resource" id="Resource_naub7"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 26.898
duration = 1.84
stream = ExtResource("25_kfldw")
text = "嗯。天台的门锁了吗？"

[sub_resource type="Resource" id="Resource_i6u70"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 27.56
duration = 7.84
stream = ExtResource("26_m2lb5")
text = "这五年，我在这间小屋子里，听你们讲了一千多个故事。有的让人害怕，有的让人心疼。"

[sub_resource type="Resource" id="Resource_j6gju"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 28.32
duration = 2.92
stream = ExtResource("27_m6epk")
text = "那个阿默……你从哪接进来的？"

[sub_resource type="Resource" id="Resource_xi2j4"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 29.138
duration = 3.8
stream = ExtResource("28_itldu")
text = "天台……那锁上礼拜就坏了，后勤还没来换。"

[sub_resource type="Resource" id="Resource_n8563"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 31.64
duration = 4.08
stream = ExtResource("29_wsmqu")
text = "热线啊，总机转过来的，我就推了一下推子。"

[sub_resource type="Resource" id="Resource_lbfsm"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 33.338
duration = 4.44
stream = ExtResource("30_g7sa8")
text = "坏了就拿铁丝拧上。今晚谁也不许上天台。"

[sub_resource type="Resource" id="Resource_0kqj2"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 35.8
duration = 6.36
stream = ExtResource("31_r4ddm")
text = "今晚，我们请到了写《海城异闻录》的作家沈墨先生，他已经在楼下等着了。"

[sub_resource type="Resource" id="Resource_vek8n"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 36.12
duration = 3.4
stream = ExtResource("32_ehi7p")
text = "总机？这个点总机就老潘一个人守着。"

[sub_resource type="Resource" id="Resource_j8skf"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 38.178
duration = 4.24
stream = ExtResource("33_aib7q")
text = "是。台长，那个……那个阿默说的事儿……"

[sub_resource type="Resource" id="Resource_dryu6"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 39.92
duration = 1.32
stream = ExtResource("34_fm6d7")
text = "（笑）那你问潘师傅去呀。"

[sub_resource type="Resource" id="Resource_n5ufs"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 41.64
duration = 5.4
stream = ExtResource("35_yfb4l")
text = "他讲的那些……红雨衣，台风夜，天台的铁栏杆……你不觉得太细了吗？"

[sub_resource type="Resource" id="Resource_4ixbk"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 42.56
duration = 5.32
stream = ExtResource("36_6m2w7")
text = "还有那位，这个星期每晚都会打来电话的听众，阿默。"

[sub_resource type="Resource" id="Resource_hqcgr"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 42.818
duration = 0.8
stream = ExtResource("37_ro12w")
text = "什么事？"

[sub_resource type="Resource" id="Resource_nt807"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 44.018
duration = 8.36
stream = ExtResource("38_hh2qj")
text = "他说，红雨衣的女人站在天台上，等一个人上去。大伙儿都说……说是五年前的叶青……"

[sub_resource type="Resource" id="Resource_sy6vf"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 47.44
duration = 6.36
stream = ExtResource("39_vlh47")
text = "讲鬼故事嘛，越细越吓人。收听率翻了三倍，台长都乐坏了。"

[sub_resource type="Resource" id="Resource_lte63"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 48.28
duration = 4.12
stream = ExtResource("40_ntpk8")
text = "阿默，如果你在听，今晚，我还在等你的电话。"

[sub_resource type="Resource" id="Resource_rdkyc"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 52.778
duration = 2.28
stream = ExtResource("41_w00dw")
text = "大刘，你在电台干了多少年了？"

[sub_resource type="Resource" id="Resource_molxv"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 52.8
duration = 4.4
stream = ExtResource("42_h48n3")
text = "先送给大家一首歌，邓丽君，《但愿人长久》。"

[sub_resource type="Resource" id="Resource_dfsxi"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 54.2
duration = 3.28
stream = ExtResource("43_1uxdh")
text = "台长乐？（冷笑）他昨天晚上一宿没睡。"

[sub_resource type="Resource" id="Resource_ic8ip"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 55.458
duration = 2.36
stream = ExtResource("44_vgve8")
text = "十二年了。"

[sub_resource type="Resource" id="Resource_s1c5b"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 57.88
duration = 4.24
stream = ExtResource("45_kt8ot")
text = "凯哥，那个穿红雨衣的女人……真的是叶青姐吗？"

[sub_resource type="Resource" id="Resource_u4byx"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 58.218
duration = 2.32
stream = ExtResource("46_o1qd1")
text = "十二年，还信这个？"

[sub_resource type="Resource" id="Resource_0wme1"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 60.938
duration = 3.52
stream = ExtResource("47_y5n8i")
text = "不是信……那天晚上是我值的班，我心里头……"

[sub_resource type="Resource" id="Resource_7nd1h"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 64.52
duration = 5.0
stream = ExtResource("48_ys044")
text = "我来台里的时候，大家都不提她。她的照片也从走廊上摘了。"

[sub_resource type="Resource" id="Resource_n73xa"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 64.858
duration = 5.56
stream = ExtResource("49_q3b2t")
text = "那天晚上的事，警察早有结论了。她为情所困，想不开。"

[sub_resource type="Resource" id="Resource_nq26u"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 69.92
duration = 2.76
stream = ExtResource("50_jk24l")
text = "唐果，好好推你的推子，别问了。"

[sub_resource type="Resource" id="Resource_2rm5d"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 70.818
duration = 1.6
stream = ExtResource("51_dt6qs")
text = "是，是。"

[sub_resource type="Resource" id="Resource_0pcij"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 72.818
duration = 4.24
stream = ExtResource("52_up3ju")
text = "回值班室待着。今晚台风大，楼里出了任何事，第一个找我。"

[sub_resource type="Resource" id="Resource_rwgn5"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 77.458
duration = 1.88
stream = ExtResource("53_gwa5k")
text = "好嘞台长。"

[sub_resource type="Resource" id="Resource_6x5ve"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 111.299
duration = 1.28
stream = ExtResource("54_elj3o")
text = "潘师傅。"

[sub_resource type="Resource" id="Resource_82ixj"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 112.979
duration = 2.4
stream = ExtResource("55_cudks")
text = "你怎么过来了？凯哥那边离得开？"

[sub_resource type="Resource" id="Resource_1cbel"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 115.779
duration = 4.28
stream = ExtResource("56_ilxnx")
text = "歌还有三分钟。我就想问问，今晚……还是十二点半？"

[sub_resource type="Resource" id="Resource_tensp"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 120.0
duration = 4.4
stream = ExtResource("57_rfn84")
text = "沈老师，请坐。耳机戴好，歌一结束就开麦。"

[sub_resource type="Resource" id="Resource_3j0yx"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 120.459
duration = 5.28
stream = ExtResource("58_0wtln")
text = "十二点半。热线二号。你听到铃响，直接推上去，别让总机登记。"

[sub_resource type="Resource" id="Resource_ddf2c"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 124.8
duration = 4.48
stream = ExtResource("59_awvwp")
text = "这屋子比我想的小。五年前，叶青也坐在这把椅子上？"

[sub_resource type="Resource" id="Resource_k1ssr"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 126.139
duration = 3.92
stream = ExtResource("60_w3anh")
text = "嗯。凯哥刚才问我，阿默是从哪接进来的。"

[sub_resource type="Resource" id="Resource_x23w6"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 129.68
duration = 1.2
stream = ExtResource("61_xaykt")
text = "……是。"

[sub_resource type="Resource" id="Resource_euxaj"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 130.459
duration = 1.6
stream = ExtResource("62_nxwq8")
text = "你怎么说？"

[sub_resource type="Resource" id="Resource_2iyf8"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 132.459
duration = 3.6
stream = ExtResource("63_o6x2i")
text = "我说总机转的。他说总机就你一个人。"

[sub_resource type="Resource" id="Resource_d7dcf"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 136.459
duration = 1.28
stream = ExtResource("64_xfjkf")
text = "（停顿）周凯起疑心了。"

[sub_resource type="Resource" id="Resource_rwvma"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 138.139
duration = 5.08
stream = ExtResource("65_b7c6p")
text = "潘师傅，你说的那盘带子，真的是叶青姐录的吗？"

[sub_resource type="Resource" id="Resource_6liin"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 143.619
duration = 9.32
stream = ExtResource("66_3en18")
text = "是她录的。台长收了化工厂二十万，把渔村孩子得白血病的报道压了下来。她把那天的谈话，全录了。"

[sub_resource type="Resource" id="Resource_4xc0d"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 153.339
duration = 1.76
stream = ExtResource("67_g6fbq")
text = "那带子现在在哪？"

[sub_resource type="Resource" id="Resource_8f5bs"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 155.499
duration = 4.04
stream = ExtResource("68_eejja")
text = "在它该在的地方。等我取出来，最后一首歌，就放它。"

[sub_resource type="Resource" id="Resource_cvjsw"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 159.939
duration = 1.84
stream = ExtResource("69_18lbs")
text = "潘师傅……你不怕吗？"

[sub_resource type="Resource" id="Resource_tsbkh"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 162.179
duration = 2.68
stream = ExtResource("70_t4jjp")
text = "怕了五年了。人老了，怕不动了。"

[sub_resource type="Resource" id="Resource_dvc3t"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 165.259
duration = 3.72
stream = ExtResource("71_axf6i")
text = "那我回去了。凯哥一个人，又该喝多了。"

[sub_resource type="Resource" id="Resource_hoa6k"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 180.0
duration = 6.76
stream = ExtResource("72_vd1fr")
text = "好，我们回到直播间。今天的嘉宾，是作家沈墨先生。沈老师，晚上好。"

[sub_resource type="Resource" id="Resource_hwilv"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 187.16
duration = 5.2
stream = ExtResource("73_4vbp3")
text = "林夕你好，各位听众朋友，晚上好。台风夜做客《夜半有声》，再合适不过了。"

[sub_resource type="Resource" id="Resource_o2afr"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 192.76
duration = 7.16
stream = ExtResource("74_rnqr0")
text = "沈老师写了很多海城的旧事。这一个星期，我们的听众阿默讲的故事，您听了吗？"

[sub_resource type="Resource" id="Resource_2tih6"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 200.32
duration = 3.56
stream = ExtResource("75_fj884")
text = "每一晚都听了。我得说，他讲得比我写得好。"

[sub_resource type="Resource" id="Resource_y7a5b"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 204.28
duration = 1.64
stream = ExtResource("76_lvg46")
text = "为什么这么说？"

[sub_resource type="Resource" id="Resource_ab04f"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 206.32
duration = 4.04
stream = ExtResource("77_6la1u")
text = "因为他讲的不像是编的。像是亲眼看见过。"

[sub_resource type="Resource" id="Resource_ffckx"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 210.76
duration = 1.36
stream = ExtResource("78_2frc4")
text = "您是说……"

[sub_resource type="Resource" id="Resource_vk45i"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 212.52
duration = 8.24
stream = ExtResource("79_jqi0y")
text = "红雨衣，台风夜，电台天台的铁栏杆，栏杆上一道掰弯的口子。这些细节，编故事的人想不到。"

[sub_resource type="Resource" id="Resource_n2c6n"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 221.16
duration = 4.28
stream = ExtResource("80_2bs4p")
text = "沈老师，您在节目里这么说，会吓到听众的。"

[sub_resource type="Resource" id="Resource_1ycsr"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 225.84
duration = 2.8
stream = ExtResource("81_30lw6")
text = "吓到才好。这个节目叫《夜半有声》嘛。"

[sub_resource type="Resource" id="Resource_t4mc4"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 229.04
duration = 7.84
stream = ExtResource("82_kw7vq")
text = "我查过旧报纸。五年前，一九九一年的台风夜，这个电台有一位女主持人从天台坠落。"

[sub_resource type="Resource" id="Resource_j4ny3"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 237.28
duration = 4.32
stream = ExtResource("83_a02qy")
text = "报纸上只有一小块豆腐块，说是“感情受挫，一时想不开”。"

[sub_resource type="Resource" id="Resource_y6r26"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 242.0
duration = 3.64
stream = ExtResource("84_pq4nu")
text = "（停顿）……她叫叶青。她是我的老师。"

[sub_resource type="Resource" id="Resource_u4c5q"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 246.04
duration = 1.12
stream = ExtResource("85_ucweg")
text = "抱歉。"

[sub_resource type="Resource" id="Resource_7ednx"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 247.56
duration = 5.64
stream = ExtResource("86_spdki")
text = "没关系。她教我的第一件事就是，话筒前面，不要撒谎。"

[sub_resource type="Resource" id="Resource_t3jnd"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 252.0
duration = 2.6
stream = ExtResource("87_nqgj4")
text = "（自言自语）十二点半……他又要打来了。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_dwfrc"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 253.6
duration = 3.04
stream = ExtResource("88_1jah0")
text = "那我就不撒谎了。我不信她是自杀。"

[sub_resource type="Resource" id="Resource_c17v6"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 255.0
duration = 3.28
stream = ExtResource("89_fv1f5")
text = "周凯？节目正在播，你跑过来干什么？"

[sub_resource type="Resource" id="Resource_fk4wq"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 257.04
duration = 1.32
stream = ExtResource("90_lwvdx")
text = "为什么？"

[sub_resource type="Resource" id="Resource_ql361"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 258.68
duration = 3.28
stream = ExtResource("91_1pl4x")
text = "唐果看着呢。台长，我有话跟您说。"

[sub_resource type="Resource" id="Resource_fdjw2"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 258.76
duration = 4.64
stream = ExtResource("92_uoabn")
text = "一个准备第二天播重磅新闻的人，前一天晚上不会想死。"

[sub_resource type="Resource" id="Resource_qrdog"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 262.36
duration = 0.44
stream = ExtResource("93_w0kty")
text = "说。"

[sub_resource type="Resource" id="Resource_myhh6"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 263.2
duration = 6.08
stream = ExtResource("94_lus33")
text = "这几天那个阿默说的，全是那天晚上的事。红雨衣……她那天就是穿的红雨衣。"

[sub_resource type="Resource" id="Resource_3wtyp"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 263.8
stream = ExtResource("95_yo65q")
text = "重磅新闻？"

[sub_resource type="Resource" id="Resource_mxbie"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 265.2
duration = 1.96
stream = ExtResource("96_y6dhm")
text = "这个，要等阿默来说了。"

[sub_resource type="Resource" id="Resource_4ug1h"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 267.56
duration = 6.76
stream = ExtResource("97_3kf06")
text = "（深吸一口气）好。各位听众，阿默的电话，我们十二点半等他。先休息一下，听一首歌。"

[sub_resource type="Resource" id="Resource_1y0c0"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 269.68
duration = 2.6
stream = ExtResource("98_yyh5e")
text = "那又怎么样？报纸上登过。"

[sub_resource type="Resource" id="Resource_aud4b"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 272.68
duration = 6.96
stream = ExtResource("99_mhhyx")
text = "报纸上没登栏杆。栏杆上那道口子，是她的手指头掰的。这件事只有三个人知道。"

[sub_resource type="Resource" id="Resource_txrj2"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 274.72
duration = 2.0
stream = ExtResource("100_bo0wp")
text = "林夕，你的手在抖。"

[sub_resource type="Resource" id="Resource_t70cs"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 277.12
duration = 1.44
stream = ExtResource("101_8teb6")
text = "是空调太冷了。"

[sub_resource type="Resource" id="Resource_wspat"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 280.04
duration = 0.84
stream = ExtResource("102_fyf3c")
text = "（停顿）你喝多了。"

[sub_resource type="Resource" id="Resource_tap6m"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 281.28
duration = 8.0
stream = ExtResource("103_wselg")
text = "我是喝多了。我这五年，天天都喝多。一闭眼就看见她的手，抓着栏杆，一根一根地松开……"

[sub_resource type="Resource" id="Resource_5r8di"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 289.68
duration = 1.28
stream = ExtResource("104_1oahm")
text = "周凯，你看着我。"

[sub_resource type="Resource" id="Resource_yyur3"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 291.36
duration = 2.8
stream = ExtResource("105_o5fvi")
text = "台长，我不想要导播这个位子了。"

[sub_resource type="Resource" id="Resource_7mos6"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 294.56
duration = 5.88
stream = ExtResource("106_koj6o")
text = "你不想要？当年是谁跪在我这间屋里，说只要能留在台里，什么都愿意做？"

[sub_resource type="Resource" id="Resource_61od8"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 300.84
duration = 1.28
stream = ExtResource("107_u8cb2")
text = "是我。"

[sub_resource type="Resource" id="Resource_ko1hl"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 302.52
duration = 2.56
stream = ExtResource("108_ouil0")
text = "你拿了这个位子，就得睡得着觉。"

[sub_resource type="Resource" id="Resource_dhed8"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 305.48
duration = 2.32
stream = ExtResource("109_xsewq")
text = "我睡不着！我睡不着！"

[sub_resource type="Resource" id="Resource_6x6e2"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 308.2
duration = 2.16
stream = ExtResource("110_v856v")
text = "小点声。外面有人。"

[sub_resource type="Resource" id="Resource_pggka"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 310.76
duration = 6.04
stream = ExtResource("111_30lqh")
text = "周凯，你想清楚。那天晚上，你也在天台上。你上来的时候，她还没掉下去。"

[sub_resource type="Resource" id="Resource_p5vx3"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 317.2
duration = 5.04
stream = ExtResource("112_42l62")
text = "（颤抖）……我喊不出来。我就站在门口，看着。"

[sub_resource type="Resource" id="Resource_k1c5t"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 322.64
duration = 5.08
stream = ExtResource("113_cgrj0")
text = "对。你看着。你一句话都没说。这件事要是翻出来，你跑得掉吗？"

[sub_resource type="Resource" id="Resource_orq86"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 330.12
duration = 5.36
stream = ExtResource("114_snrvx")
text = "回去，好好把最后一期做完。下个月合并，我推荐你去市台当主任。"

[sub_resource type="Resource" id="Resource_8ujw6"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 505.783
duration = 4.64
stream = ExtResource("115_tpy4t")
text = "周凯，歌还有四分钟，我进来拿一下听众来信。"

[sub_resource type="Resource" id="Resource_35f8g"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 510.823
duration = 1.16
stream = ExtResource("116_03xha")
text = "夕夕。"

[sub_resource type="Resource" id="Resource_1uyah"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 512.383
duration = 2.64
stream = ExtResource("117_q3t0o")
text = "别这么叫我。我们分开两年了。"

[sub_resource type="Resource" id="Resource_1oxjt"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 515.423
duration = 3.08
stream = ExtResource("118_ke0fv")
text = "那个……我去休息室倒杯热水。"

[sub_resource type="Resource" id="Resource_q5vi0"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 518.903
duration = 3.24
stream = ExtResource("119_lhjaq")
text = "林夕，今晚节目结束之前，给我五分钟。"

[sub_resource type="Resource" id="Resource_7l2vf"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 522.543
duration = 1.76
stream = ExtResource("120_y2u86")
text = "五分钟干什么？"

[sub_resource type="Resource" id="Resource_47wjb"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 524.703
duration = 1.88
stream = ExtResource("121_u6g30")
text = "我有话要在节目里说。"

[sub_resource type="Resource" id="Resource_fqqvm"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 526.983
duration = 2.88
stream = ExtResource("122_afrua")
text = "在节目里？你知道这是直播。"

[sub_resource type="Resource" id="Resource_j62ef"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 530.263
duration = 4.88
stream = ExtResource("123_5nqto")
text = "就因为是直播。有些话，私下说没人信，说完就被按下去了。"

[sub_resource type="Resource" id="Resource_0uakb"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 535.543
duration = 2.44
stream = ExtResource("124_bxyuq")
text = "周凯，你到底要说什么？"

[sub_resource type="Resource" id="Resource_x1p67"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 538.383
duration = 2.4
stream = ExtResource("125_md34y")
text = "关于叶青。关于那天晚上。"

[sub_resource type="Resource" id="Resource_uicg6"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 541.183
duration = 0.8
stream = ExtResource("126_uwpq0")
text = "（愣住）……你知道什么？"

[sub_resource type="Resource" id="Resource_m20d1"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 542.383
duration = 6.68
stream = ExtResource("127_naiqv")
text = "我知道得比谁都多。我是个混蛋，林夕。这五年，我天天都在等一个人来揭穿我。"

[sub_resource type="Resource" id="Resource_j3f05"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 543.147
duration = 3.8
stream = ExtResource("128_y5mht")
text = "哎哎哎，沈作家！你去哪？天台不能上！"

[sub_resource type="Resource" id="Resource_3cbeh"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 547.347
duration = 4.48
stream = ExtResource("129_agppb")
text = "刘师傅，我就上去看一眼。写东西，总得看看现场。"

[sub_resource type="Resource" id="Resource_gucvu"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 549.463
duration = 1.36
stream = ExtResource("130_5yutj")
text = "那个阿默……"

[sub_resource type="Resource" id="Resource_fyaxx"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 551.223
duration = 3.8
stream = ExtResource("131_fy3hj")
text = "我不知道他是谁。可他知道。他什么都知道。"

[sub_resource type="Resource" id="Resource_tgndw"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 552.227
duration = 3.36
stream = ExtResource("132_cs088")
text = "台长说了，今晚谁也不许上天台。"

[sub_resource type="Resource" id="Resource_glj63"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 555.423
duration = 3.88
stream = ExtResource("133_i3ijt")
text = "好。最后一首歌之前，我给你五分钟。"

[sub_resource type="Resource" id="Resource_2ivdu"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 555.987
duration = 2.96
stream = ExtResource("134_tvlg0")
text = "（递烟）刘师傅，抽根烟。红塔山。"

[sub_resource type="Resource" id="Resource_cmatp"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 559.347
duration = 1.68
stream = ExtResource("135_nkqck")
text = "这……那就一根。"

[sub_resource type="Resource" id="Resource_nlcrc"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 559.703
duration = 1.76
stream = ExtResource("136_yst6b")
text = "谢谢。"

[sub_resource type="Resource" id="Resource_dl8cg"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 561.427
duration = 2.92
stream = ExtResource("137_1fncf")
text = "刘师傅在台里干了很多年了吧？"

[sub_resource type="Resource" id="Resource_ypie5"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 561.863
duration = 1.6
stream = ExtResource("138_nv8lm")
text = "你别再喝了。"

[sub_resource type="Resource" id="Resource_5tgi7"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 564.747
duration = 2.36
stream = ExtResource("44_vgve8")
text = "十二年了。"

[sub_resource type="Resource" id="Resource_mx6hc"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 567.507
duration = 2.08
stream = ExtResource("139_u3a3g")
text = "那五年前那天晚上……"

[sub_resource type="Resource" id="Resource_h0wph"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 569.987
duration = 2.68
stream = ExtResource("140_rf6kr")
text = "（叹气）那天晚上，是我值的班。"

[sub_resource type="Resource" id="Resource_1usdl"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 573.067
duration = 1.64
stream = ExtResource("141_bv3jj")
text = "你上天台了吗？"

[sub_resource type="Resource" id="Resource_vqyo3"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 575.107
duration = 4.8
stream = ExtResource("142_eg1we")
text = "我听见一声叫，就往上跑。我跑到天台上，人已经在下面了。"

[sub_resource type="Resource" id="Resource_f0yog"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 580.307
duration = 4.48
stream = ExtResource("143_xy0q6")
text = "天台上就剩一件红雨衣，挂在栏杆上，哗啦哗啦地响。"

[sub_resource type="Resource" id="Resource_0htev"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 585.187
duration = 1.76
stream = ExtResource("144_iv8gq")
text = "只有一件雨衣？"

[sub_resource type="Resource" id="Resource_d8328"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 587.347
duration = 5.44
stream = ExtResource("145_q56jp")
text = "还有……我在楼梯上碰见了周导。他从上面下来，脸白得跟纸一样。"

[sub_resource type="Resource" id="Resource_d0ycd"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 593.187
duration = 1.96
stream = ExtResource("146_1ugnx")
text = "周凯？他跟你说什么了？"

[sub_resource type="Resource" id="Resource_1xva6"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 595.547
duration = 3.6
stream = ExtResource("147_r2uwg")
text = "他什么都没说。他就那么看着我，一直发抖。"

[sub_resource type="Resource" id="Resource_qmbjt"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 599.547
duration = 3.92
stream = ExtResource("148_ikjpd")
text = "后来警察来，问我看见谁了，台长让我……"

[sub_resource type="Resource" id="Resource_4csgu"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 603.867
duration = 1.4
stream = ExtResource("149_dkxna")
text = "让你什么？"

[sub_resource type="Resource" id="Resource_g5bh1"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 605.667
duration = 6.0
stream = ExtResource("150_408ft")
text = "（摆手）没什么，没什么。我什么都没说。烟抽完了，你快下来啊。"

[sub_resource type="Resource" id="Resource_h55rx"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 612.067
duration = 1.2
stream = ExtResource("151_66vhj")
text = "就十分钟。"

[sub_resource type="Resource" id="Resource_ebnue"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 648.0
duration = 5.4
stream = ExtResource("152_v6w7x")
text = "我们继续。这里有一封听众来信，写信的是一位渔村的母亲。"

[sub_resource type="Resource" id="Resource_uulii"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 653.8
duration = 6.36
stream = ExtResource("153_vaopy")
text = "她说：林夕，我女儿走了五年了。她走之前，最喜欢听叶青姐姐的节目。"

[sub_resource type="Resource" id="Resource_ioefp"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 660.56
duration = 6.68
stream = ExtResource("154_815cj")
text = "叶青姐姐说过，要替我们村的孩子讨个说法。后来，叶青姐姐也不在了。"

[sub_resource type="Resource" id="Resource_85p4i"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 667.64
duration = 2.8
stream = ExtResource("155_faw4g")
text = "（停顿）……对不起，我念不下去了。"

[sub_resource type="Resource" id="Resource_qyjy1"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 670.84
duration = 4.48
stream = ExtResource("156_jvll4")
text = "这位妈妈，如果您在听……我会把这封信，一直留着。"

[sub_resource type="Resource" id="Resource_sm5s4"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 696.0
duration = 7.16
stream = ExtResource("157_vovfv")
text = "（自言自语）好大的风。栏杆……这一截是新换的，焊口还是亮的。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_b461l"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 707.178
duration = 2.68
stream = ExtResource("158_qcdvo")
text = "水箱间里……怎么会有一部电话？"

[sub_resource type="Resource" id="Resource_v7p85"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 710.258
duration = 5.44
stream = ExtResource("159_bilim")
text = "线是新拉的，顺着水管下去。（拿起听筒）……有声音，是内线。"

[sub_resource type="Resource" id="Resource_p6mfg"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 716.098
duration = 3.32
stream = ExtResource("160_7qmxt")
text = "还有个本子……“十二点半，热线二号”。"

[sub_resource type="Resource" id="Resource_883t3"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 719.818
duration = 2.28
stream = ExtResource("161_3i4rg")
text = "（低声）阿默，原来你就在这栋楼里。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_kb0gy"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 759.646
duration = 6.92
stream = ExtResource("162_g6id0")
text = "（低声）《淡淡幽情》……还在。青青，你最喜欢的这张。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_3jott"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 771.296
duration = 3.88
stream = ExtResource("163_iupm5")
text = "（自言自语）谁动过本子？……风吹的吧。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_pnvmx"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 840.0
duration = 2.64
stream = ExtResource("164_mo7lx")
text = "林夕，我有件事要告诉你。"

[sub_resource type="Resource" id="Resource_lkbco"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 843.04
duration = 1.96
stream = ExtResource("165_aowhj")
text = "小声点，麦没关严。"

[sub_resource type="Resource" id="Resource_xxjc1"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 845.4
duration = 4.28
stream = ExtResource("166_drmrw")
text = "天台水箱间里，有一部电话，线是新接的，是内线。"

[sub_resource type="Resource" id="Resource_2s2as"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 850.08
duration = 1.28
stream = ExtResource("167_hmaqk")
text = "内线？"

[sub_resource type="Resource" id="Resource_8j3ut"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 851.76
duration = 4.08
stream = ExtResource("168_7skpa")
text = "那个阿默，不是从外面打进来的。他就在这栋楼里。"

[sub_resource type="Resource" id="Resource_yvo48"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 856.24
duration = 1.88
stream = ExtResource("169_3wda4")
text = "（停顿）……你确定？"

[sub_resource type="Resource" id="Resource_dq5xe"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 858.52
duration = 3.64
stream = ExtResource("170_vb1l7")
text = "本子上写着，十二点半，热线二号。"

[sub_resource type="Resource" id="Resource_6i0cl"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 862.56
duration = 3.72
stream = ExtResource("171_lb4do")
text = "那就让他打。我想听他把话说完。"

[sub_resource type="Resource" id="Resource_n3pxi"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 912.0
duration = 3.36
stream = ExtResource("172_jej0a")
text = "热线二号！凯哥，是二号！"

[sub_resource type="Resource" id="Resource_jgmtc"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 915.76
duration = 2.56
stream = ExtResource("173_6c1v8")
text = "二号？这条线不是早就停了吗？"

[sub_resource type="Resource" id="Resource_tq6e4"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 918.72
duration = 2.16
stream = ExtResource("174_p8646")
text = "我、我推上去了！"

[sub_resource type="Resource" id="Resource_fuimg"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 924.0
duration = 6.24
stream = ExtResource("175_gbti1")
text = "各位听众，我们的热线电话响了。喂，您好，这里是《夜半有声》。"

[sub_resource type="Resource" id="Resource_4gvt1"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 930.64
duration = 1.92
stream = ExtResource("176_wyu0t")
text = "你好，林夕。我是阿默。"

[sub_resource type="Resource" id="Resource_c7v4p"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 932.96
duration = 3.96
stream = ExtResource("177_71hhp")
text = "阿默，晚上好。今天是最后一期。"

[sub_resource type="Resource" id="Resource_f1l08"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 937.32
duration = 2.84
stream = ExtResource("178_3nsg6")
text = "我知道。所以我来讲这个故事的结尾。"

[sub_resource type="Resource" id="Resource_no2so"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 940.56
duration = 1.08
stream = ExtResource("179_e1n5e")
text = "我们都在听。"

[sub_resource type="Resource" id="Resource_rr7md"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 942.04
duration = 6.6
stream = ExtResource("180_vny3u")
text = "五年前，台风夜。穿红雨衣的女人上了天台。她手里拿着一样东西，一盘录音带。"

[sub_resource type="Resource" id="Resource_0o6px"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 949.04
duration = 3.04
stream = ExtResource("181_4q2mw")
text = "她要把这盘带子，放给全城的人听。"

[sub_resource type="Resource" id="Resource_j2ve6"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 952.48
duration = 1.64
stream = ExtResource("182_5n527")
text = "带子里是什么？"

[sub_resource type="Resource" id="Resource_pehcy"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 954.52
duration = 4.24
stream = ExtResource("183_yuusn")
text = "是一个人，收了二十万，把一群孩子的命压了下去。"

[sub_resource type="Resource" id="Resource_v8cc2"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 959.16
duration = 0.92
stream = ExtResource("184_hmd8i")
text = "（低声）二十万……"
loudness = 0.3

[sub_resource type="Resource" id="Resource_2qcse"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 960.48
duration = 7.16
stream = ExtResource("185_ea1gi")
text = "那天晚上，天台上不只她一个人。有一个人伸手抢她的东西，另一个人，站在门口看着。"

[sub_resource type="Resource" id="Resource_pny84"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 968.04
duration = 3.08
stream = ExtResource("186_8hwe1")
text = "（声音发紧）站在门口的人……为什么不救她？"

[sub_resource type="Resource" id="Resource_ducb7"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 971.52
duration = 3.88
stream = ExtResource("187_h86ro")
text = "因为他怕。后来，他用这份怕，换了一个好位子。"

[sub_resource type="Resource" id="Resource_osowi"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 975.8
duration = 3.2
stream = ExtResource("188_f24ob")
text = "阿默，你说的这些……有证据吗？"

[sub_resource type="Resource" id="Resource_0x3uf"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 979.4
duration = 5.32
stream = ExtResource("189_i85mc")
text = "她的带子，没有被抢走。它在一个很安全的地方，躺了五年。"

[sub_resource type="Resource" id="Resource_urxex"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 985.12
duration = 5.36
stream = ExtResource("190_mq4fj")
text = "今晚，十二点三刻，她的声音会回到这个频率上。请所有人，听好。"

[sub_resource type="Resource" id="Resource_ldlsj"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 990.88
duration = 1.16
stream = ExtResource("191_sx7kq")
text = "阿默——"

[sub_resource type="Resource" id="Resource_uq6nv"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 992.44
duration = 3.76
stream = ExtResource("192_2wtou")
text = "林夕，你是她最好的学生。替她把话说完。"

[sub_resource type="Resource" id="Resource_6ad12"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 996.6
duration = 0.48
stream = ExtResource("193_t51eq")
text = "（低声）再见。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_jkg8u"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 997.48
duration = 2.08
stream = ExtResource("194_20jmk")
text = "喂？阿默？……他挂了。"

[sub_resource type="Resource" id="Resource_8ywui"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 999.96
duration = 3.88
stream = ExtResource("195_kht04")
text = "各位听众……我们……我们先听一首歌。"

[sub_resource type="Resource" id="Resource_hqeiw"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 1008.0
duration = 3.12
stream = ExtResource("196_wlu2n")
text = "（颤抖）站在门口的人……他说的是我。"

[sub_resource type="Resource" id="Resource_61n7s"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 1011.52
duration = 2.12
stream = ExtResource("197_03jeg")
text = "凯哥？你说什么？"

[sub_resource type="Resource" id="Resource_x762o"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 1014.04
duration = 4.2
stream = ExtResource("198_mdkf2")
text = "唐果，你老实告诉我，这个电话，是不是你接进来的？"

[sub_resource type="Resource" id="Resource_ig4lt"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 1018.64
duration = 2.24
stream = ExtResource("199_yn3kq")
text = "我、我只是推了推子……"

[sub_resource type="Resource" id="Resource_lrmx0"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1020.0
duration = 6.48
stream = ExtResource("200_20ar3")
text = "（自言自语）二十万……带子……带子没丢？"
loudness = 0.3

[sub_resource type="Resource" id="Resource_prpmr"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 1021.28
duration = 1.36
stream = ExtResource("201_egs70")
text = "他是谁？"

[sub_resource type="Resource" id="Resource_gicda"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 1023.04
duration = 2.16
stream = ExtResource("202_pg7fw")
text = "凯哥，我不能说。"

[sub_resource type="Resource" id="Resource_4cx8q"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 1025.6
duration = 4.56
stream = ExtResource("203_04cgo")
text = "（苦笑）不说也好。今晚，就让我自己说。"

[sub_resource type="Resource" id="Resource_5yoox"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1026.88
duration = 3.84
stream = ExtResource("204_tuxrp")
text = "不可能……那天晚上我明明搜过她的雨衣……"

[sub_resource type="Resource" id="Resource_371i4"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1058.322
duration = 2.68
stream = ExtResource("205_vm6vi")
text = "刚才那个电话，从哪打进来的！"

[sub_resource type="Resource" id="Resource_qo7by"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 1061.402
duration = 2.6
stream = ExtResource("206_u7i5u")
text = "总、总机转的……"

[sub_resource type="Resource" id="Resource_22x4v"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1064.402
duration = 1.84
stream = ExtResource("207_ek6fn")
text = "总机？总机的老潘人呢？"

[sub_resource type="Resource" id="Resource_3tlvu"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 1066.642
duration = 3.84
stream = ExtResource("208_182j1")
text = "不、不知道，潘师傅可能去厕所了……"

[sub_resource type="Resource" id="Resource_2whti"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1070.882
duration = 2.2
stream = ExtResource("209_oa5bk")
text = "周凯，你是导播，你也不知道？"

[sub_resource type="Resource" id="Resource_w7cum"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 1073.482
duration = 1.52
stream = ExtResource("210_x2gcd")
text = "我不知道，台长。"

[sub_resource type="Resource" id="Resource_qac11"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1075.402
duration = 1.2
stream = ExtResource("211_j2c8w")
text = "（盯着他）你最好不知道。"

[sub_resource type="Resource" id="Resource_vfv10"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1080.194
duration = 6.96
stream = ExtResource("212_ftkav")
text = "（自言自语）人不在……这是什么？变声器……"
loudness = 0.3

[sub_resource type="Resource" id="Resource_co8db"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1087.554
duration = 3.8
stream = ExtResource("213_p03u6")
text = "线头还是热的。老潘……原来是你。"

[sub_resource type="Resource" id="Resource_yr20t"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 1094.33
duration = 2.12
stream = ExtResource("214_lw28o")
text = "（自言自语）青青，到时候了。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_kvuth"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1094.946
duration = 1.36
stream = ExtResource("215_mxfsv")
text = "周凯，你出来一下。"

[sub_resource type="Resource" id="Resource_07nwc"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 1096.85
duration = 5.48
stream = ExtResource("216_b0jpw")
text = "《淡淡幽情》……封套里……在这儿。五年了，一点没受潮。"

[sub_resource type="Resource" id="Resource_g253b"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1097.976
duration = 2.2
stream = ExtResource("217_eh8iv")
text = "（低声）天台。五分钟以后。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_kpndf"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 1100.576
duration = 1.32
stream = ExtResource("218_fucci")
text = "天台？"

[sub_resource type="Resource" id="Resource_p6d2h"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1102.296
duration = 5.08
stream = ExtResource("219_870oo")
text = "你想在节目里说的话，先上去跟我说。说完了，你想怎么样，我都不拦你。"

[sub_resource type="Resource" id="Resource_vbxia"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 1102.73
duration = 5.28
stream = ExtResource("220_imm5f")
text = "你放在我手里的那天说，潘叔，替我收好，万一我出事……"

[sub_resource type="Resource" id="Resource_o2kon"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 1107.776
duration = 1.12
stream = ExtResource("221_r5wej")
text = "……好。"

[sub_resource type="Resource" id="Resource_ysm6n"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 1108.41
duration = 4.32
stream = ExtResource("222_lkq38")
text = "（哽咽）我收好了。收了五年。"

[sub_resource type="Resource" id="Resource_55yof"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 1114.256
duration = 3.36
stream = ExtResource("223_xxglg")
text = "（自言自语）五分钟……再抽一根烟。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_fsg85"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 1116.813
duration = 2.56
stream = ExtResource("224_34l72")
text = "有人动过……变声器被挪了。"

[sub_resource type="Resource" id="Resource_sfg06"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 1119.773
duration = 0.68
stream = ExtResource("225_qhamt")
text = "（低声）台长来过。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_harm6"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 1120.853
duration = 3.0
stream = ExtResource("226_bsuf2")
text = "来就来吧。带子在我手里，谁也拿不走了。"

[sub_resource type="Resource" id="Resource_rb4ec"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 1188.0
duration = 1.52
stream = ExtResource("227_nxwiv")
text = "林夕，你还好吗？"

[sub_resource type="Resource" id="Resource_sv8wj"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 1189.92
duration = 2.68
stream = ExtResource("228_kalv5")
text = "沈老师，“站在门口的人”……"

[sub_resource type="Resource" id="Resource_f4018"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 1193.0
duration = 1.48
stream = ExtResource("229_2ikg2")
text = "你想到谁了？"

[sub_resource type="Resource" id="Resource_dku3x"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 1194.88
duration = 6.84
stream = ExtResource("230_tcshg")
text = "周凯。我们在一起的时候，他每次喝醉，都会做同一个噩梦，喊“别松手”。"

[sub_resource type="Resource" id="Resource_0cbil"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 1202.12
duration = 2.48
stream = ExtResource("231_pxn7l")
text = "那他今晚要你给他五分钟……"

[sub_resource type="Resource" id="Resource_1pldq"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 1205.0
duration = 1.08
stream = ExtResource("232_xa317")
text = "他要坦白。"

[sub_resource type="Resource" id="Resource_rupoa"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 1206.48
duration = 3.24
stream = ExtResource("233_vuxaa")
text = "那个收了二十万的人，不会让他坦白的。"

[sub_resource type="Resource" id="Resource_4rg3m"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 1210.12
duration = 0.6
stream = ExtResource("234_ikig2")
text = "（站起来）我去找他。"

[sub_resource type="Resource" id="Resource_w6r4m"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 1211.12
duration = 3.16
stream = ExtResource("235_c2sd0")
text = "歌还没完。你是主持人，你不能离开直播间。"

[sub_resource type="Resource" id="Resource_d04fc"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 1214.68
duration = 5.52
stream = ExtResource("236_jhjrg")
text = "……对。我不能离开。沈老师，你去导播间看看他。"

[sub_resource type="Resource" id="Resource_gksji"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 1220.6
duration = 0.88
stream = ExtResource("237_h1kqq")
text = "好。"

[sub_resource type="Resource" id="Resource_dws3n"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 1223.468
duration = 1.76
stream = ExtResource("238_6l8ap")
text = "唐果，周凯呢？"

[sub_resource type="Resource" id="Resource_c40tk"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 1225.628
duration = 4.68
stream = ExtResource("239_0mnv5")
text = "凯哥……凯哥刚才被台长叫出去了。他说去去就回。"

[sub_resource type="Resource" id="Resource_qrybf"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 1230.708
duration = 1.2
stream = ExtResource("240_omied")
text = "去哪了？"

[sub_resource type="Resource" id="Resource_wt1kj"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 1232.308
duration = 1.08
stream = ExtResource("241_mtsq3")
text = "我不知道……"

[sub_resource type="Resource" id="Resource_vkhot"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 1233.788
duration = 1.44
stream = ExtResource("242_6fwh5")
text = "那我在这儿等他。"

[sub_resource type="Resource" id="Resource_w65qd"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1320.0
duration = 2.28
stream = ExtResource("243_0anfs")
text = "来了？过来点说，风太大。"

[sub_resource type="Resource" id="Resource_1700f"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 1323.51
duration = 5.2
stream = ExtResource("244_w3t5k")
text = "台长，我想好了。最后一首歌之前，我把那天晚上的事，全说出来。"

[sub_resource type="Resource" id="Resource_0o320"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1329.11
duration = 2.8
stream = ExtResource("245_gb5jj")
text = "全说出来？说什么？"

[sub_resource type="Resource" id="Resource_b4w7d"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 1332.31
duration = 5.84
stream = ExtResource("246_g2d80")
text = "说你抢她的带子。说她抓着栏杆，你一根一根地，把她的手指头掰开。"

[sub_resource type="Resource" id="Resource_kkjxg"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1338.55
duration = 2.8
stream = ExtResource("247_5j7th")
text = "（平静）是她自己没站稳。"

[sub_resource type="Resource" id="Resource_ehgqt"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 1341.75
duration = 2.64
stream = ExtResource("248_hxkfm")
text = "你把她的手掰开的！我看见了！"

[sub_resource type="Resource" id="Resource_h1olu"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1344.79
duration = 2.72
stream = ExtResource("249_u5txl")
text = "你看见了，五年里一个字都没说。"

[sub_resource type="Resource" id="Resource_onaek"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 1347.91
duration = 4.16
stream = ExtResource("250_06id6")
text = "所以我今天要说。我说了，我也去坐牢。我认了。"

[sub_resource type="Resource" id="Resource_mvo0t"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1352.47
duration = 8.28
stream = ExtResource("251_6ob6r")
text = "周凯，你以为你说了，有人信？一个酒鬼，一个前男友。“为情所困”，这四个字，警察记得清清楚楚。"

[sub_resource type="Resource" id="Resource_jl2ic"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 1361.15
duration = 2.64
stream = ExtResource("252_h0wgl")
text = "带子还在。阿默说了，带子还在。"

[sub_resource type="Resource" id="Resource_c2kwt"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1364.19
duration = 4.16
stream = ExtResource("253_8ocw6")
text = "带子……带子在老潘手里，对吧？变声器我看见了。"

[sub_resource type="Resource" id="Resource_ajf5a"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 1368.75
duration = 0.52
stream = ExtResource("254_v5bde")
text = "（愣住）老潘？"

[sub_resource type="Resource" id="Resource_h6hxe"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1369.67
duration = 3.88
stream = ExtResource("255_0qtkc")
text = "原来你也不知道。你们一个个的，都瞒着我。"

[sub_resource type="Resource" id="Resource_busp3"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1373.95
duration = 4.36
stream = ExtResource("256_8yxhv")
text = "周凯，你看下面。五年前，她就落在那块水泥地上。"

[sub_resource type="Resource" id="Resource_plj4k"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 1378.71
duration = 1.44
stream = ExtResource("257_bb48f")
text = "你要干什么？"

[sub_resource type="Resource" id="Resource_70w5p"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1380.55
duration = 5.72
stream = ExtResource("258_3gq2i")
text = "风真大啊。这么大的风，一个喝醉的人，站不稳，也是常事。"

[sub_resource type="Resource" id="Resource_5shiy"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 1386.67
duration = 1.16
stream = ExtResource("259_hpf2q")
text = "你别过来——"

[sub_resource type="Resource" id="Resource_begl3"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1388.23
duration = 2.88
stream = ExtResource("260_rlofr")
text = "“为情所困”。跟她一样。"

[sub_resource type="Resource" id="Resource_exwu3"]
script = ExtResource("10_ljbqc")
speaker = &"C"
start = 1391.51
duration = 0.6
stream = ExtResource("261_bhnyb")
text = "（惨叫）啊——！"
loudness = 1.0

[sub_resource type="Resource" id="Resource_1v47s"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1394.51
duration = 1.2
stream = ExtResource("262_um5vy")
text = "（喘息）……都是你们逼的。"

[sub_resource type="Resource" id="Resource_et1ar"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1396.11
duration = 3.4
stream = ExtResource("263_l3br0")
text = "（低声）带子……还有带子……"
loudness = 0.3

[sub_resource type="Resource" id="Resource_tbuy3"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 1399.91
duration = 5.68
stream = ExtResource("264_do6j3")
text = "（惊叫）什么声音？！天台？！"

[sub_resource type="Resource" id="Resource_4dqo3"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 1405.99
duration = 1.88
stream = ExtResource("265_7tm48")
text = "那是什么声音？"

[sub_resource type="Resource" id="Resource_13jqh"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 1408.27
duration = 2.32
stream = ExtResource("266_jtnxt")
text = "好像……好像是从楼上……"

[sub_resource type="Resource" id="Resource_iqdvq"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 1410.99
duration = 5.72
stream = ExtResource("267_ng6u3")
text = "（颤抖）各位听众，我们这里好像出了点状况……请……请稍等……"

[sub_resource type="Resource" id="Resource_ywygl"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 1417.11
duration = 2.48
stream = ExtResource("268_qm57x")
text = "（大喊）周导？！周导！谁在上面！"
loudness = 0.9

[sub_resource type="Resource" id="Resource_lo0b3"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 1419.99
duration = 3.8
stream = ExtResource("269_jjcwi")
text = "栏杆……栏杆这儿……老天爷……"

[sub_resource type="Resource" id="Resource_l3kh2"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 1424.19
duration = 1.84
stream = ExtResource("270_afle4")
text = "刘师傅！怎么回事？"

[sub_resource type="Resource" id="Resource_ryind"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 1426.43
duration = 3.84
stream = ExtResource("271_xvdik")
text = "周导……周导掉下去了……就在那儿，下面……"

[sub_resource type="Resource" id="Resource_8l4h2"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 1430.67
duration = 5.6
stream = ExtResource("272_qsjr2")
text = "（尖叫）凯哥！凯哥——！"
loudness = 0.9

[sub_resource type="Resource" id="Resource_cahjo"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 1436.67
duration = 1.52
stream = ExtResource("273_temne")
text = "周凯……不……"

[sub_resource type="Resource" id="Resource_agykb"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 1438.59
duration = 2.56
stream = ExtResource("274_63of1")
text = "都别靠近栏杆！风太大了。"

[sub_resource type="Resource" id="Resource_yw53e"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 1441.55
duration = 3.6
stream = ExtResource("275_tfhms")
text = "刘师傅，你上来的时候，天台上还有别人吗？"

[sub_resource type="Resource" id="Resource_pi3b4"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 1445.55
duration = 10.32
stream = ExtResource("276_seaub")
text = "没、没看见人。我在值班室听见一声叫，就往上跑，楼梯上……楼梯上好像有人往下走，黑乎乎的，没看清。"

[sub_resource type="Resource" id="Resource_1kvyp"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 1456.27
duration = 2.08
stream = ExtResource("277_1ox0p")
text = "往下走？穿什么衣服？"

[sub_resource type="Resource" id="Resource_h8apy"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 1458.75
duration = 2.52
stream = ExtResource("278_p4kfn")
text = "西装……好像是西装。"

[sub_resource type="Resource" id="Resource_0ims6"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 1461.67
duration = 4.48
stream = ExtResource("279_riya4")
text = "栏杆这儿有拖拽的痕迹。鞋印两双，一双是皮鞋。"

[sub_resource type="Resource" id="Resource_6kf10"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 1466.55
duration = 5.68
stream = ExtResource("280_88bd3")
text = "他刚才还跟我说，要在节目里说出真相……他不会自己跳下去的。"

[sub_resource type="Resource" id="Resource_dvg62"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 1472.63
duration = 8.4
stream = ExtResource("281_nuljv")
text = "（哭）是我……是我把阿默的电话接进来的……要不是我……"

[sub_resource type="Resource" id="Resource_l2mou"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 1481.43
duration = 1.76
stream = ExtResource("282_6hxnw")
text = "唐果，你说什么？"

[sub_resource type="Resource" id="Resource_e40d6"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 1483.59
duration = 5.0
stream = ExtResource("283_oc8mo")
text = "是潘师傅……潘师傅让我接的。阿默就是潘师傅。"

[sub_resource type="Resource" id="Resource_jhjfj"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 1495.568
duration = 1.32
stream = ExtResource("284_0dc3s")
text = "是我。"

[sub_resource type="Resource" id="Resource_2lc3l"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 1497.288
duration = 0.64
stream = ExtResource("285_0pa7c")
text = "潘叔……"

[sub_resource type="Resource" id="Resource_731wx"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 1498.328
duration = 1.72
stream = ExtResource("286_76oos")
text = "林夕，周凯他……"

[sub_resource type="Resource" id="Resource_i3php"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 1500.448
duration = 1.28
stream = ExtResource("287_2k8bu")
text = "下去了。"

[sub_resource type="Resource" id="Resource_uq6dk"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 1502.128
duration = 2.6
stream = ExtResource("288_lvnbj")
text = "（长叹）我来晚了。我去唱片库取带子了。"

[sub_resource type="Resource" id="Resource_5vn71"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 1505.128
duration = 2.28
stream = ExtResource("289_o1qyj")
text = "带子在这儿。叶青的带子。"

[sub_resource type="Resource" id="Resource_e2g5f"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1514.569
duration = 3.88
stream = ExtResource("290_35tjj")
text = "怎么回事？我在办公室听见喊声……周凯呢？"

[sub_resource type="Resource" id="Resource_05dek"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 1518.849
duration = 2.32
stream = ExtResource("291_sfxrj")
text = "台长，周导他……掉下去了。"

[sub_resource type="Resource" id="Resource_6yfqe"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1521.569
duration = 5.0
stream = ExtResource("292_tk40g")
text = "（震惊）什么？！这个周凯……喝了那么多，我早说过他……"

[sub_resource type="Resource" id="Resource_qlbb2"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 1526.969
duration = 2.0
stream = ExtResource("293_3m2hp")
text = "台长，您刚才在哪？"

[sub_resource type="Resource" id="Resource_2qfan"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1529.369
duration = 3.76
stream = ExtResource("294_u2ybb")
text = "我一直在办公室，给市里打电话，报台风灾情。"

[sub_resource type="Resource" id="Resource_qx7is"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 1533.529
duration = 6.48
stream = ExtResource("295_aws4t")
text = "台长，十一点以后，台风把外线全刮断了。我守着总机，一个电话都没打出去过。"

[sub_resource type="Resource" id="Resource_uvfuf"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1540.409
duration = 3.12
stream = ExtResource("296_savf1")
text = "……我、我是说，我一直在打，打不通。"

[sub_resource type="Resource" id="Resource_kpbv4"]
script = ExtResource("10_ljbqc")
speaker = &"E"
start = 1543.929
duration = 2.52
stream = ExtResource("297_3m681")
text = "台长……你的肩膀是湿的。"

[sub_resource type="Resource" id="Resource_5cdpl"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 1546.849
duration = 2.24
stream = ExtResource("298_j4x2a")
text = "办公室里也下雨吗，台长？"

[sub_resource type="Resource" id="Resource_rkoo1"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1549.489
duration = 2.24
stream = ExtResource("299_e8ijr")
text = "我……我刚才去楼梯口看了看……"

[sub_resource type="Resource" id="Resource_4w4na"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 1552.129
duration = 4.2
stream = ExtResource("300_wryav")
text = "台长！我在楼梯上看见的，穿西装往下走的人……"

[sub_resource type="Resource" id="Resource_umckj"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1556.729
duration = 4.96
stream = ExtResource("301_vh04c")
text = "大刘！你想清楚再说话！你当年在警察面前，是怎么说的？"

[sub_resource type="Resource" id="Resource_tjn7p"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 1562.089
duration = 6.88
stream = ExtResource("302_d16qt")
text = "（发抖）当年……当年您让我说，我什么都没看见。"

[sub_resource type="Resource" id="Resource_pa44n"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 1569.369
duration = 5.8
stream = ExtResource("303_3wrww")
text = "可我看见了。我看见周导，也看见您。您那天的西装，也是湿的。"

[sub_resource type="Resource" id="Resource_shqvw"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1575.569
duration = 5.6
stream = ExtResource("304_eiaak")
text = "你们……你们一个个都疯了！一个闹鬼的节目，把你们都闹疯了！"

[sub_resource type="Resource" id="Resource_1sks0"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 1581.569
duration = 4.96
stream = ExtResource("305_gbii1")
text = "台长，带子里是您的声音。“二十万，渔村那篇稿子，压下去。”"

[sub_resource type="Resource" id="Resource_p1rqc"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1586.929
duration = 3.72
stream = ExtResource("306_rnkh0")
text = "那盘带子……那天晚上，我搜遍了她的雨衣……"

[sub_resource type="Resource" id="Resource_ylvpc"]
script = ExtResource("10_ljbqc")
speaker = &"G"
start = 1591.049
duration = 1.4
stream = ExtResource("307_y8pq6")
text = "您刚才说什么？"

[sub_resource type="Resource" id="Resource_kmhyc"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 1594.849
duration = 1.76
stream = ExtResource("308_k8kt5")
text = "潘叔，带子给我。"

[sub_resource type="Resource" id="Resource_3vyfk"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 1597.009
duration = 1.92
stream = ExtResource("309_pjfjw")
text = "你要怎么做？"

[sub_resource type="Resource" id="Resource_7l5el"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 1599.329
duration = 4.4
stream = ExtResource("310_50m5f")
text = "叶青姐教我的第一件事：话筒前面，不要撒谎。"

[sub_resource type="Resource" id="Resource_sgffb"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 1604.129
duration = 3.8
stream = ExtResource("311_wruee")
text = "我回直播间。最后一首歌，放它。"

[sub_resource type="Resource" id="Resource_dreoh"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 1608.329
duration = 2.56
stream = ExtResource("312_gxwei")
text = "我跟你下去，机房我来开。"

[sub_resource type="Resource" id="Resource_mwdm0"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 1611.289
duration = 4.4
stream = ExtResource("313_rnqat")
text = "台长，您……就在这儿，跟我一块儿等警察吧。"

[sub_resource type="Resource" id="Resource_ao1na"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1616.089
duration = 1.76
stream = ExtResource("314_wyyfp")
text = "大刘，你跟了我十二年……"

[sub_resource type="Resource" id="Resource_adm7y"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 1618.249
duration = 5.16
stream = ExtResource("315_u7vfc")
text = "十二年，我替您瞒了五年。不瞒了。"

[sub_resource type="Resource" id="Resource_vbule"]
script = ExtResource("10_ljbqc")
speaker = &"D"
start = 1623.809
duration = 3.24
stream = ExtResource("316_cec66")
text = "（低声）林夕，带子装好了，随时可以放。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_keqn2"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 1627.449
duration = 4.6
stream = ExtResource("317_1uyki")
text = "各位听众，我是林夕。对不起，刚才节目中断了。"

[sub_resource type="Resource" id="Resource_h145k"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 1632.449
duration = 8.52
stream = ExtResource("318_p7xey")
text = "今晚，我们的导播周凯，从这栋楼的天台上坠落。五年前，叶青老师也是从那里坠落的。"

[sub_resource type="Resource" id="Resource_5wj1v"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 1641.369
duration = 7.4
stream = ExtResource("319_ntv53")
text = "接下来这段录音，是叶青老师五年前录下的。她没能把它放出来。今晚，我替她放。"

[sub_resource type="Resource" id="Resource_fddsi"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 1649.169
duration = 1.44
stream = ExtResource("320_8ythp")
text = "（停顿）……潘叔，放吧。"

[sub_resource type="Resource" id="Resource_6mb1v"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1657.009
duration = 6.72
stream = ExtResource("321_038i1")
text = "（低声）我只是想拿回那盘带子……她不撒手……她就是不撒手……"
loudness = 0.3

[sub_resource type="Resource" id="Resource_6f6xf"]
script = ExtResource("10_ljbqc")
speaker = &"F"
start = 1664.129
duration = 2.56
stream = ExtResource("322_napn2")
text = "台长，下去吧。"

[sub_resource type="Resource" id="Resource_n1g7d"]
script = ExtResource("10_ljbqc")
speaker = &"A"
start = 1667.089
duration = 3.4
stream = ExtResource("323_yqjow")
text = "（喃喃）二十万……就二十万……"
loudness = 0.3

[sub_resource type="Resource" id="Resource_7w72q"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 1670.889
duration = 2.72
stream = ExtResource("324_sboak")
text = "这里是《夜半有声》，最后一期。"

[sub_resource type="Resource" id="Resource_f7d5t"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 1674.009
duration = 4.36
stream = ExtResource("325_xaqsa")
text = "谢谢叶青老师，谢谢周凯，谢谢每一个没睡的人。"

[sub_resource type="Resource" id="Resource_78shb"]
script = ExtResource("10_ljbqc")
speaker = &"B"
start = 1678.769
duration = 2.0
stream = ExtResource("326_hyj2y")
text = "台风会过去的。晚安。"

[resource]
script = ExtResource("5_ljkf5")
id = &"case9"
title = "午夜电台"
description = "1996年夏，台风“海葵”登陆海城。午夜十二点，海城人民广播电台三楼，深夜节目《夜半有声》正在直播它的最后一期。
这一个星期，每晚都有一个自称“阿默”的听众打进热线，讲一个穿红雨衣的女人站在电台天台上的故事。
五年前，同样一个台风夜，前任主持人叶青从这栋楼的天台坠下。今晚，阿默说，她要回来了。"
