label = "雷声"

[sub_resource type="Resource" id="Resource_vfv10"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 2.0
duration = 6.72
stream = ExtResource("11_bo0wp")
text = "这里是海城人民广播电台，调频九十三点六。现在是午夜十二点整。"

[sub_resource type="Resource" id="Resource_co8db"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 5.0
duration = 5.56
stream = ExtResource("12_8teb6")
text = "凯哥，你又喝了？今天是最后一期，台长说不定会过来。"

[sub_resource type="Resource" id="Resource_yr20t"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 9.12
duration = 3.12
stream = ExtResource("13_fyf3c")
text = "欢迎收听《夜半有声》。我是林夕。"

[sub_resource type="Resource" id="Resource_kvuth"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 10.0
duration = 7.16
stream = ExtResource("14_wselg")
text = "（自言自语）合并……合并了也好。旧楼一拆，干干净净。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_07nwc"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 10.96
duration = 6.04
stream = ExtResource("15_1oahm")
text = "最后一期了，还怕什么。（喝了一口）你没闻到吗，这屋子里五年都是这股味儿。"

[sub_resource type="Resource" id="Resource_g253b"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 12.64
duration = 7.72
stream = ExtResource("16_o5fvi")
text = "窗外，台风“海葵”正在登陆。如果您还没睡，请关好门窗，离窗户远一点。"

[sub_resource type="Resource" id="Resource_kpndf"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 17.4
stream = ExtResource("17_koj6o")
text = "什么味儿？"

[sub_resource type="Resource" id="Resource_p6d2h"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 18.8
duration = 3.68
stream = ExtResource("18_u8cb2")
text = "潮味儿。海边的楼，墙里头全是水。"

[sub_resource type="Resource" id="Resource_vbxia"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 20.76
duration = 6.4
stream = ExtResource("19_ouil0")
text = "今天，是《夜半有声》的最后一期。下个月起，咱们台就要和市台合并了。"

[sub_resource type="Resource" id="Resource_o2kon"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 20.898
duration = 5.6
stream = ExtResource("20_xsewq")
text = "台长，三楼的窗户我都看过了，唱片库那扇漏雨，我拿报纸塞上了。"

[sub_resource type="Resource" id="Resource_ysm6n"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 22.88
duration = 5.04
stream = ExtResource("21_v856v")
text = "凯哥，你说今晚阿默还会打来吗？他都打了六天了。"

[sub_resource type="Resource" id="Resource_55yof"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 26.898
duration = 1.84
stream = ExtResource("22_30lqh")
text = "嗯。天台的门锁了吗？"

[sub_resource type="Resource" id="Resource_fsg85"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 27.56
duration = 7.84
stream = ExtResource("23_42l62")
text = "这五年，我在这间小屋子里，听你们讲了一千多个故事。有的让人害怕，有的让人心疼。"

[sub_resource type="Resource" id="Resource_sfg06"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 28.32
duration = 2.92
stream = ExtResource("24_cgrj0")
text = "那个阿默……你从哪接进来的？"

[sub_resource type="Resource" id="Resource_harm6"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 29.138
duration = 3.8
stream = ExtResource("25_snrvx")
text = "天台……那锁上礼拜就坏了，后勤还没来换。"

[sub_resource type="Resource" id="Resource_rb4ec"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 31.64
duration = 4.08
stream = ExtResource("26_tpy4t")
text = "热线啊，总机转过来的，我就推了一下推子。"

[sub_resource type="Resource" id="Resource_sv8wj"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 33.338
duration = 4.44
stream = ExtResource("27_03xha")
text = "坏了就拿铁丝拧上。今晚谁也不许上天台。"

[sub_resource type="Resource" id="Resource_f4018"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 35.8
duration = 6.36
stream = ExtResource("28_q3t0o")
text = "今晚，我们请到了写《海城异闻录》的作家沈墨先生，他已经在楼下等着了。"

[sub_resource type="Resource" id="Resource_dku3x"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 36.12
duration = 3.4
stream = ExtResource("29_ke0fv")
text = "总机？这个点总机就老潘一个人守着。"

[sub_resource type="Resource" id="Resource_0cbil"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 38.178
duration = 4.24
stream = ExtResource("30_lhjaq")
text = "是。台长，那个……那个阿默说的事儿……"

[sub_resource type="Resource" id="Resource_1pldq"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 39.92
duration = 1.32
stream = ExtResource("31_y2u86")
text = "（笑）那你问潘师傅去呀。"

[sub_resource type="Resource" id="Resource_rupoa"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 41.64
duration = 5.4
stream = ExtResource("32_u6g30")
text = "他讲的那些……红雨衣，台风夜，天台的铁栏杆……你不觉得太细了吗？"

[sub_resource type="Resource" id="Resource_4rg3m"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 42.56
duration = 5.32
stream = ExtResource("33_afrua")
text = "还有那位，这个星期每晚都会打来电话的听众，阿默。"

[sub_resource type="Resource" id="Resource_w6r4m"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 42.818
duration = 0.8
stream = ExtResource("34_5nqto")
text = "什么事？"

[sub_resource type="Resource" id="Resource_d04fc"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 44.018
duration = 8.36
stream = ExtResource("35_bxyuq")
text = "他说，红雨衣的女人站在天台上，等一个人上去。大伙儿都说……说是五年前的叶青……"

[sub_resource type="Resource" id="Resource_gksji"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 47.44
duration = 6.36
stream = ExtResource("36_md34y")
text = "讲鬼故事嘛，越细越吓人。收听率翻了三倍，台长都乐坏了。"

[sub_resource type="Resource" id="Resource_dws3n"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 48.28
duration = 4.12
stream = ExtResource("37_uwpq0")
text = "阿默，如果你在听，今晚，我还在等你的电话。"

[sub_resource type="Resource" id="Resource_c40tk"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 52.778
duration = 2.28
stream = ExtResource("38_naiqv")
text = "大刘，你在电台干了多少年了？"

[sub_resource type="Resource" id="Resource_qrybf"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 52.8
duration = 4.4
stream = ExtResource("39_y5mht")
text = "先送给大家一首歌，邓丽君，《但愿人长久》。"

[sub_resource type="Resource" id="Resource_wt1kj"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 54.2
duration = 3.28
stream = ExtResource("40_agppb")
text = "台长乐？（冷笑）他昨天晚上一宿没睡。"

[sub_resource type="Resource" id="Resource_vkhot"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 55.458
duration = 2.36
stream = ExtResource("41_5yutj")
text = "十二年了。"

[sub_resource type="Resource" id="Resource_w65qd"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 57.88
duration = 4.24
stream = ExtResource("42_fy3hj")
text = "凯哥，那个穿红雨衣的女人……真的是叶青姐吗？"

[sub_resource type="Resource" id="Resource_1700f"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 58.218
duration = 2.32
stream = ExtResource("43_cs088")
text = "十二年，还信这个？"

[sub_resource type="Resource" id="Resource_0o320"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 60.938
duration = 3.52
stream = ExtResource("44_i3ijt")
text = "不是信……那天晚上是我值的班，我心里头……"

[sub_resource type="Resource" id="Resource_b4w7d"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 64.52
duration = 5.0
stream = ExtResource("45_tvlg0")
text = "我来台里的时候，大家都不提她。她的照片也从走廊上摘了。"

[sub_resource type="Resource" id="Resource_kkjxg"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 64.858
duration = 5.56
stream = ExtResource("46_nkqck")
text = "那天晚上的事，警察早有结论了。她为情所困，想不开。"

[sub_resource type="Resource" id="Resource_ehgqt"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 69.92
duration = 2.76
stream = ExtResource("47_yst6b")
text = "唐果，好好推你的推子，别问了。"

[sub_resource type="Resource" id="Resource_h1olu"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 70.818
duration = 1.6
stream = ExtResource("48_1fncf")
text = "是，是。"

[sub_resource type="Resource" id="Resource_onaek"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 72.818
duration = 4.24
stream = ExtResource("49_nv8lm")
text = "回值班室待着。今晚台风大，楼里出了任何事，第一个找我。"

[sub_resource type="Resource" id="Resource_mvo0t"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 77.458
duration = 1.88
stream = ExtResource("50_u3a3g")
text = "好嘞台长。"

[sub_resource type="Resource" id="Resource_jl2ic"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 80.0
duration = 4.12
stream = ExtResource("51_rf6kr")
text = "（低声）青青，再等等。今晚，就今晚。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_c2kwt"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 84.52
duration = 3.32
stream = ExtResource("52_bv3jj")
text = "变声器……电池换过了，线也接好了。"

[sub_resource type="Resource" id="Resource_ajf5a"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 88.24
duration = 6.56
stream = ExtResource("53_eg1we")
text = "唱片库下礼拜就清空了。再不放，这盘带子就跟着废纸一起进焚化炉。"

[sub_resource type="Resource" id="Resource_h6hxe"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 98.499
duration = 1.28
stream = ExtResource("54_xy0q6")
text = "潘师傅。"

[sub_resource type="Resource" id="Resource_busp3"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 100.179
duration = 2.4
stream = ExtResource("55_iv8gq")
text = "你怎么过来了？凯哥那边离得开？"

[sub_resource type="Resource" id="Resource_plj4k"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 102.979
duration = 4.28
stream = ExtResource("56_q56jp")
text = "歌还有三分钟。我就想问问，今晚……还是十二点半？"

[sub_resource type="Resource" id="Resource_70w5p"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 107.659
duration = 5.28
stream = ExtResource("57_1ugnx")
text = "十二点半。热线二号。你听到铃响，直接推上去，别让总机登记。"

[sub_resource type="Resource" id="Resource_5shiy"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 113.339
duration = 3.92
stream = ExtResource("58_r2uwg")
text = "嗯。凯哥刚才问我，阿默是从哪接进来的。"

[sub_resource type="Resource" id="Resource_begl3"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 117.659
duration = 1.6
stream = ExtResource("59_ikjpd")
text = "你怎么说？"

[sub_resource type="Resource" id="Resource_exwu3"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 119.659
duration = 3.6
stream = ExtResource("60_dkxna")
text = "我说总机转的。他说总机就你一个人。"

[sub_resource type="Resource" id="Resource_1v47s"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 120.0
duration = 4.4
stream = ExtResource("61_408ft")
text = "沈老师，请坐。耳机戴好，歌一结束就开麦。"

[sub_resource type="Resource" id="Resource_et1ar"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 123.659
duration = 1.28
stream = ExtResource("62_66vhj")
text = "（停顿）周凯起疑心了。"

[sub_resource type="Resource" id="Resource_tbuy3"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 124.8
duration = 4.48
stream = ExtResource("63_v6w7x")
text = "这屋子比我想的小。五年前，叶青也坐在这把椅子上？"

[sub_resource type="Resource" id="Resource_4dqo3"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 125.339
duration = 5.08
stream = ExtResource("64_vaopy")
text = "潘师傅，你说的那盘带子，真的是叶青姐录的吗？"

[sub_resource type="Resource" id="Resource_13jqh"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 129.68
duration = 1.2
stream = ExtResource("65_815cj")
text = "……是。"

[sub_resource type="Resource" id="Resource_iqdvq"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 130.819
duration = 9.32
stream = ExtResource("66_faw4g")
text = "是她录的。台长收了化工厂二十万，把渔村孩子得白血病的报道压了下来。她把那天的谈话，全录了。"

[sub_resource type="Resource" id="Resource_ywygl"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 131.28
duration = 2.04
stream = ExtResource("67_jvll4")
text = "这首歌，叶青也喜欢？"

[sub_resource type="Resource" id="Resource_lo0b3"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 133.72
duration = 6.16
stream = ExtResource("68_vovfv")
text = "她每期结尾都放邓丽君。她说，台风天，人心里总得有点甜的东西。"

[sub_resource type="Resource" id="Resource_l3kh2"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 140.28
duration = 1.76
stream = ExtResource("69_qcdvo")
text = "你跟她学了几年？"

[sub_resource type="Resource" id="Resource_ryind"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 140.539
duration = 1.76
stream = ExtResource("70_bilim")
text = "那带子现在在哪？"

[sub_resource type="Resource" id="Resource_8l4h2"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 142.44
duration = 5.32
stream = ExtResource("71_7qmxt")
text = "三年。我刚来的时候，连麦都不敢开，是她手把手教我的。"

[sub_resource type="Resource" id="Resource_cahjo"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 142.699
duration = 4.04
stream = ExtResource("72_3i4rg")
text = "在它该在的地方。等我取出来，最后一首歌，就放它。"

[sub_resource type="Resource" id="Resource_agykb"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 147.139
duration = 1.84
stream = ExtResource("73_g6id0")
text = "潘师傅……你不怕吗？"

[sub_resource type="Resource" id="Resource_yw53e"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 148.16
duration = 2.76
stream = ExtResource("74_iupm5")
text = "那她走的那天晚上，你在哪？"

[sub_resource type="Resource" id="Resource_pi3b4"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 149.379
duration = 2.68
stream = ExtResource("75_mo7lx")
text = "怕了五年了。人老了，怕不动了。"

[sub_resource type="Resource" id="Resource_1kvyp"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 151.32
duration = 4.64
stream = ExtResource("76_aowhj")
text = "（停顿）在楼下宿舍。我只听见风声，别的什么都没听见。"

[sub_resource type="Resource" id="Resource_h8apy"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 152.459
duration = 3.72
stream = ExtResource("77_drmrw")
text = "那我回去了。凯哥一个人，又该喝多了。"

[sub_resource type="Resource" id="Resource_0ims6"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 156.36
duration = 1.04
stream = ExtResource("78_hmaqk")
text = "风声……"

[sub_resource type="Resource" id="Resource_6kf10"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 157.8
duration = 2.24
stream = ExtResource("79_7skpa")
text = "歌快完了。沈老师，耳机。"

[sub_resource type="Resource" id="Resource_dvg62"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 160.44
duration = 6.76
stream = ExtResource("80_3wda4")
text = "好，我们回到直播间。今天的嘉宾，是作家沈墨先生。沈老师，晚上好。"

[sub_resource type="Resource" id="Resource_l2mou"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 167.6
duration = 5.2
stream = ExtResource("81_vb1l7")
text = "林夕你好，各位听众朋友，晚上好。台风夜做客《夜半有声》，再合适不过了。"

[sub_resource type="Resource" id="Resource_e40d6"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 173.2
duration = 7.16
stream = ExtResource("82_lb4do")
text = "沈老师写了很多海城的旧事。这一个星期，我们的听众阿默讲的故事，您听了吗？"

[sub_resource type="Resource" id="Resource_jhjfj"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 180.76
duration = 3.56
stream = ExtResource("83_jej0a")
text = "每一晚都听了。我得说，他讲得比我写得好。"

[sub_resource type="Resource" id="Resource_2lc3l"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 184.72
duration = 1.64
stream = ExtResource("84_6c1v8")
text = "为什么这么说？"

[sub_resource type="Resource" id="Resource_731wx"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 186.76
duration = 4.04
stream = ExtResource("85_p8646")
text = "因为他讲的不像是编的。像是亲眼看见过。"

[sub_resource type="Resource" id="Resource_i3php"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 191.2
duration = 1.36
stream = ExtResource("86_gbti1")
text = "您是说……"

[sub_resource type="Resource" id="Resource_uq6dk"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 192.96
duration = 8.24
stream = ExtResource("87_wyu0t")
text = "红雨衣，台风夜，电台天台的铁栏杆，栏杆上一道掰弯的口子。这些细节，编故事的人想不到。"

[sub_resource type="Resource" id="Resource_5vn71"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 201.6
duration = 4.28
stream = ExtResource("88_71hhp")
text = "沈老师，您在节目里这么说，会吓到听众的。"

[sub_resource type="Resource" id="Resource_e2g5f"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 206.28
duration = 2.8
stream = ExtResource("89_3nsg6")
text = "吓到才好。这个节目叫《夜半有声》嘛。"

[sub_resource type="Resource" id="Resource_05dek"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 209.48
duration = 7.84
stream = ExtResource("90_e1n5e")
text = "我查过旧报纸。五年前，一九九一年的台风夜，这个电台有一位女主持人从天台坠落。"

[sub_resource type="Resource" id="Resource_6yfqe"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 217.72
duration = 4.32
stream = ExtResource("91_vny3u")
text = "报纸上只有一小块豆腐块，说是“感情受挫，一时想不开”。"

[sub_resource type="Resource" id="Resource_qlbb2"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 222.44
duration = 3.64
stream = ExtResource("92_4q2mw")
text = "（停顿）……她叫叶青。她是我的老师。"

[sub_resource type="Resource" id="Resource_2qfan"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 226.48
duration = 1.12
stream = ExtResource("93_5n527")
text = "抱歉。"

[sub_resource type="Resource" id="Resource_qx7is"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 228.0
duration = 5.64
stream = ExtResource("94_yuusn")
text = "没关系。她教我的第一件事就是，话筒前面，不要撒谎。"

[sub_resource type="Resource" id="Resource_uvfuf"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 234.04
duration = 3.04
stream = ExtResource("95_hmd8i")
text = "那我就不撒谎了。我不信她是自杀。"

[sub_resource type="Resource" id="Resource_kpbv4"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 237.48
duration = 1.32
stream = ExtResource("96_ea1gi")
text = "为什么？"

[sub_resource type="Resource" id="Resource_5cdpl"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 239.2
duration = 4.64
stream = ExtResource("97_8hwe1")
text = "一个准备第二天播重磅新闻的人，前一天晚上不会想死。"

[sub_resource type="Resource" id="Resource_rkoo1"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 244.24
stream = ExtResource("98_h86ro")
text = "重磅新闻？"

[sub_resource type="Resource" id="Resource_4w4na"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 245.64
duration = 1.96
stream = ExtResource("99_f24ob")
text = "这个，要等阿默来说了。"

[sub_resource type="Resource" id="Resource_umckj"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 248.0
duration = 6.76
stream = ExtResource("100_i85mc")
text = "（深吸一口气）好。各位听众，阿默的电话，我们十二点半等他。先休息一下，听一首歌。"

[sub_resource type="Resource" id="Resource_tjn7p"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 252.0
duration = 2.6
stream = ExtResource("101_mq4fj")
text = "（自言自语）十二点半……他又要打来了。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_pa44n"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 255.0
duration = 3.28
stream = ExtResource("102_sx7kq")
text = "周凯？节目正在播，你跑过来干什么？"

[sub_resource type="Resource" id="Resource_shqvw"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 255.16
duration = 2.0
stream = ExtResource("103_2wtou")
text = "林夕，你的手在抖。"

[sub_resource type="Resource" id="Resource_1sks0"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 257.56
duration = 1.44
stream = ExtResource("104_t51eq")
text = "是空调太冷了。"

[sub_resource type="Resource" id="Resource_p1rqc"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 258.68
duration = 3.28
stream = ExtResource("105_20jmk")
text = "唐果看着呢。台长，我有话跟您说。"

[sub_resource type="Resource" id="Resource_ylvpc"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 262.36
duration = 0.44
stream = ExtResource("106_kht04")
text = "说。"

[sub_resource type="Resource" id="Resource_kmhyc"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 263.2
duration = 6.08
stream = ExtResource("107_wlu2n")
text = "这几天那个阿默说的，全是那天晚上的事。红雨衣……她那天就是穿的红雨衣。"

[sub_resource type="Resource" id="Resource_3vyfk"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 269.68
duration = 2.6
stream = ExtResource("108_03jeg")
text = "那又怎么样？报纸上登过。"

[sub_resource type="Resource" id="Resource_7l5el"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 272.68
duration = 6.96
stream = ExtResource("109_mdkf2")
text = "报纸上没登栏杆。栏杆上那道口子，是她的手指头掰的。这件事只有三个人知道。"

[sub_resource type="Resource" id="Resource_sgffb"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 280.04
duration = 0.84
stream = ExtResource("110_yn3kq")
text = "（停顿）你喝多了。"

[sub_resource type="Resource" id="Resource_dreoh"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 281.28
duration = 8.0
stream = ExtResource("111_20ar3")
text = "我是喝多了。我这五年，天天都喝多。一闭眼就看见她的手，抓着栏杆，一根一根地松开……"

[sub_resource type="Resource" id="Resource_mwdm0"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 289.68
duration = 1.28
stream = ExtResource("112_egs70")
text = "周凯，你看着我。"

[sub_resource type="Resource" id="Resource_ao1na"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 291.36
duration = 2.8
stream = ExtResource("113_pg7fw")
text = "台长，我不想要导播这个位子了。"

[sub_resource type="Resource" id="Resource_adm7y"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 294.56
duration = 5.88
stream = ExtResource("114_04cgo")
text = "你不想要？当年是谁跪在我这间屋里，说只要能留在台里，什么都愿意做？"

[sub_resource type="Resource" id="Resource_vbule"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 300.84
duration = 1.28
stream = ExtResource("115_tuxrp")
text = "是我。"

[sub_resource type="Resource" id="Resource_keqn2"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 302.52
duration = 2.56
stream = ExtResource("116_vm6vi")
text = "你拿了这个位子，就得睡得着觉。"

[sub_resource type="Resource" id="Resource_h145k"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 305.48
duration = 2.32
stream = ExtResource("117_u7i5u")
text = "我睡不着！我睡不着！"

[sub_resource type="Resource" id="Resource_5wj1v"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 308.2
duration = 2.16
stream = ExtResource("118_ek6fn")
text = "小点声。外面有人。"

[sub_resource type="Resource" id="Resource_fddsi"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 310.76
duration = 6.04
stream = ExtResource("119_182j1")
text = "周凯，你想清楚。那天晚上，你也在天台上。你上来的时候，她还没掉下去。"

[sub_resource type="Resource" id="Resource_6mb1v"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 317.2
duration = 5.04
stream = ExtResource("120_oa5bk")
text = "（颤抖）……我喊不出来。我就站在门口，看着。"

[sub_resource type="Resource" id="Resource_6f6xf"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 322.64
duration = 5.08
stream = ExtResource("121_x2gcd")
text = "对。你看着。你一句话都没说。这件事要是翻出来，你跑得掉吗？"

[sub_resource type="Resource" id="Resource_n1g7d"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 330.12
duration = 5.36
stream = ExtResource("122_j2c8w")
text = "回去，好好把最后一期做完。下个月合并，我推荐你去市台当主任。"

[sub_resource type="Resource" id="Resource_7w72q"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 335.88
duration = 4.08
stream = ExtResource("123_ftkav")
text = "凯哥，台长找你干嘛了？脸色这么难看。"

[sub_resource type="Resource" id="Resource_f7d5t"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 340.36
duration = 3.2
stream = ExtResource("124_p03u6")
text = "他说下个月推荐我去市台当主任。"

[sub_resource type="Resource" id="Resource_78shb"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 343.96
duration = 1.36
stream = ExtResource("125_lw28o")
text = "那是好事啊！"

[sub_resource type="Resource" id="Resource_lfuvt"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 345.72
duration = 5.8
stream = ExtResource("126_mxfsv")
text = "（笑）好事。唐果，你知道叶青走的那年，我是干什么的吗？"

[sub_resource type="Resource" id="Resource_qsgdd"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 351.92
stream = ExtResource("127_b0jpw")
text = "干什么的？"

[sub_resource type="Resource" id="Resource_kjdde"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 353.32
duration = 4.0
stream = ExtResource("128_eh8iv")
text = "一个编辑。拿死工资，写稿子，天天挨她骂。"

[sub_resource type="Resource" id="Resource_4ukh4"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 357.72
duration = 1.84
stream = ExtResource("129_fucci")
text = "叶青姐还骂人？"

[sub_resource type="Resource" id="Resource_bv3ys"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 359.96
duration = 8.24
stream = ExtResource("130_870oo")
text = "骂得可凶了。一个标点不对，稿子扔回来重写。她说，播出去的每个字，都要对得起人家的耳朵。"

[sub_resource type="Resource" id="Resource_4vc68"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 368.6
duration = 1.92
stream = ExtResource("131_imm5f")
text = "那你……喜欢她吗？"

[sub_resource type="Resource" id="Resource_ntq2u"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 370.92
duration = 3.56
stream = ExtResource("132_r5wej")
text = "（沉默）……喜欢。喜欢到不敢跟她站在一起。"

[sub_resource type="Resource" id="Resource_4pxg4"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 374.88
duration = 0.96
stream = ExtResource("133_lkq38")
text = "凯哥……"

[sub_resource type="Resource" id="Resource_j8ptq"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 376.24
duration = 2.4
stream = ExtResource("134_xxglg")
text = "推子推上去吧，歌完了。"

[sub_resource type="Resource" id="Resource_navst"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 390.0
duration = 5.92
stream = ExtResource("135_34l72")
text = "沈老师，您说叶青老师第二天要播重磅新闻，您是从哪儿知道的？"

[sub_resource type="Resource" id="Resource_k01pn"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 396.32
duration = 3.24
stream = ExtResource("136_qhamt")
text = "我写《海城异闻录》的时候，去过城东的渔村。"

[sub_resource type="Resource" id="Resource_bqdyv"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 399.96
duration = 5.84
stream = ExtResource("137_bsuf2")
text = "那几年，村里十几个孩子得了白血病。村口就是化工厂的排污口。"

[sub_resource type="Resource" id="Resource_nghif"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 406.2
duration = 3.72
stream = ExtResource("138_nxwiv")
text = "这件事我听说过……可是后来再没人报道。"

[sub_resource type="Resource" id="Resource_u0q3w"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 410.32
duration = 7.28
stream = ExtResource("139_kalv5")
text = "有人要报道。村里的老人说，出事前一个礼拜，有个电台的女记者，穿红雨衣，天天往村里跑。"

[sub_resource type="Resource" id="Resource_usi1q"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 418.0
duration = 1.56
stream = ExtResource("140_2ikg2")
text = "叶青老师……"

[sub_resource type="Resource" id="Resource_1atbn"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 419.96
duration = 6.0
stream = ExtResource("141_tcshg")
text = "她录了好几盘采访带。可节目一直没播出来。后来村里人听说，稿子让台里压了。"

[sub_resource type="Resource" id="Resource_0hdut"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 426.36
duration = 2.72
stream = ExtResource("142_pxn7l")
text = "压稿子，要台长签字。"

[sub_resource type="Resource" id="Resource_xfu56"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 429.48
duration = 5.28
stream = ExtResource("143_xa317")
text = "（点头）所以我说，一个准备第二天播重磅新闻的人，不会想死。"

[sub_resource type="Resource" id="Resource_5b0bu"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 435.16
duration = 4.96
stream = ExtResource("144_vuxaa")
text = "（低声）沈老师，这些话，您刚才怎么不在节目里说？"
loudness = 0.3

[sub_resource type="Resource" id="Resource_mnt2g"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 440.52
duration = 3.72
stream = ExtResource("145_ikig2")
text = "证据不够。说出来，就成了编故事的。我等阿默。"

[sub_resource type="Resource" id="Resource_4nrfb"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 442.533
duration = 4.28
stream = ExtResource("146_c2sd0")
text = "潘师傅，借个手电，值班室那个灯泡又烧了。"

[sub_resource type="Resource" id="Resource_offe5"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 444.64
duration = 1.24
stream = ExtResource("147_jhjrg")
text = "……歌要完了。"

[sub_resource type="Resource" id="Resource_ewuq6"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 447.213
duration = 1.48
stream = ExtResource("148_h1kqq")
text = "抽屉里，自己拿。"

[sub_resource type="Resource" id="Resource_pwpkm"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 449.093
duration = 4.6
stream = ExtResource("149_6l8ap")
text = "潘师傅，这个阿默……你守着总机，没听出是谁？"

[sub_resource type="Resource" id="Resource_j4j60"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 454.093
duration = 3.32
stream = ExtResource("150_0mnv5")
text = "电话那头的声音都是变过的，谁听得出来。"

[sub_resource type="Resource" id="Resource_baync"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 457.813
duration = 7.76
stream = ExtResource("151_omied")
text = "我听着瘆得慌。他说红雨衣的女人在天台上等人……五年前那天也是我值的班……"

[sub_resource type="Resource" id="Resource_f1jlk"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 465.973
duration = 2.88
stream = ExtResource("152_mtsq3")
text = "大刘，那天晚上你看见什么了？"

[sub_resource type="Resource" id="Resource_afwro"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 469.253
duration = 1.8
stream = ExtResource("153_6fwh5")
text = "（支吾）没、没看见什么……"

[sub_resource type="Resource" id="Resource_whrgt"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 471.453
duration = 2.8
stream = ExtResource("154_0anfs")
text = "没看见就好。没看见的人，睡得着。"

[sub_resource type="Resource" id="Resource_y3mud"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 474.653
duration = 2.48
stream = ExtResource("155_w3t5k")
text = "潘师傅，你这话……"

[sub_resource type="Resource" id="Resource_c6uwx"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 477.533
duration = 2.16
stream = ExtResource("156_gb5jj")
text = "天台那把锁，修好了吗？"

[sub_resource type="Resource" id="Resource_mfwb0"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 480.093
duration = 3.44
stream = ExtResource("157_g2d80")
text = "没呢，台长让拿铁丝拧上，我还没去。"

[sub_resource type="Resource" id="Resource_1cqc1"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 483.933
duration = 3.44
stream = ExtResource("158_5j7th")
text = "不用拧了。今晚风大，铁丝也拧不住。"

[sub_resource type="Resource" id="Resource_6ne7o"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 487.773
duration = 2.52
stream = ExtResource("159_hxkfm")
text = "也是……那我回去了。"

[sub_resource type="Resource" id="Resource_fan61"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 501.783
duration = 4.64
stream = ExtResource("160_u5txl")
text = "周凯，歌还有四分钟，我进来拿一下听众来信。"

[sub_resource type="Resource" id="Resource_ykn1k"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 506.823
duration = 1.16
stream = ExtResource("161_06id6")
text = "夕夕。"

[sub_resource type="Resource" id="Resource_gvyhg"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 508.383
duration = 2.64
stream = ExtResource("162_6ob6r")
text = "别这么叫我。我们分开两年了。"

[sub_resource type="Resource" id="Resource_82f7j"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 511.423
duration = 3.08
stream = ExtResource("163_h0wgl")
text = "那个……我去休息室倒杯热水。"

[sub_resource type="Resource" id="Resource_envqj"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 514.903
duration = 3.24
stream = ExtResource("164_8ocw6")
text = "林夕，今晚节目结束之前，给我五分钟。"

[sub_resource type="Resource" id="Resource_vw0q8"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 518.543
duration = 1.76
stream = ExtResource("165_v5bde")
text = "五分钟干什么？"

[sub_resource type="Resource" id="Resource_dsi33"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 520.703
duration = 1.88
stream = ExtResource("166_0qtkc")
text = "我有话要在节目里说。"

[sub_resource type="Resource" id="Resource_0vcor"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 522.983
duration = 2.88
stream = ExtResource("167_8yxhv")
text = "在节目里？你知道这是直播。"

[sub_resource type="Resource" id="Resource_spy8c"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 526.263
duration = 4.88
stream = ExtResource("168_bb48f")
text = "就因为是直播。有些话，私下说没人信，说完就被按下去了。"

[sub_resource type="Resource" id="Resource_a0ont"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 531.543
duration = 2.44
stream = ExtResource("169_3gq2i")
text = "周凯，你到底要说什么？"

[sub_resource type="Resource" id="Resource_luejg"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 534.383
duration = 2.4
stream = ExtResource("170_hpf2q")
text = "关于叶青。关于那天晚上。"

[sub_resource type="Resource" id="Resource_465oh"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 537.183
duration = 0.8
stream = ExtResource("171_rlofr")
text = "（愣住）……你知道什么？"

[sub_resource type="Resource" id="Resource_cktqy"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 538.383
duration = 6.68
stream = ExtResource("172_bhnyb")
text = "我知道得比谁都多。我是个混蛋，林夕。这五年，我天天都在等一个人来揭穿我。"

[sub_resource type="Resource" id="Resource_e65ya"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 543.147
duration = 3.8
stream = ExtResource("173_um5vy")
text = "哎哎哎，沈作家！你去哪？天台不能上！"

[sub_resource type="Resource" id="Resource_6glwq"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 545.463
duration = 1.36
stream = ExtResource("174_l3br0")
text = "那个阿默……"

[sub_resource type="Resource" id="Resource_1y4vj"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 547.223
duration = 3.8
stream = ExtResource("175_do6j3")
text = "我不知道他是谁。可他知道。他什么都知道。"

[sub_resource type="Resource" id="Resource_sm0d8"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 547.347
duration = 4.48
stream = ExtResource("176_7tm48")
text = "刘师傅，我就上去看一眼。写东西，总得看看现场。"

[sub_resource type="Resource" id="Resource_aqbuq"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 551.423
duration = 3.88
stream = ExtResource("177_jtnxt")
text = "好。最后一首歌之前，我给你五分钟。"

[sub_resource type="Resource" id="Resource_sulbl"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 552.227
duration = 3.36
stream = ExtResource("178_ng6u3")
text = "台长说了，今晚谁也不许上天台。"

[sub_resource type="Resource" id="Resource_mguer"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 555.703
duration = 1.76
stream = ExtResource("179_qm57x")
text = "谢谢。"

[sub_resource type="Resource" id="Resource_7wvtp"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 555.987
duration = 2.96
stream = ExtResource("180_jjcwi")
text = "（递烟）刘师傅，抽根烟。红塔山。"

[sub_resource type="Resource" id="Resource_8snhk"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 557.863
duration = 1.6
stream = ExtResource("181_afle4")
text = "你别再喝了。"

[sub_resource type="Resource" id="Resource_jykb4"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 559.347
duration = 1.68
stream = ExtResource("182_xvdik")
text = "这……那就一根。"

[sub_resource type="Resource" id="Resource_2geg1"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 561.427
duration = 2.92
stream = ExtResource("183_qsjr2")
text = "刘师傅在台里干了很多年了吧？"

[sub_resource type="Resource" id="Resource_rjago"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 564.747
duration = 2.36
stream = ExtResource("41_5yutj")
text = "十二年了。"

[sub_resource type="Resource" id="Resource_bhre5"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 567.507
duration = 2.08
stream = ExtResource("184_temne")
text = "那五年前那天晚上……"

[sub_resource type="Resource" id="Resource_umrnk"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 569.987
duration = 2.68
stream = ExtResource("185_63of1")
text = "（叹气）那天晚上，是我值的班。"

[sub_resource type="Resource" id="Resource_o3wl6"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 573.067
duration = 1.64
stream = ExtResource("186_tfhms")
text = "你上天台了吗？"

[sub_resource type="Resource" id="Resource_h6sio"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 575.107
duration = 4.8
stream = ExtResource("187_seaub")
text = "我听见一声叫，就往上跑。我跑到天台上，人已经在下面了。"

[sub_resource type="Resource" id="Resource_kl3a7"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 580.307
duration = 4.48
stream = ExtResource("188_1ox0p")
text = "天台上就剩一件红雨衣，挂在栏杆上，哗啦哗啦地响。"

[sub_resource type="Resource" id="Resource_vqi23"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 585.187
duration = 1.76
stream = ExtResource("189_p4kfn")
text = "只有一件雨衣？"

[sub_resource type="Resource" id="Resource_8gq4c"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 587.347
duration = 5.44
stream = ExtResource("190_riya4")
text = "还有……我在楼梯上碰见了周导。他从上面下来，脸白得跟纸一样。"

[sub_resource type="Resource" id="Resource_4wa6a"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 593.187
duration = 1.96
stream = ExtResource("191_88bd3")
text = "周凯？他跟你说什么了？"

[sub_resource type="Resource" id="Resource_lpmxi"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 595.547
duration = 3.6
stream = ExtResource("192_nuljv")
text = "他什么都没说。他就那么看着我，一直发抖。"

[sub_resource type="Resource" id="Resource_6ypp2"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 599.547
duration = 3.92
stream = ExtResource("193_6hxnw")
text = "后来警察来，问我看见谁了，台长让我……"

[sub_resource type="Resource" id="Resource_1suhq"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 603.867
duration = 1.4
stream = ExtResource("194_oc8mo")
text = "让你什么？"

[sub_resource type="Resource" id="Resource_bq5a2"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 605.667
duration = 6.0
stream = ExtResource("195_0dc3s")
text = "（摆手）没什么，没什么。我什么都没说。烟抽完了，你快下来啊。"

[sub_resource type="Resource" id="Resource_tgrd4"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 612.067
duration = 1.2
stream = ExtResource("196_0pa7c")
text = "就十分钟。"

[sub_resource type="Resource" id="Resource_s220h"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 615.0
duration = 5.4
stream = ExtResource("197_76oos")
text = "我们继续。这里有一封听众来信，写信的是一位渔村的母亲。"

[sub_resource type="Resource" id="Resource_j2ufo"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 620.8
duration = 6.36
stream = ExtResource("198_2k8bu")
text = "她说：林夕，我女儿走了五年了。她走之前，最喜欢听叶青姐姐的节目。"

[sub_resource type="Resource" id="Resource_wwap4"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 627.56
duration = 6.68
stream = ExtResource("199_lvnbj")
text = "叶青姐姐说过，要替我们村的孩子讨个说法。后来，叶青姐姐也不在了。"

[sub_resource type="Resource" id="Resource_fvvfx"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 634.64
duration = 2.8
stream = ExtResource("200_o1qyj")
text = "（停顿）……对不起，我念不下去了。"

[sub_resource type="Resource" id="Resource_qscet"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 637.84
duration = 4.48
stream = ExtResource("201_35tjj")
text = "这位妈妈，如果您在听……我会把这封信，一直留着。"

[sub_resource type="Resource" id="Resource_sss63"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 644.0
duration = 2.6
stream = ExtResource("202_sfxrj")
text = "凯哥……林夕姐哭了。"

[sub_resource type="Resource" id="Resource_cmq2f"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 647.0
duration = 0.48
stream = ExtResource("203_tk40g")
text = "（沉默）……渔村。"

[sub_resource type="Resource" id="Resource_6q8nl"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 647.88
duration = 2.56
stream = ExtResource("204_3m2hp")
text = "凯哥，你知道那篇报道？"

[sub_resource type="Resource" id="Resource_jmiaf"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 650.84
duration = 7.52
stream = ExtResource("205_u2ybb")
text = "那年的稿子，是叶青写的，我誊的。誊好了交到台长办公室，第二天退回来，上面就四个字。"

[sub_resource type="Resource" id="Resource_smuew"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 658.76
duration = 1.64
stream = ExtResource("206_aws4t")
text = "哪四个字？"

[sub_resource type="Resource" id="Resource_celgt"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 660.8
duration = 2.76
stream = ExtResource("207_savf1")
text = "“不予播出”。台长亲笔签的。"

[sub_resource type="Resource" id="Resource_6aeqv"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 663.96
duration = 2.4
stream = ExtResource("208_3m681")
text = "那……那叶青姐后来……"

[sub_resource type="Resource" id="Resource_fl1xi"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 666.76
duration = 9.16
stream = ExtResource("209_j4x2a")
text = "后来她说，不让播，她就自己想办法播。（灌了一口酒）然后就是那个台风夜。"

[sub_resource type="Resource" id="Resource_hsnh8"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 680.0
duration = 7.16
stream = ExtResource("210_e8ijr")
text = "（自言自语）好大的风。栏杆……这一截是新换的，焊口还是亮的。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_22vgn"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 691.178
duration = 2.68
stream = ExtResource("211_wryav")
text = "水箱间里……怎么会有一部电话？"

[sub_resource type="Resource" id="Resource_ks5jv"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 694.258
duration = 5.44
stream = ExtResource("212_vh04c")
text = "线是新拉的，顺着水管下去。（拿起听筒）……有声音，是内线。"

[sub_resource type="Resource" id="Resource_mjcvo"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 700.098
duration = 3.32
stream = ExtResource("213_d16qt")
text = "还有个本子……“十二点半，热线二号”。"

[sub_resource type="Resource" id="Resource_vcadv"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 703.818
duration = 2.28
stream = ExtResource("214_3wrww")
text = "（低声）阿默，原来你就在这栋楼里。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_1hvuc"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 706.0
duration = 3.68
stream = ExtResource("215_eiaak")
text = "（拿起内线）喂，值班室？大刘，天台的门拧上了没有？"

[sub_resource type="Resource" id="Resource_oc0o7"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 710.08
duration = 3.0
stream = ExtResource("216_gbii1")
text = "（接电话）拧、拧上了，台长。"

[sub_resource type="Resource" id="Resource_qgyf1"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 713.48
duration = 3.68
stream = ExtResource("217_rnkh0")
text = "拧上就好。刚才沈作家是不是往楼上去了？"

[sub_resource type="Resource" id="Resource_qi4ds"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 717.56
duration = 3.36
stream = ExtResource("218_y8pq6")
text = "没、没有吧，我没看见……"

[sub_resource type="Resource" id="Resource_64ong"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 721.32
duration = 3.28
stream = ExtResource("219_k8kt5")
text = "看好楼梯口。谁上去，马上告诉我。"

[sub_resource type="Resource" id="Resource_vmf8s"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 725.0
duration = 2.68
stream = ExtResource("220_pjfjw")
text = "是，是。（挂电话，自言自语）铁丝还在我兜里呢……"
loudness = 0.3

[sub_resource type="Resource" id="Resource_015eh"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 733.646
duration = 6.92
stream = ExtResource("221_50m5f")
text = "（低声）《淡淡幽情》……还在。青青，你最喜欢的这张。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_wnpq7"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 745.0
duration = 2.64
stream = ExtResource("222_wruee")
text = "林夕，我有件事要告诉你。"

[sub_resource type="Resource" id="Resource_upm4p"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 745.296
duration = 3.88
stream = ExtResource("223_gxwei")
text = "（自言自语）谁动过本子？……风吹的吧。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_8dbuf"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 748.04
duration = 1.96
stream = ExtResource("224_rnqat")
text = "小声点，麦没关严。"

[sub_resource type="Resource" id="Resource_a2j1v"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 750.4
duration = 4.28
stream = ExtResource("225_wyyfp")
text = "天台水箱间里，有一部电话，线是新接的，是内线。"

[sub_resource type="Resource" id="Resource_2m0tr"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 755.08
duration = 1.28
stream = ExtResource("226_u7vfc")
text = "内线？"

[sub_resource type="Resource" id="Resource_wp2ud"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 756.76
duration = 4.08
stream = ExtResource("227_cec66")
text = "那个阿默，不是从外面打进来的。他就在这栋楼里。"

[sub_resource type="Resource" id="Resource_1ncbq"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 761.24
duration = 1.88
stream = ExtResource("228_1uyki")
text = "（停顿）……你确定？"

[sub_resource type="Resource" id="Resource_rkib2"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 763.52
duration = 3.64
stream = ExtResource("229_p7xey")
text = "本子上写着，十二点半，热线二号。"

[sub_resource type="Resource" id="Resource_pvo3x"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 767.56
duration = 3.72
stream = ExtResource("230_ntv53")
text = "那就让他打。我想听他把话说完。"

[sub_resource type="Resource" id="Resource_gbnm7"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 780.0
duration = 4.32
stream = ExtResource("231_8ythp")
text = "（对着变声器）喂……喂……林夕，我是阿默。"

[sub_resource type="Resource" id="Resource_pfdp7"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 784.72
duration = 4.24
stream = ExtResource("232_038i1")
text = "（自言自语）声音还行。青青，你听听，像不像个鬼。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_wjxja"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 789.36
duration = 2.04
stream = ExtResource("233_napn2")
text = "十二点半……还有几分钟。"

[sub_resource type="Resource" id="Resource_hdfaf"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 791.8
duration = 5.16
stream = ExtResource("234_yqjow")
text = "（翻本子）先讲带子，再讲门口那个人……最后，告诉他们几点。"

[sub_resource type="Resource" id="Resource_jhlsp"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 810.0
duration = 2.6
stream = ExtResource("235_sboak")
text = "唐果，你手心怎么全是汗？"

[sub_resource type="Resource" id="Resource_vdvs1"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 813.0
duration = 2.6
stream = ExtResource("236_xaqsa")
text = "有、有吗？屋里闷。"

[sub_resource type="Resource" id="Resource_a6qy6"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 816.0
duration = 2.76
stream = ExtResource("237_hyj2y")
text = "十二点半快到了。你在等阿默。"

[sub_resource type="Resource" id="Resource_ah8a4"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 819.16
duration = 2.36
stream = ExtResource("238_y8t3y")
text = "大家都在等阿默啊。"

[sub_resource type="Resource" id="Resource_psy84"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 821.92
duration = 2.8
stream = ExtResource("239_3c8sk")
text = "今晚他要是打来，你别推上去。"

[sub_resource type="Resource" id="Resource_7ffpg"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 825.12
duration = 2.4
stream = ExtResource("240_ujbmt")
text = "为什么？收听率……"

[sub_resource type="Resource" id="Resource_6itf5"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 827.92
duration = 11.36
stream = ExtResource("241_ouklv")
text = "收听率。（苦笑）唐果，有些故事讲完了，是要死人的。"

[sub_resource type="Resource" id="Resource_wj02w"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 839.68
duration = 2.32
stream = ExtResource("242_jxjkq")
text = "凯哥，你别吓我。"

[sub_resource type="Resource" id="Resource_axp1f"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 842.4
duration = 2.68
stream = ExtResource("243_kd4s0")
text = "我没吓你。推不推，你自己定。"

[sub_resource type="Resource" id="Resource_rqfkp"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 855.0
duration = 7.16
stream = ExtResource("244_kjmkw")
text = "各位听众，现在是凌晨十二点二十八分。台风“海葵”的中心，正在经过海城。"

[sub_resource type="Resource" id="Resource_x5myc"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 862.56
duration = 8.24
stream = ExtResource("245_c2qr1")
text = "刚才有不少朋友打电话到总机，说家里停电了，是用半导体在听我们的节目。谢谢你们。"

[sub_resource type="Resource" id="Resource_cu68u"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 871.2
duration = 4.88
stream = ExtResource("246_vxcf8")
text = "再过两分钟，就是十二点半。阿默，我们在等你。"

[sub_resource type="Resource" id="Resource_bhh0s"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 876.48
duration = 0.92
stream = ExtResource("247_8yup8")
text = "（低声）他会打来的。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_ady6n"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 885.0
duration = 3.36
stream = ExtResource("248_0aocb")
text = "热线二号！凯哥，是二号！"

[sub_resource type="Resource" id="Resource_66876"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 888.76
duration = 2.56
stream = ExtResource("249_8kqnc")
text = "二号？这条线不是早就停了吗？"

[sub_resource type="Resource" id="Resource_p7qi4"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 891.72
duration = 2.16
stream = ExtResource("250_75som")
text = "我、我推上去了！"

[sub_resource type="Resource" id="Resource_2lk02"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 894.28
duration = 6.24
stream = ExtResource("251_jmct6")
text = "各位听众，我们的热线电话响了。喂，您好，这里是《夜半有声》。"

[sub_resource type="Resource" id="Resource_46wf4"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 900.92
duration = 1.92
stream = ExtResource("252_l5ls1")
text = "你好，林夕。我是阿默。"

[sub_resource type="Resource" id="Resource_cgwcm"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 903.24
duration = 3.96
stream = ExtResource("253_we7oa")
text = "阿默，晚上好。今天是最后一期。"

[sub_resource type="Resource" id="Resource_6qahk"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 907.6
duration = 2.84
stream = ExtResource("254_5tr6t")
text = "我知道。所以我来讲这个故事的结尾。"

[sub_resource type="Resource" id="Resource_5f4l3"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 910.84
duration = 1.08
stream = ExtResource("255_cgaj3")
text = "我们都在听。"

[sub_resource type="Resource" id="Resource_oj71b"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 912.32
duration = 6.6
stream = ExtResource("256_hq6ql")
text = "五年前，台风夜。穿红雨衣的女人上了天台。她手里拿着一样东西，一盘录音带。"

[sub_resource type="Resource" id="Resource_0k64h"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 919.32
duration = 3.04
stream = ExtResource("257_4vgoj")
text = "她要把这盘带子，放给全城的人听。"

[sub_resource type="Resource" id="Resource_5ur8j"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 922.76
duration = 1.64
stream = ExtResource("258_g3cur")
text = "带子里是什么？"

[sub_resource type="Resource" id="Resource_qgefy"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 924.8
duration = 4.24
stream = ExtResource("259_bpusk")
text = "是一个人，收了二十万，把一群孩子的命压了下去。"

[sub_resource type="Resource" id="Resource_wo8lq"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 929.44
duration = 0.92
stream = ExtResource("260_d1fp3")
text = "（低声）二十万……"
loudness = 0.3

[sub_resource type="Resource" id="Resource_gktia"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 930.76
duration = 7.16
stream = ExtResource("261_qruxf")
text = "那天晚上，天台上不只她一个人。有一个人伸手抢她的东西，另一个人，站在门口看着。"

[sub_resource type="Resource" id="Resource_feuwe"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 938.32
duration = 3.08
stream = ExtResource("262_3k28j")
text = "（声音发紧）站在门口的人……为什么不救她？"

[sub_resource type="Resource" id="Resource_n3t6k"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 941.8
duration = 3.88
stream = ExtResource("263_wh55p")
text = "因为他怕。后来，他用这份怕，换了一个好位子。"

[sub_resource type="Resource" id="Resource_13krw"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 946.08
duration = 3.2
stream = ExtResource("264_6pv3k")
text = "阿默，你说的这些……有证据吗？"

[sub_resource type="Resource" id="Resource_dlk6o"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 949.68
duration = 5.32
stream = ExtResource("265_nsc6h")
text = "她的带子，没有被抢走。它在一个很安全的地方，躺了五年。"

[sub_resource type="Resource" id="Resource_xqlav"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 955.4
duration = 5.36
stream = ExtResource("266_3twhi")
text = "今晚，十二点三刻，她的声音会回到这个频率上。请所有人，听好。"

[sub_resource type="Resource" id="Resource_mnxkq"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 961.16
duration = 1.16
stream = ExtResource("267_g3cta")
text = "阿默——"

[sub_resource type="Resource" id="Resource_m3was"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 962.72
duration = 3.76
stream = ExtResource("268_bwd60")
text = "林夕，你是她最好的学生。替她把话说完。"

[sub_resource type="Resource" id="Resource_v18yr"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 966.88
duration = 0.48
stream = ExtResource("269_mq1t6")
text = "（低声）再见。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_3qvsg"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 967.76
duration = 2.08
stream = ExtResource("270_asybc")
text = "喂？阿默？……他挂了。"

[sub_resource type="Resource" id="Resource_xixv2"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 970.24
duration = 3.88
stream = ExtResource("271_mg6tp")
text = "各位听众……我们……我们先听一首歌。"

[sub_resource type="Resource" id="Resource_a37fb"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 982.0
duration = 3.12
stream = ExtResource("272_u8xr0")
text = "（颤抖）站在门口的人……他说的是我。"

[sub_resource type="Resource" id="Resource_3njag"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 985.52
duration = 2.12
stream = ExtResource("273_v8ggp")
text = "凯哥？你说什么？"

[sub_resource type="Resource" id="Resource_hhryl"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 988.04
duration = 4.2
stream = ExtResource("274_68ig5")
text = "唐果，你老实告诉我，这个电话，是不是你接进来的？"

[sub_resource type="Resource" id="Resource_m33ik"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 992.64
duration = 2.24
stream = ExtResource("275_l2fn2")
text = "我、我只是推了推子……"

[sub_resource type="Resource" id="Resource_q5nmc"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 995.28
duration = 1.36
stream = ExtResource("276_6a4ga")
text = "他是谁？"

[sub_resource type="Resource" id="Resource_0ut5n"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 997.04
duration = 2.16
stream = ExtResource("277_bb7hu")
text = "凯哥，我不能说。"

[sub_resource type="Resource" id="Resource_wb2xx"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 999.6
duration = 4.56
stream = ExtResource("278_wihyy")
text = "（苦笑）不说也好。今晚，就让我自己说。"

[sub_resource type="Resource" id="Resource_wlsvd"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1000.0
duration = 6.48
stream = ExtResource("279_ab8n1")
text = "（自言自语）二十万……带子……带子没丢？"
loudness = 0.3

[sub_resource type="Resource" id="Resource_dtm8t"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1006.88
duration = 3.84
stream = ExtResource("280_41314")
text = "不可能……那天晚上我明明搜过她的雨衣……"

[sub_resource type="Resource" id="Resource_qevcf"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1013.442
duration = 2.68
stream = ExtResource("281_t42uj")
text = "刚才那个电话，从哪打进来的！"

[sub_resource type="Resource" id="Resource_oybmu"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 1016.522
duration = 2.6
stream = ExtResource("282_qmwfq")
text = "总、总机转的……"

[sub_resource type="Resource" id="Resource_spx06"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1019.522
duration = 1.84
stream = ExtResource("283_1dmvi")
text = "总机？总机的老潘人呢？"

[sub_resource type="Resource" id="Resource_eglw8"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 1021.762
duration = 3.84
stream = ExtResource("284_sfnqt")
text = "不、不知道，潘师傅可能去厕所了……"

[sub_resource type="Resource" id="Resource_day5q"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1026.002
duration = 2.2
stream = ExtResource("285_ksaqq")
text = "周凯，你是导播，你也不知道？"

[sub_resource type="Resource" id="Resource_gmfmm"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 1028.602
duration = 1.52
stream = ExtResource("286_cmy7k")
text = "我不知道，台长。"

[sub_resource type="Resource" id="Resource_osg3l"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1030.522
duration = 1.2
stream = ExtResource("287_l66c2")
text = "（盯着他）你最好不知道。"

[sub_resource type="Resource" id="Resource_g72fv"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1035.314
duration = 6.96
stream = ExtResource("288_qf1yh")
text = "（自言自语）人不在……这是什么？变声器……"
loudness = 0.3

[sub_resource type="Resource" id="Resource_1pv1b"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1042.674
duration = 3.8
stream = ExtResource("289_agv1f")
text = "线头还是热的。老潘……原来是你。"

[sub_resource type="Resource" id="Resource_d3sfr"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1050.066
duration = 1.36
stream = ExtResource("290_obrfk")
text = "周凯，你出来一下。"

[sub_resource type="Resource" id="Resource_wrg5o"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1053.096
duration = 2.2
stream = ExtResource("291_r1yxy")
text = "（低声）天台。五分钟以后。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_xd6ny"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 1055.696
duration = 1.32
stream = ExtResource("292_vtpdt")
text = "天台？"

[sub_resource type="Resource" id="Resource_ydgmf"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1057.416
duration = 5.08
stream = ExtResource("293_0qmwy")
text = "你想在节目里说的话，先上去跟我说。说完了，你想怎么样，我都不拦你。"

[sub_resource type="Resource" id="Resource_fgcks"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 1059.33
duration = 2.12
stream = ExtResource("294_4t5cn")
text = "（自言自语）青青，到时候了。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_6g2v1"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 1061.85
duration = 5.48
stream = ExtResource("295_v8dpm")
text = "《淡淡幽情》……封套里……在这儿。五年了，一点没受潮。"

[sub_resource type="Resource" id="Resource_qo5q2"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 1062.896
duration = 1.12
stream = ExtResource("296_3v1vp")
text = "……好。"

[sub_resource type="Resource" id="Resource_rxote"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 1067.73
duration = 5.28
stream = ExtResource("297_sjd1a")
text = "你放在我手里的那天说，潘叔，替我收好，万一我出事……"

[sub_resource type="Resource" id="Resource_rwkgs"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 1069.376
duration = 3.36
stream = ExtResource("298_s4wds")
text = "（自言自语）五分钟……再抽一根烟。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_tko36"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 1073.41
duration = 4.32
stream = ExtResource("299_8f2y5")
text = "（哽咽）我收好了。收了五年。"

[sub_resource type="Resource" id="Resource_moi8w"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 1081.813
duration = 2.56
stream = ExtResource("300_u4kc7")
text = "有人动过……变声器被挪了。"

[sub_resource type="Resource" id="Resource_ovukj"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 1084.773
duration = 0.68
stream = ExtResource("301_uypu5")
text = "（低声）台长来过。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_v5qrh"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 1085.853
duration = 3.0
stream = ExtResource("302_8m42p")
text = "来就来吧。带子在我手里，谁也拿不走了。"

[sub_resource type="Resource" id="Resource_jvxck"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 1095.267
duration = 2.52
stream = ExtResource("303_iuefu")
text = "周导，又在这儿抽烟呢？"

[sub_resource type="Resource" id="Resource_w8wj8"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 1098.187
duration = 1.36
stream = ExtResource("304_w6v8i")
text = "老刘。来一根？"

[sub_resource type="Resource" id="Resource_rj5fi"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 1099.947
duration = 3.32
stream = ExtResource("305_ik3cn")
text = "不了，刚抽过。周导，你脸色不对啊。"

[sub_resource type="Resource" id="Resource_s3soo"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 1103.667
duration = 4.16
stream = ExtResource("306_tewkx")
text = "老刘，五年前那天晚上，你在楼梯上碰见我了吧。"

[sub_resource type="Resource" id="Resource_18ts6"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 1108.227
duration = 0.64
stream = ExtResource("307_f0apw")
text = "（停顿）……碰见了。"

[sub_resource type="Resource" id="Resource_rbuaa"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 1109.267
duration = 4.48
stream = ExtResource("308_1qfw8")
text = "谢谢你没说出去。也对不起你，替我背了五年。"

[sub_resource type="Resource" id="Resource_3go5u"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 1110.0
duration = 1.52
stream = ExtResource("309_2firu")
text = "林夕，你还好吗？"

[sub_resource type="Resource" id="Resource_63qoq"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 1111.92
duration = 2.68
stream = ExtResource("310_c1d50")
text = "沈老师，“站在门口的人”……"

[sub_resource type="Resource" id="Resource_37c4l"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 1114.147
duration = 2.8
stream = ExtResource("311_wuyqv")
text = "周导，你今晚这是怎么了？"

[sub_resource type="Resource" id="Resource_lskdq"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 1115.0
duration = 1.48
stream = ExtResource("312_dnaju")
text = "你想到谁了？"

[sub_resource type="Resource" id="Resource_067m0"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 1116.88
duration = 6.84
stream = ExtResource("313_hekw5")
text = "周凯。我们在一起的时候，他每次喝醉，都会做同一个噩梦，喊“别松手”。"

[sub_resource type="Resource" id="Resource_y4omn"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 1117.347
duration = 6.0
stream = ExtResource("314_wvduk")
text = "没怎么。老刘，你记住一句话。我要是一会儿出了什么事——是台长叫我上的天台。"

[sub_resource type="Resource" id="Resource_8171k"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 1123.747
duration = 3.68
stream = ExtResource("315_vktm5")
text = "上天台？台长自己说的，今晚谁也不许上去。"

[sub_resource type="Resource" id="Resource_i10h7"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 1124.12
duration = 2.48
stream = ExtResource("316_10bhp")
text = "那他今晚要你给他五分钟……"

[sub_resource type="Resource" id="Resource_yevi8"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 1127.0
duration = 1.08
stream = ExtResource("317_e0g1a")
text = "他要坦白。"

[sub_resource type="Resource" id="Resource_tduvx"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 1127.827
duration = 2.04
stream = ExtResource("318_bhtpc")
text = "对，他自己说的。"

[sub_resource type="Resource" id="Resource_2qatg"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 1128.48
duration = 3.24
stream = ExtResource("319_ul44p")
text = "那个收了二十万的人，不会让他坦白的。"

[sub_resource type="Resource" id="Resource_8efbo"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 1130.267
duration = 2.48
stream = ExtResource("320_ciyib")
text = "周导，你可别犯傻……"

[sub_resource type="Resource" id="Resource_r1eqt"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 1132.12
duration = 0.6
stream = ExtResource("321_qfl14")
text = "（站起来）我去找他。"

[sub_resource type="Resource" id="Resource_ia78w"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 1133.12
duration = 3.16
stream = ExtResource("322_rugq7")
text = "歌还没完。你是主持人，你不能离开直播间。"

[sub_resource type="Resource" id="Resource_mlt57"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 1133.147
duration = 2.32
stream = ExtResource("323_m7x7w")
text = "回去吧，老刘。外头风大。"

[sub_resource type="Resource" id="Resource_seaky"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 1136.68
duration = 5.52
stream = ExtResource("324_jghsl")
text = "……对。我不能离开。沈老师，你去导播间看看他。"

[sub_resource type="Resource" id="Resource_nl4u0"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 1142.6
duration = 0.88
stream = ExtResource("325_wewkx")
text = "好。"

[sub_resource type="Resource" id="Resource_marrt"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 1145.468
duration = 1.76
stream = ExtResource("326_wnxai")
text = "唐果，周凯呢？"

[sub_resource type="Resource" id="Resource_qmtb7"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 1147.628
duration = 4.68
stream = ExtResource("327_12vf4")
text = "凯哥……凯哥刚才被台长叫出去了。他说去去就回。"

[sub_resource type="Resource" id="Resource_xgsfr"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 1152.708
duration = 1.2
stream = ExtResource("328_du0g2")
text = "去哪了？"

[sub_resource type="Resource" id="Resource_bdhn6"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 1154.308
duration = 1.08
stream = ExtResource("329_7w2w7")
text = "我不知道……"

[sub_resource type="Resource" id="Resource_xqsn4"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1155.0
duration = 5.04
stream = ExtResource("330_scfio")
text = "（自言自语）这么大的风……五年前，也是这么大的风。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_uqms6"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 1155.788
duration = 1.44
stream = ExtResource("331_0fshw")
text = "那我在这儿等他。"

[sub_resource type="Resource" id="Resource_djb3u"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1160.44
duration = 2.28
stream = ExtResource("332_j4n64")
text = "来了？过来点说，风太大。"

[sub_resource type="Resource" id="Resource_g4vei"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 1163.95
duration = 5.2
stream = ExtResource("333_vnwqr")
text = "台长，我想好了。最后一首歌之前，我把那天晚上的事，全说出来。"

[sub_resource type="Resource" id="Resource_wtc7k"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1169.55
duration = 2.8
stream = ExtResource("334_yxwiu")
text = "全说出来？说什么？"

[sub_resource type="Resource" id="Resource_hae63"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 1172.75
duration = 5.84
stream = ExtResource("335_ac8j2")
text = "说你抢她的带子。说她抓着栏杆，你一根一根地，把她的手指头掰开。"

[sub_resource type="Resource" id="Resource_sffl7"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1178.99
duration = 2.8
stream = ExtResource("336_bk58e")
text = "（平静）是她自己没站稳。"

[sub_resource type="Resource" id="Resource_08ctu"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 1182.19
duration = 2.64
stream = ExtResource("337_f8kiy")
text = "你把她的手掰开的！我看见了！"

[sub_resource type="Resource" id="Resource_ycyw1"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1185.23
duration = 2.72
stream = ExtResource("338_6kx8r")
text = "你看见了，五年里一个字都没说。"

[sub_resource type="Resource" id="Resource_b2hp7"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 1188.35
duration = 4.16
stream = ExtResource("339_gi1bm")
text = "所以我今天要说。我说了，我也去坐牢。我认了。"

[sub_resource type="Resource" id="Resource_w2tuj"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1192.91
duration = 8.28
stream = ExtResource("340_hm1ur")
text = "周凯，你以为你说了，有人信？一个酒鬼，一个前男友。“为情所困”，这四个字，警察记得清清楚楚。"

[sub_resource type="Resource" id="Resource_cfdeb"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 1201.59
duration = 2.64
stream = ExtResource("341_u3php")
text = "带子还在。阿默说了，带子还在。"

[sub_resource type="Resource" id="Resource_syldj"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1204.63
duration = 4.16
stream = ExtResource("342_8rroi")
text = "带子……带子在老潘手里，对吧？变声器我看见了。"

[sub_resource type="Resource" id="Resource_twgjy"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 1209.19
duration = 0.52
stream = ExtResource("343_br37q")
text = "（愣住）老潘？"

[sub_resource type="Resource" id="Resource_g8374"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1210.11
duration = 3.88
stream = ExtResource("344_7bafm")
text = "原来你也不知道。你们一个个的，都瞒着我。"

[sub_resource type="Resource" id="Resource_a8lwu"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1214.39
duration = 4.36
stream = ExtResource("345_2nb5e")
text = "周凯，你看下面。五年前，她就落在那块水泥地上。"

[sub_resource type="Resource" id="Resource_p1lye"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 1219.15
duration = 1.44
stream = ExtResource("346_tqk1g")
text = "你要干什么？"

[sub_resource type="Resource" id="Resource_r7xaq"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1220.99
duration = 5.72
stream = ExtResource("347_acteo")
text = "风真大啊。这么大的风，一个喝醉的人，站不稳，也是常事。"

[sub_resource type="Resource" id="Resource_8g01c"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 1227.11
duration = 1.16
stream = ExtResource("348_55tjj")
text = "你别过来——"

[sub_resource type="Resource" id="Resource_yhu68"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1228.67
duration = 2.88
stream = ExtResource("349_nuhnh")
text = "“为情所困”。跟她一样。"

[sub_resource type="Resource" id="Resource_hr860"]
script = ExtResource("10_mhhyx")
speaker = &"C"
start = 1231.95
duration = 0.6
stream = ExtResource("350_yc8sl")
text = "（惨叫）啊——！"
loudness = 1.0

[sub_resource type="Resource" id="Resource_2jvhf"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1234.95
duration = 1.2
stream = ExtResource("351_2827l")
text = "（喘息）……都是你们逼的。"

[sub_resource type="Resource" id="Resource_ppf0v"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1236.55
duration = 3.4
stream = ExtResource("352_n5c7y")
text = "（低声）带子……还有带子……"
loudness = 0.3

[sub_resource type="Resource" id="Resource_ndne0"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 1240.35
duration = 5.68
stream = ExtResource("353_5kdny")
text = "（惊叫）什么声音？！天台？！"

[sub_resource type="Resource" id="Resource_4b0ox"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 1246.43
duration = 1.88
stream = ExtResource("354_pvyu1")
text = "那是什么声音？"

[sub_resource type="Resource" id="Resource_53b8i"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 1248.71
duration = 2.32
stream = ExtResource("355_2dexn")
text = "好像……好像是从楼上……"

[sub_resource type="Resource" id="Resource_2ywib"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 1251.43
duration = 5.72
stream = ExtResource("356_cxtkk")
text = "（颤抖）各位听众，我们这里好像出了点状况……请……请稍等……"

[sub_resource type="Resource" id="Resource_xqgi8"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 1257.55
duration = 2.48
stream = ExtResource("357_lkft7")
text = "（大喊）周导？！周导！谁在上面！"
loudness = 0.9

[sub_resource type="Resource" id="Resource_3vclg"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 1260.43
duration = 3.8
stream = ExtResource("358_irfjk")
text = "栏杆……栏杆这儿……老天爷……"

[sub_resource type="Resource" id="Resource_banku"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 1264.63
duration = 1.84
stream = ExtResource("359_wftq4")
text = "刘师傅！怎么回事？"

[sub_resource type="Resource" id="Resource_m1urr"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 1266.87
duration = 3.84
stream = ExtResource("360_1vd6f")
text = "周导……周导掉下去了……就在那儿，下面……"

[sub_resource type="Resource" id="Resource_qt3db"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 1271.11
duration = 5.6
stream = ExtResource("361_rq4n6")
text = "（尖叫）凯哥！凯哥——！"
loudness = 0.9

[sub_resource type="Resource" id="Resource_b2lly"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 1277.11
duration = 1.52
stream = ExtResource("362_wh6fm")
text = "周凯……不……"

[sub_resource type="Resource" id="Resource_wxfit"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 1279.03
duration = 2.56
stream = ExtResource("363_1msso")
text = "都别靠近栏杆！风太大了。"

[sub_resource type="Resource" id="Resource_rybkn"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 1281.99
duration = 3.6
stream = ExtResource("364_5nvt5")
text = "刘师傅，你上来的时候，天台上还有别人吗？"

[sub_resource type="Resource" id="Resource_5lcnj"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 1285.99
duration = 10.32
stream = ExtResource("365_5xgms")
text = "没、没看见人。我在值班室听见一声叫，就往上跑，楼梯上……楼梯上好像有人往下走，黑乎乎的，没看清。"

[sub_resource type="Resource" id="Resource_uvboh"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 1296.71
duration = 2.08
stream = ExtResource("366_biftf")
text = "往下走？穿什么衣服？"

[sub_resource type="Resource" id="Resource_ytlyw"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 1299.19
duration = 2.52
stream = ExtResource("367_g4i7b")
text = "西装……好像是西装。"

[sub_resource type="Resource" id="Resource_0dnox"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 1302.11
duration = 4.48
stream = ExtResource("368_vyde5")
text = "栏杆这儿有拖拽的痕迹。鞋印两双，一双是皮鞋。"

[sub_resource type="Resource" id="Resource_euaf1"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 1306.99
duration = 5.68
stream = ExtResource("369_mdnup")
text = "他刚才还跟我说，要在节目里说出真相……他不会自己跳下去的。"

[sub_resource type="Resource" id="Resource_x1os5"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 1313.07
duration = 8.4
stream = ExtResource("370_1ddmw")
text = "（哭）是我……是我把阿默的电话接进来的……要不是我……"

[sub_resource type="Resource" id="Resource_5fr54"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 1321.87
duration = 1.76
stream = ExtResource("371_alb02")
text = "唐果，你说什么？"

[sub_resource type="Resource" id="Resource_rv6dd"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 1324.03
duration = 5.0
stream = ExtResource("372_cq8in")
text = "是潘师傅……潘师傅让我接的。阿默就是潘师傅。"

[sub_resource type="Resource" id="Resource_tghv5"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 1336.008
duration = 1.32
stream = ExtResource("373_3ackb")
text = "是我。"

[sub_resource type="Resource" id="Resource_yaqv1"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 1337.728
duration = 0.64
stream = ExtResource("374_3nd40")
text = "潘叔……"

[sub_resource type="Resource" id="Resource_qbvq2"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 1338.768
duration = 1.72
stream = ExtResource("375_dlswo")
text = "林夕，周凯他……"

[sub_resource type="Resource" id="Resource_pgq22"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 1340.888
duration = 1.28
stream = ExtResource("376_saibq")
text = "下去了。"

[sub_resource type="Resource" id="Resource_go265"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 1342.568
duration = 2.6
stream = ExtResource("377_k1fu7")
text = "（长叹）我来晚了。我去唱片库取带子了。"

[sub_resource type="Resource" id="Resource_s6254"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 1345.568
duration = 2.28
stream = ExtResource("378_mn11w")
text = "带子在这儿。叶青的带子。"

[sub_resource type="Resource" id="Resource_mh28l"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1355.009
duration = 3.88
stream = ExtResource("379_r8e0p")
text = "怎么回事？我在办公室听见喊声……周凯呢？"

[sub_resource type="Resource" id="Resource_t0efv"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 1359.289
duration = 2.32
stream = ExtResource("380_aa7du")
text = "台长，周导他……掉下去了。"

[sub_resource type="Resource" id="Resource_na3hj"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1362.009
duration = 5.0
stream = ExtResource("381_72lm6")
text = "（震惊）什么？！这个周凯……喝了那么多，我早说过他……"

[sub_resource type="Resource" id="Resource_ckg5d"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 1367.409
duration = 2.0
stream = ExtResource("382_i38ud")
text = "台长，您刚才在哪？"

[sub_resource type="Resource" id="Resource_l20nr"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1369.809
duration = 3.76
stream = ExtResource("383_4atfi")
text = "我一直在办公室，给市里打电话，报台风灾情。"

[sub_resource type="Resource" id="Resource_1vd55"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 1373.969
duration = 6.48
stream = ExtResource("384_56fw6")
text = "台长，十一点以后，台风把外线全刮断了。我守着总机，一个电话都没打出去过。"

[sub_resource type="Resource" id="Resource_kq3hr"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1380.849
duration = 3.12
stream = ExtResource("385_cvlbd")
text = "……我、我是说，我一直在打，打不通。"

[sub_resource type="Resource" id="Resource_0ubdc"]
script = ExtResource("10_mhhyx")
speaker = &"E"
start = 1384.369
duration = 2.52
stream = ExtResource("386_rphf3")
text = "台长……你的肩膀是湿的。"

[sub_resource type="Resource" id="Resource_rj18p"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 1387.289
duration = 2.24
stream = ExtResource("387_jo5uh")
text = "办公室里也下雨吗，台长？"

[sub_resource type="Resource" id="Resource_onqbd"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1389.929
duration = 2.24
stream = ExtResource("388_3ysw4")
text = "我……我刚才去楼梯口看了看……"

[sub_resource type="Resource" id="Resource_crgrq"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 1392.569
duration = 4.2
stream = ExtResource("389_687wy")
text = "台长！我在楼梯上看见的，穿西装往下走的人……"

[sub_resource type="Resource" id="Resource_prud8"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1397.169
duration = 4.96
stream = ExtResource("390_ppjsk")
text = "大刘！你想清楚再说话！你当年在警察面前，是怎么说的？"

[sub_resource type="Resource" id="Resource_ht3ym"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 1402.529
duration = 6.88
stream = ExtResource("391_b1wiu")
text = "（发抖）当年……当年您让我说，我什么都没看见。"

[sub_resource type="Resource" id="Resource_jo55m"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 1409.809
duration = 5.8
stream = ExtResource("392_o7vmw")
text = "可我看见了。我看见周导，也看见您。您那天的西装，也是湿的。"

[sub_resource type="Resource" id="Resource_qkwbl"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1416.009
duration = 5.6
stream = ExtResource("393_dfiv5")
text = "你们……你们一个个都疯了！一个闹鬼的节目，把你们都闹疯了！"

[sub_resource type="Resource" id="Resource_jyec0"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 1422.009
duration = 4.96
stream = ExtResource("394_1gtia")
text = "台长，带子里是您的声音。“二十万，渔村那篇稿子，压下去。”"

[sub_resource type="Resource" id="Resource_d8kic"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1427.369
duration = 3.72
stream = ExtResource("395_uk1n3")
text = "那盘带子……那天晚上，我搜遍了她的雨衣……"

[sub_resource type="Resource" id="Resource_rxydr"]
script = ExtResource("10_mhhyx")
speaker = &"G"
start = 1431.489
duration = 1.4
stream = ExtResource("396_703uy")
text = "您刚才说什么？"

[sub_resource type="Resource" id="Resource_had34"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 1435.289
duration = 1.76
stream = ExtResource("397_wcwmq")
text = "潘叔，带子给我。"

[sub_resource type="Resource" id="Resource_hpnf1"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 1437.449
duration = 1.92
stream = ExtResource("398_vlsbl")
text = "你要怎么做？"

[sub_resource type="Resource" id="Resource_ex687"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 1439.769
duration = 4.4
stream = ExtResource("399_trhgm")
text = "叶青姐教我的第一件事：话筒前面，不要撒谎。"

[sub_resource type="Resource" id="Resource_8u8qq"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 1444.569
duration = 3.8
stream = ExtResource("400_qovju")
text = "我回直播间。最后一首歌，放它。"

[sub_resource type="Resource" id="Resource_283wp"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 1448.769
duration = 2.56
stream = ExtResource("401_8dfdx")
text = "我跟你下去，机房我来开。"

[sub_resource type="Resource" id="Resource_4j1q1"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 1451.729
duration = 4.4
stream = ExtResource("402_4istx")
text = "台长，您……就在这儿，跟我一块儿等警察吧。"

[sub_resource type="Resource" id="Resource_01emv"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1456.529
duration = 1.76
stream = ExtResource("403_3o0ho")
text = "大刘，你跟了我十二年……"

[sub_resource type="Resource" id="Resource_h2lei"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 1458.689
duration = 5.16
stream = ExtResource("404_5kffy")
text = "十二年，我替您瞒了五年。不瞒了。"

[sub_resource type="Resource" id="Resource_21tu6"]
script = ExtResource("10_mhhyx")
speaker = &"D"
start = 1464.249
duration = 3.24
stream = ExtResource("405_s5gcy")
text = "（低声）林夕，带子装好了，随时可以放。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_wnm7g"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 1467.889
duration = 4.6
stream = ExtResource("406_df2e1")
text = "各位听众，我是林夕。对不起，刚才节目中断了。"

[sub_resource type="Resource" id="Resource_tkj8b"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 1472.889
duration = 8.52
stream = ExtResource("407_c5x5t")
text = "今晚，我们的导播周凯，从这栋楼的天台上坠落。五年前，叶青老师也是从那里坠落的。"

[sub_resource type="Resource" id="Resource_xeacy"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 1481.809
duration = 7.4
stream = ExtResource("408_pxwol")
text = "接下来这段录音，是叶青老师五年前录下的。她没能把它放出来。今晚，我替她放。"

[sub_resource type="Resource" id="Resource_8eosv"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 1489.609
duration = 1.44
stream = ExtResource("409_wpouu")
text = "（停顿）……潘叔，放吧。"

[sub_resource type="Resource" id="Resource_vo17r"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1497.449
duration = 6.72
stream = ExtResource("410_j4tpo")
text = "（低声）我只是想拿回那盘带子……她不撒手……她就是不撒手……"
loudness = 0.3

[sub_resource type="Resource" id="Resource_pwj5e"]
script = ExtResource("10_mhhyx")
speaker = &"F"
start = 1504.569
duration = 2.56
stream = ExtResource("411_3682g")
text = "台长，下去吧。"

[sub_resource type="Resource" id="Resource_vtm7m"]
script = ExtResource("10_mhhyx")
speaker = &"A"
start = 1507.529
duration = 3.4
stream = ExtResource("412_3nnop")
text = "（喃喃）二十万……就二十万……"
loudness = 0.3

[sub_resource type="Resource" id="Resource_5m4qt"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 1511.329
duration = 2.72
stream = ExtResource("413_q6n18")
text = "这里是《夜半有声》，最后一期。"

[sub_resource type="Resource" id="Resource_gpvhj"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 1514.449
duration = 4.36
stream = ExtResource("414_poor2")
text = "谢谢叶青老师，谢谢周凯，谢谢每一个没睡的人。"

[sub_resource type="Resource" id="Resource_lyb7l"]
script = ExtResource("10_mhhyx")
speaker = &"B"
start = 1519.209
duration = 2.0
stream = ExtResource("415_e4t2a")
text = "台风会过去的。晚安。"

