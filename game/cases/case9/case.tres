[sub_resource type="Resource" id="Resource_x36hx"]
script = ExtResource("4_umuph")
id = &"q1"
kind = 1
prompt = "每晚打进热线的“阿默”是谁？"
options = PackedStringArray()
answer = "老潘"

[sub_resource type="Resource" id="Resource_ku3uc"]
script = ExtResource("4_umuph")
id = &"q2"
kind = 1
prompt = "是谁把阿默的电话转进直播的？"
options = PackedStringArray()
answer = "唐果"

[sub_resource type="Resource" id="Resource_xlxb5"]
script = ExtResource("4_umuph")
id = &"q3"
prompt = "叶青留下的录音带藏在哪里？"
options = PackedStringArray("唱片库的唱片封套里", "机房的设备柜", "天台水箱间", "台长办公室的保险柜")
answer = "唱片库的唱片封套里"

[sub_resource type="Resource" id="Resource_isdm1"]
script = ExtResource("4_umuph")
id = &"q4"
prompt = "周凯今晚原本打算做什么？"
options = PackedStringArray("在直播里说出真相", "辞职离开电台", "向台长勒索", "和林夕复合")
answer = "在直播里说出真相"

[sub_resource type="Resource" id="Resource_wu4i8"]
script = ExtResource("4_umuph")
id = &"q5"
prompt = "邵台长的不在场证明为什么站不住？"
options = PackedStringArray("台风刮断了全部外线", "有人在天台上看见了他", "办公室的门一直锁着", "他的手表停了")
answer = "台风刮断了全部外线"

[sub_resource type="Resource" id="Resource_7rdxq"]
script = ExtResource("4_umuph")
id = &"q6"
kind = 1
prompt = "杀害周凯的凶手是谁？"
options = PackedStringArray()
answer = "邵台长"

