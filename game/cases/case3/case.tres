[sub_resource type="Resource" id="Resource_a1kch"]
script = ExtResource("1_iv26r")
id = &"G"
display_name = "吴嫂"
label = "7"
color = Color(0.47058824, 0.25882354, 0.07058824, 1)
track = Array[ExtResource("2_n1itt")]([SubResource("Resource_dqhp6"), SubResource("Resource_rbt4j"), SubResource("Resource_m1tah"), SubResource("Resource_ehxke"), SubResource("Resource_7otgt"), SubResource("Resource_tg221"), SubResource("Resource_v8on2"), SubResource("Resource_x3mw4"), SubResource("Resource_t4qgr"), SubResource("Resource_ws4sw"), SubResource("Resource_00ewh"), SubResource("Resource_0unno"), SubResource("Resource_0wimt"), SubResource("Resource_o0ee5"), SubResource("Resource_yndk5"), SubResource("Resource_d81yt"), SubResource("Resource_lekli"), SubResource("Resource_5fbj6"), SubResource("Resource_ngaor"), SubResource("Resource_0r2lr"), SubResource("Resource_o44r4"), SubResource("Resource_lqwen"), SubResource("Resource_k5idx"), SubResource("Resource_vic6i"), SubResource("Resource_572jo"), SubResource("Resource_q4bpd"), SubResource("Resource_1a2sn"), SubResource("Resource_4iv1k"), SubResource("Resource_uvcof"), SubResource("Resource_qmlrf"), SubResource("Resource_3rt0u"), SubResource("Resource_3nv3f"), SubResource("Resource_bpjid"), SubResource("Resource_ux8w7"), SubResource("Resource_p76ug"), SubResource("Resource_km60g"), SubResource("Resource_e0f6s"), SubResource("Resource_ikp1i"), SubResource("Resource_oavb8"), SubResource("Resource_qa8nr"), SubResource("Resource_b1gcy")])

[sub_resource type="Resource" id="Resource_takop"]
script = ExtResource("4_v8apa")
id = &"q1"
kind = 1
prompt = "谁把《呐喊》的真迹换走了？"
options = PackedStringArray("齐晓舟", "裴岚", "韩松", "周宁", "马卫东", "梁叔平", "吴嫂")
answer = "齐晓舟"

[sub_resource type="Resource" id="Resource_ydnjl"]
script = ExtResource("4_v8apa")
id = &"q2"
prompt = "调包发生在什么时候？"
options = PackedStringArray("三天前闭馆之后", "今晚打翻展柜的时候", "上个月外借期间", "今天上午开馆前")
answer = "三天前闭馆之后"

[sub_resource type="Resource" id="Resource_2j8y5"]
script = ExtResource("4_v8apa")
id = &"q3"
prompt = "真迹现在在哪里？"
options = PackedStringArray("仓库里标着外借归还的木箱", "修复画室的抽屉", "馆长办公室的保险柜", "已经运出美术馆")
answer = "仓库里标着外借归还的木箱"

[sub_resource type="Resource" id="Resource_80kvc"]
script = ExtResource("4_v8apa")
id = &"q4"
kind = 1
prompt = "谁把马卫东从值班室支走了？"
options = PackedStringArray("裴岚", "吴嫂", "周宁", "韩松")
answer = "裴岚"

[sub_resource type="Resource" id="Resource_qvdvd"]
script = ExtResource("4_v8apa")
id = &"q5"
kind = 1
prompt = "留在墙上的那幅是谁画的？"
options = PackedStringArray("韩松", "齐晓舟", "梁叔平", "周宁")
answer = "韩松"

[sub_resource type="Resource" id="Resource_ky6ax"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 5.0
duration = 5.08
stream = ExtResource("8_ao2ce")
text = "周宁最后看一眼。《呐喊》还在展厅正中，闭馆灯按老时间关。"

[sub_resource type="Resource" id="Resource_rb5ic"]
script = ExtResource("7_vkywf")
speaker = &"G"
start = 10.48
duration = 5.2
stream = ExtResource("9_dgwap")
text = "吴嫂把地拖完了。梁叔平要是还在馆长办公室，我去还钥匙。"

[sub_resource type="Resource" id="Resource_3pnf8"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 16.08
duration = 4.72
stream = ExtResource("10_esnuv")
text = "马卫东在值班室。监视器四路都亮，展厅这一路最清楚。"

[sub_resource type="Resource" id="Resource_ovgal"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 21.2
duration = 4.76
stream = ExtResource("11_58vxn")
text = "钥匙先放门厅那个盘。馆长办公室今晚不再收人。"

[sub_resource type="Resource" id="Resource_kuokq"]
script = ExtResource("7_vkywf")
speaker = &"G"
start = 31.376
duration = 6.56
stream = ExtResource("12_i2ap7")
text = "梁叔平，门厅的地拖好了。星期二夜里我还看见修复画室亮着灯。"

[sub_resource type="Resource" id="Resource_fjep3"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 38.336
duration = 4.44
stream = ExtResource("13_eifki")
text = "星期二是齐晓舟加班。吴嫂你看见他动《呐喊》了吗？"

[sub_resource type="Resource" id="Resource_alg42"]
script = ExtResource("7_vkywf")
speaker = &"G"
start = 43.176
duration = 4.92
stream = ExtResource("14_n4w35")
text = "看见了。画不在墙上，靠在修复画室的桌边，他正在量框。"

[sub_resource type="Resource" id="Resource_y508y"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 48.496
duration = 5.84
stream = ExtResource("15_rrgar")
text = "量框可以。摘下来不行。出库单没有我的签字，画不能过夜。"

[sub_resource type="Resource" id="Resource_lluyq"]
script = ExtResource("7_vkywf")
speaker = &"G"
start = 54.736
duration = 5.72
stream = ExtResource("16_xoe2m")
text = "吴嫂不懂单。我只记得那晚展厅空了一块，第二天又挂上了。"

[sub_resource type="Resource" id="Resource_16xvb"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 60.856
duration = 7.24
stream = ExtResource("17_0xtkr")
text = "韩松，习作按印刷品临就行。左下角你平时怎么收笔，还怎么收。"

[sub_resource type="Resource" id="Resource_2yd34"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 68.496
duration = 5.84
stream = ExtResource("18_x2rrw")
text = "齐晓舟，这是画册配图，不是让我伪造《呐喊》。韩松不干那个。"

[sub_resource type="Resource" id="Resource_5fer6"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 74.736
duration = 5.12
stream = ExtResource("19_ob2xy")
text = "谁说伪造。尺寸一样，印刷品看不清笔触，你补上就好。"

[sub_resource type="Resource" id="Resource_abwxr"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 80.256
duration = 5.68
stream = ExtResource("20_sb8b6")
text = "补可以。但韩松的收笔会在左下角多顿一下，行家一看就知道。"

[sub_resource type="Resource" id="Resource_pljjg"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 86.336
duration = 5.84
stream = ExtResource("21_eym5o")
text = "行家今晚不来。你画完把布留在修复画室，钱裴岚另算。"

[sub_resource type="Resource" id="Resource_gdjba"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 92.576
duration = 4.44
stream = ExtResource("22_hq7vv")
text = "裴岚？收藏家为什么要一张习作？韩松要当面问她。"

[sub_resource type="Resource" id="Resource_suess"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 97.416
duration = 6.0
stream = ExtResource("23_he4ty")
text = "特展厅的柜子别靠太近。裴岚只是来看装框，不碰《呐喊》。"

[sub_resource type="Resource" id="Resource_fuicp"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 108.784
duration = 4.92
stream = ExtResource("24_576au")
text = "裴岚，展厅那幅今晚不外借。周宁的清单上没有出库。"

[sub_resource type="Resource" id="Resource_vt7cw"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 114.104
duration = 5.48
stream = ExtResource("25_tk6c2")
text = "不出库最好。我出的价，梁叔平如果点头，画可以以后再谈。"

[sub_resource type="Resource" id="Resource_m35dt"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 119.984
duration = 4.8
stream = ExtResource("26_2p1k8")
text = "他不会点头。《呐喊》是馆里的镇馆，不是裴岚的私人藏。"

[sub_resource type="Resource" id="Resource_i80mp"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 128.463
duration = 5.12
stream = ExtResource("27_q74j0")
text = "周宁，灯可以关了。我在展厅闻到一股松节油，新得很。"

[sub_resource type="Resource" id="Resource_ywr1f"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 133.983
duration = 6.04
stream = ExtResource("28_x27en")
text = "松节油不该在展厅。真迹的罩光是旧的，梁叔平你上次说过。"

[sub_resource type="Resource" id="Resource_s3g18"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 140.423
duration = 5.44
stream = ExtResource("29_t8c0p")
text = "说过。这股味道像三天之内补过。齐晓舟，你上来解释。"

[sub_resource type="Resource" id="Resource_dptpx"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 151.487
duration = 5.76
stream = ExtResource("30_cvam3")
text = "局部回软，我在修复画室处理过边角。画没有离开过展厅过夜。"

[sub_resource type="Resource" id="Resource_t8uwa"]
script = ExtResource("7_vkywf")
speaker = &"G"
start = 157.647
duration = 6.36
stream = ExtResource("31_0i87a")
text = "吴嫂听见了。星期二夜里画就靠在桌边，不算没有离开墙。"

[sub_resource type="Resource" id="Resource_qew5a"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 164.407
duration = 4.48
stream = ExtResource("32_pwfda")
text = "靠一下是为了看框。齐晓舟第二天一早就挂回去了。"

[sub_resource type="Resource" id="Resource_27wxe"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 169.287
duration = 5.6
stream = ExtResource("33_nhc6t")
text = "挂回去的如果是我那张习作，左下角会有我的顿笔。韩松要看。"

[sub_resource type="Resource" id="Resource_l3fe6"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 181.367
duration = 5.76
stream = ExtResource("34_1gg2r")
text = "这儿。收笔多顿了一下。墙上这幅是韩松三个月前交的习作。"

[sub_resource type="Resource" id="Resource_73jy1"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 187.527
duration = 5.92
stream = ExtResource("35_r4hqc")
text = "周宁的清册写的是原作。习作从来没有出库单，也没有上墙记录。"

[sub_resource type="Resource" id="Resource_fttv8"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 193.847
duration = 5.24
stream = ExtResource("36_w0yj0")
text = "清册可以错。眼睛也会看错一笔。齐晓舟不承认换过。"

[sub_resource type="Resource" id="Resource_6xrwe"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 199.487
duration = 6.28
stream = ExtResource("37_754sp")
text = "裴岚劝你们别在闭馆后吵架。保险单按原作估价，换了谁也赔不起。"

[sub_resource type="Resource" id="Resource_hyfpi"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 206.167
duration = 5.72
stream = ExtResource("38_kenbe")
text = "保险的事归我。梁叔平没有签过任何一张《呐喊》的出库单。"

[sub_resource type="Resource" id="Resource_khfkg"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 212.287
duration = 4.96
stream = ExtResource("39_dmxjd")
text = "马卫东插一句。三天前夜里，展厅那路监视器黑了四十分钟。"

[sub_resource type="Resource" id="Resource_22ya2"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 217.647
duration = 5.12
stream = ExtResource("40_bk8tt")
text = "记录上写的是设备维护。值班室没有人来跟我确认过这四个字。"

[sub_resource type="Resource" id="Resource_2qafc"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 223.167
duration = 5.96
stream = ExtResource("41_rv4os")
text = "周宁去档案室对。维护单和出库单如果是同一支笔，就有问题。"

[sub_resource type="Resource" id="Resource_lfwnh"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 229.527
duration = 5.04
stream = ExtResource("42_epvxo")
text = "马卫东看着屏幕。周宁上楼梯这几秒，展厅没有人靠近画。"

[sub_resource type="Resource" id="Resource_jodo0"]
script = ExtResource("7_vkywf")
speaker = &"G"
start = 234.967
duration = 4.16
stream = ExtResource("43_kwois")
text = "吴嫂在门厅。楼梯响一下，我就在本子上记一笔。"

[sub_resource type="Resource" id="Resource_fitw4"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 239.527
duration = 4.32
stream = ExtResource("44_f8xda")
text = "韩松还在展厅。顿笔不会自己消失，我守到你们下来。"

[sub_resource type="Resource" id="Resource_3e8n2"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 244.247
duration = 6.0
stream = ExtResource("45_0ut6f")
text = "二层走廊的灯还亮着。档案室我先进，梁叔平你把钥匙给我。"

[sub_resource type="Resource" id="Resource_7e0ch"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 250.647
duration = 4.32
stream = ExtResource("46_0sb5r")
text = "钥匙在馆长办公室抽屉。周宁你等我，别自己撬。"

[sub_resource type="Resource" id="Resource_fqd23"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 260.672
duration = 5.68
stream = ExtResource("47_ljlfe")
text = "（低声）布还卷在修复画室的柜里。等裴岚把保安支走，再送进仓库。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_tw060"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 266.752
duration = 4.08
stream = ExtResource("48_2iogw")
text = "韩松听见了。什么布？我的习作不是已经在墙上了吗？"

[sub_resource type="Resource" id="Resource_1ul4i"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 271.232
duration = 5.44
stream = ExtResource("49_bb460")
text = "墙上是你的。柜子里是另一卷。韩松你今晚就当没听见。"

[sub_resource type="Resource" id="Resource_osb7b"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 277.072
duration = 4.92
stream = ExtResource("50_xhmih")
text = "另一卷要是真迹，齐晓舟你是在让我的名字挂在赃物旁边。"

[sub_resource type="Resource" id="Resource_t66v6"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 288.412
duration = 5.88
stream = ExtResource("51_i7pi7")
text = "梁叔平不在。裴岚把话说在这儿：钱已经给了齐晓舟一半。"

[sub_resource type="Resource" id="Resource_d3sxx"]
script = ExtResource("7_vkywf")
speaker = &"G"
start = 294.692
duration = 5.64
stream = ExtResource("52_6dx8r")
text = "吴嫂在拖地，不是在作证。可这句话我听见了，裴岚。"

[sub_resource type="Resource" id="Resource_mvjsl"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 300.732
duration = 5.32
stream = ExtResource("53_4u6gk")
text = "听见也别传。另一半等画离墙。今晚的事你当噪音。"

[sub_resource type="Resource" id="Resource_fev30"]
script = ExtResource("7_vkywf")
speaker = &"G"
start = 306.452
duration = 5.88
stream = ExtResource("54_i1blk")
text = "吴嫂当不了噪音。星期二的灯，加上这句话，我都要告诉周宁。"

[sub_resource type="Resource" id="Resource_f7c4v"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 312.732
duration = 4.72
stream = ExtResource("55_g7m7v")
text = "值班室的屏幕跳了一下。特展厅有人靠近柜子，马卫东盯着。"

[sub_resource type="Resource" id="Resource_rdchx"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 325.156
duration = 4.84
stream = ExtResource("56_r2l38")
text = "仓库这边空着。标了外借归还的那只木箱，盖是松的。"

[sub_resource type="Resource" id="Resource_2l7rd"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 330.396
duration = 4.32
stream = ExtResource("57_2ek8k")
text = "（自言自语）真迹卷好就能放下。等特展厅一响，值班室的人会跑。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_npigq"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 335.834
duration = 5.52
stream = ExtResource("58_c8rk6")
text = "韩松再看一遍左下角。顿笔还在。这不是印刷品，是我的手。"

[sub_resource type="Resource" id="Resource_ccy7e"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 341.754
duration = 6.6
stream = ExtResource("59_x8kdv")
text = "档案室找到了。出库单日期是三天前，签名像梁叔平，笔迹发虚。"

[sub_resource type="Resource" id="Resource_tkutg"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 348.754
duration = 5.44
stream = ExtResource("60_245mj")
text = "虚就对了。梁叔平没签过。三天前我在馆外，不在这张纸上。"

[sub_resource type="Resource" id="Resource_iioxy"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 354.594
duration = 5.76
stream = ExtResource("61_0vq55")
text = "周宁对过日程。三天前闭馆之后，楼里加班的只有齐晓舟。"

[sub_resource type="Resource" id="Resource_fog7i"]
script = ExtResource("7_vkywf")
speaker = &"G"
start = 366.542
duration = 6.16
stream = ExtResource("62_s38ix")
text = "吴嫂来补一句。就是那天夜里，我看见他把《呐喊》靠在桌边。"

[sub_resource type="Resource" id="Resource_ea67c"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 373.102
duration = 4.96
stream = ExtResource("63_jdwn4")
text = "靠在桌边，第二天墙上就是韩松的顿笔。时间对得上。"

[sub_resource type="Resource" id="Resource_uw1ng"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 378.462
duration = 5.12
stream = ExtResource("64_30eqj")
text = "裴岚不关心三天前。今晚柜子如果倒了，别怪我裙子扫到。"

[sub_resource type="Resource" id="Resource_akm4j"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 383.982
duration = 5.0
stream = ExtResource("65_2h76y")
text = "马卫东警告你。特展厅的柜子感应很灵，倒了我会离开值班室。"

[sub_resource type="Resource" id="Resource_h4tm0"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 389.382
duration = 5.92
stream = ExtResource("66_joab5")
text = "那就让你离开一会儿。裴岚要的就是走廊里有脚步，仓库没人看。"

[sub_resource type="Resource" id="Resource_t5y44"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 395.702
duration = 6.04
stream = ExtResource("67_s0r7b")
text = "仓库的箱盖我试过了。外借归还四个字是我写的，清册里没有这箱。"

[sub_resource type="Resource" id="Resource_13xfm"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 402.142
duration = 3.96
stream = ExtResource("68_0r1lq")
text = "韩松把这句话记住了。外借归还。齐晓舟，箱子不是空的。"

[sub_resource type="Resource" id="Resource_7br0x"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 406.502
duration = 6.76
stream = ExtResource("69_iiw2e")
text = "周宁也记住了。清册上没有外借归还。谁写的标签，谁就想把真迹藏进去。"

[sub_resource type="Resource" id="Resource_ti3bk"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 413.662
duration = 5.12
stream = ExtResource("70_ttopn")
text = "梁叔平把日程摊开。三天前下午我在馆外，这支笔不是我的。"

[sub_resource type="Resource" id="Resource_cy2d6"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 419.182
duration = 4.36
stream = ExtResource("71_ymfkn")
text = "周宁把回执夹上。时间对得上，签名对不上。"

[sub_resource type="Resource" id="Resource_1b6ek"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 423.942
duration = 5.52
stream = ExtResource("72_11mbx")
text = "马卫东调出门禁。齐晓舟的卡在闭馆后刷过，进的是修复画室。"

[sub_resource type="Resource" id="Resource_5gwu6"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 429.862
duration = 3.08
stream = ExtResource("73_eo7y2")
text = "夜班不稀奇。齐晓舟每个月都有两次。"

[sub_resource type="Resource" id="Resource_o152g"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 433.342
duration = 4.6
stream = ExtResource("74_0f7o8")
text = "稀奇的是画面。那四十分钟只有展厅是黑的，别的路都亮着。"

[sub_resource type="Resource" id="Resource_jx2op"]
script = ExtResource("7_vkywf")
speaker = &"G"
start = 438.342
duration = 5.4
stream = ExtResource("75_hmy8c")
text = "吴嫂出门厅的时候，展厅的灯灭了，修复画室还亮着。"

[sub_resource type="Resource" id="Resource_4y1ba"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 444.142
duration = 6.08
stream = ExtResource("76_o05s8")
text = "韩松三个月前交画，是在白天。裴岚在场，她说画册用得上。"

[sub_resource type="Resource" id="Resource_b8hms"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 450.622
duration = 6.24
stream = ExtResource("77_e0in1")
text = "画册用得上是我说的。裴岚没让他把习作挂到《呐喊》的钉子上。"

[sub_resource type="Resource" id="Resource_wb3cn"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 457.262
duration = 5.6
stream = ExtResource("78_plvqe")
text = "钉子上现在就是它。韩松要你当着周宁的面承认见过这张习作。"

[sub_resource type="Resource" id="Resource_uamsi"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 463.262
duration = 5.64
stream = ExtResource("79_3jynv")
text = "承认。习作我看过。真迹我没让他碰，碰的人另有价钱。"

[sub_resource type="Resource" id="Resource_j2gxj"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 469.302
duration = 5.64
stream = ExtResource("80_j2sfb")
text = "价钱以后算。外借归还这几个字，是哪一天写上库房牌的？"

[sub_resource type="Resource" id="Resource_bfmqy"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 475.342
duration = 4.56
stream = ExtResource("81_uq2ct")
text = "牌是旧的，字是新的。齐晓舟不解释新在哪一天。"

[sub_resource type="Resource" id="Resource_ae501"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 480.302
duration = 6.0
stream = ExtResource("82_opshd")
text = "不必解释。清册上一次外借是去年的素描，不是这只箱号。"

[sub_resource type="Resource" id="Resource_rm6m3"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 486.702
duration = 4.16
stream = ExtResource("83_p6v78")
text = "箱号我记下了。仓库的镜头对着门，不对着箱盖。"

[sub_resource type="Resource" id="Resource_86cb3"]
script = ExtResource("7_vkywf")
speaker = &"G"
start = 491.262
duration = 5.08
stream = ExtResource("84_fd2hl")
text = "门开吴嫂听得见。星期二一次。今晚再开，就是第二次。"

[sub_resource type="Resource" id="Resource_4850f"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 496.742
duration = 5.8
stream = ExtResource("85_cjpl8")
text = "韩松不去仓库。我守展厅。谁再摘墙上这幅，连顿笔一起摘。"

[sub_resource type="Resource" id="Resource_wotyx"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 502.942
duration = 5.76
stream = ExtResource("86_wraq4")
text = "先别摘。两幅同时在，才证明不是看花了眼。梁叔平要这个对照。"

[sub_resource type="Resource" id="Resource_gjvfp"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 509.102
duration = 5.48
stream = ExtResource("87_p6v54")
text = "保险的人明天才到。今晚打开箱子，味道会散进一层走廊。"

[sub_resource type="Resource" id="Resource_l8mtk"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 514.982
duration = 5.84
stream = ExtResource("88_lh2bn")
text = "散就散。周宁宁愿走廊都是松节油，也不愿真迹在箱里过夜。"

[sub_resource type="Resource" id="Resource_0l6q5"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 521.222
duration = 5.44
stream = ExtResource("89_fct6d")
text = "过夜也出不了馆。大门钥匙在马卫东那儿，齐晓舟没有。"

[sub_resource type="Resource" id="Resource_kllnt"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 527.062
duration = 3.56
stream = ExtResource("90_tskck")
text = "钥匙在值班室。谁要出去，得从我这扇窗前过。"

[sub_resource type="Resource" id="Resource_ufm52"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 540.043
duration = 3.24
stream = ExtResource("91_0kx3l")
text = "裴岚上休息室等。价钱不在展厅喊。"

[sub_resource type="Resource" id="Resource_v28q3"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 548.85
duration = 5.68
stream = ExtResource("92_k6fka")
text = "不谈价钱。《呐喊》不卖。已经付给齐晓舟的，数目说出来。"

[sub_resource type="Resource" id="Resource_nia4h"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 554.93
duration = 4.6
stream = ExtResource("93_vj8qq")
text = "一半。另一半等画到我手里。梁叔平不用听整数。"

[sub_resource type="Resource" id="Resource_o6yjt"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 559.93
duration = 3.68
stream = ExtResource("94_ajtl1")
text = "到不了手里。修复画室的柜，今晚贴封条。"

[sub_resource type="Resource" id="Resource_5prbi"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 571.559
duration = 5.48
stream = ExtResource("95_7vwqt")
text = "周宁到机房了。三天前的录像如果有备份，黑屏会留下。"

[sub_resource type="Resource" id="Resource_ksv78"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 577.439
duration = 4.52
stream = ExtResource("96_kjecg")
text = "备份在。马卫东每夜把值班室的盘拷进机房，黑的那段也在。"

[sub_resource type="Resource" id="Resource_j6xq2"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 582.359
duration = 5.12
stream = ExtResource("97_j8kgl")
text = "周宁就把它当成空档。空档从闭馆后开始，一共四十分钟。"

[sub_resource type="Resource" id="Resource_n0ish"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 587.879
duration = 4.0
stream = ExtResource("98_djom0")
text = "只有展厅。修复画室那路是亮的，人影进过一次。"

[sub_resource type="Resource" id="Resource_8eqns"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 592.279
duration = 4.12
stream = ExtResource("99_k4wh6")
text = "人影一个。请你在盘上标出齐晓舟进门的时间。"

[sub_resource type="Resource" id="Resource_uwj24"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 596.799
duration = 3.04
stream = ExtResource("100_r63s3")
text = "标了。和出库单上的日期是同一天。"

[sub_resource type="Resource" id="Resource_xbe5m"]
script = ExtResource("7_vkywf")
speaker = &"G"
start = 605.492
duration = 4.92
stream = ExtResource("101_3g3c7")
text = "吴嫂送水。休息室的门没关严，一半这个词我听见了。"

[sub_resource type="Resource" id="Resource_emsto"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 610.812
duration = 4.92
stream = ExtResource("102_u4hhb")
text = "听见就当没听见。吴嫂，拖把不要停在二层走廊。"

[sub_resource type="Resource" id="Resource_hk4ig"]
script = ExtResource("7_vkywf")
speaker = &"G"
start = 616.132
duration = 5.24
stream = ExtResource("103_ct1nf")
text = "不停。可这一半，吴嫂会原话告诉周宁。"

[sub_resource type="Resource" id="Resource_7lxas"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 621.772
duration = 4.8
stream = ExtResource("104_6ngdb")
text = "马卫东盯着特展厅。裴岚你回到柜子旁边了，手别挨玻璃。"

[sub_resource type="Resource" id="Resource_n1jvf"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 633.414
duration = 3.64
stream = ExtResource("105_0ua4e")
text = "挨不挨，等这一下再说。裴岚自己会喊。"

[sub_resource type="Resource" id="Resource_ck7r8"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 642.0
duration = 4.0
stream = ExtResource("106_ok745")
text = "（大喊）特展厅的柜子倒了！裴岚闪不开，马卫东快过来！"
loudness = 0.9

[sub_resource type="Resource" id="Resource_iuerg"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 649.273
duration = 3.88
stream = ExtResource("107_x3yib")
text = "马卫东离开值班室了。你站着别动，玻璃我来看。"

[sub_resource type="Resource" id="Resource_52moe"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 653.553
duration = 5.24
stream = ExtResource("108_v8wb6")
text = "看吧。没有碎到人。裴岚就是想让你的眼睛离开那一路屏幕。"

[sub_resource type="Resource" id="Resource_w8bw3"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 659.193
duration = 4.16
stream = ExtResource("109_p1f4h")
text = "离开了四十秒。足够有人从修复画室走到仓库。"

[sub_resource type="Resource" id="Resource_j00xc"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 664.103
duration = 5.56
stream = ExtResource("110_qyfs2")
text = "（低声）卷进去了。外借归还的箱子合上。齐晓舟不再碰第二下。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_lnt41"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 670.063
duration = 5.4
stream = ExtResource("111_5ew7o")
text = "展厅这边韩松守着墙上那幅。谁要再换，得从我前面过。"

[sub_resource type="Resource" id="Resource_7ucdm"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 675.863
duration = 6.88
stream = ExtResource("112_57jos")
text = "周宁在机房听着特展厅的响动。出库单的复印件我按在手里，不跟去凑热闹。"

[sub_resource type="Resource" id="Resource_7o4j4"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 683.143
duration = 5.24
stream = ExtResource("113_y71ip")
text = "梁叔平也不去。松节油的味道还在展厅，箱子如果有画，会更冲。"

[sub_resource type="Resource" id="Resource_u61pl"]
script = ExtResource("7_vkywf")
speaker = &"G"
start = 688.783
duration = 5.52
stream = ExtResource("114_1l44y")
text = "吴嫂在一层走廊。仓库门开过一下，有卷画布的声音，很短。"

[sub_resource type="Resource" id="Resource_epjsc"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 702.874
duration = 4.36
stream = ExtResource("115_id6u8")
text = "人回到值班室。马卫东把刚才四十秒空出来的那段标上。"

[sub_resource type="Resource" id="Resource_3qstx"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 711.816
duration = 4.2
stream = ExtResource("116_ka65l")
text = "裴岚可以解释。柜子是我碰的，人不是我搬的。"

[sub_resource type="Resource" id="Resource_etoao"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 723.731
duration = 5.04
stream = ExtResource("117_2nxbq")
text = "修复画室的柜子空了。齐晓舟要是被问，就说布用完了。"

[sub_resource type="Resource" id="Resource_cccv1"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 733.746
duration = 4.76
stream = ExtResource("118_rmyyj")
text = "空了正好。韩松要看你把那卷布送到了哪只箱子。"

[sub_resource type="Resource" id="Resource_3mb2n"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 738.906
duration = 5.6
stream = ExtResource("119_38cr8")
text = "送到仓库。外借归还。你的习作留在墙上，真迹不在墙上。"

[sub_resource type="Resource" id="Resource_6bsb7"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 744.906
duration = 3.8
stream = ExtResource("120_s2id3")
text = "那我就是被你拿来做假的人。韩松只答应过临一张习作。"

[sub_resource type="Resource" id="Resource_u0laa"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 749.106
duration = 6.76
stream = ExtResource("121_onqjw")
text = "习作上了墙，真迹才能离墙。裴岚要的是能卷走的那一卷。"

[sub_resource type="Resource" id="Resource_njyv7"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 759.767
duration = 4.88
stream = ExtResource("122_ylfrd")
text = "箱子在这儿。裴岚付了一半，另一半等它出馆。今晚还不出。"

[sub_resource type="Resource" id="Resource_slpgv"]
script = ExtResource("7_vkywf")
speaker = &"G"
start = 775.387
duration = 5.72
stream = ExtResource("123_2p7xh")
text = "吴嫂听见盖合上了。外借归还是齐晓舟的字，我认得他写的还。"

[sub_resource type="Resource" id="Resource_g6y76"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 781.507
duration = 5.2
stream = ExtResource("124_55gvh")
text = "裴岚就在箱子旁边。周宁你过来对清册，我不再改口。"

[sub_resource type="Resource" id="Resource_u6v16"]
script = ExtResource("7_vkywf")
speaker = &"G"
start = 787.107
duration = 4.72
stream = ExtResource("125_fi2ju")
text = "吴嫂把盖按住。等人到齐再打开，省得味道先散。"

[sub_resource type="Resource" id="Resource_dpvpt"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 794.849
duration = 5.28
stream = ExtResource("126_wm1h0")
text = "周宁把清册带来了。没有这只箱子，没有这次外借，没有这张还。"

[sub_resource type="Resource" id="Resource_wj34u"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 800.529
duration = 4.48
stream = ExtResource("127_e7gqh")
text = "韩松让开半步。梁叔平要站到灯下，才看得见布纹。"

[sub_resource type="Resource" id="Resource_nk36u"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 805.409
duration = 4.28
stream = ExtResource("128_mgah8")
text = "马卫东还在值班室。仓库里多一个人，屏幕上就多一个影。"

[sub_resource type="Resource" id="Resource_w8iq3"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 811.398
duration = 3.52
stream = ExtResource("129_1uax1")
text = "打开。梁叔平要看见布，不是听见你们争。"

[sub_resource type="Resource" id="Resource_2oo1o"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 815.318
duration = 5.28
stream = ExtResource("130_5dh50")
text = "别开在灯下。罩光是新补的，松节油一散，谁都闻得见。"

[sub_resource type="Resource" id="Resource_ogx36"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 820.998
duration = 4.72
stream = ExtResource("131_tbopr")
text = "闻见了。三天前的味道，不是今晚才从墙上揭下来的。"

[sub_resource type="Resource" id="Resource_dhe38"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 826.118
duration = 4.72
stream = ExtResource("132_3x5dq")
text = "墙上那幅留下。韩松的顿笔在左下角，可以跟我别的画对。"

[sub_resource type="Resource" id="Resource_8mv4u"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 834.611
duration = 5.32
stream = ExtResource("133_a6nhy")
text = "马卫东补上监视器。三天前黑掉的四十分钟，和维护单是同一天。"

[sub_resource type="Resource" id="Resource_bn68m"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 840.331
duration = 5.36
stream = ExtResource("134_pmogn")
text = "维护单的字和出库单像一支笔。周宁认为都是齐晓舟填的。"

[sub_resource type="Resource" id="Resource_8pdaj"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 846.091
duration = 4.76
stream = ExtResource("135_lxrc2")
text = "是我填的。梁叔平的签名我描了。三天前闭馆，人只有我。"

[sub_resource type="Resource" id="Resource_pnf7b"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 851.251
duration = 5.4
stream = ExtResource("136_tvxpk")
text = "裴岚承认付钱。支开马卫东也是我说的。搬画的手不是我的。"

[sub_resource type="Resource" id="Resource_2jmkc"]
script = ExtResource("7_vkywf")
speaker = &"G"
start = 857.051
duration = 4.56
stream = ExtResource("137_u8xv7")
text = "搬的那天吴嫂在。星期二夜里，画靠在修复画室桌边。"

[sub_resource type="Resource" id="Resource_2jkn0"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 862.011
duration = 4.48
stream = ExtResource("138_7jo8s")
text = "韩松没有参与搬家。我交习作的时候，他说是画册。"

[sub_resource type="Resource" id="Resource_d27g1"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 866.891
duration = 5.88
stream = ExtResource("139_lo0vi")
text = "画册不需要描我的签名。齐晓舟，箱子里这一卷现在归馆里。"

[sub_resource type="Resource" id="Resource_bx0f8"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 873.171
duration = 4.64
stream = ExtResource("140_x6nb7")
text = "值班室的录像从这一分钟重新记。谁再靠近仓库，我都留档。"

[sub_resource type="Resource" id="Resource_ywe70"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 878.211
duration = 5.68
stream = ExtResource("141_nh61o")
text = "周宁把假出库单夹进清册。日期写着三天前，旁边注上伪造。"

[sub_resource type="Resource" id="Resource_oj0hr"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 884.291
duration = 5.4
stream = ExtResource("142_ehpup")
text = "另一半的钱裴岚不会再付。柜子我赔，画我碰都不碰。"

[sub_resource type="Resource" id="Resource_7axty"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 890.091
duration = 4.96
stream = ExtResource("143_g358x")
text = "布在箱子里。齐晓舟把它放进去的时候，特展厅正好在响。"

[sub_resource type="Resource" id="Resource_gugwq"]
script = ExtResource("7_vkywf")
speaker = &"G"
start = 895.451
duration = 6.08
stream = ExtResource("144_o1nvx")
text = "吴嫂可以再说一遍。响之前，星期二的灯；响之后，仓库的盖。"

[sub_resource type="Resource" id="Resource_v7t6o"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 901.931
duration = 5.56
stream = ExtResource("145_opb0d")
text = "墙上的顿笔也再说一遍。那是韩松的手，不是《呐喊》的手。"

[sub_resource type="Resource" id="Resource_78daj"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 907.891
duration = 6.96
stream = ExtResource("146_2qb8k")
text = "够了。真迹在标着外借归还的箱子里。留下的那幅，今晚就摘下去。"

[sub_resource type="Resource" id="Resource_c8dqh"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 915.251
duration = 4.96
stream = ExtResource("147_xd8vc")
text = "马卫东看着摘。从展厅到仓库，这条走廊我一步一步跟。"

[sub_resource type="Resource" id="Resource_4haqj"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 920.611
duration = 4.16
stream = ExtResource("148_u5142")
text = "周宁跟单。没有签字的出库，以后都算没有发生。"

[sub_resource type="Resource" id="Resource_le7rj"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 925.171
duration = 5.48
stream = ExtResource("149_5oc6w")
text = "裴岚留在门厅等。钱的事我自己跟齐晓舟了，不跟馆里赖。"

[sub_resource type="Resource" id="Resource_83p6w"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 931.051
duration = 4.64
stream = ExtResource("150_f2jpm")
text = "了不了。另一半没付，可已经卷进去的这一卷，是我放的。"

[sub_resource type="Resource" id="Resource_xelgk"]
script = ExtResource("7_vkywf")
speaker = &"G"
start = 936.091
duration = 5.16
stream = ExtResource("151_q0mwi")
text = "吴嫂把拖布放回门厅。该说的都说了，地明天再拖。"

[sub_resource type="Resource" id="Resource_g5uvp"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 941.651
duration = 6.16
stream = ExtResource("152_pan1q")
text = "梁叔平按顺序收。三天前摘画的是齐晓舟，墙上换上韩松的习作。"

[sub_resource type="Resource" id="Resource_id01v"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 948.211
duration = 5.8
stream = ExtResource("153_a54ea")
text = "习作我画的。用途他骗了我。韩松认画，不认贼。"

[sub_resource type="Resource" id="Resource_gkbgv"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 954.411
duration = 6.44
stream = ExtResource("154_tyxdd")
text = "支开马卫东的是裴岚。柜子算我碰的，箱子我没开。"

[sub_resource type="Resource" id="Resource_31fr5"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 961.251
duration = 4.16
stream = ExtResource("155_ob3qs")
text = "箱子是我合上的。外借归还是我写的。真迹在里面。"

[sub_resource type="Resource" id="Resource_qxvl5"]
script = ExtResource("7_vkywf")
speaker = &"G"
start = 965.811
duration = 4.84
stream = ExtResource("156_ishy6")
text = "星期二的灯是吴嫂看见的。今晚的箱盖也是。"

[sub_resource type="Resource" id="Resource_jnaao"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 971.051
duration = 5.12
stream = ExtResource("157_yin4r")
text = "四十分钟黑屏是机器记下的。维护两个字不是马卫东写的。"

[sub_resource type="Resource" id="Resource_4jw3h"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 976.571
duration = 5.52
stream = ExtResource("158_lyvrr")
text = "出库单是周宁对出来的。签名是描的，日期是三天前。"

[sub_resource type="Resource" id="Resource_ytg0o"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 982.491
duration = 6.6
stream = ExtResource("159_xfh2x")
text = "明天换回真迹。习作摘下去单独登记，不跟《呐喊》放一起。"

[sub_resource type="Resource" id="Resource_ydf2m"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 989.491
duration = 5.64
stream = ExtResource("160_hfat4")
text = "马卫东把黑屏的四十分钟导出。文件名就写三天前，不写维护。"

[sub_resource type="Resource" id="Resource_lwd5i"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 995.531
duration = 6.24
stream = ExtResource("161_ev7n3")
text = "周宁在单子旁边注了伪造。描出来的签名，跟梁叔平今晚的字对过。"

[sub_resource type="Resource" id="Resource_1p353"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 1002.171
duration = 5.36
stream = ExtResource("162_n8pbi")
text = "韩松可以留下习作的照片。左下角那一顿，跟我工作室里的旧画一样。"

[sub_resource type="Resource" id="Resource_dl05l"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 1007.931
duration = 6.16
stream = ExtResource("163_4ycw0")
text = "裴岚把转账时间说给周宁。一半在三天前，不是在柜子倒下的今晚。"

[sub_resource type="Resource" id="Resource_0rock"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 1014.491
duration = 5.36
stream = ExtResource("164_d3ua6")
text = "三天前那一半到了，我才摘的画。今晚只是把卷好的布放进箱子。"

[sub_resource type="Resource" id="Resource_3g36a"]
script = ExtResource("7_vkywf")
speaker = &"G"
start = 1020.251
duration = 6.32
stream = ExtResource("165_abikk")
text = "吴嫂把两晚分开记。星期二是灯，今晚是盖。中间隔着三天。"

[sub_resource type="Resource" id="Resource_mocg4"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 1026.971
duration = 4.16
stream = ExtResource("166_3sbab")
text = "隔着三天，所以展厅里的松节油不是刚揭下来的味道。"

[sub_resource type="Resource" id="Resource_uhac5"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 1031.531
duration = 4.8
stream = ExtResource("167_lojjp")
text = "值班室的人证到此。谁再改标签，走廊的镜头对着仓库门。"

[sub_resource type="Resource" id="Resource_5e6vv"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 1036.731
duration = 7.08
stream = ExtResource("168_x8o7p")
text = "清册合上。没有外借，就没有归还。箱子留下，画留下，单子留下。"

[sub_resource type="Resource" id="Resource_1p7ee"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 1044.211
duration = 5.6
stream = ExtResource("169_mh33w")
text = "梁叔平再确认箱盖里面。卷着的是布，不是目录，也不是镜框。"

[sub_resource type="Resource" id="Resource_00o6h"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 1050.211
duration = 6.08
stream = ExtResource("170_qgjec")
text = "布的左上角没有我的顿笔。韩松的顿笔在墙上那幅，不在这卷里。"

[sub_resource type="Resource" id="Resource_o5pdo"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 1056.691
duration = 5.72
stream = ExtResource("171_af4rt")
text = "这卷是原作。三天前从钉子上摘下，边角补过，所以有松节油。"

[sub_resource type="Resource" id="Resource_ah7wl"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 1062.811
duration = 5.44
stream = ExtResource("172_a4f6x")
text = "裴岚付的那一半，就是为了这卷能卷起来。柜子只为把人引开。"

[sub_resource type="Resource" id="Resource_hqm0e"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 1068.651
duration = 5.24
stream = ExtResource("173_wai74")
text = "马卫东把引开的四十秒单独标了。人一离开值班室，仓库门就开。"

[sub_resource type="Resource" id="Resource_8a84s"]
script = ExtResource("7_vkywf")
speaker = &"G"
start = 1074.291
duration = 5.0
stream = ExtResource("174_w7xyp")
text = "吴嫂听见门，也听见盖。星期二没有盖的声音，只有灯。"

[sub_resource type="Resource" id="Resource_8sm8c"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 1079.691
duration = 6.96
stream = ExtResource("175_qdphc")
text = "周宁把两天写成两行。三天前是换墙，今晚是装箱。没有第三次。"

[sub_resource type="Resource" id="Resource_r8yie"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 1087.051
duration = 4.4
stream = ExtResource("176_yr35d")
text = "出库单只有一张。签名是描的，日期是三天前。"

[sub_resource type="Resource" id="Resource_fjdrs"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 1091.851
duration = 6.64
stream = ExtResource("177_fj1xy")
text = "三个月前我交习作，裴岚在场。齐晓舟说是画册。我没见过箱子。"

[sub_resource type="Resource" id="Resource_ccn5y"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 1098.891
duration = 5.92
stream = ExtResource("178_yjit4")
text = "画册是我当时的说法。后来我改了主意，要的是能拿走的真迹。"

[sub_resource type="Resource" id="Resource_g5773"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 1105.211
duration = 6.2
stream = ExtResource("179_bhrog")
text = "改主意那天，钱到了一半。我才夜班摘画，才把监视器写成维护。"

[sub_resource type="Resource" id="Resource_cp5fc"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 1111.811
duration = 5.12
stream = ExtResource("180_5uumo")
text = "维护两个字的笔迹，和出库单一致。不是值班室的笔，马卫东对过。"

[sub_resource type="Resource" id="Resource_ppskc"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 1117.331
duration = 5.28
stream = ExtResource("181_ghjr8")
text = "也不是周宁的。清册是我抄的，不会把自己的字写成梁叔平。"

[sub_resource type="Resource" id="Resource_fo3lq"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 1123.011
duration = 5.92
stream = ExtResource("182_umcel")
text = "我的字在捐赠回执上。谁要核，跟这张描出来的签名并排放。"

[sub_resource type="Resource" id="Resource_w7mka"]
script = ExtResource("7_vkywf")
speaker = &"G"
start = 1129.331
duration = 5.96
stream = ExtResource("183_m61lf")
text = "吴嫂不认笔。我认灯，认桌子，认星期二夜里画不在墙上。"

[sub_resource type="Resource" id="Resource_g1kcc"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 1135.691
duration = 4.32
stream = ExtResource("184_4u4nx")
text = "第二天墙上有了顿笔。韩松今天才第一次站到这幅画前面。"

[sub_resource type="Resource" id="Resource_fsq1r"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 1140.411
duration = 4.84
stream = ExtResource("185_dogsp")
text = "裴岚今天才第一次碰倒柜子。箱子上的字不是我写的。"

[sub_resource type="Resource" id="Resource_ak3jh"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 1145.651
duration = 5.36
stream = ExtResource("186_nmm6y")
text = "字是我写的。外借归还，是为了让人以为这箱本来就该离开。"

[sub_resource type="Resource" id="Resource_exndv"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 1151.411
duration = 4.2
stream = ExtResource("187_h0lm0")
text = "清册里没有这只箱号。本来就该留下，不该离开。"

[sub_resource type="Resource" id="Resource_h7ja1"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 1156.011
duration = 4.48
stream = ExtResource("188_qpooj")
text = "大门钥匙没离开过值班室。画没有出馆，只是换了房间。"

[sub_resource type="Resource" id="Resource_mlf0a"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 1160.891
duration = 6.16
stream = ExtResource("189_j38li")
text = "换了房间就还能挂回去。习作摘下，真迹展开，边角等它干。"

[sub_resource type="Resource" id="Resource_rkq00"]
script = ExtResource("7_vkywf")
speaker = &"G"
start = 1167.451
duration = 4.96
stream = ExtResource("190_8nhll")
text = "吴嫂明天再拖地。今晚走廊里的味道留着，算证据。"

[sub_resource type="Resource" id="Resource_k3jgk"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 1172.811
duration = 3.64
stream = ExtResource("191_p15xw")
text = "习作可以留在馆里，但要写上临本，不能再叫《呐喊》。"

[sub_resource type="Resource" id="Resource_5infu"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 1176.851
duration = 5.8
stream = ExtResource("192_7hgqe")
text = "周宁来写。墙上那幅的标签今晚就换，免得明天还有人看错。"

[sub_resource type="Resource" id="Resource_knnya"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 1183.051
duration = 5.36
stream = ExtResource("193_cmp5b")
text = "裴岚不参与换标签。另一半的钱取消，转账记录交给周宁。"

[sub_resource type="Resource" id="Resource_6txi4"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 1188.811
duration = 4.8
stream = ExtResource("194_emfp4")
text = "取消也改变不了箱子。齐晓舟放进去的那一卷，已经点过了。"

[sub_resource type="Resource" id="Resource_qmqux"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 1194.011
duration = 5.4
stream = ExtResource("195_a6cb2")
text = "马卫东在仓库门口守到交班。镜头对着门，不再只对着走廊。"

[sub_resource type="Resource" id="Resource_ey7cs"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 1199.811
duration = 5.0
stream = ExtResource("196_8cb30")
text = "梁叔平把封条贴上箱盖。没有我的签字，谁也不能再打开。"

[sub_resource type="Resource" id="Resource_b8kin"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 1205.211
duration = 5.52
stream = ExtResource("197_gsm7s")
text = "周宁把封条编号抄进清册。打开要两个人，其中一个是馆长。"

[sub_resource type="Resource" id="Resource_0x7w8"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 1211.131
duration = 4.24
stream = ExtResource("198_otuxw")
text = "韩松不参与开箱。我只负责证明墙上的顿笔是我的。"

[sub_resource type="Resource" id="Resource_ulo66"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 1215.771
duration = 4.24
stream = ExtResource("199_gp3qp")
text = "裴岚在门厅等。保险的人明天来，柜子的损失我单独说。"

[sub_resource type="Resource" id="Resource_hxtd1"]
script = ExtResource("7_vkywf")
speaker = &"G"
start = 1220.411
duration = 6.68
stream = ExtResource("200_dk2f5")
text = "吴嫂把两页笔记交给周宁。口头说过的，我再留一份写的。"

[sub_resource type="Resource" id="Resource_dokba"]
script = ExtResource("7_vkywf")
speaker = &"C"
start = 1227.491
duration = 4.96
stream = ExtResource("201_yn3dm")
text = "写上我的名字。摘画、换画、装箱，三件都是齐晓舟。"

[sub_resource type="Resource" id="Resource_cpl0r"]
script = ExtResource("7_vkywf")
speaker = &"B"
start = 1232.851
duration = 5.96
stream = ExtResource("202_4wkk4")
text = "马卫东在旁边签时间。黑屏四十分钟，引开四十秒，写在同一张纸。"

[sub_resource type="Resource" id="Resource_33rns"]
script = ExtResource("7_vkywf")
speaker = &"A"
start = 1239.211
duration = 5.6
stream = ExtResource("203_myht1")
text = "纸留下，画留下，箱子留下。梁叔平今晚不再改任何一句。"

[sub_resource type="Resource" id="Resource_fsw3f"]
script = ExtResource("7_vkywf")
speaker = &"D"
start = 1245.211
duration = 5.36
stream = ExtResource("204_ui0qm")
text = "清册第二次合上。这一次没有外借，也没有归还，只有调包。"

[sub_resource type="Resource" id="Resource_mfx4t"]
script = ExtResource("7_vkywf")
speaker = &"E"
start = 1250.971
duration = 6.24
stream = ExtResource("205_fixfb")
text = "调包两个字我听见了。习作是被拿去填墙的，不是韩松送去填的。"

[sub_resource type="Resource" id="Resource_baiwu"]
script = ExtResource("7_vkywf")
speaker = &"F"
start = 1257.611
duration = 4.72
stream = ExtResource("206_oafcq")
text = "裴岚也听见了。支开保安是我，填墙的人不是我。"

