[sub_resource type="Resource" id="Resource_ygnmo"]
script = ExtResource("4_mag14")
id = &"q1"
kind = 1
prompt = "谁发现了《呐喊》失窃？"
options = PackedStringArray("保安", "馆长", "员工")
answer = "保安"

[sub_resource type="Resource" id="Resource_rnat8"]
script = ExtResource("4_mag14")
id = &"q2"
prompt = "保安离开岗位去做什么了？"
options = PackedStringArray("去厕所", "吃饭", "抽烟")
answer = "去厕所"

[sub_resource type="Resource" id="Resource_kukax"]
script = ExtResource("4_mag14")
id = &"q3"
kind = 1
prompt = "谁最后提出去检查监控？"
options = PackedStringArray("馆长", "员工", "经纪人")
answer = "员工"

[sub_resource type="Resource" id="Resource_35t08"]
script = ExtResource("7_5vlho")
speaker = &"J"
start = 10.0
duration = 6.422
stream = ExtResource("8_2irf0")
text = "保安，今天闭馆后你巡逻的时候注意点，听说最近有小偷盯上了《呐喊》。"

[sub_resource type="Resource" id="Resource_haa6g"]
script = ExtResource("7_5vlho")
speaker = &"I"
start = 19.0
duration = 4.567
stream = ExtResource("9_r56eg")
text = "放心吧，我会每半小时巡逻一次，绝对不会出问题。"

[sub_resource type="Resource" id="Resource_4a6da"]
script = ExtResource("7_5vlho")
speaker = &"J"
start = 26.0
duration = 3.821
stream = ExtResource("10_npkhy")
text = "那就好，我先去办公室找馆长汇报工作。"

[sub_resource type="Resource" id="Resource_o4e5o"]
script = ExtResource("7_5vlho")
speaker = &"H"
start = 35.0
duration = 2.439
stream = ExtResource("11_ajxpn")
text = "你来了，今天的参观人数怎么样？"

[sub_resource type="Resource" id="Resource_07wsb"]
script = ExtResource("7_5vlho")
speaker = &"J"
start = 41.0
duration = 8.519
stream = ExtResource("12_mlnww")
text = "还不错，比预期多了20%。对了，馆长，关于《呐喊》的安保，我已经让保安加强巡逻了。"

[sub_resource type="Resource" id="Resource_pdwsm"]
script = ExtResource("7_5vlho")
speaker = &"H"
start = 49.0
duration = 5.311
stream = ExtResource("13_10pgk")
text = "好的，辛苦你了。对了，明天有个重要的客人要来，你准备一下。"

[sub_resource type="Resource" id="Resource_y7g8t"]
script = ExtResource("7_5vlho")
speaker = &"K"
start = 60.0
duration = 3.786
stream = ExtResource("14_oomvm")
text = "经纪人，你看这幅《呐喊》，真的很有冲击力。"

[sub_resource type="Resource" id="Resource_kds2c"]
script = ExtResource("7_5vlho")
speaker = &"L"
start = 67.0
duration = 6.76
stream = ExtResource("15_yflhu")
text = "是啊，这可是蒙克的代表作，价值连城。不过听说最近有人想偷它？"

[sub_resource type="Resource" id="Resource_amvcs"]
script = ExtResource("7_5vlho")
speaker = &"K"
start = 74.0
duration = 5.366
stream = ExtResource("16_duvft")
text = "偷？谁有那个胆子？这里的安保系统可是最先进的。"

[sub_resource type="Resource" id="Resource_arlot"]
script = ExtResource("7_5vlho")
speaker = &"M"
start = 85.0
duration = 3.326
stream = ExtResource("17_2k4np")
text = "哎，又要打扫展厅了，真是麻烦。"

[sub_resource type="Resource" id="Resource_tky0p"]
script = ExtResource("7_5vlho")
speaker = &"I"
start = 95.0
duration = 3.464
stream = ExtResource("18_jjexx")
text = "馆长，不好了！《呐喊》不见了！"

[sub_resource type="Resource" id="Resource_sg2h5"]
script = ExtResource("7_5vlho")
speaker = &"H"
start = 101.0
duration = 4.092
stream = ExtResource("19_0hoj4")
text = "什么？怎么可能？我明明锁在展柜里的！"

[sub_resource type="Resource" id="Resource_770v7"]
script = ExtResource("7_5vlho")
speaker = &"I"
start = 107.0
duration = 5.538
stream = ExtResource("20_3t4aw")
text = "我刚才巡逻的时候还在，现在展柜的玻璃被打碎了，画不见了。"

[sub_resource type="Resource" id="Resource_rb0vg"]
script = ExtResource("7_5vlho")
speaker = &"J"
start = 114.0
duration = 4.955
stream = ExtResource("21_kmgx0")
