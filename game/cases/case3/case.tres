Resource("Resource_hxtd1"), SubResource("Resource_dokba"), SubResource("Resource_cpl0r"), SubResource("Resource_33rns"), SubResource("Resource_fsw3f"), SubResource("Resource_mfx4t"), SubResource("Resource_baiwu")])
questions = Array[ExtResource("4_v8apa")]([SubResource("Resource_takop"), SubResource("Resource_ydnjl"), SubResource("Resource_2j8y5"), SubResource("Resource_80kvc"), SubResource("Resource_qvdvd")])
truth = "修复师齐晓舟三天前闭馆后把真迹从墙上摘下，换上画家韩松按印刷品临的习作。韩松以为那只是画册配图，不知道上了墙。收藏家裴岚付了钱，今晚在特展厅打翻展柜，把保安马卫东从值班室支走。齐晓舟趁机把卷好的真迹放进仓库一只标着“外借归还”的木箱。馆长梁叔平没有签过那张出库单，策展周宁在档案室对出了伪造的日期。清洁工吴嫂星期二夜里看见齐晓舟把画摘下来。留在墙上的那幅，左下角是韩松的收笔。"
cover = "gallery"
