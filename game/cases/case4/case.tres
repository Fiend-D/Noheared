track = Array[ExtResource("2_weaqk")]([SubResource("Resource_splbn"), SubResource("Resource_edm73"), SubResource("Resource_owqnf"), SubResource("Resource_jcao5"), SubResource("Resource_kvvah"), SubResource("Resource_bpi7o"), SubResource("Resource_wemw2"), SubResource("Resource_nuyn7"), SubResource("Resource_xml6s"), SubResource("Resource_hwmsh"), SubResource("Resource_on1hc"), SubResource("Resource_wdrk5"), SubResource("Resource_s2kft"), SubResource("Resource_yihns"), SubResource("Resource_8qip5"), SubResource("Resource_s2e4t"), SubResource("Resource_6510y"), SubResource("Resource_40ul0"), SubResource("Resource_nb0y0"), SubResource("Resource_am3gx"), SubResource("Resource_l0iph"), SubResource("Resource_8w7f0"), SubResource("Resource_g1j6q"), SubResource("Resource_4gr82"), SubResource("Resource_e5d5f"), SubResource("Resource_j7yab"), SubResource("Resource_jo3aa")])

[sub_resource type="Resource" id="Resource_6ilb7"]
script = ExtResource("4_lo8om")
id = &"q1"
kind = 1
prompt = "谁是杀害先生的凶手？"
options = PackedStringArray("管家", "继承人", "秘书", "厨师", "园丁")
answer = "继承人"

[sub_resource type="Resource" id="Resource_djiv5"]
script = ExtResource("4_lo8om")
id = &"q2"
prompt = "凶器是什么？"
options = PackedStringArray("匕首", "镇纸", "毒药", "绳子")
answer = "镇纸"

[sub_resource type="Resource" id="Resource_wgdea"]
script = ExtResource("4_lo8om")
id = &"q3"
prompt = "凶手是如何作案的？"
options = PackedStringArray("从门进入", "从窗户扔进凶器", "下毒", "勒死")
answer = "从窗户扔进凶器"

[sub_resource type="Resource" id="Resource_okt1j"]
script = ExtResource("7_8nsbp")
speaker = &"F"
start = 10.0
duration = 9.235
stream = ExtResource("8_usp4q")
text = "各位，我是负责这个案件的侦探。昨晚8点，先生在书房被发现死亡。现在我需要了解案发时每个人的行踪。"

[sub_resource type="Resource" id="Resource_3c5w6"]
script = ExtResource("7_8nsbp")
speaker = &"A"
start = 27.0
duration = 9.609
stream = ExtResource("9_q1gug")
text = "侦探先生，我当时在客厅整理文件。8点左右，我听到书房传来一声闷响，但以为是先生在整理东西，就没在意。"

[sub_resource type="Resource" id="Resource_q0cx7"]
script = ExtResource("7_8nsbp")
speaker = &"B"
start = 44.0
duration = 8.767
stream = ExtResource("10_r5uww")
text = "我在花园打电话，和朋友讨论生意的事情。大概7点50分左右，我看到园丁从书房方向走出来。"

[sub_resource type="Resource" id="Resource_m3grc"]
script = ExtResource("7_8nsbp")
speaker = &"E"
start = 61.0
duration = 9.231
stream = ExtResource("11_n1ml8")
text = "我确实去过书房，先生让我修剪书房窗外的灌木。7点45分左右我就离开了，去了花园继续工作。"

[sub_resource type="Resource" id="Resource_2ctb5"]
script = ExtResource("7_8nsbp")
speaker = &"C"
start = 78.0
duration = 12.619
stream = ExtResource("12_yv254")
text = "我在厨房帮厨师准备晚餐。7点55分的时候，先生打电话让我送一杯咖啡到书房。我7点58分送到，先生当时还好好的。"

[sub_resource type="Resource" id="Resource_kdtgk"]
script = ExtResource("7_8nsbp")
speaker = &"D"
start = 95.0
duration = 7.762
stream = ExtResource("13_5pff2")
text = "是的，秘书确实在厨房帮我。她7点55分离开去送咖啡，8点05分左右回来的。"

[sub_resource type="Resource" id="Resource_ism61"]
script = ExtResource("7_8nsbp")
speaker = &"F"
start = 107.0
duration = 3.368
stream = ExtResource("14_2ya6k")
text = "秘书，你送咖啡的时候，先生有什么异常吗？"

[sub_resource type="Resource" id="Resource_n7kk8"]
script = ExtResource("7_8nsbp")
speaker = &"C"
start = 117.0
duration = 7.706
stream = ExtResource("15_w8k54")
text = "先生看起来很生气，在电话里和人吵架。他说'你别想拿走一分钱'，然后挂了电话。"

[sub_resource type="Resource" id="Resource_soe7d"]
script = ExtResource("7_8nsbp")
speaker = &"B"
start = 134.0
duration = 6.677
stream = ExtResource("16_13ou2")
text = "那通电话一定是打给我的！先生最近对我很不满，说我花钱大手大脚。"

[sub_resource type="Resource" id="Resource_qjav1"]
script = ExtResource("7_8nsbp")
speaker = &"A"
start = 146.0
duration = 4.563
stream = ExtResource("17_4fagu")
text = "先生确实在考虑修改遗嘱，最近和律师谈了好几次。"

[sub_resource type="Resource" id="Resource_xtmb6"]
script = ExtResource("7_8nsbp")
speaker = &"F"
start = 158.0
duration = 3.189
stream = ExtResource("18_ati2w")
text = "管家，你知道先生要修改遗嘱的内容吗？"

[sub_resource type="Resource" id="Resource_27l1x"]
script = ExtResource("7_8nsbp")
speaker = &"A"
start = 168.0
duration = 5.613
stream = ExtResource("19_p2us2")
text = "具体内容我不清楚，但先生提到过要把大部分财产捐给慈善机构。"

[sub_resource type="Resource" id="Resource_mnwwq"]
script = ExtResource("7_8nsbp")
speaker = &"B"
start = 180.0
duration = 5.131
stream = ExtResource("20_qptta")
text = "什么？那我的继承权怎么办？我是他唯一的侄子！"

[sub_resource type="Resource" id="Resource_d7rsv"]
script = ExtResource("7_8nsbp")
speaker = &"C"
start = 192.0
duration = 6.795
stream = ExtResource("21_x241h")
text = "先生最近确实和很多人有矛盾。上周还和园丁因为花园的事情吵架。"

[sub_resource type="Resource" id="Resource_8ecds"]
script = ExtResource("7_8nsbp")
speaker = &"E"
start = 204.0
duration = 6.55
stream = ExtResource("22_6e7af")
text = "那是因为先生要卖掉花园的一块地，我不同意。但我绝对不会伤害先生！"

[sub_resource type="Resource" id="Resource_sa6mf"]
script = ExtResource("7_8nsbp")
speaker = &"D"
start = 216.0
duration = 6.034
stream = ExtResource("23_nnviw")
text = "先生也和厨师长吵架了，说我们的菜不符合他的口味，要扣我们工资。"

[sub_resource type="Resource" id="Resource_m2oyo"]
script = ExtResource("7_8nsbp")
speaker = &"F"
start = 228.0
duration = 7.539
stream = ExtResource("24_rhscs")
text = "现在让我们回到案发时间。8点整，有人听到闷响。秘书，你送完咖啡后去了哪里？"

[sub_resource type="Resource" id="Resource_3o6br"]
script = ExtResource("7_8nsbp")
speaker = &"C"
start = 245.0
duration = 7.244
stream = ExtResource("25_lymop")
text = "我回到厨房，和厨师一起准备晚餐，直到8点15分管家来说先生出事了。"

[sub_resource type="Resource" id="Resource_vevsb"]
script = ExtResource("7_8nsbp")
speaker = &"A"
start = 257.0
duration = 5.555
stream = ExtResource("26_4w3aq")
text = "8点10分左右，我去书房送文件，发现先生倒在地上，已经没有呼吸了。"

[sub_resource type="Resource" id="Resource_xotam"]
script = ExtResource("7_8nsbp")
speaker = &"F"
start = 269.0
duration = 9.001
stream = ExtResource("27_la680")
text = "法医初步判断死亡时间是7点55分到8点05分之间。凶器是书房里的黄铜镇纸，上面没有指纹。"

[sub_resource type="Resource" id="Resource_dxaei"]
script = ExtResource("7_8nsbp")
speaker = &"B"
start = 286.0
duration = 3.546
stream = ExtResource("28_ssfcd")
text = "镇纸？那是我去年送给先生的礼物！"

[sub_resource type="Resource" id="Resource_jrtql"]
script = ExtResource("7_8nsbp")
speaker = &"F"
start = 298.0
duration = 4.666
stream = ExtResource("29_dyu8l")
text = "哦？这很有趣。继承人送的镇纸成了凶器。"

[sub_resource type="Resource" id="Resource_7bv5t"]
script = ExtResource("7_8nsbp")
speaker = &"B"
start = 310.0
duration = 4.722
stream = ExtResource("30_vmbpw")
text = "不是我！我当时在花园打电话，园丁可以证明！"

[sub_resource type="Resource" id="Resource_yquhp"]
script = ExtResource("7_8nsbp")
speaker = &"E"
start = 322.0
duration = 5.124
stream = ExtResource("31_a1oux")
text = "是的，我在花园看到他在打电话，一直到8点10分左右。"

[sub_resource type="Resource" id="Resource_f52ky"]
script = ExtResource("7_8nsbp")
speaker = &"F"
start = 334.0
duration = 4.715
stream = ExtResource("32_ergob")
text = "管家，你说你8点10分发现先生的尸体，之前你在做什么？"

[sub_resource type="Resource" id="Resource_4mdfa"]
script = ExtResource("7_8nsbp")
speaker = &"A"
start = 346.0
duration = 5.379
stream = ExtResource("33_8mmb6")
text = "我一直在客厅整理文件，8点整听到闷响，8点10分去书房查看。"

[sub_resource type="Resource" id="Resource_tj55m"]
script = ExtResource("7_8nsbp")
speaker = &"F"
start = 358.0
duration = 7.611
stream = ExtResource("34_gxw8f")
text = "秘书，你送咖啡的时间是7点58分，回来是8点05分。这段时间你在书房待了多久？"

[sub_resource type="Resource" id="Resource_4ky06"]
script = ExtResource("7_8nsbp")
speaker = &"C"
start = 375.0
duration = 5.933
stream = ExtResource("35_am8ot")
text = "就待了1分钟左右，放下咖啡就走了。先生当时还在打电话。"

[sub_resource type="Resource" id="Resource_x6o2c"]
script = ExtResource("7_8nsbp")
speaker = &"F"
start = 387.0
duration = 3.67
stream = ExtResource("36_ha6ds")
text = "厨师，你能证明秘书8点05分回到厨房吗？"

[sub_resource type="Resource" id="Resource_o0k3j"]
script = ExtResource("7_8nsbp")
speaker = &"D"
start = 399.0
duration = 6.146
stream = ExtResource("37_8gft5")
text = "是的，她8点05分准时回来的，我们一起准备晚餐直到8点15分。"

[sub_resource type="Resource" id="Resource_2ufva"]
script = ExtResource("7_8nsbp")
speaker = &"F"
start = 411.0
duration = 4.197
stream = ExtResource("38_c5e34")
text = "园丁，你7点45分离开书房后，一直都在花园吗？"

[sub_resource type="Resource" id="Resource_ds0qq"]
script = ExtResource("7_8nsbp")
speaker = &"E"
start = 423.0
duration = 6.096
stream = ExtResource("39_s5f3a")
text = "是的，我一直在修剪花园的灌木，直到8点15分听到管家的叫声。"

[sub_resource type="Resource" id="Resource_rwto1"]
script = ExtResource("7_8nsbp")
speaker = &"F"
start = 435.0
duration = 14.49
stream = ExtResource("40_skc5i")
text = "现在让我重新梳理一下时间线：7点45分园丁离开书房，7点55分秘书去送咖啡，7点58分到达，8点05分返回厨房，8点整管家听到闷响，8点10分管家发现尸体。"

[sub_resource type="Resource" id="Resource_o31lw"]
script = ExtResource("7_8nsbp")
speaker = &"A"
start = 457.0
duration = 1.543
stream = ExtResource("41_0evao")
text = "是的，就是这样。"

[sub_resource type="Resource" id="Resource_cf30k"]
script = ExtResource("7_8nsbp")
speaker = &"F"
start = 464.0
duration = 8.505
stream = ExtResource("42_g6uto")
text = "等等，有个问题。如果闷响是8点整发生的，而秘书8点05分才回到厨房，那她有足够的时间作案。"

[sub_resource type="Resource" id="Resource_va7ep"]
script = ExtResource("7_8nsbp")
speaker = &"C"
start = 481.0
duration = 4.897
stream = ExtResource("43_o8u2m")
text = "不可能！我8点05分回到厨房，厨师可以证明！"

[sub_resource type="Resource" id="Resource_ne7pg"]
script = ExtResource("7_8nsbp")
speaker = &"D"
start = 493.0
duration = 5.499
stream = ExtResource("44_q4iqo")
text = "是的，她确实8点05分回来的，我们一起工作到8点15分。"

[sub_resource type="Resource" id="Resource_jvigl"]
script = ExtResource("7_8nsbp")
speaker = &"F"
start = 505.0
duration = 5.232
stream = ExtResource("45_aibsf")
text = "那管家呢？你8点整听到闷响，为什么10分钟后才去查看？"

[sub_resource type="Resource" id="Resource_gm6hc"]
script = ExtResource("7_8nsbp")
speaker = &"A"
start = 517.0
duration = 6.449
stream = ExtResource("46_t1jt3")
text = "我以为先生在整理东西，所以没在意。直到10分钟后觉得不对劲才去查看。"

[sub_resource type="Resource" id="Resource_w4snw"]
script = ExtResource("7_8nsbp")
speaker = &"F"
start = 529.0
duration = 6.414
stream = ExtResource("47_x6gc0")
text = "但如果是你作案，你完全可以在8点整动手，然后10分钟后假装发现尸体。"

[sub_resource type="Resource" id="Resource_wa6cs"]
script = ExtResource("7_8nsbp")
speaker = &"A"
start = 546.0
duration = 5.77
stream = ExtResource("48_dtx2t")
text = "我没有理由伤害先生！我在这个家工作了30年，先生待我如家人。"

[sub_resource type="Resource" id="Resource_s1qvy"]
script = ExtResource("7_8nsbp")
speaker = &"F"
start = 558.0
duration = 6.393
stream = ExtResource("49_yayn4")
text = "让我检查一下书房的窗户。园丁，你修剪灌木时，书房的窗户是开着的吗？"

[sub_resource type="Resource" id="Resource_gfan8"]
script = ExtResource("7_8nsbp")
speaker = &"E"
start = 575.0
duration = 3.673
stream = ExtResource("50_sini7")
text = "是的，窗户是开着的，先生说要通风。"

[sub_resource type="Resource" id="Resource_fpeij"]
script = ExtResource("7_8nsbp")
speaker = &"F"
start = 587.0
duration = 5.59
stream = ExtResource("51_x2aq6")
text = "哦？这就有意思了。如果窗户开着，凶手可以从窗外作案。"

[sub_resource type="Resource" id="Resource_pn508"]
script = ExtResource("7_8nsbp")
speaker = &"B"
start = 599.0
duration = 4.769
stream = ExtResource("52_plqyx")
text = "从窗外？那只有园丁有机会，他当时就在花园！"

[sub_resource type="Resource" id="Resource_cbg3g"]
script = ExtResource("7_8nsbp")
speaker = &"E"
start = 611.0
duration = 4.533
stream = ExtResource("53_7rf3c")
text = "我没有！我一直在修剪灌木，没有靠近窗户。"

[sub_resource type="Resource" id="Resource_kogkc"]
script = ExtResource("7_8nsbp")
speaker = &"F"
start = 623.0
duration = 8.18
stream = ExtResource("54_grnri")
text = "但你有动机，先生要卖掉你精心照料的花园。而且你熟悉花园的布局，可以从窗户进入书房。"

[sub_resource type="Resource" id="Resource_22vb4"]
script = ExtResource("7_8nsbp")
speaker = &"E"
start = 640.0
duration = 6.666
stream = ExtResource("55_3gd6s")
text = "我绝对不会这么做！先生虽然要卖地，但他答应给我一笔钱让我退休。"

[sub_resource type="Resource" id="Resource_5gwrx"]
script = ExtResource("7_8nsbp")
speaker = &"F"
start = 652.0
duration = 11.325
stream = ExtResource("56_eu002")
text = "现在我有了一个大胆的推测。凶手不是从门进入的，而是从窗户。而且凶手知道先生8点左右会在书房，并且知道镇纸的位置。"

[sub_resource type="Resource" id="Resource_hpa0w"]
script = ExtResource("7_8nsbp")
speaker = &"B"
start = 669.0
duration = 5.766
stream = ExtResource("57_fjjpu")
text = "镇纸是我送的，我当然知道它的位置！但我当时在花园打电话！"

[sub_resource type="Resource" id="Resource_opqhk"]
script = ExtResource("7_8nsbp")
speaker = &"F"
start = 681.0
duration = 6.907
stream = ExtResource("58_5no6l")
text = "是的，你在花园打电话，但你可以在打电话的同时，从花园的窗户扔进镇纸，击中先生。"

[sub_resource type="Resource" id="Resource_dqidr"]
script = ExtResource("7_8nsbp")
speaker = &"B"
start = 698.0
duration = 3.002
stream = ExtResource("59_im6ic")
text = "不可能！我没有那么准的手法！"

[sub_resource type="Resource" id="Resource_yjr1v"]
script = ExtResource("7_8nsbp")
speaker = &"F"
start = 710.0
duration = 8.495
stream = ExtResource("60_y3tpa")
text = "但你有动机，有机会，而且是唯一知道镇纸位置的人。管家听到的闷响，就是镇纸击中先生的声音。"

