room = &"副总室"

[sub_resource type="Resource" id="Resource_2nlqy"]
script = ExtResource("1_6ogpb")
id = &"F"
display_name = "小唐"
label = "6"
color = Color(0.18039216, 0.5254902, 0.67058825, 1)
track = Array[ExtResource("2_0yb2g")]([SubResource("Resource_o2f1r"), SubResource("Resource_nmdh4"), SubResource("Resource_3xo4k"), SubResource("Resource_vug10"), SubResource("Resource_rmnra"), SubResource("Resource_kdcj6"), SubResource("Resource_gbu4h"), SubResource("Resource_l7x8t"), SubResource("Resource_qfss5"), SubResource("Resource_widn1"), SubResource("Resource_ndsjq"), SubResource("Resource_i0y3u"), SubResource("Resource_u58f7"), SubResource("Resource_6c5jx"), SubResource("Resource_w57iw"), SubResource("Resource_58fgj"), SubResource("Resource_r2j1j"), SubResource("Resource_0jnpw"), SubResource("Resource_qu7ak"), SubResource("Resource_y5o6n"), SubResource("Resource_wpswr"), SubResource("Resource_rkreh"), SubResource("Resource_g04to"), SubResource("Resource_wmbrw"), SubResource("Resource_lnuie"), SubResource("Resource_e0mmp"), SubResource("Resource_n5gq7"), SubResource("Resource_ucpme"), SubResource("Resource_valpi"), SubResource("Resource_3xayr"), SubResource("Resource_vptfq"), SubResource("Resource_gwycp"), SubResource("Resource_ablu2"), SubResource("Resource_56ts6"), SubResource("Resource_7q7dp"), SubResource("Resource_oylxc"), SubResource("Resource_jtsqd"), SubResource("Resource_ei6am"), SubResource("Resource_i15hu"), SubResource("Resource_p2nyp"), SubResource("Resource_f27fc"), SubResource("Resource_ehhy7"), SubResource("Resource_j8heb"), SubResource("Resource_al17g"), SubResource("Resource_v34tu"), SubResource("Resource_y5xy0"), SubResource("Resource_ikq8b"), SubResource("Resource_8oc78"), SubResource("Resource_i2aw2"), SubResource("Resource_glhsw"), SubResource("Resource_nitje"), SubResource("Resource_rg4kv"), SubResource("Resource_r2ekm"), SubResource("Resource_repr8"), SubResource("Resource_wtp0g"), SubResource("Resource_egd12"), SubResource("Resource_4l5j2"), SubResource("Resource_fk6cc"), SubResource("Resource_1xqrx"), SubResource("Resource_id2pc"), SubResource("Resource_vjcp8"), SubResource("Resource_u81sf"), SubResource("Resource_d0c52"), SubResource("Resource_5oelc"), SubResource("Resource_y1daj")])

[sub_resource type="Resource" id="Resource_vauyc"]
script = ExtResource("4_ofy75")
id = &"q1"
kind = 1
prompt = "谁杀了周启明？"
options = PackedStringArray("沈衡", "宋晚", "高序", "刘远", "小唐")
answer = "沈衡"

[sub_resource type="Resource" id="Resource_yb5ka"]
script = ExtResource("4_ofy75")
id = &"q2"
prompt = "沈衡的不在场证明是怎么来的？"
options = PackedStringArray("预先录好发言在通气会上播放", "高序替他开了麦", "他一直待在副总室", "监控被关掉了")
answer = "预先录好发言在通气会上播放"

[sub_resource type="Resource" id="Resource_qrkul"]
script = ExtResource("4_ofy75")
id = &"q3"
prompt = "宋晚离开前交给沈衡的是什么？"
options = PackedStringArray("周启明受贿证据的U盘", "总经理室的钥匙", "一份辞职信", "空白合同")
answer = "周启明受贿证据的U盘"

[sub_resource type="Resource" id="Resource_phpul"]
script = ExtResource("4_ofy75")
id = &"q4"
prompt = "刘远发现尸体之后做了什么？"
options = PackedStringArray("换掉了报价合同", "报了警", "擦掉了镇纸上的指纹", "把U盘拿走了")
answer = "换掉了报价合同"

[sub_resource type="Resource" id="Resource_fxqui"]
script = ExtResource("4_ofy75")
id = &"q5"
prompt = "高序为什么没有杀人动机？"
options = PackedStringArray("他已用受贿证据换到晋升推荐", "他当晚不在公司", "他和周启明是亲戚", "合同利益归他")
answer = "他已用受贿证据换到晋升推荐"

[sub_resource type="Resource" id="Resource_y1nm3"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 5.0
duration = 4.04
stream = ExtResource("8_1gff7")
text = "宋晚女士，周启明在总经理室，他让您先别进。"

[sub_resource type="Resource" id="Resource_g2ujj"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 9.44
duration = 4.28
stream = ExtResource("9_s570q")
text = "沈衡发消息，让我直接去副总室。小唐别拦。"

[sub_resource type="Resource" id="Resource_i2hf1"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 14.12
duration = 6.04
stream = ExtResource("10_wk74d")
text = "沈衡在副总室。您走一层走廊，最里面那间。"

[sub_resource type="Resource" id="Resource_gdqn4"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 20.56
duration = 3.44
stream = ExtResource("11_w1iya")
text = "我待一会儿就走。别跟别人说宋晚来过。"

[sub_resource type="Resource" id="Resource_25dqf"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 24.4
duration = 3.84
stream = ExtResource("12_yyuyp")
text = "进了前台都要登记。小唐只能照实写。"

[sub_resource type="Resource" id="Resource_jbv42"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 28.64
duration = 3.24
stream = ExtResource("13_q7lsn")
text = "周启明一早把财务室的钥匙收回去了。"

[sub_resource type="Resource" id="Resource_tiser"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 32.28
duration = 5.56
stream = ExtResource("14_sdga4")
text = "小唐，通气会的麦我测过，六点五十准点开。"

[sub_resource type="Resource" id="Resource_vl01a"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 38.24
duration = 3.16
stream = ExtResource("15_fyr0c")
text = "高序，名单上怎么没有周启明？"

[sub_resource type="Resource" id="Resource_tcbaa"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 41.8
duration = 4.96
stream = ExtResource("16_83ecw")
text = "周启明说他不参加。今晚由沈衡代表管理层讲。"

[sub_resource type="Resource" id="Resource_0ksbr"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 47.16
duration = 3.12
stream = ExtResource("17_cew7m")
text = "（低声）宋晚，门没关严。进来再说话。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_6wk6p"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 50.68
duration = 5.12
stream = ExtResource("18_w7c8k")
text = "沈衡，合影的事我知道了。是周启明设的局。"

[sub_resource type="Resource" id="Resource_jh10i"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 56.2
duration = 3.56
stream = ExtResource("19_mllwa")
text = "他拿我们的照片，逼我把总经理的位子让出去。"

[sub_resource type="Resource" id="Resource_5nkbr"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 60.16
duration = 4.84
stream = ExtResource("20_m63n6")
text = "让出去他仍不肯停。他还要你每月工资分他一半。"

[sub_resource type="Resource" id="Resource_0732x"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 65.4
duration = 3.52
stream = ExtResource("21_cufut")
text = "这些话你从哪儿听来的？周启明亲口说的？"

[sub_resource type="Resource" id="Resource_wexgh"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 69.32
duration = 4.2
stream = ExtResource("22_4e0h0")
text = "我另有他的把柄。供应商的回扣，全在这个U盘里。"

[sub_resource type="Resource" id="Resource_e4lr0"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 73.92
duration = 4.04
stream = ExtResource("23_bef7p")
text = "宋晚，你是想拿它跟周启明谈离婚，对不对？"

[sub_resource type="Resource" id="Resource_uerlc"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 78.36
duration = 4.68
stream = ExtResource("24_1doma")
text = "谈不成我就公开。刘远那笔五十万，日期都在。"

[sub_resource type="Resource" id="Resource_7utlk"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 83.44
duration = 4.16
stream = ExtResource("25_fepy2")
text = "U盘留下。我去跟周启明谈。你现在就离开公司。"

[sub_resource type="Resource" id="Resource_klcrf"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 88.0
duration = 4.8
stream = ExtResource("26_r7m28")
text = "我走。小唐要是问，就说我回我母亲家，今晚不回来。"

[sub_resource type="Resource" id="Resource_p0nf3"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 93.2
duration = 4.68
stream = ExtResource("27_4x4xr")
text = "从正门走，让前台看见宋晚离开。别走楼梯后门。"

[sub_resource type="Resource" id="Resource_hekgw"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 98.28
duration = 4.4
stream = ExtResource("28_twddc")
text = "（自言自语）发言得先录好。通气会上不能有空档。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_ak0qe"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 103.08
duration = 4.36
stream = ExtResource("29_rg2wd")
text = "宋晚女士怎么又下来了？通气会还没开始呢。"

[sub_resource type="Resource" id="Resource_ywag4"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 107.84
duration = 5.04
stream = ExtResource("30_kp614")
text = "东西落在楼上。小唐，我这就走，今晚不再进来。"

[sub_resource type="Resource" id="Resource_h0s3n"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 113.28
duration = 4.04
stream = ExtResource("31_iwtwy")
text = "我记下了。宋晚，六点四十以前离开前台。"

[sub_resource type="Resource" id="Resource_rlm7e"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 117.72
duration = 4.32
stream = ExtResource("32_gvua7")
text = "名字写宋晚。别写成周太太，我不要那个姓。"

[sub_resource type="Resource" id="Resource_v2k6l"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 122.44
duration = 3.68
stream = ExtResource("33_ist6t")
text = "她上了楼梯。休息室的方向，灯应该会亮。"

[sub_resource type="Resource" id="Resource_x46sf"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 126.52
duration = 4.6
stream = ExtResource("34_ijb8r")
text = "财务室的柜子被人翻过。回扣底账不在原处。"

[sub_resource type="Resource" id="Resource_lp8si"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 131.52
duration = 4.6
stream = ExtResource("35_bmfcd")
text = "高序在吗？我是刘远。周启明让我在茶水间等。"

[sub_resource type="Resource" id="Resource_88c8u"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 136.52
duration = 4.4
stream = ExtResource("36_rnn60")
text = "刘远先别去总经理室。周启明正在清人。"

[sub_resource type="Resource" id="Resource_wjjmd"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 141.32
duration = 4.52
stream = ExtResource("37_luew8")
text = "二层走廊没人。我在休息室等车，谁也别来敲。"

[sub_resource type="Resource" id="Resource_l2svu"]
script = ExtResource("7_g115r")
speaker = &"A"
start = 146.24
duration = 4.76
stream = ExtResource("38_p5fy0")
text = "高序，上来。大办公室的门我开着，就你一个人。"

[sub_resource type="Resource" id="Resource_fg32x"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 151.4
duration = 4.24
stream = ExtResource("39_0xigg")
text = "周启明，财务室的底账没了。是你收走的吗？"

[sub_resource type="Resource" id="Resource_erp3j"]
script = ExtResource("7_g115r")
speaker = &"A"
start = 156.04
duration = 4.08
stream = ExtResource("40_5o2ou")
text = "是我收的。你手里那份复印件，够用了，别再翻。"

[sub_resource type="Resource" id="Resource_qdtbr"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 160.52
duration = 4.92
stream = ExtResource("41_uv36a")
text = "你答应过，我把回扣的证据压下来，你就推荐我。"

[sub_resource type="Resource" id="Resource_tpvrv"]
script = ExtResource("7_g115r")
speaker = &"A"
start = 165.84
duration = 4.84
stream = ExtResource("42_srmr8")
text = "晋升推荐信在我抽屉里，明天董事会之前交上去。"

[sub_resource type="Resource" id="Resource_ar5hn"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 171.08
duration = 4.4
stream = ExtResource("43_qqv14")
text = "那我没有理由再闹。高序要的就是这个位子。"

[sub_resource type="Resource" id="Resource_cbrie"]
script = ExtResource("7_g115r")
speaker = &"A"
start = 175.88
duration = 4.6
stream = ExtResource("44_ipqse")
text = "记住，通气会上你只负责设备。沈衡的麦，别切断。"

[sub_resource type="Resource" id="Resource_1glo7"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 180.88
duration = 4.2
stream = ExtResource("45_galqe")
text = "沈衡的麦我看着。周启明你真的不进会议室？"

[sub_resource type="Resource" id="Resource_7q0vu"]
script = ExtResource("7_g115r")
speaker = &"A"
start = 185.48
duration = 5.12
stream = ExtResource("46_7kwgf")
text = "不进。有人要来谈条件。谈完之前，谁也别往这儿送咖啡。"

[sub_resource type="Resource" id="Resource_hsfw4"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 191.0
duration = 3.48
stream = ExtResource("47_ix2py")
text = "我下楼。大办公室这边，我当没来过。"

[sub_resource type="Resource" id="Resource_s44s6"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 199.433
duration = 4.36
stream = ExtResource("48_a0dk4")
text = "休息室的门关着。宋晚，车要是没到，前台可以再叫。"

[sub_resource type="Resource" id="Resource_xpl7y"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 204.193
duration = 4.84
stream = ExtResource("49_ayfdv")
text = "（低声）不用。我在跟我母亲说话，小唐你下楼去。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_0sdpu"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 209.433
duration = 4.44
stream = ExtResource("50_dj0mq")
text = "妈，我已经离开周启明的办公室了。人在公司休息室。"

[sub_resource type="Resource" id="Resource_kfdvx"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 214.273
duration = 6.72
stream = ExtResource("51_76dap")
text = "小唐，你下来。财务室这本领用登记，中午谁签走了美工刀？"

[sub_resource type="Resource" id="Resource_i2rj8"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 221.393
duration = 5.08
stream = ExtResource("52_qg0wy")
text = "沈衡签的。他说拆箱用，用完会还到前台。"

[sub_resource type="Resource" id="Resource_rsq6w"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 226.873
duration = 4.08
stream = ExtResource("53_i7h83")
text = "到现在没还。刀不在财务室，也不在我的抽屉。"

[sub_resource type="Resource" id="Resource_p8mgb"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 231.353
duration = 4.56
stream = ExtResource("54_fihpx")
text = "高序你别吓我。一把美工刀，至于查成这样吗？"

[sub_resource type="Resource" id="Resource_qodwn"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 236.313
duration = 5.56
stream = ExtResource("55_3e27e")
text = "周启明把底账收走了。他用那份证据，换我的晋升推荐。"

[sub_resource type="Resource" id="Resource_i4jn8"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 242.273
duration = 4.72
stream = ExtResource("56_p3hac")
text = "所以高序你不会去碰他？你的好处已经到手了。"

[sub_resource type="Resource" id="Resource_fv25w"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 247.393
duration = 5.52
stream = ExtResource("57_0p6hj")
text = "到手了。我再动手，推荐信就是一张废纸。"

[sub_resource type="Resource" id="Resource_mpip7"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 253.313
duration = 4.12
stream = ExtResource("58_4l8lw")
text = "（低声）喂，是我，刘远。那五十万他收了，还要一笔。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_8ji4f"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 257.833
duration = 4.12
stream = ExtResource("59_6kyid")
text = "周启明说，合同不改成低价，董事会就拿我们开刀。"

[sub_resource type="Resource" id="Resource_te7a2"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 262.353
duration = 5.24
stream = ExtResource("60_noats")
text = "再汇五十万。我在茶水间等财务回话，人进不了总经理室。"

[sub_resource type="Resource" id="Resource_vdk0e"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 267.993
duration = 2.92
stream = ExtResource("61_x77e8")
text = "你们别催我进去谈。他现在不见供应商。"

[sub_resource type="Resource" id="Resource_cpopy"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 271.313
duration = 6.16
stream = ExtResource("62_aobyg")
text = "沈衡进总经理室了。小唐在前台看着一层走廊，谁过我都记。"

[sub_resource type="Resource" id="Resource_s7yy8"]
script = ExtResource("7_g115r")
speaker = &"A"
start = 277.873
duration = 4.88
stream = ExtResource("63_86kvj")
text = "沈衡，位子你已经让了。工资的一半，今晚给个准话。"

[sub_resource type="Resource" id="Resource_niif2"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 283.153
duration = 4.44
stream = ExtResource("64_radmw")
text = "不给。周启明，照片可以合成，回扣的账却是你签的。"

[sub_resource type="Resource" id="Resource_edqvl"]
script = ExtResource("7_g115r")
speaker = &"A"
start = 287.993
duration = 5.12
stream = ExtResource("65_en76h")
text = "账在我抽屉里。你敢在通气会上提，我就放宋晚的合影。"

[sub_resource type="Resource" id="Resource_odatc"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 293.513
duration = 3.84
stream = ExtResource("66_4agiy")
text = "总经理室左手那块石头镇纸，倒是比你的话沉。"

[sub_resource type="Resource" id="Resource_xlmjm"]
script = ExtResource("7_g115r")
speaker = &"A"
start = 297.753
duration = 5.28
stream = ExtResource("67_cenvc")
text = "镇纸压文件，不压人。滚回副总室，把开场白准备好。"

[sub_resource type="Resource" id="Resource_q63uu"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 303.433
duration = 5.8
stream = ExtResource("68_3grok")
text = "高序在财务室听见了。周启明活到明天，推荐信才算数。"

[sub_resource type="Resource" id="Resource_ij6sh"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 309.633
duration = 5.36
stream = ExtResource("69_xhcg3")
text = "沈衡出来了，脸色很差。美工刀的事我再提醒他一句。"

[sub_resource type="Resource" id="Resource_pjxmh"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 323.145
duration = 4.8
stream = ExtResource("70_gilba")
text = "沈衡，中午领的美工刀该还前台了。登记簿还空着。"

[sub_resource type="Resource" id="Resource_ityui"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 328.345
duration = 4.56
stream = ExtResource("71_rvxqb")
text = "今晚还要用。拆完最后一箱，小唐你再来收。"

[sub_resource type="Resource" id="Resource_d1oev"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 333.305
duration = 3.88
stream = ExtResource("72_jmbef")
text = "刘远还在茶水间。电话没来之前，我不离开这间屋。"

[sub_resource type="Resource" id="Resource_ijsxc"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 339.7
duration = 5.2
stream = ExtResource("73_1q5l8")
text = "机房共享盘上，沈衡下午传过一个很短的文件。"

[sub_resource type="Resource" id="Resource_d4gyg"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 345.3
duration = 5.24
stream = ExtResource("74_jhvu7")
text = "不到一分钟。高序先不打开，免得跟通气会的麦混在一起。"

[sub_resource type="Resource" id="Resource_xd5gc"]
script = ExtResource("7_g115r")
speaker = &"A"
start = 354.254
duration = 4.8
stream = ExtResource("75_wkh5b")
text = "档案室的高价合同我锁好了。刘远要换，让他拿钱来谈。"

[sub_resource type="Resource" id="Resource_7n0sp"]
script = ExtResource("7_g115r")
speaker = &"A"
start = 359.454
duration = 4.68
stream = ExtResource("76_18856")
text = "（自言自语）备份放上层，原件在总经理室左手。别让他先看见。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_vosb7"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 364.534
duration = 4.12
stream = ExtResource("77_anp1h")
text = "周启明从档案室回总经理室了。门重新关上。"

[sub_resource type="Resource" id="Resource_vlesd"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 369.054
duration = 4.76
stream = ExtResource("78_orqyw")
text = "那就继续等。刘远的公司还没把第二笔五十万批下来。"

[sub_resource type="Resource" id="Resource_frhek"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 374.214
duration = 4.64
stream = ExtResource("79_5apv1")
text = "妈，休息室的沙发对着门。有人上楼我会先看见。"

[sub_resource type="Resource" id="Resource_bfvas"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 379.254
duration = 4.96
stream = ExtResource("80_imkoo")
text = "周启明要是打电话来，你就说宋晚已经在来你这儿的车上。"

[sub_resource type="Resource" id="Resource_lb23e"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 384.614
duration = 4.08
stream = ExtResource("81_csfsh")
text = "实际上我还没下楼。车要等这通电话打完。"

[sub_resource type="Resource" id="Resource_wubru"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 389.094
duration = 5.32
stream = ExtResource("82_h67j2")
text = "U盘不在我身上。交给沈衡的时候，副总室只有我们两个。"

[sub_resource type="Resource" id="Resource_outgx"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 394.814
duration = 5.68
stream = ExtResource("83_b5xft")
text = "二层没有脚步。小唐在前台，听得见楼梯，听不见休息室。"

[sub_resource type="Resource" id="Resource_lv2rm"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 400.894
duration = 6.8
stream = ExtResource("84_6g5x5")
text = "高序把时间写在纸上。宋晚六点四十离开前台，这是记录。"

[sub_resource type="Resource" id="Resource_6dewp"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 408.094
duration = 3.52
stream = ExtResource("85_d1huu")
text = "记录在。她上了二层，之后楼梯就安静了。"

[sub_resource type="Resource" id="Resource_yuyw1"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 412.014
duration = 6.32
stream = ExtResource("86_03uq8")
text = "沈衡要是想要一份不在场证明，会议室里就得一直有他的声音。"

[sub_resource type="Resource" id="Resource_xflha"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 418.734
duration = 5.24
stream = ExtResource("87_t31dv")
text = "你是说他会放录音？高序把话说清楚，前台好记。"

[sub_resource type="Resource" id="Resource_q420k"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 424.374
duration = 5.88
stream = ExtResource("88_0n65r")
text = "还不能说死。会一开，我问他一句。答非所问，就是假的。"

[sub_resource type="Resource" id="Resource_3aryk"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 430.654
duration = 6.04
stream = ExtResource("89_3r1hl")
text = "喂，还是刘远。周启明把报价抬了一倍，董事会那边他扛着。"

[sub_resource type="Resource" id="Resource_ksg8u"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 437.094
duration = 3.56
stream = ExtResource("90_ss5l7")
text = "第二笔五十万今夜要是到不了，合同就按高价走。"

[sub_resource type="Resource" id="Resource_skkly"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 441.054
duration = 5.28
stream = ExtResource("91_hi2ht")
text = "我人在茶水间，没进总经理室。你们查位置也是这一间。"

[sub_resource type="Resource" id="Resource_hknik"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 446.734
duration = 4.0
stream = ExtResource("92_p4tg1")
text = "别再拖。他死了……我是说他要是翻脸，我们就完了。"

[sub_resource type="Resource" id="Resource_tst3o"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 451.134
duration = 4.56
stream = ExtResource("93_q0b6n")
text = "（自言自语）录这一条。本季度宏远的账，经得起任何对质。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_hc0aj"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 456.094
duration = 3.76
stream = ExtResource("94_f6esy")
text = "再录一遍。本季度宏远的账，经得起任何对质。"

[sub_resource type="Resource" id="Resource_n6iec"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 460.254
duration = 4.88
stream = ExtResource("95_fm5rt")
text = "第三遍，语速别变。本季度宏远的账，经得起任何对质。"

[sub_resource type="Resource" id="Resource_6v2s2"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 465.534
duration = 3.52
stream = ExtResource("96_80e44")
text = "手机放在副总室的桌上，外放。人可以离开。"

[sub_resource type="Resource" id="Resource_mgl6e"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 469.454
duration = 5.28
stream = ExtResource("97_b8rnf")
text = "副总室那边怎么在反复说同一句？沈衡你在跟谁演练？"

[sub_resource type="Resource" id="Resource_x75lw"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 475.134
duration = 3.56
stream = ExtResource("98_wsix0")
text = "小唐少问。通气会的开场白，我怕现场卡壳。"

[sub_resource type="Resource" id="Resource_ek32k"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 479.444
duration = 5.48
stream = ExtResource("99_jp758")
text = "我回会议室了。沈衡，还有十分钟，你的麦要开着。"

[sub_resource type="Resource" id="Resource_8t66v"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 485.324
duration = 4.24
stream = ExtResource("100_yibvr")
text = "高序你先接线上的人。我去总经理室拿一份材料就回来。"

[sub_resource type="Resource" id="Resource_14cvu"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 489.964
duration = 4.92
stream = ExtResource("101_i1h6x")
text = "材料让小唐送。沈衡你一离开，线上就没人应。"

[sub_resource type="Resource" id="Resource_dglsh"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 495.284
duration = 3.6
stream = ExtResource("102_c55rb")
text = "应声我安排好了。你听见我的声音，就当我在。"

[sub_resource type="Resource" id="Resource_bvg7o"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 503.332
duration = 4.8
stream = ExtResource("103_wjrtr")
text = "一层走廊能听见副总室的手机。人影却朝总经理室去了。"

[sub_resource type="Resource" id="Resource_c4op3"]
script = ExtResource("7_g115r")
speaker = &"A"
start = 508.532
duration = 4.44
stream = ExtResource("104_o40xu")
text = "门没锁。要谈就进来，周启明把手机扣在桌上了。"

[sub_resource type="Resource" id="Resource_m2b61"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 518.0
duration = 5.16
stream = ExtResource("105_yrx2y")
text = "各位，沈衡的麦是开的。他在讲本季度的账。"

[sub_resource type="Resource" id="Resource_2mgxh"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 523.56
duration = 5.92
stream = ExtResource("106_k1sn3")
text = "沈衡，听到就答应一声。董事会的人在等你点头。"

[sub_resource type="Resource" id="Resource_hs1gi"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 529.88
duration = 5.2
stream = ExtResource("107_dal8p")
text = "他没接话。那句“经得起任何对质”，又从头来了一遍。"

[sub_resource type="Resource" id="Resource_tj7yw"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 535.48
duration = 4.28
stream = ExtResource("108_1f7i4")
text = "同一口气，连停顿都一样。这不是现场在说。"

[sub_resource type="Resource" id="Resource_qvc5m"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 540.16
duration = 5.48
stream = ExtResource("109_ymcls")
text = "我在一层走廊看见沈衡往总经理室走，副总室的手机还亮着。"

[sub_resource type="Resource" id="Resource_fgug3"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 546.04
duration = 5.0
stream = ExtResource("110_pabd3")
text = "高序，线上那个声音是放出来的。沈衡本人不在副总室。"

[sub_resource type="Resource" id="Resource_dir82"]
script = ExtResource("7_g115r")
speaker = &"A"
start = 551.44
duration = 3.24
stream = ExtResource("111_y5th0")
text = "（低声）沈衡，门带上。宋晚把U盘给你了？"
loudness = 0.3

[sub_resource type="Resource" id="Resource_ffj4x"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 555.08
duration = 3.76
stream = ExtResource("112_w3tqd")
text = "给你了。周启明，照片的事可以停了。回扣我也知道。"

[sub_resource type="Resource" id="Resource_excgs"]
script = ExtResource("7_g115r")
speaker = &"A"
start = 559.24
duration = 4.88
stream = ExtResource("113_234cj")
text = "知道又怎样。总经理的位子你已经让出来了，工资还得分我。"

[sub_resource type="Resource" id="Resource_773w4"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 564.52
duration = 4.32
stream = ExtResource("114_aeriv")
text = "宋晚说，那笔五十万只是开头。你还想再要刘远一笔。"

[sub_resource type="Resource" id="Resource_8gr4d"]
script = ExtResource("7_g115r")
speaker = &"A"
start = 569.24
duration = 4.88
stream = ExtResource("115_a8suy")
text = "（大喊）沈衡！我现在就开麦，让通气会听听你和宋晚的事。"
loudness = 0.9

[sub_resource type="Resource" id="Resource_ijv76"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 574.52
duration = 3.6
stream = ExtResource("116_7wmaa")
text = "晚了。石头镇纸就在手边。你别碰那部手机。"

[sub_resource type="Resource" id="Resource_3em2c"]
script = ExtResource("7_g115r")
speaker = &"A"
start = 578.52
duration = 4.28
stream = ExtResource("117_bwwni")
text = "（大喊）沈衡你敢……手机还在桌上，他们听得见！"
loudness = 0.9

[sub_resource type="Resource" id="Resource_6hpgl"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 583.2
duration = 3.12
stream = ExtResource("118_8irkq")
text = "（低声）美工刀我中午就领了。别出声，周启明。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_41wrx"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 586.72
duration = 9.04
stream = ExtResource("119_rspbx")
text = "线上忽然安静了两秒，然后开场白又开始了。沈衡没有回答。"

[sub_resource type="Resource" id="Resource_4i0y1"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 596.16
duration = 5.0
stream = ExtResource("120_takou")
text = "总经理室方向有人在叫沈衡的名字。闷的，隔着门。"

[sub_resource type="Resource" id="Resource_4ti4s"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 601.56
duration = 5.32
stream = ExtResource("121_ro5vf")
text = "妈，我还在休息室。周启明那边怎样我不管，我没有回去。"

[sub_resource type="Resource" id="Resource_ocp5i"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 607.28
duration = 5.44
stream = ExtResource("122_5ofv8")
text = "小唐的登记上是六点四十。宋晚离开前台之后，再没下楼。"

[sub_resource type="Resource" id="Resource_cgy2h"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 613.12
duration = 5.56
stream = ExtResource("123_crxyq")
text = "U盘在沈衡手里，不在我包里。你让弟弟别来公司。"

[sub_resource type="Resource" id="Resource_ticft"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 624.0
duration = 4.44
stream = ExtResource("124_yq67q")
text = "财务回话了。钱能汇。我这就进总经理室，把合同换回来。"

[sub_resource type="Resource" id="Resource_lj03j"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 634.689
duration = 4.52
stream = ExtResource("125_jkaw4")
text = "周启明？灯还亮着。人怎么趴在桌上，镇纸掉在地上。"

[sub_resource type="Resource" id="Resource_615ox"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 639.609
duration = 4.32
stream = ExtResource("126_18uys")
text = "（低声）已经没有气了。刘远不能被看见站在这儿。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_5md4t"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 644.329
duration = 4.08
stream = ExtResource("127_5wpkc")
text = "合同夹在左手边。高价那份抽走，低价的塞进去。"

[sub_resource type="Resource" id="Resource_f1bxv"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 652.683
duration = 5.56
stream = ExtResource("128_2cfr4")
text = "档案室有备份。原件放回去，时间写成我没进过总经理室。"

[sub_resource type="Resource" id="Resource_u4mjf"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 658.643
duration = 5.96
stream = ExtResource("129_x7syp")
text = "（自言自语）茶水间的电话能证明我当时不在场。换合同的事另说。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_eu2o4"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 665.003
duration = 4.76
stream = ExtResource("130_io8vw")
text = "沈衡的麦掉了。我去总经理室看他拿到材料没有。"

[sub_resource type="Resource" id="Resource_dbmy7"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 675.955
duration = 6.64
stream = ExtResource("131_od7n6")
text = "小唐！周启明趴着，头旁边是那块石头镇纸。你别进来。"

[sub_resource type="Resource" id="Resource_umb60"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 683.345
duration = 4.84
stream = ExtResource("132_7wtfs")
text = "高序你大声说清楚。周启明怎么了？前台听不全。"

[sub_resource type="Resource" id="Resource_plvk8"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 688.585
duration = 6.12
stream = ExtResource("133_yhscy")
text = "周启明死了。美工刀不在我看见的地方。沈衡，你人呢？"

[sub_resource type="Resource" id="Resource_s3woi"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 697.542
duration = 3.8
stream = ExtResource("134_dlf0u")
text = "我一直在线上。高序，我的麦只是静音了几秒。"

[sub_resource type="Resource" id="Resource_np5iy"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 701.742
duration = 5.32
stream = ExtResource("135_2bk0g")
text = "沈衡你说谎。副总室只有手机在响，你人在走廊里。"

[sub_resource type="Resource" id="Resource_1subo"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 713.298
duration = 6.12
stream = ExtResource("136_412ek")
text = "都到会议室。先别动总经理室。高序把刚才听到的说一遍。"

[sub_resource type="Resource" id="Resource_012i5"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 719.818
duration = 6.04
stream = ExtResource("137_8gfg0")
text = "沈衡的开场白循环了三遍，“经得起任何对质”，提问他不答。"

[sub_resource type="Resource" id="Resource_eqoi1"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 726.258
duration = 4.6
stream = ExtResource("138_2v3kj")
text = "小唐看见沈衡走向总经理室。手机留在副总室外放。"

[sub_resource type="Resource" id="Resource_uan2m"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 731.258
duration = 3.92
stream = ExtResource("139_4ys5i")
text = "那是演练录音，我随手开着。人我很快就回去了。"

[sub_resource type="Resource" id="Resource_qtr4r"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 735.578
duration = 6.36
stream = ExtResource("140_vulg0")
text = "周启明最后在喊沈衡。隔着门都听得见，高序不会听错。"

[sub_resource type="Resource" id="Resource_03ex1"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 742.338
duration = 5.48
stream = ExtResource("141_murpx")
text = "美工刀是沈衡中午在前台领的，登记在财务室，到现在没还。"

[sub_resource type="Resource" id="Resource_nw1qq"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 748.218
duration = 4.36
stream = ExtResource("142_7w0rc")
text = "刀用来拆箱。周启明的死跟沈衡没有关系。"

[sub_resource type="Resource" id="Resource_yd03o"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 757.463
duration = 5.76
stream = ExtResource("143_meu3l")
text = "楼下在吵。我从休息室下来，只到二层走廊，我不进那间屋。"

[sub_resource type="Resource" id="Resource_nfehq"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 770.263
duration = 6.64
stream = ExtResource("144_jd5k6")
text = "宋晚六点四十就走了。U盘交给了沈衡，我妈可以作证我在打电话。"

[sub_resource type="Resource" id="Resource_fiyql"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 777.303
duration = 4.72
stream = ExtResource("145_ddjcj")
text = "我补充一句。刘远进总经理室的时候，人已经死了。"

[sub_resource type="Resource" id="Resource_wcxk2"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 782.423
duration = 5.76
stream = ExtResource("146_om6mv")
text = "那你在里面待了多久？茶水间到总经理室，用不了这么久。"

[sub_resource type="Resource" id="Resource_n8fii"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 788.583
duration = 3.48
stream = ExtResource("147_bqruj")
text = "（低声）我换了合同。高价报价抽走了。人不是我动的。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_p3ad7"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 792.463
duration = 6.72
stream = ExtResource("148_oodcw")
text = "刘远你刚才说没进过。小唐在前台看不见档案室，但听得见你承不承认。"

[sub_resource type="Resource" id="Resource_gbj7d"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 799.583
duration = 5.12
stream = ExtResource("149_com5k")
text = "承认换合同。不承认杀人。周启明要再吞我五十万。"

[sub_resource type="Resource" id="Resource_3wumm"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 805.103
duration = 6.6
stream = ExtResource("150_yi6xy")
text = "高序的动机你们可以查。晋升推荐信在周启明抽屉里，我要他活着。"

[sub_resource type="Resource" id="Resource_yq0ne"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 812.103
duration = 4.92
stream = ExtResource("151_b6gcq")
text = "推荐信说明不了刀和镇纸。沈衡也可以说自己要他活着。"

[sub_resource type="Resource" id="Resource_7oldu"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 817.423
duration = 5.76
stream = ExtResource("152_r3lrt")
text = "镇纸平时在总经理室左手。小唐送水时看见过，今晚它在地上。"

[sub_resource type="Resource" id="Resource_j1fyh"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 823.583
duration = 5.32
stream = ExtResource("153_pcgw0")
text = "我再去机房。通气会的录音如果存在共享盘，就能对上时间。"

[sub_resource type="Resource" id="Resource_7ifxw"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 837.86
duration = 6.92
stream = ExtResource("154_th604")
text = "共享盘里有一条，文件名是沈衡下午传的。时长不到一分钟。"

[sub_resource type="Resource" id="Resource_4dygg"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 845.18
duration = 4.84
stream = ExtResource("155_ddirp")
text = "内容就是那句。本季度宏远的账，经得起任何对质。"

[sub_resource type="Resource" id="Resource_s15d8"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 858.674
duration = 5.44
stream = ExtResource("156_6ufyb")
text = "高序，从一分钟之后，线上放的是不是就是这个文件在循环？"

[sub_resource type="Resource" id="Resource_2kcrd"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 864.514
duration = 4.96
stream = ExtResource("157_gjuhu")
text = "是。沈衡人离开副总室之后，声音还在会议室里响。"

[sub_resource type="Resource" id="Resource_fk604"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 869.874
duration = 6.12
stream = ExtResource("158_1cyhm")
text = "沈衡又往副总室去了。宋晚的U盘要是在抽屉里，他现在就想毁。"

[sub_resource type="Resource" id="Resource_1ai6k"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 876.394
duration = 3.88
stream = ExtResource("159_eqlvg")
text = "刘远留在会议室。合同的事我说完了，不再跑第二趟。"

[sub_resource type="Resource" id="Resource_puj2h"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 880.674
duration = 3.4
stream = ExtResource("160_hkayj")
text = "（低声）手机还在。删掉这条，就剩他们的嘴。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_g42p6"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 884.474
duration = 4.32
stream = ExtResource("161_hax3x")
text = "小唐跟着去。前台的人走了，登记簿也不能没人看着。"

[sub_resource type="Resource" id="Resource_d737e"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 889.194
duration = 3.36
stream = ExtResource("162_c66sv")
text = "高序也去。机房的拷贝别只留在他嘴里。"

[sub_resource type="Resource" id="Resource_00cd6"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 895.812
duration = 3.8
stream = ExtResource("163_x8b2u")
text = "沈衡，手离开手机。小唐看见你要删什么了。"

[sub_resource type="Resource" id="Resource_t8x4e"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 900.012
duration = 4.96
stream = ExtResource("164_avyl3")
text = "我在会议室等着。谁再改口，刘远就把时间线再说一遍。"

[sub_resource type="Resource" id="Resource_ylcgx"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 912.06
duration = 6.12
stream = ExtResource("165_6cotd")
text = "不用删。机房那边已经拷下来了。高序对过开场白，一字不差。"

[sub_resource type="Resource" id="Resource_tkdac"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 918.58
duration = 4.68
stream = ExtResource("166_xkqo2")
text = "周启明要在通气会上毁掉宋晚，也毁掉我。我只是去谈。"

[sub_resource type="Resource" id="Resource_jadc0"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 923.66
duration = 5.12
stream = ExtResource("167_sfytc")
text = "谈不用带美工刀。刀是你中午领的，人是你走进去的。"

[sub_resource type="Resource" id="Resource_w0a4h"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 929.18
duration = 7.04
stream = ExtResource("168_2vy40")
text = "石头镇纸砸倒他，刀是后来的。周启明喊的那个名字，就是沈衡。"

[sub_resource type="Resource" id="Resource_tv7wb"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 940.998
duration = 6.24
stream = ExtResource("169_b7tqv")
text = "合同我放回档案室了。刘远愿意把高价原件交出来，换我不被当成凶手。"

[sub_resource type="Resource" id="Resource_arojy"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 947.638
duration = 6.2
stream = ExtResource("170_yhxg3")
text = "宋晚的U盘呢？沈衡，你要是还想拿它去要挟谁，现在交出来。"

[sub_resource type="Resource" id="Resource_vhv8h"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 954.238
duration = 6.88
stream = ExtResource("171_rlsas")
text = "在副总室抽屉里。受贿的日期都在，可那只能证明周启明脏，不能证明我干净。"

[sub_resource type="Resource" id="Resource_d2d8q"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 961.518
duration = 5.84
stream = ExtResource("172_fh8ko")
text = "干净不干净，前台的登记簿写得清楚。宋晚走了，沈衡没走。"

[sub_resource type="Resource" id="Resource_v8umy"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 967.758
duration = 7.0
stream = ExtResource("173_4nqlb")
text = "通气会可以散了。把录音、美工刀的领用单、还有这块镇纸，一起留下。"

[sub_resource type="Resource" id="Resource_s7r01"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 975.158
duration = 6.64
stream = ExtResource("174_lp2us")
text = "我把时间再说一遍。进门、上副总室、下前台、上休息室，都在死人之前。"

[sub_resource type="Resource" id="Resource_x14bx"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 982.198
duration = 6.96
stream = ExtResource("175_qyufw")
text = "前台登记有四行。到达、离开、上二层、再也没下来。小唐可以抄。"

[sub_resource type="Resource" id="Resource_c7owc"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 989.558
duration = 5.76
stream = ExtResource("176_8nory")
text = "刘远的电话从茶水间打出，公司总机有记录。换合同是后来的事。"

[sub_resource type="Resource" id="Resource_fgq6i"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 995.718
duration = 8.36
stream = ExtResource("177_h08yd")
text = "推荐信抬头是高序。周启明签了名，日期是今天上午。他死了，信也废了。"

[sub_resource type="Resource" id="Resource_51kl7"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 1004.478
duration = 5.12
stream = ExtResource("178_06rql")
text = "所以高序会恨他临时变卦？推荐信可以重写，命不行。"

[sub_resource type="Resource" id="Resource_otoik"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 1009.998
duration = 6.68
stream = ExtResource("179_ek6i4")
text = "我恨变卦。可我要他活着把信交到董事会。死人不会推荐任何人。"

[sub_resource type="Resource" id="Resource_0ifb0"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 1017.078
duration = 5.48
stream = ExtResource("180_qo26x")
text = "美工刀、手机、镇纸、循环的开场白。四样都指向沈衡。"

[sub_resource type="Resource" id="Resource_1vm57"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 1022.958
duration = 4.36
stream = ExtResource("181_5ttec")
text = "高价原件在档案室柜子第二层。刘远这次不改口。"

[sub_resource type="Resource" id="Resource_lc5ri"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 1027.718
duration = 5.56
stream = ExtResource("182_b8tj8")
text = "宋晚只求把回扣交给该管的人。婚外情的照片，随它去。"

[sub_resource type="Resource" id="Resource_s54cm"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 1033.678
duration = 6.72
stream = ExtResource("183_pou7t")
text = "照片在周启明左手抽屉，和镇纸一边。沈衡进门就能看见。"

[sub_resource type="Resource" id="Resource_wq38f"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 1040.798
duration = 3.44
stream = ExtResource("184_4fher")
text = "看见又怎样。我去谈条件，不是去送死。"

[sub_resource type="Resource" id="Resource_bsrl4"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 1044.638
duration = 5.8
stream = ExtResource("185_r5b7l")
text = "死的是周启明。刀口在颈上。小唐没进门，高序看见了。"

[sub_resource type="Resource" id="Resource_p03mk"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 1050.838
duration = 7.44
stream = ExtResource("186_svtbu")
text = "看见了。石头镇纸上有血。会议室里那段循环，我已经拷进机房。"

[sub_resource type="Resource" id="Resource_ve5lc"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 1058.678
duration = 5.84
stream = ExtResource("187_0d802")
text = "到此为止。前台的门我锁上，谁也别再改今晚的登记簿。"

[sub_resource type="Resource" id="Resource_2i2u8"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 1064.918
duration = 6.88
stream = ExtResource("188_vj0ne")
text = "高序把抽屉里的U盘也封上。日期和金额，跟刘远说的五十万对得上。"

[sub_resource type="Resource" id="Resource_wlca6"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 1072.198
duration = 5.2
stream = ExtResource("189_mqfgn")
text = "对得上又怎样。沈衡拿到U盘，是宋晚塞过来的，不是我去偷的。"

[sub_resource type="Resource" id="Resource_kk15m"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 1077.798
duration = 6.36
stream = ExtResource("190_xrhr4")
text = "小唐不管你怎么拿到。美工刀的领用，比通气会早了整整一个中午。"

[sub_resource type="Resource" id="Resource_rneu0"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 1084.558
duration = 5.16
stream = ExtResource("191_i248g")
text = "宋晚再补一句。我进副总室的时候，沈衡还没开始录音。"

[sub_resource type="Resource" id="Resource_wsbwa"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 1090.118
duration = 5.2
stream = ExtResource("192_a4x6n")
text = "我下楼之后才听见开场白在循环。人已经不在那间屋里。"

[sub_resource type="Resource" id="Resource_kb7oj"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 1095.718
duration = 6.52
stream = ExtResource("193_ml5m1")
text = "刘远在档案室把高价原件装袋。低价那份我塞回去过，现在一并交出。"

[sub_resource type="Resource" id="Resource_xawjm"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 1102.638
duration = 7.48
stream = ExtResource("194_l21xu")
text = "两份都要。高序看着沈衡，小唐看着手机，谁也别再按删除。"

[sub_resource type="Resource" id="Resource_6ac5d"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 1110.518
duration = 5.52
stream = ExtResource("195_qow0s")
text = "手机屏幕还亮着。播放停在“经得起任何对质”那句的末尾。"

[sub_resource type="Resource" id="Resource_ryrc3"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 1116.438
duration = 5.6
stream = ExtResource("196_140r0")
text = "停在末尾，是因为我回来按掉了。之前一直在放，不能说明人在屋里。"

[sub_resource type="Resource" id="Resource_npyx8"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 1122.438
duration = 6.56
stream = ExtResource("197_odh5o")
text = "不能。高序问你的时候你没有答，开场白却又从头来了一遍。"

[sub_resource type="Resource" id="Resource_7l1ej"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 1129.398
duration = 6.32
stream = ExtResource("198_f5idx")
text = "一层走廊里，小唐看见你进了总经理室。时间对得上那两秒静音。"

[sub_resource type="Resource" id="Resource_vaqu3"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 1136.118
duration = 6.36
stream = ExtResource("199_3f217")
text = "休息室的电话没断。宋晚要是下过楼，楼梯的声音小唐听得见。"

[sub_resource type="Resource" id="Resource_fo0r1"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 1142.878
duration = 6.08
stream = ExtResource("200_g74gd")
text = "茶水间的电话也没断。我进总经理室时，镇纸在地上，人已经没有气。"

[sub_resource type="Resource" id="Resource_3655t"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 1149.358
duration = 8.48
stream = ExtResource("201_f40ol")
text = "所以换合同是事后。杀人是通气会中途，沈衡离开副总室那几分钟。"

[sub_resource type="Resource" id="Resource_tpp2w"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 1158.238
duration = 7.48
stream = ExtResource("202_cq2w3")
text = "登记簿、领用单、手机、镇纸、循环的开场白。五样都留在公司。"

[sub_resource type="Resource" id="Resource_ts8dw"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 1166.118
duration = 5.32
stream = ExtResource("203_8cgog")
text = "五样都留着。沈衡不再碰。周启明要毁的是宋晚，我只是先动了手。"

[sub_resource type="Resource" id="Resource_n80w1"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 1171.838
duration = 5.84
stream = ExtResource("204_gwnkd")
text = "先动了手这句，宋晚听见了。U盘你交出来，剩下的我不再替你圆。"

[sub_resource type="Resource" id="Resource_eqydu"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 1178.078
duration = 4.88
stream = ExtResource("205_khage")
text = "刘远也不圆。高价合同在档案室这个袋子里，谁来取都行。"

[sub_resource type="Resource" id="Resource_txovl"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 1183.358
duration = 5.2
stream = ExtResource("206_4kvt8")
text = "高序去取。推荐信废了就废了，我不要一份用命换来的晋升。"

[sub_resource type="Resource" id="Resource_o36v0"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 1188.958
duration = 4.72
stream = ExtResource("207_syalt")
text = "小唐把前台反锁。今晚进出的名字，就停在这一页。"

[sub_resource type="Resource" id="Resource_bb73n"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 1194.078
duration = 7.72
stream = ExtResource("208_wfa3u")
text = "我再对一遍。录音开始时沈衡还在副总室，这句小唐听见了。"

[sub_resource type="Resource" id="Resource_hjr1b"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 1202.198
duration = 4.68
stream = ExtResource("209_qlb0s")
text = "听见了。后来声音还在，人已经在一层走廊，朝着总经理室。"

[sub_resource type="Resource" id="Resource_whh7j"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 1207.278
duration = 3.4
stream = ExtResource("210_yhvcw")
text = "走廊很短。我去拿材料，来回用不了多久。"

[sub_resource type="Resource" id="Resource_ebnp1"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 1211.078
duration = 6.48
stream = ExtResource("211_jv0ox")
text = "来回用了多久，线上有空白。空白只有两秒，然后开场白复位。"

[sub_resource type="Resource" id="Resource_mqwjg"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 1217.958
duration = 5.92
stream = ExtResource("212_374h2")
text = "那两秒里周启明在喊沈衡。会议室听得见闷响，休息室听不全。"

[sub_resource type="Resource" id="Resource_jbsue"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 1224.278
duration = 5.72
stream = ExtResource("213_7eaxm")
text = "刘远当时在茶水间，闷响也听见了。我没有立刻过去，是在等电话。"

[sub_resource type="Resource" id="Resource_54yms"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 1230.398
duration = 4.64
stream = ExtResource("214_8l1ol")
text = "等电话可以。等完换合同，小唐不替你瞒，但那不是刀。"

[sub_resource type="Resource" id="Resource_5ua28"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 1235.438
duration = 4.96
stream = ExtResource("215_asgra")
text = "刀在沈衡中午的领用单上。总经理室地上没有第二把。"

[sub_resource type="Resource" id="Resource_qfagu"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 1240.798
duration = 4.28
stream = ExtResource("216_q4nr4")
text = "没有第二把。盒子里原来就这一把，是我带进去的。"

[sub_resource type="Resource" id="Resource_chxh8"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 1245.478
duration = 4.72
stream = ExtResource("217_uwycn")
text = "宋晚没有见过那把刀。我离开时，桌上只有手机和U盘。"

[sub_resource type="Resource" id="Resource_88cdn"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 1250.598
duration = 5.32
stream = ExtResource("218_aik4x")
text = "我进门看见镇纸和血，没有看见刀。刀也许被带走了。"

[sub_resource type="Resource" id="Resource_t6sva"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 1256.318
duration = 6.4
stream = ExtResource("219_wgb7t")
text = "带走了也记在沈衡名下。前台的笔是我的，时间是我写的。"

[sub_resource type="Resource" id="Resource_0ahqb"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 1263.118
duration = 6.04
stream = ExtResource("220_ka3x0")
text = "高序把共享盘的文件再拷一份。循环的句子，一个字都不差。"

[sub_resource type="Resource" id="Resource_6aih6"]
script = ExtResource("7_g115r")
speaker = &"B"
start = 1269.558
duration = 5.08
stream = ExtResource("221_6utcq")
text = "一个字都不差，因为就是我录的。我认这句，也认进了那间屋。"

[sub_resource type="Resource" id="Resource_6swqf"]
script = ExtResource("7_g115r")
speaker = &"C"
start = 1275.038
duration = 4.32
stream = ExtResource("222_vck0f")
text = "认了就好。宋晚回休息室等车，不再下楼。"

[sub_resource type="Resource" id="Resource_2767s"]
script = ExtResource("7_g115r")
speaker = &"E"
start = 1279.758
duration = 3.08
stream = ExtResource("223_7pn7t")
text = "刘远留在档案室，把两份合同点清再走。"

[sub_resource type="Resource" id="Resource_am62y"]
script = ExtResource("7_g115r")
speaker = &"F"
start = 1283.238
duration = 5.44
stream = ExtResource("224_8yfa1")
text = "小唐回前台。登记簿合上之前，我再核对宋晚的离开时间。"

[sub_resource type="Resource" id="Resource_pbmt4"]
script = ExtResource("7_g115r")
speaker = &"D"
start = 1289.078
duration = 6.76
stream = ExtResource("225_2a8yf")
text = "核对完，通气会的设备我关掉。线上不该再响起沈衡的声音。"

