[sub_resource type="Resource" id="Resource_a7sjp"]
script = ExtResource("4_smlgh")
id = &"q1"
prompt = "老爷的真正死因是什么？"
options = PackedStringArray("毒酒", "刀伤", "心脏病发作", "窒息")
answer = "毒酒"

[sub_resource type="Resource" id="Resource_q4m27"]
script = ExtResource("4_smlgh")
id = &"q2"
kind = 1
prompt = "谁最有动机杀害老爷？"
options = PackedStringArray("夫人", "侄女", "画家", "厨师")
answer = "夫人"

[sub_resource type="Resource" id="Resource_4bk37"]
script = ExtResource("4_smlgh")
id = &"q3"
prompt = "毒药是在哪个环节被放入的？"
options = PackedStringArray("厨房备餐时", "酒窖取酒时", "餐厅上桌时", "书房谈话时")
answer = "酒窖取酒时"

[sub_resource type="Resource" id="Resource_rh8s0"]
script = ExtResource("4_smlgh")
id = &"q4"
kind = 1
prompt = "夫人的秘密情人是谁？"
options = PackedStringArray("管家", "画家", "医生", "律师")
answer = "画家"

[sub_resource type="Resource" id="Resource_8vcjh"]
script = ExtResource("4_smlgh")
id = &"q5"
kind = 1
prompt = "真正的凶手是谁？"
options = PackedStringArray("夫人", "管家", "侄女", "厨师")
answer = "夫人"

[sub_resource type="Resource" id="Resource_43gbr"]
script = ExtResource("7_2lv3s")
speaker = &"J"
start = 5.0
duration = 4.72
stream = ExtResource("8_2cfua")
text = "（抵达古堡）这里就是传说中的黑石古堡吗？确实很有气氛。"

[sub_resource type="Resource" id="Resource_d65d6"]
script = ExtResource("7_2lv3s")
speaker = &"C"
start = 15.0
duration = 4.28
stream = ExtResource("9_405ut")
text = "欢迎欢迎，侦探先生。老爷已经等候您多时了。"

[sub_resource type="Resource" id="Resource_lrwgy"]
script = ExtResource("7_2lv3s")
speaker = &"A"
start = 25.0
duration = 5.4
stream = ExtResource("10_ihen4")
text = "哦，侦探来了。很好，今晚我希望你能享受到最好的款待。"

[sub_resource type="Resource" id="Resource_g0rtg"]
script = ExtResource("7_2lv3s")
speaker = &"B"
start = 35.0
duration = 2.12
stream = ExtResource("11_mx0la")
text = "（冷冷地）老爷对任何新来的人都这么说。"

[sub_resource type="Resource" id="Resource_tls06"]
script = ExtResource("7_2lv3s")
speaker = &"A"
start = 43.0
duration = 4.12
stream = ExtResource("12_lb5eq")
text = "夫人，今晚是重要的晚宴，希望你能配合一下。"

[sub_resource type="Resource" id="Resource_u1y0a"]
script = ExtResource("7_2lv3s")
speaker = &"H"
start = 52.0
duration = 4.04
stream = ExtResource("13_l0u82")
text = "叔叔好！好久不见，您看起来还是那么精神。"

[sub_resource type="Resource" id="Resource_1pdsg"]
script = ExtResource("7_2lv3s")
speaker = &"E"
start = 65.0
duration = 1.88
stream = ExtResource("14_xrw2d")
text = "（整理餐具）今晚的宴会听说很重要呢。"

[sub_resource type="Resource" id="Resource_j2pad"]
script = ExtResource("7_2lv3s")
speaker = &"C"
start = 74.0
duration = 3.68
stream = ExtResource("15_gexks")
text = "是的，老爷邀请了很多重要客人。你要格外用心。"

[sub_resource type="Resource" id="Resource_gq2uy"]
script = ExtResource("7_2lv3s")
speaker = &"E"
start = 83.0
duration = 6.36
stream = ExtResource("16_qjf3b")
text = "管家先生，老爷和夫人最近是不是吵架了？我看夫人总是闷闷不乐。"

[sub_resource type="Resource" id="Resource_5ynfg"]
script = ExtResource("7_2lv3s")
speaker = &"C"
start = 94.0
duration = 3.64
stream = ExtResource("17_fgq4l")
text = "主人的事不是我们该过问的。专心做好你的工作。"

[sub_resource type="Resource" id="Resource_bll0f"]
script = ExtResource("7_2lv3s")
speaker = &"D"
start = 105.0
duration = 3.6
stream = ExtResource("18_qx37x")
text = "（从厨房出来）哼，那个老头子今晚肯定又要挑三拣四了。"

[sub_resource type="Resource" id="Resource_j31nc"]
script = ExtResource("7_2lv3s")
speaker = &"C"
start = 115.0
duration = 4.4
stream = ExtResource("19_h1uej")
text = "厨师先生，老爷对美食很有研究，请拿出您的看家本领。"

[sub_resource type="Resource" id="Resource_ju8tp"]
script = ExtResource("7_2lv3s")
speaker = &"F"
start = 125.0
duration = 2.6
stream = ExtResource("20_8cf4x")
text = "（翻阅文件）陈老爷的遗嘱问题确实比较复杂。"

[sub_resource type="Resource" id="Resource_nch6p"]
script = ExtResource("7_2lv3s")
speaker = &"A"
start = 135.0
duration = 5.12
stream = ExtResource("21_pfnh1")
text = "律师先生，关于我弟弟的遗产分配问题，我们需要好好谈谈。"

[sub_resource type="Resource" id="Resource_rswed"]
script = ExtResource("7_2lv3s")
speaker = &"G"
start = 147.0
duration = 3.56
stream = ExtResource("22_k4tig")
text = "老陈啊，多少年没见了！身体还好吗？"

[sub_resource type="Resource" id="Resource_iak8a"]
script = ExtResource("7_2lv3s")
speaker = &"A"
start = 156.0
duration = 4.8
stream = ExtResource("23_go6o8")
text = "托你的福，还死不了。倒是你，医学研究做得怎么样了？"

[sub_resource type="Resource" id="Resource_t7xl0"]
script = ExtResource("7_2lv3s")
speaker = &"I"
start = 168.0
duration = 3.92
stream = ExtResource("24_phkmb")
text = "（观察夫人的画像）这幅画真是栩栩如生，老爷收藏了不少好作品。"

[sub_resource type="Resource" id="Resource_8ic56"]
script = ExtResource("7_2lv3s")
speaker = &"B"
start = 179.0
duration = 5.56
stream = ExtResource("25_st4km")
text = "画家先生是吗？您画的人物肖像特别有神韵。"

[sub_resource type="Resource" id="Resource_2f8aa"]
script = ExtResource("7_2lv3s")
speaker = &"D"
start = 185.0
duration = 3.96
stream = ExtResource("26_6tnwj")
text = "今晚的主菜是红酒炖羊排，我已经准备就绪。"

[sub_resource type="Resource" id="Resource_pgtkq"]
script = ExtResource("7_2lv3s")
speaker = &"E"
start = 195.0
duration = 3.32
stream = ExtResource("27_75fir")
text = "厨师先生，需要我帮忙准备什么吗？"

[sub_resource type="Resource" id="Resource_hhsgu"]
script = ExtResource("7_2lv3s")
speaker = &"D"
start = 203.0
duration = 2.92
stream = ExtResource("28_p1wkk")
text = "不用了，你去看看餐厅的布置吧。"

[sub_resource type="Resource" id="Resource_nsi5x"]
script = ExtResource("7_2lv3s")
speaker = &"C"
start = 212.0
duration = 3.28
stream = ExtResource("29_fb00g")
text = "各位客人请移步餐厅，晚宴即将开始。"

[sub_resource type="Resource" id="Resource_r8ff7"]
script = ExtResource("7_2lv3s")
speaker = &"H"
start = 222.0
duration = 3.32
stream = ExtResource("30_lvfpe")
text = "（小声对F）律师，我叔叔的遗产问题，您有多少把握？"
loudness = 0.3

[sub_resource type="Resource" id="Resource_lp5nl"]
script = ExtResource("7_2lv3s")
speaker = &"F"
start = 232.0
duration = 3.84
stream = ExtResource("31_4lw6f")
text = "侄女小姐，这需要看老爷本人的意愿，我们只能执行。"

[sub_resource type="Resource" id="Resource_lksd1"]
script = ExtResource("7_2lv3s")
speaker = &"A"
start = 245.0
duration = 4.56
stream = ExtResource("32_6nam6")
text = "各位来宾，感谢大家拨冗参加今晚的晚宴！"

[sub_resource type="Resource" id="Resource_4frfu"]
script = ExtResource("7_2lv3s")
speaker = &"B"
start = 255.0
duration = 1.28
stream = ExtResource("33_xliwr")
text = "（举杯）祝老爷健康长寿。"

[sub_resource type="Resource" id="Resource_gh2ic"]
script = ExtResource("7_2lv3s")
speaker = &"G"
start = 263.0
duration = 5.04
stream = ExtResource("34_274tc")
text = "老陈，你这古堡虽然偏僻，但酒窖里的藏酒真是不错。"

[sub_resource type="Resource" id="Resource_vmrik"]
script = ExtResource("7_2lv3s")
speaker = &"A"
start = 275.0
duration = 6.92
stream = ExtResource("35_cxd37")
text = "那是当然，我收藏的都是珍品。管家，去取那瓶82年的拉菲来。"

[sub_resource type="Resource" id="Resource_8yulf"]
script = ExtResource("7_2lv3s")
speaker = &"C"
start = 287.0
duration = 1.08
stream = ExtResource("36_uwpfk")
text = "遵命，老爷。（前往酒窖）"

[sub_resource type="Resource" id="Resource_oj5j4"]
script = ExtResource("7_2lv3s")
speaker = &"I"
start = 295.0
duration = 3.44
stream = ExtResource("37_k1yyf")
text = "（观察夫人）夫人的气质真是优雅，很适合做模特。"

[sub_resource type="Resource" id="Resource_22y56"]
script = ExtResource("7_2lv3s")
speaker = &"C"
start = 305.0
duration = 1.92
stream = ExtResource("38_1r0rm")
text = "（取酒回来）老爷，酒来了。"

[sub_resource type="Resource" id="Resource_i3yws"]
script = ExtResource("7_2lv3s")
speaker = &"A"
start = 313.0
duration = 3.88
stream = ExtResource("39_o2e6j")
text = "好，给各位斟上。今晚我们要好好庆祝一番。"

[sub_resource type="Resource" id="Resource_ri1g6"]
script = ExtResource("7_2lv3s")
speaker = &"B"
start = 324.0
duration = 1.24
stream = ExtResource("40_uyyun")
text = "（接过酒杯，掩饰着某种情绪）这酒色泽真美。"

[sub_resource type="Resource" id="Resource_l6ijs"]
script = ExtResource("7_2lv3s")
speaker = &"H"
start = 334.0
duration = 4.0
stream = ExtResource("41_4a6m7")
text = "叔叔，我敬您一杯！祝您事业蒸蒸日上。"

[sub_resource type="Resource" id="Resource_lpxun"]
script = ExtResource("7_2lv3s")
speaker = &"A"
start = 344.0
duration = 4.36
stream = ExtResource("42_vaueh")
text = "好侄女，你有出息。不像某些人，只会花钱。"

[sub_resource type="Resource" id="Resource_iiwxw"]
script = ExtResource("7_2lv3s")
speaker = &"D"
start = 355.0
duration = 2.92
stream = ExtResource("43_1bs5g")
text = "（在厨房）羊排马上就好，请稍等。"

[sub_resource type="Resource" id="Resource_tsuat"]
script = ExtResource("7_2lv3s")
speaker = &"E"
start = 365.0
duration = 1.32
stream = ExtResource("44_n11eo")
text = "（上菜）各位请慢用。"

[sub_resource type="Resource" id="Resource_y0p7r"]
script = ExtResource("7_2lv3s")
speaker = &"A"
start = 373.0
duration = 4.16
stream = ExtResource("45_1gw6o")
text = "（品尝羊排）嗯，味道不错。厨师，你手艺越来越好了。"

[sub_resource type="Resource" id="Resource_cpkdm"]
script = ExtResource("7_2lv3s")
speaker = &"D"
start = 384.0
duration = 1.24
stream = ExtResource("46_khrtn")
text = "多谢老爷夸奖。（松一口气）"

[sub_resource type="Resource" id="Resource_3mhgc"]
script = ExtResource("7_2lv3s")
speaker = &"F"
start = 392.0
duration = 3.8
stream = ExtResource("47_mpwtq")
text = "陈老爷，关于您弟弟的遗产，有几件事需要确认..."

[sub_resource type="Resource" id="Resource_nneco"]
script = ExtResource("7_2lv3s")
speaker = &"A"
start = 403.0
duration = 4.0
stream = ExtResource("48_lll61")
text = "此事不急，今晚是享乐的时候。对吧，夫人？"

[sub_resource type="Resource" id="Resource_ic14i"]
script = ExtResource("7_2lv3s")
speaker = &"B"
start = 414.0
duration = 1.72
stream = ExtResource("49_w8ayq")
text = "（冷笑）老爷说什么就是什么吧。"

[sub_resource type="Resource" id="Resource_i4wk5"]
script = ExtResource("7_2lv3s")
speaker = &"G"
start = 425.0
duration = 3.84
stream = ExtResource("50_ygpv1")
text = "老陈，你脸色有点红，是不是太激动了？"

[sub_resource type="Resource" id="Resource_hbwc4"]
script = ExtResource("7_2lv3s")
speaker = &"A"
start = 435.0
duration = 3.52
stream = ExtResource("51_7oc8d")
text = "可能是酒劲上来了。夫人，再给我倒一杯。"

[sub_resource type="Resource" id="Resource_d6hvw"]
script = ExtResource("7_2lv3s")
speaker = &"B"
start = 446.0
duration = 2.84
stream = ExtResource("52_hpqbo")
text = "（倒酒）老爷还是少喝点吧，对身体不好。"

[sub_resource type="Resource" id="Resource_oju6e"]
script = ExtResource("7_2lv3s")
speaker = &"I"
start = 456.0
duration = 2.08
stream = ExtResource("53_jmphf")
text = "（注意着夫人和老爷的互动）这两人之间似乎有些微妙。"

[sub_resource type="Resource" id="Resource_iey1n"]
script = ExtResource("7_2lv3s")
speaker = &"H"
start = 467.0
duration = 2.32
stream = ExtResource("54_aja7u")
text = "（不耐烦地）叔叔，我有事想和您单独谈谈。"

[sub_resource type="Resource" id="Resource_vfe63"]
script = ExtResource("7_2lv3s")
speaker = &"A"
start = 477.0
duration = 4.56
stream = ExtResource("55_0vfb1")
text = "有什么事等晚宴结束后再说。现在不要打扰大家。"

[sub_resource type="Resource" id="Resource_my0qu"]
script = ExtResource("7_2lv3s")
speaker = &"A"
start = 485.0
duration = 1.56
stream = ExtResource("56_q6smp")
text = "（突然捂住胸口）这...这酒有问题..."

[sub_resource type="Resource" id="Resource_rpfq6"]
script = ExtResource("7_2lv3s")
speaker = &"B"
start = 494.0
duration = 1.64
stream = ExtResource("57_4br0h")
text = "（惊慌）老爷！您怎么了？"

[sub_resource type="Resource" id="Resource_i1wo2"]
script = ExtResource("7_2lv3s")
speaker = &"G"
start = 501.0
duration = 3.16
stream = ExtResource("58_qx5cu")
text = "（起身查看）让我看看！这是...中毒症状！"

[sub_resource type="Resource" id="Resource_figgd"]
script = ExtResource("7_2lv3s")
speaker = &"C"
start = 510.0
duration = 2.08
stream = ExtResource("59_qufe5")
text = "什么？！中毒？快叫救护车！"

[sub_resource type="Resource" id="Resource_23hvd"]
script = ExtResource("7_2lv3s")
speaker = &"A"
start = 518.0
duration = 1.8
stream = ExtResource("60_e21hy")
text = "（艰难地）酒...酒里有...（倒下）"

[sub_resource type="Resource" id="Resource_lkgc1"]
script = ExtResource("7_2lv3s")
speaker = &"D"
start = 528.0
duration = 3.72
stream = ExtResource("61_g675x")
text = "（惊恐）不可能！我亲手做的菜，不可能有毒！"

[sub_resource type="Resource" id="Resource_7d531"]
script = ExtResource("7_2lv3s")
speaker = &"E"
start = 540.0
duration = 1.48
stream = ExtResource("62_2hibg")
text = "（尖叫）老爷！老爷！"
loudness = 0.9

[sub_resource type="Resource" id="Resource_qswxq"]
script = ExtResource("7_2lv3s")
speaker = &"F"
start = 547.0
duration = 2.48
stream = ExtResource("63_dcufv")
text = "大家冷静！让我检查一下那瓶酒！"

[sub_resource type="Resource" id="Resource_r13r5"]
script = ExtResource("7_2lv3s")
speaker = &"C"
start = 555.0
duration = 3.44
stream = ExtResource("64_qs2nx")
text = "（检查酒瓶）这...这酒瓶被人动过手脚！"

[sub_resource type="Resource" id="Resource_u5npi"]
script = ExtResource("7_2lv3s")
speaker = &"B"
start = 565.0
duration = 1.96
stream = ExtResource("65_d81qw")
text = "（脸色苍白）不可能...这酒是我倒的啊..."

[sub_resource type="Resource" id="Resource_v2oh0"]
script = ExtResource("7_2lv3s")
speaker = &"J"
start = 575.0
duration = 4.84
stream = ExtResource("66_2gmrr")
text = "所有人都别动！在警方到达之前，任何人不得离开！"

[sub_resource type="Resource" id="Resource_kjvu0"]
script = ExtResource("7_2lv3s")
speaker = &"H"
start = 586.0
duration = 1.88
stream = ExtResource("67_1otx1")
text = "（慌张）怎么会...叔叔怎么会..."

[sub_resource type="Resource" id="Resource_3d3v0"]
script = ExtResource("7_2lv3s")
speaker = &"G"
start = 605.0
duration = 6.8
stream = ExtResource("68_nhmw8")
text = "（检查尸体）已经...已经没有脉搏了。老陈...老朋友..."

[sub_resource type="Resource" id="Resource_22272"]
script = ExtResource("7_2lv3s")
speaker = &"B"
start = 617.0
duration = 2.4
stream = ExtResource("69_qq34s")
text = "（哭泣）老爷！您不能这样就走啊！"

[sub_resource type="Resource" id="Resource_emghq"]
script = ExtResource("7_2lv3s")
speaker = &"I"
start = 626.0
duration = 3.48
stream = ExtResource("70_02bju")
text = "（冷静观察）夫人的反应很奇怪...为什么她这么紧张？"

[sub_resource type="Resource" id="Resource_2g684"]
script = ExtResource("7_2lv3s")
speaker = &"C"
start = 637.0
duration = 4.32
stream = ExtResource("71_ase2o")
text = "侦探先生，我刚才去酒窖取酒时，酒瓶还是完好的。"

[sub_resource type="Resource" id="Resource_m1xj1"]
script = ExtResource("7_2lv3s")
speaker = &"E"
start = 648.0
duration = 4.0
stream = ExtResource("72_eflrk")
text = "我...我一直在餐厅帮忙，没有接近过酒瓶..."

[sub_resource type="Resource" id="Resource_qho7b"]
script = ExtResource("7_2lv3s")
speaker = &"D"
start = 657.0
duration = 3.16
stream = ExtResource("73_6d7en")
text = "我的菜绝对没有问题！谁敢冤枉我！"

[sub_resource type="Resource" id="Resource_g1lqm"]
script = ExtResource("7_2lv3s")
speaker = &"F"
start = 665.0
duration = 4.36
stream = ExtResource("74_yq4vk")
text = "让我想想...从酒窖到餐桌，谁有机会接触这瓶酒？"

[sub_resource type="Resource" id="Resource_3vf0f"]
script = ExtResource("7_2lv3s")
speaker = &"H"
start = 676.0
duration = 3.16
stream = ExtResource("75_xwaxk")
text = "（指着一仆人）是你！一定是你下的毒！"

[sub_resource type="Resource" id="Resource_jq7kq"]
script = ExtResource("7_2lv3s")
speaker = &"C"
start = 685.0
duration = 5.28
stream = ExtResource("76_v5mc3")
text = "请不要随意指控。事发时，每个人都有不在场证明。"

[sub_resource type="Resource" id="Resource_2ke16"]
script = ExtResource("7_2lv3s")
speaker = &"B"
start = 696.0
duration = 1.76
stream = ExtResource("77_3tf6w")
text = "（突然）我有事先离开一下...（起身要走）"

[sub_resource type="Resource" id="Resource_oacft"]
script = ExtResource("7_2lv3s")
speaker = &"J"
start = 705.0
duration = 4.52
stream = ExtResource("78_lf873")
text = "夫人，请留步。在查清真相之前，所有人都不能离开。"

[sub_resource type="Resource" id="Resource_ftqok"]
script = ExtResource("7_2lv3s")
speaker = &"I"
start = 717.0
duration = 3.32
stream = ExtResource("79_y7e7n")
text = "（轻声）夫人，您没事吧？您看起来很不安..."

[sub_resource type="Resource" id="Resource_djpru"]
script = ExtResource("7_2lv3s")
speaker = &"B"
start = 725.0
duration = 3.68
stream = ExtResource("80_bc75t")
text = "（崩溃）我...我只是...那瓶酒..."

[sub_resource type="Resource" id="Resource_kn6pv"]
script = ExtResource("7_2lv3s")
speaker = &"C"
start = 734.0
duration = 1.96
stream = ExtResource("81_jk3gw")
text = "夫人，请您解释清楚。"

[sub_resource type="Resource" id="Resource_ftwk4"]
script = ExtResource("7_2lv3s")
speaker = &"G"
start = 741.0
duration = 5.2
stream = ExtResource("82_61exg")
text = "根据我的判断，毒药是在酒窖中被投入的，而非餐桌上。"

[sub_resource type="Resource" id="Resource_8thsm"]
script = ExtResource("7_2lv3s")
speaker = &"F"
start = 753.0
duration = 4.32
stream = ExtResource("83_doum7")
text = "什么？！那管家先生，您确定酒瓶在酒窖中是完好的吗？"

[sub_resource type="Resource" id="Resource_4th2x"]
script = ExtResource("7_2lv3s")
speaker = &"C"
start = 764.0
duration = 3.84
stream = ExtResource("84_w6c43")
text = "我...我去酒窖时，瓶子确实没有开封的痕迹。"

[sub_resource type="Resource" id="Resource_bvb3n"]
script = ExtResource("7_2lv3s")
speaker = &"I"
start = 775.0
duration = 2.96
stream = ExtResource("85_f8jqm")
text = "那在这段时间里，谁有机会进入酒窖？"

[sub_resource type="Resource" id="Resource_a4nsr"]
script = ExtResource("7_2lv3s")
speaker = &"E"
start = 785.0
duration = 3.44
stream = ExtResource("86_u3weu")
text = "（小声）我...我看到夫人去过酒窖那边..."
loudness = 0.3

[sub_resource type="Resource" id="Resource_fm36q"]
script = ExtResource("7_2lv3s")
speaker = &"B"
start = 795.0
duration = 3.36
stream = ExtResource("87_08pnf")
text = "（惊恐）你胡说什么！我没有！"

[sub_resource type="Resource" id="Resource_d0e6r"]
script = ExtResource("7_2lv3s")
speaker = &"J"
start = 802.0
duration = 2.68
stream = ExtResource("88_4310k")
text = "女仆小姐，你确定你看到的是夫人吗？"

[sub_resource type="Resource" id="Resource_8a6iw"]
script = ExtResource("7_2lv3s")
speaker = &"E"
start = 811.0
duration = 3.6
stream = ExtResource("89_m6op0")
text = "我...我确定...夫人穿着那件紫色礼服..."

[sub_resource type="Resource" id="Resource_h6ffr"]
script = ExtResource("7_2lv3s")
speaker = &"H"
start = 821.0
duration = 2.48
stream = ExtResource("90_draya")
text = "（突然）够了！我不想再听这些谎话了！"

[sub_resource type="Resource" id="Resource_5w4p5"]
script = ExtResource("7_2lv3s")
speaker = &"G"
start = 830.0
duration = 5.52
stream = ExtResource("91_m8040")
text = "等等...我刚才检查了酒杯，发现里面有异常的残留物..."

[sub_resource type="Resource" id="Resource_uof4l"]
script = ExtResource("7_2lv3s")
speaker = &"C"
start = 845.0
duration = 2.0
stream = ExtResource("92_c37hn")
text = "医生，您发现了什么？"

[sub_resource type="Resource" id="Resource_bv3qe"]
script = ExtResource("7_2lv3s")
speaker = &"G"
start = 852.0
duration = 3.88
stream = ExtResource("93_hk0h5")
text = "这不是普通的毒药...是一种非常罕见的毒素。"

[sub_resource type="Resource" id="Resource_4uaoa"]
script = ExtResource("7_2lv3s")
speaker = &"B"
start = 862.0
duration = 2.72
stream = ExtResource("94_eeqqp")
text = "（脸色惨白）我...我需要坦白一些事..."

[sub_resource type="Resource" id="Resource_h55v2"]
script = ExtResource("7_2lv3s")
speaker = &"I"
start = 871.0
duration = 2.2
stream = ExtResource("95_3wcwk")
text = "（紧张）夫人，请三思..."

[sub_resource type="Resource" id="Resource_cquwl"]
script = ExtResource("7_2lv3s")
speaker = &"J"
start = 878.0
duration = 3.0
stream = ExtResource("96_xijxx")
text = "夫人，如果您知道什么，请现在说出来。"

[sub_resource type="Resource" id="Resource_sje6c"]
script = ExtResource("7_2lv3s")
speaker = &"B"
start = 888.0
duration = 3.92
stream = ExtResource("97_c5mv6")
text = "那瓶酒...是我从老爷的酒窖私人收藏中挑选的..."

[sub_resource type="Resource" id="Resource_4yuc7"]
script = ExtResource("7_2lv3s")
speaker = &"F"
start = 905.0
duration = 2.96
stream = ExtResource("98_u2fn5")
text = "什么？！您亲自挑选的？那酒窖的钥匙..."

[sub_resource type="Resource" id="Resource_laidi"]
script = ExtResource("7_2lv3s")
speaker = &"C"
start = 915.0
duration = 3.0
stream = ExtResource("99_e811w")
text = "（警觉）等等...我取酒时，钥匙还在我身上..."

[sub_resource type="Resource" id="Resource_5n1hx"]
script = ExtResource("7_2lv3s")
speaker = &"B"
start = 925.0
duration = 2.12
stream = ExtResource("100_574qn")
text = "（深吸一口气）是的...是我和画家一起..."

[sub_resource type="Resource" id="Resource_jh5mi"]
script = ExtResource("7_2lv3s")
speaker = &"I"
start = 935.0
duration = 2.04
stream = ExtResource("101_2wxt6")
text = "（震惊）夫人！您怎么能..."

[sub_resource type="Resource" id="Resource_260wj"]
script = ExtResource("7_2lv3s")
speaker = &"H"
start = 942.0
duration = 2.96
stream = ExtResource("102_egitu")
text = "什么？！你们两个...叔叔早就知道了！"

[sub_resource type="Resource" id="Resource_ojs6x"]
script = ExtResource("7_2lv3s")
speaker = &"J"
start = 951.0
duration = 3.6
stream = ExtResource("103_p0mmh")
text = "所以是夫人和画家先生合谋...但是，为什么？"

[sub_resource type="Resource" id="Resource_t720s"]
script = ExtResource("7_2lv3s")
speaker = &"B"
start = 965.0
duration = 4.2
stream = ExtResource("104_ub3f8")
text = "（冷笑）为什么？因为我受够了这个暴君！"

[sub_resource type="Resource" id="Resource_s5d3x"]
script = ExtResource("7_2lv3s")
speaker = &"I"
start = 975.0
duration = 4.36
stream = ExtResource("105_y7weh")
text = "（痛苦）夫人...对不起...是我连累了您..."

[sub_resource type="Resource" id="Resource_nn8no"]
script = ExtResource("7_2lv3s")
speaker = &"B"
start = 985.0
duration = 4.16
stream = ExtResource("106_kc2ae")
text = "不...是我自己的选择。他囚禁了我二十年！"

[sub_resource type="Resource" id="Resource_rosg8"]
script = ExtResource("7_2lv3s")
speaker = &"G"
start = 995.0
duration = 3.72
stream = ExtResource("107_8f4pk")
text = "所以您在他酒里下了毒？是什么毒？"

[sub_resource type="Resource" id="Resource_4wpdk"]
script = ExtResource("7_2lv3s")
speaker = &"B"
start = 1004.0
duration = 3.36
stream = ExtResource("108_ktpco")
text = "（平静）是一种从植物中提取的毒素，发作缓慢。"

[sub_resource type="Resource" id="Resource_mdc6v"]
script = ExtResource("7_2lv3s")
speaker = &"D"
start = 1015.0
duration = 3.28
stream = ExtResource("109_1ri7t")
text = "所以我的菜没有问题！我就说嘛！"

[sub_resource type="Resource" id="Resource_p25g0"]
script = ExtResource("7_2lv3s")
speaker = &"C"
start = 1025.0
duration = 3.6
stream = ExtResource("110_sokef")
text = "（震惊）夫人...我一直以为您是真心爱老爷的..."

[sub_resource type="Resource" id="Resource_patrf"]
script = ExtResource("7_2lv3s")
speaker = &"B"
start = 1035.0
duration = 4.36
stream = ExtResource("111_ql0n4")
text = "爱？我早就没有了。当年是被迫嫁进来的。"

[sub_resource type="Resource" id="Resource_ooo8f"]
script = ExtResource("7_2lv3s")
speaker = &"H"
start = 1045.0
duration = 3.56
stream = ExtResource("112_qa1ho")
text = "所以叔叔的遗产...反正我也没份了是吧？"

[sub_resource type="Resource" id="Resource_cfuof"]
script = ExtResource("7_2lv3s")
speaker = &"F"
start = 1055.0
duration = 4.04
stream = ExtResource("113_4k35l")
text = "根据老爷最新的遗嘱，所有财产将捐给慈善机构。"

[sub_resource type="Resource" id="Resource_r3far"]
script = ExtResource("7_2lv3s")
speaker = &"E"
start = 1066.0
duration = 4.72
stream = ExtResource("114_eypl8")
text = "那...那凶手冒着风险杀人，结果什么都没有得到？"

[sub_resource type="Resource" id="Resource_j2j0a"]
script = ExtResource("7_2lv3s")
speaker = &"J"
start = 1077.0
duration = 3.4
stream = ExtResource("115_j0y1l")
text = "但凶手的目标可能不是财产...而是复仇。"

[sub_resource type="Resource" id="Resource_8j26g"]
script = ExtResource("7_2lv3s")
speaker = &"I"
start = 1085.0
duration = 2.72
stream = ExtResource("116_bj1dv")
text = "（深吸一口气）够了...不要再说了...是我下的毒。"

[sub_resource type="Resource" id="Resource_s5yrb"]
script = ExtResource("7_2lv3s")
speaker = &"B"
start = 1096.0
duration = 2.68
stream = ExtResource("117_k3uq8")
text = "（惊呼）不！画家，你不能..."

[sub_resource type="Resource" id="Resource_681ki"]
script = ExtResource("7_2lv3s")
speaker = &"I"
start = 1104.0
duration = 4.4
stream = ExtResource("118_bk4ub")
text = "夫人，这一切都是我的错。老爷发现了我们的关系..."

[sub_resource type="Resource" id="Resource_he4dd"]
script = ExtResource("7_2lv3s")
speaker = &"C"
start = 1116.0
duration = 2.08
stream = ExtResource("119_i6m48")
text = "什么？！你们...你们..."

[sub_resource type="Resource" id="Resource_a52yf"]
script = ExtResource("7_2lv3s")
speaker = &"I"
start = 1123.0
duration = 4.52
stream = ExtResource("120_g8o44")
text = "老爷威胁要毁掉夫人的名誉。我...我没有选择。"

[sub_resource type="Resource" id="Resource_n614t"]
script = ExtResource("7_2lv3s")
speaker = &"J"
start = 1135.0
duration = 2.52
stream = ExtResource("121_6x6ne")
text = "所以你就杀了他？用毒药？"

[sub_resource type="Resource" id="Resource_xk616"]
script = ExtResource("7_2lv3s")
speaker = &"I"
start = 1145.0
duration = 3.96
stream = ExtResource("122_kv6p0")
text = "是的。我在夫人不知情的情况下，在酒里下了毒。"

[sub_resource type="Resource" id="Resource_4gkdl"]
script = ExtResource("7_2lv3s")
speaker = &"B"
start = 1156.0
duration = 2.88
stream = ExtResource("123_1r4r1")
text = "（哭泣）不...你不是说他会慢慢好起来的吗..."

[sub_resource type="Resource" id="Resource_3lg87"]
script = ExtResource("7_2lv3s")
speaker = &"I"
start = 1166.0
duration = 3.12
stream = ExtResource("124_0bqth")
text = "我...我骗了您。我只想让他消失..."

[sub_resource type="Resource" id="Resource_ebxwy"]
script = ExtResource("7_2lv3s")
speaker = &"G"
start = 1175.0
duration = 4.8
stream = ExtResource("125_vm2eo")
text = "所以毒药是画家下的...但夫人的指纹一定还在酒瓶上。"

[sub_resource type="Resource" id="Resource_0w3tw"]
script = ExtResource("7_2lv3s")
speaker = &"F"
start = 1187.0
duration = 3.04
stream = ExtResource("126_s5b1l")
text = "这意味着夫人是共犯，而不是主谋。"

[sub_resource type="Resource" id="Resource_lnq38"]
script = ExtResource("7_2lv3s")
speaker = &"J"
start = 1196.0
duration = 3.4
stream = ExtResource("127_skcpv")
text = "两位，很抱歉，我需要以谋杀罪的罪名逮捕你们。"

[sub_resource type="Resource" id="Resource_7seim"]
script = ExtResource("7_2lv3s")
speaker = &"C"
start = 1210.0
duration = 3.32
stream = ExtResource("128_xl7od")
text = "侦探先生，这个结果...我一时难以接受..."

[sub_resource type="Resource" id="Resource_xia7k"]
script = ExtResource("7_2lv3s")
speaker = &"D"
start = 1221.0
duration = 3.04
stream = ExtResource("129_pn2xp")
text = "我就说那个画家看起来就不像好人！"

[sub_resource type="Resource" id="Resource_um6bw"]
script = ExtResource("7_2lv3s")
speaker = &"E"
start = 1230.0
duration = 12.0
stream = ExtResource("130_oljpc")
text = "（小声哭泣）太可怕了...我还以为这里很安全..."
loudness = 0.3

[sub_resource type="Resource" id="Resource_fh57r"]
script = ExtResource("7_2lv3s")
speaker = &"H"
start = 1241.0
duration = 2.8
stream = ExtResource("131_y440k")
text = "（冷笑）遗产全没了吧？真是讽刺。"

[sub_resource type="Resource" id="Resource_igt5m"]
script = ExtResource("7_2lv3s")
speaker = &"G"
start = 1250.0
duration = 3.08
stream = ExtResource("132_n201e")
text = "老陈就这么走了...我们都是凶手啊..."

[sub_resource type="Resource" id="Resource_mefhk"]
script = ExtResource("7_2lv3s")
speaker = &"J"
start = 1260.0
duration = 3.6
stream = ExtResource("133_bnod4")
text = "各位，很遗憾的通知你们，警方已经在路上了。"

[sub_resource type="Resource" id="Resource_lgpa5"]
script = ExtResource("7_2lv3s")
speaker = &"C"
start = 1265.0
duration = 1.32
stream = ExtResource("134_s3ou6")
text = "（开门）警察先生，请进。"

[sub_resource type="Resource" id="Resource_bcijq"]
script = ExtResource("7_2lv3s")
speaker = &"J"
start = 1273.0
duration = 3.64
stream = ExtResource("135_8b0d3")
text = "警官，我是私家侦探。这两位是本案的嫌疑人。"

[sub_resource type="Resource" id="Resource_4f38c"]
script = ExtResource("7_2lv3s")
speaker = &"B"
start = 1284.0
duration = 2.32
stream = ExtResource("136_8kw1a")
text = "（被戴上手铐）这一切...终于结束了..."

[sub_resource type="Resource" id="Resource_i5yny"]
script = ExtResource("7_2lv3s")
speaker = &"I"
start = 1293.0
duration = 2.88
stream = ExtResource("137_kmmki")
text = "（被戴上手铐）夫人，对不起...是我害了您..."

[sub_resource type="Resource" id="Resource_vw8qh"]
script = ExtResource("7_2lv3s")
speaker = &"F"
start = 1304.0
duration = 3.4
stream = ExtResource("138_wxysi")
text = "关于遗产问题，恐怕要经过漫长的法律程序了。"

[sub_resource type="Resource" id="Resource_oj656"]
script = ExtResource("7_2lv3s")
speaker = &"H"
start = 1315.0
duration = 3.8
stream = ExtResource("139_u0n2k")
text = "（大笑）哈哈哈！都是徒劳！什么都没得到！"

[sub_resource type="Resource" id="Resource_r8cgt"]
script = ExtResource("7_2lv3s")
speaker = &"G"
start = 1325.0
duration = 3.28
stream = ExtResource("140_0moj6")
text = "老陈啊老陈，你这一生...唉..."

[sub_resource type="Resource" id="Resource_wlan7"]
script = ExtResource("7_2lv3s")
speaker = &"D"
start = 1335.0
duration = 3.64
stream = ExtResource("141_ynnna")
text = "（摇头）我那羊排可惜了...还没来得及让他夸完..."

[sub_resource type="Resource" id="Resource_7frj5"]
script = ExtResource("7_2lv3s")
speaker = &"E"
start = 1346.0
duration = 2.4
stream = ExtResource("142_cdnsw")
text = "管家先生...我们该怎么办..."

[sub_resource type="Resource" id="Resource_hnnad"]
script = ExtResource("7_2lv3s")
speaker = &"C"
start = 1354.0
duration = 3.68
stream = ExtResource("143_32xxq")
text = "继续我们的生活吧。古堡还在，我还要打理这里。"

[sub_resource type="Resource" id="Resource_8isp7"]
script = ExtResource("7_2lv3s")
speaker = &"J"
start = 1365.0
duration = 3.72
stream = ExtResource("144_u2i6m")
text = "各位，感谢你们的配合。真相终于大白于天下。"

[sub_resource type="Resource" id="Resource_8fjyl"]
script = ExtResource("7_2lv3s")
speaker = &"B"
start = 1377.0
duration = 2.6
stream = ExtResource("145_oxin7")
text = "（回头最后看一眼古堡）再见了...我的牢笼..."

[sub_resource type="Resource" id="Resource_d7wh4"]
script = ExtResource("7_2lv3s")
speaker = &"I"
start = 1390.0
duration = 3.12
stream = ExtResource("146_qikp3")
text = "夫人，来生...我还会在画布上画您..."

[sub_resource type="Resource" id="Resource_55ya4"]
script = ExtResource("7_2lv3s")
speaker = &"H"
start = 1400.0
duration = 2.92
stream = ExtResource("147_t832f")
text = "（独自离开）我什么都没得到...什么都没得到..."

[sub_resource type="Resource" id="Resource_lejav"]
script = ExtResource("7_2lv3s")
speaker = &"F"
start = 1411.0
duration = 2.64
stream = ExtResource("148_jddgg")
text = "这案子会成为业界的经典案例的。"

[sub_resource type="Resource" id="Resource_1rsml"]
script = ExtResource("7_2lv3s")
speaker = &"G"
start = 1420.0
duration = 2.16
stream = ExtResource("149_ixfxj")
text = "（离开）下次聚会不知道是什么时候了..."

[sub_resource type="Resource" id="Resource_kibrr"]
script = ExtResource("7_2lv3s")
speaker = &"D"
start = 1429.0
duration = 2.0
stream = ExtResource("150_y48as")
text = "（回厨房）明天还有客人...日子还得过..."

[sub_resource type="Resource" id="Resource_3qpmd"]
script = ExtResource("7_2lv3s")
speaker = &"C"
start = 1439.0
duration = 3.2
stream = ExtResource("151_m3gba")
text = "（目送众人离开）古堡依旧，但人已不同..."

[sub_resource type="Resource" id="Resource_jd51j"]
script = ExtResource("7_2lv3s")
speaker = &"E"
start = 1450.0
duration = 2.36
stream = ExtResource("152_nlbci")
text = "（打扫餐厅）这套餐具...以后谁还用呢..."

[sub_resource type="Resource" id="Resource_jeeaf"]
script = ExtResource("7_2lv3s")
speaker = &"J"
start = 1460.0
duration = 3.04
stream = ExtResource("153_o828x")
text = "（思考）这个案子...凶手的手法其实并不高明..."

[sub_resource type="Resource" id="Resource_hvybt"]
script = ExtResource("7_2lv3s")
speaker = &"G"
start = 1471.0
duration = 2.84
stream = ExtResource("154_5iesg")
text = "（在车里）老陈那颗心脏早就承受太多了..."

[sub_resource type="Resource" id="Resource_wo1rm"]
script = ExtResource("7_2lv3s")
speaker = &"F"
start = 1481.0
duration = 2.0
stream = ExtResource("155_ryc0h")
text = "（整理文件）遗产案的卷宗...又多了几页..."

[sub_resource type="Resource" id="Resource_hqt8u"]
script = ExtResource("7_2lv3s")
speaker = &"H"
start = 1491.0
duration = 2.56
stream = ExtResource("156_wca4a")
text = "（在火车站）等下一班火车...去哪里呢..."

[sub_resource type="Resource" id="Resource_o4cpy"]
script = ExtResource("7_2lv3s")
speaker = &"D"
start = 1500.0
duration = 1.84
stream = ExtResource("157_wmqp8")
text = "（看着羊排照片）这道菜...我不会再做了..."

[sub_resource type="Resource" id="Resource_sc6w7"]
script = ExtResource("7_2lv3s")
speaker = &"C"
start = 1510.0
duration = 2.6
stream = ExtResource("158_x3d1i")
text = "（关上古堡大门）今晚...就当是一场梦吧..."

[sub_resource type="Resource" id="Resource_8a1oe"]
script = ExtResource("7_2lv3s")
speaker = &"E"
start = 1520.0
duration = 2.68
stream = ExtResource("159_w3mow")
text = "管家先生，谢谢您这些天的照顾。"

[sub_resource type="Resource" id="Resource_wrv2u"]
script = ExtResource("7_2lv3s")
speaker = &"C"
start = 1529.0
duration = 1.6
stream = ExtResource("160_e2uvh")
text = "（微笑）你也该去找更好的工作了。"

[sub_resource type="Resource" id="Resource_4r0s7"]
script = ExtResource("7_2lv3s")
speaker = &"J"
start = 1537.0
duration = 3.08
stream = ExtResource("161_n4ids")
text = "（离开古堡）这个案子结束了...但人心..."

[sub_resource type="Resource" id="Resource_8ci0k"]
script = ExtResource("7_2lv3s")
speaker = &"G"
start = 1547.0
duration = 3.16
stream = ExtResource("162_7cqn3")
text = "也许死亡...对老陈来说是一种解脱吧..."

[sub_resource type="Resource" id="Resource_nolj6"]
script = ExtResource("7_2lv3s")
speaker = &"H"
start = 1557.0
duration = 5.24
stream = ExtResource("163_736sg")
text = "（自语）遗产、爱情、复仇...都是浮云..."

[sub_resource type="Resource" id="Resource_nvm06"]
script = ExtResource("7_2lv3s")
speaker = &"F"
start = 1565.0
duration = 2.64
stream = ExtResource("164_k4u06")
text = "各位同行，这案子值得好好研究。"

[sub_resource type="Resource" id="Resource_y0jkh"]
script = ExtResource("7_2lv3s")
speaker = &"D"
start = 1574.0
duration = 3.48
stream = ExtResource("165_wp3rm")
text = "哼，那个画家...我早看他不顺眼了。"

[sub_resource type="Resource" id="Resource_jpxgb"]
script = ExtResource("7_2lv3s")
speaker = &"I"
start = 1583.0
duration = 2.32
stream = ExtResource("166_4efnt")
text = "（在警车上）夫人...请不要为我哭泣..."

[sub_resource type="Resource" id="Resource_enbkm"]
script = ExtResource("7_2lv3s")
speaker = &"B"
start = 1592.0
duration = 2.76
stream = ExtResource("167_28ncp")
text = "（在警车上）来生...我们再相见..."

[sub_resource type="Resource" id="Resource_djqmd"]
script = ExtResource("7_2lv3s")
speaker = &"E"
start = 1601.0
duration = 5.8
stream = ExtResource("168_bljsw")
text = "（祈祷）愿主保佑这古堡...愿主保佑我们所有人..."

[sub_resource type="Resource" id="Resource_n7bxj"]
script = ExtResource("7_2lv3s")
speaker = &"C"
start = 1613.0
duration = 2.16
stream = ExtResource("169_t632m")
text = "（独自站在大厅）老爷...您听到了吗..."

[sub_resource type="Resource" id="Resource_yvt0y"]
script = ExtResource("7_2lv3s")
speaker = &"J"
start = 1625.0
duration = 2.32
stream = ExtResource("170_eu3og")
text = "这就是黑石古堡的最后一夜..."

[sub_resource type="Resource" id="Resource_jwpr4"]
script = ExtResource("7_2lv3s")
speaker = &"G"
start = 1634.0
duration = 2.72
stream = ExtResource("171_s5685")
text = "月光依旧...但人心已变..."

[sub_resource type="Resource" id="Resource_fs1op"]
script = ExtResource("7_2lv3s")
speaker = &"D"
start = 1642.0
duration = 3.2
stream = ExtResource("172_dwcys")
text = "明天太阳升起...一切都将重新开始..."

[sub_resource type="Resource" id="Resource_ghoum"]
script = ExtResource("7_2lv3s")
speaker = &"F"
start = 1652.0
duration = 3.4
stream = ExtResource("173_evw2l")
text = "法律的裁决...有时候并不能带来真正的正义..."

[sub_resource type="Resource" id="Resource_61s5n"]
script = ExtResource("7_2lv3s")
speaker = &"H"
start = 1664.0
duration = 1.76
stream = ExtResource("174_kuis6")
text = "（消失在夜色中）我再也不会回来了..."

[sub_resource type="Resource" id="Resource_eme7g"]
script = ExtResource("7_2lv3s")
speaker = &"C"
start = 1673.0
duration = 1.32
stream = ExtResource("175_gnosu")
text = "（吹灭蜡烛）晚安...黑石古堡..."

[sub_resource type="Resource" id="Resource_2da6r"]
script = ExtResource("7_2lv3s")
speaker = &"E"
start = 1685.0
duration = 3.28
stream = ExtResource("176_hc080")
text = "（离开时回头）再见...这美丽而悲伤的地方..."

[sub_resource type="Resource" id="Resource_1307i"]
script = ExtResource("7_2lv3s")
speaker = &"J"
start = 1696.0
duration = 5.48
stream = ExtResource("177_dkjy0")
text = "（上车）血色晚宴...这个案件我会记很久..."

[sub_resource type="Resource" id="Resource_q7ark"]
script = ExtResource("7_2lv3s")
speaker = &"G"
start = 1707.0
duration = 1.64
stream = ExtResource("178_ffocv")
text = "（启动引擎）老陈...一路走好..."

[sub_resource type="Resource" id="Resource_ie4dg"]
script = ExtResource("7_2lv3s")
speaker = &"D"
start = 1715.0
duration = 2.04
stream = ExtResource("179_xridc")
text = "（关灯）好了，我也该休息了..."

[sub_resource type="Resource" id="Resource_asa2y"]
script = ExtResource("7_2lv3s")
speaker = &"F"
start = 1723.0
duration = 2.28
stream = ExtResource("180_ujpcu")
text = "（合上文件夹）这个案子...结束了..."

[sub_resource type="Resource" id="Resource_5kvpk"]
script = ExtResource("7_2lv3s")
speaker = &"C"
start = 1732.0
duration = 1.88
stream = ExtResource("181_h87ya")
text = "（锁门）愿这里早日恢复平静..."

[sub_resource type="Resource" id="Resource_ru7t8"]
script = ExtResource("7_2lv3s")
speaker = &"J"
start = 1745.0
duration = 4.36
stream = ExtResource("182_c2hbw")
text = "（远望古堡）黑夜中的灯火一盏盏熄灭..."

[sub_resource type="Resource" id="Resource_lj7jr"]
script = ExtResource("7_2lv3s")
speaker = &"G"
start = 1755.0
duration = 1.6
stream = ExtResource("183_p4faq")
text = "暴风雨就要来了..."

[sub_resource type="Resource" id="Resource_7tnhl"]
script = ExtResource("7_2lv3s")
speaker = &"E"
start = 1761.0
duration = 2.36
stream = ExtResource("184_3a536")
text = "（远去的身影）故事...就这样结束了吗..."

[sub_resource type="Resource" id="Resource_uon6j"]
script = ExtResource("7_2lv3s")
speaker = &"D"
start = 1771.0
duration = 4.0
stream = ExtResource("185_f5ptn")
text = "（回望）古堡依旧矗立...但已物是人非..."

[sub_resource type="Resource" id="Resource_7xb8n"]
script = ExtResource("7_2lv3s")
speaker = &"F"
start = 1781.0
duration = 2.88
stream = ExtResource("186_ii07x")
text = "（合上笔记本）下一个案子...不知道在哪里..."

[sub_resource type="Resource" id="Resource_k5tdu"]
script = ExtResource("7_2lv3s")
speaker = &"C"
start = 1791.0
duration = 3.84
stream = ExtResource("187_qep6c")
text = "（独白）血色晚宴...永远不会被遗忘..."

