[sub_resource type="Resource" id="Resource_dt0ye"]
script = ExtResource("1_3gx2v")
id = &"H"
display_name = "顾教授"
label = "8"
color = Color(0.09019608, 0.64705884, 0.5372549, 1)
track = Array[ExtResource("2_6il5s")]([SubResource("Resource_6dc17"), SubResource("Resource_mpfrx"), SubResource("Resource_jo0bn"), SubResource("Resource_xacie"), SubResource("Resource_73xc6"), SubResource("Resource_mqlh3"), SubResource("Resource_f0gcs"), SubResource("Resource_lcnte")])

[sub_resource type="Resource" id="Resource_18lgs"]
script = ExtResource("4_w2w3g")
id = &"q1"
prompt = "宋院长真正的死因是什么？"
options = PackedStringArray("心肌梗死", "注射过量的七号药", "被钝器击打", "煤气中毒")
answer = "注射过量的七号药"

[sub_resource type="Resource" id="Resource_nyk82"]
script = ExtResource("4_w2w3g")
id = &"q2"
prompt = "“陈医生”的真实身份是什么？"
options = PackedStringArray("许晴的哥哥", "省卫生厅的调查员", "院长的私生子", "报社记者")
answer = "许晴的哥哥"

[sub_resource type="Resource" id="Resource_h1s4d"]
script = ExtResource("4_w2w3g")
id = &"q3"
kind = 1
prompt = "十年前，是谁下令锁上西翼的门？"
options = PackedStringArray("宋院长", "冯护士长", "顾教授", "老金")
answer = "宋院长"

[sub_resource type="Resource" id="Resource_owwk5"]
script = ExtResource("4_w2w3g")
id = &"q4"
prompt = "装着试验记录的樟木箱最后在哪里？"
options = PackedStringArray("在锅炉房烧掉了", "洗衣房的被单底下", "院长室的保险柜", "旧西翼病房")
answer = "洗衣房的被单底下"

[sub_resource type="Resource" id="Resource_j3jym"]
script = ExtResource("4_w2w3g")
id = &"q5"
kind = 1
prompt = "每天深夜去敲西翼那扇门的是谁？"
options = PackedStringArray("白露", "老金", "阿强", "冯护士长")
answer = "老金"

[sub_resource type="Resource" id="Resource_bggn0"]
script = ExtResource("4_w2w3g")
id = &"q6"
kind = 1
prompt = "杀死宋院长的凶手是谁？"
options = PackedStringArray()
answer = "冯护士长"

[sub_resource type="Resource" id="Resource_q2cfk"]
script = ExtResource("6_2vm73")
