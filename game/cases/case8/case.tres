label = "敲门声"

[sub_resource type="Resource" id="Resource_qy387"]
script = ExtResource("6_2vm73")
time = 514.473
duration = 1.6
stream = ExtResource("7_f4ens")
attach_to = &"E"
loudness = 0.8
label = "敲门声"

[sub_resource type="Resource" id="Resource_oolii"]
script = ExtResource("6_2vm73")
time = 1271.56
duration = 1.6
stream = ExtResource("8_3boww")
attach_to = &"A"
loudness = 0.7
label = "倒地声"

[sub_resource type="Resource" id="Resource_qf6qk"]
script = ExtResource("6_2vm73")
time = 1674.417
duration = 1.6
stream = ExtResource("7_f4ens")
attach_to = &"B"
loudness = 0.6
label = "开门声"

[sub_resource type="Resource" id="Resource_bh6qy"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 2.0
duration = 3.96
stream = ExtResource("10_a2gyv")
text = "（搓着手）护士长，电话还是不通，线让雪压断了。"

[sub_resource type="Resource" id="Resource_icta0"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 5.0
duration = 5.52
stream = ExtResource("11_88nqt")
text = "（自言自语）“十年了，西翼的门该开了。”……又是这句。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_dlllp"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 6.36
duration = 6.0
stream = ExtResource("12_d28rd")
text = "压断就压断。大雪封山，三天之内谁也上不来，也谁都下不去。"

[sub_resource type="Resource" id="Resource_askrn"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 10.92
duration = 5.08
stream = ExtResource("13_nxum0")
text = "字是用左手写的，故意歪歪扭扭。哼，装神弄鬼。"

[sub_resource type="Resource" id="Resource_sui0y"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 12.0
duration = 7.56
stream = ExtResource("14_lns67")
text = "（自言自语）马走日，象走田……老宋啊老宋，你这步棋，十年前就下错了。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_5pogx"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 12.76
duration = 2.96
stream = ExtResource("15_qcenj")
text = "那……那万一夜里有病人出事呢？"

[sub_resource type="Resource" id="Resource_33a62"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 14.87
duration = 1.8
stream = ExtResource("16_3xq3f")
text = "白露，还没睡？"

[sub_resource type="Resource" id="Resource_fb63h"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 16.12
duration = 5.4
stream = ExtResource("17_j0evu")
text = "出事就找我。我在这儿干了二十年，比电话管用。"

[sub_resource type="Resource" id="Resource_kyyln"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 17.07
duration = 4.04
stream = ExtResource("18_7rvid")
text = "陈医生……我不敢睡。一闭眼，又是那扇门。"

[sub_resource type="Resource" id="Resource_xxvc2"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 21.51
duration = 1.6
stream = ExtResource("19_m3vmi")
text = "还是同一个梦？"

[sub_resource type="Resource" id="Resource_ffqq8"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 21.92
duration = 4.96
stream = ExtResource("20_0cnpl")
text = "（小声）我听食堂的大姐说，西翼那边，半夜有人敲门……"
loudness = 0.3

[sub_resource type="Resource" id="Resource_8hl0w"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 22.483
duration = 4.36
stream = ExtResource("21_r10i3")
text = "院长，您叫我？锅炉我刚添过煤，烧得正旺。"

[sub_resource type="Resource" id="Resource_nu615"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 23.51
duration = 5.52
stream = ExtResource("22_adrtv")
text = "嗯。很热，到处都是烟。门外面有人在锁门，咔哒一声。"

[sub_resource type="Resource" id="Resource_nu717"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 27.243
duration = 3.64
stream = ExtResource("23_uyhbx")
text = "烧得旺就好。阿强，你在这儿干了几年了？"

[sub_resource type="Resource" id="Resource_oco5i"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 27.28
duration = 3.44
stream = ExtResource("24_6tba7")
text = "（冷冷地）西翼十年没人住了，门是封死的。"

[sub_resource type="Resource" id="Resource_8fqo5"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 29.43
duration = 5.0
stream = ExtResource("25_igtol")
text = "然后有个姐姐抱着我，一直喊：小露，低头，捂住嘴，别哭。"

[sub_resource type="Resource" id="Resource_q6gfw"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 31.12
duration = 4.48
stream = ExtResource("26_76jhh")
text = "再让我听见你传这种话，雪一化你就收拾东西下山。"

[sub_resource type="Resource" id="Resource_6ubww"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 31.283
duration = 1.24
stream = ExtResource("27_htnxv")
text = "快四年了。"

[sub_resource type="Resource" id="Resource_is2ys"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 32.923
duration = 7.36
stream = ExtResource("28_oa3kh")
text = "四年，人还算老实。今晚有件事交给你，办好了，这个月工资加五十。"

[sub_resource type="Resource" id="Resource_j7m8k"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 34.83
duration = 3.6
stream = ExtResource("29_hk1e5")
text = "（声音发紧）那个姐姐……你记得她长什么样吗？"

[sub_resource type="Resource" id="Resource_023xm"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 36.0
duration = 2.56
stream = ExtResource("30_gfn2p")
text = "是，是，我不说了。"

[sub_resource type="Resource" id="Resource_76ph8"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 38.83
duration = 5.32
stream = ExtResource("31_38rme")
text = "记不清了。她手腕上有一根红绳，绳子上挂着一颗小铃铛。"

[sub_resource type="Resource" id="Resource_n1l54"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 38.96
duration = 5.24
stream = ExtResource("32_jgi7t")
text = "交代你一件事。十一点半之前，三号病房的白露要打一针。"

[sub_resource type="Resource" id="Resource_ftb1l"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 40.683
duration = 1.56
stream = ExtResource("33_kukee")
text = "（眼睛一亮）您说，您说。"

[sub_resource type="Resource" id="Resource_xyicf"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 42.643
duration = 5.8
stream = ExtResource("34_dcx58")
text = "档案室最里面，靠墙那只樟木箱子。十一点二十，你把它搬到锅炉房。"

[sub_resource type="Resource" id="Resource_dqfta"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 44.55
duration = 2.12
stream = ExtResource("35_vxj7o")
text = "（沉默片刻）……红绳，小铃铛。"

[sub_resource type="Resource" id="Resource_gufy2"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 44.6
duration = 3.12
stream = ExtResource("36_wg6el")
text = "白露？她今天下午挺安静的呀。"

[sub_resource type="Resource" id="Resource_gb7ky"]
script = ExtResource("9_0vga1")
speaker = &"E"
start = 46.992
duration = 3.68
stream = ExtResource("37_p4kw7")
text = "教授！教授！又下棋呢？"

[sub_resource type="Resource" id="Resource_tdkoc"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 47.07
duration = 2.96
stream = ExtResource("38_opcvd")
text = "陈医生，你怎么了？你的手在抖。"

[sub_resource type="Resource" id="Resource_tdcri"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 48.12
duration = 3.44
stream = ExtResource("39_x2v5x")
text = "院长的医嘱。药我亲自配，你别碰。"

[sub_resource type="Resource" id="Resource_knxmi"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 48.843
duration = 5.32
stream = ExtResource("40_t862s")
text = "搬到锅炉房？那箱子不是一直锁着吗，里面装的什么？"

[sub_resource type="Resource" id="Resource_he20o"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 50.43
duration = 6.48
stream = ExtResource("41_c6v2l")
text = "没什么，屋里冷。白露，最近这几天，你是不是比以前清醒多了？"

[sub_resource type="Resource" id="Resource_lqcx3"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 51.072
duration = 2.8
stream = ExtResource("42_ggtni")
text = "老金，这么晚不睡觉，又出来逛？"

[sub_resource type="Resource" id="Resource_q0akk"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 51.96
duration = 3.28
stream = ExtResource("43_cxmsx")
text = "好的护士长。是……什么药啊？"

[sub_resource type="Resource" id="Resource_sehve"]
script = ExtResource("9_0vga1")
speaker = &"E"
start = 54.272
duration = 5.12
stream = ExtResource("44_62acv")
text = "睡不着。西翼那边的人叫我，叫了一晚上。"

[sub_resource type="Resource" id="Resource_evj6i"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 54.563
duration = 6.88
stream = ExtResource("45_u1xkt")
text = "不该问的别问。搬过去，扔进炉膛，看着它烧干净。一张纸片都不许剩。"

[sub_resource type="Resource" id="Resource_643et"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 55.64
duration = 1.32
stream = ExtResource("46_anklk")
text = "七号。"

[sub_resource type="Resource" id="Resource_v7kk8"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 57.31
duration = 6.28
stream = ExtResource("47_ymoqk")
text = "是。以前我整天都昏昏沉沉的，现在……现在好多事情都回来了。好可怕。"

[sub_resource type="Resource" id="Resource_2bwlg"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 57.36
duration = 4.88
stream = ExtResource("48_q3k1w")
text = "（翻着本子）七号……我在药品册子上没见过这个编号。"

[sub_resource type="Resource" id="Resource_yh0e4"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 59.792
duration = 3.36
stream = ExtResource("49_8hd5m")
text = "西翼没人。你听岔了，是暖气管子在响。"

[sub_resource type="Resource" id="Resource_0v5yh"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 61.843
duration = 5.0
stream = ExtResource("50_kmo68")
text = "烧……行。钥匙呢？档案室的门一直锁着。"

[sub_resource type="Resource" id="Resource_ybk1f"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 62.64
duration = 4.84
stream = ExtResource("51_ugmnk")
text = "册子上没有的东西多了。去，把二楼的暖气阀查一遍。"

[sub_resource type="Resource" id="Resource_7605e"]
script = ExtResource("9_0vga1")
speaker = &"E"
start = 63.552
duration = 8.6
stream = ExtResource("52_rnaq3")
text = "（压低声音）不是管子。是他们在敲门，咚，咚，咚。他们出不来，门锁着。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_3pevm"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 63.99
duration = 4.68
stream = ExtResource("53_h4lhq")
text = "别怕。可怕的不是想起来，是有人不想让你想起来。"

[sub_resource type="Resource" id="Resource_yyk5g"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 67.243
duration = 5.76
stream = ExtResource("54_83in0")
text = "（递过钥匙）用完还我。这件事，除了你我，不许第三个人知道。"

[sub_resource type="Resource" id="Resource_ntiy6"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 67.88
duration = 2.28
stream = ExtResource("55_yxvw2")
text = "我、我这就去看。"

[sub_resource type="Resource" id="Resource_g108x"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 69.07
duration = 5.2
stream = ExtResource("56_w7r28")
text = "后来……后来有人把窗户砸开了，把我从窗户里拖了出去。"

[sub_resource type="Resource" id="Resource_4aggu"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 72.06
duration = 4.44
stream = ExtResource("57_o7ice")
text = "（自言自语）七号……怪了，护士长从来没亲自配过药。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_vnjnd"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 72.552
duration = 2.92
stream = ExtResource("58_o346r")
text = "门锁着，你也打不开。坐下，陪我下一盘。"

[sub_resource type="Resource" id="Resource_r6w8w"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 73.403
duration = 2.84
stream = ExtResource("59_jepa1")
text = "明白，明白。院长放心。"

[sub_resource type="Resource" id="Resource_tfa1g"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 74.67
duration = 4.12
stream = ExtResource("60_orq8r")
text = "那个人身上有一股香味，甜甜的，像桂花。"

[sub_resource type="Resource" id="Resource_bxgut"]
script = ExtResource("9_0vga1")
speaker = &"E"
start = 75.872
duration = 6.04
stream = ExtResource("61_yaifx")
text = "那天也是白衣服的那个女的锁的门。咔哒一声，我听得清清楚楚。"

[sub_resource type="Resource" id="Resource_ndwhd"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 76.643
duration = 3.68
stream = ExtResource("62_a61ce")
text = "去吧。记住，十一点二十，不早不晚。"

[sub_resource type="Resource" id="Resource_rqh0h"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 79.19
duration = 0.72
stream = ExtResource("63_ijb5v")
text = "桂花？"

[sub_resource type="Resource" id="Resource_ebuis"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 80.31
duration = 4.36
stream = ExtResource("64_uavx6")
text = "嗯，桂花头油的味道。我一闻到那个味道，就想哭。"

[sub_resource type="Resource" id="Resource_jltht"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 82.312
duration = 3.04
stream = ExtResource("65_j2gom")
text = "（停下棋子）老金，这话你对谁都别说。"

[sub_resource type="Resource" id="Resource_nqdrq"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 85.07
duration = 5.92
stream = ExtResource("66_l112r")
text = "白露，今晚要是有人来给你打针，不管是谁，你就说头疼，叫人去喊我。"

[sub_resource type="Resource" id="Resource_ng7c3"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 85.673
duration = 8.16
stream = ExtResource("67_phb5o")
text = "（低声）加五十……箱子要烧，还不让问……这里头的东西，怕是不止五十块。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_0wrea"]
script = ExtResource("9_0vga1")
speaker = &"E"
start = 85.752
duration = 5.76
stream = ExtResource("68_7o36r")
text = "说了也没人信。他们都说老金疯了。教授，你也疯了吗？"

[sub_resource type="Resource" id="Resource_twkg5"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 91.39
duration = 2.16
stream = ExtResource("69_qdy4o")
text = "打针？为什么？"

[sub_resource type="Resource" id="Resource_1a45q"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 91.912
duration = 3.84
stream = ExtResource("70_pqqtc")
text = "我？我是被写成疯了。这里头的差别，可大了去了。"

[sub_resource type="Resource" id="Resource_ahaul"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 93.95
duration = 2.8
stream = ExtResource("71_m5pkk")
text = "别问为什么。答应我。"

[sub_resource type="Resource" id="Resource_rt57f"]
script = ExtResource("9_0vga1")
speaker = &"E"
start = 96.152
duration = 3.76
stream = ExtResource("72_unofb")
text = "（笑）嘿嘿，写成疯了……写成疯了。"

[sub_resource type="Resource" id="Resource_4ssm1"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 97.15
duration = 2.28
stream = ExtResource("73_tmmmp")
text = "……好，我答应你。"

[sub_resource type="Resource" id="Resource_4hrrl"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 100.312
duration = 1.72
stream = ExtResource("74_h44oo")
text = "该你走了。别碰我的车。"

[sub_resource type="Resource" id="Resource_pb2xf"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 214.495
duration = 1.24
stream = ExtResource("75_sl8k6")
text = "院长，您找我。"

[sub_resource type="Resource" id="Resource_xnhvs"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 216.135
duration = 4.16
stream = ExtResource("76_y8gf7")
text = "秀英，你看看这个。这个星期第三封了。"

[sub_resource type="Resource" id="Resource_7k76f"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 220.695
duration = 4.76
stream = ExtResource("77_m8f1g")
text = "“十年了，西翼的门该开了。”……又是从门缝塞进来的？"

[sub_resource type="Resource" id="Resource_k6bl0"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 225.855
duration = 5.24
stream = ExtResource("78_ski2s")
text = "早上一开门就在地上。疗养院就这么几个人，你说，是谁？"

[sub_resource type="Resource" id="Resource_0leg0"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 231.495
duration = 3.96
stream = ExtResource("79_cxi3r")
text = "老金天天念叨西翼。可他连字都认不全。"

[sub_resource type="Resource" id="Resource_y2a3b"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 235.855
duration = 5.52
stream = ExtResource("80_dyfp4")
text = "那就是顾明远。那个老东西关了十年，脑子比谁都清楚。"

[sub_resource type="Resource" id="Resource_tap5q"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 241.775
duration = 2.52
stream = ExtResource("81_o047j")
text = "顾教授这十年一直很安分。"

[sub_resource type="Resource" id="Resource_jalva"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 244.695
duration = 5.44
stream = ExtResource("82_beeoa")
text = "安分？安分的人才最可怕。还有那个陈医生，你注意到没有？"

[sub_resource type="Resource" id="Resource_fvfr8"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 250.535
duration = 1.84
stream = ExtResource("83_obori")
text = "陈医生怎么了？"

[sub_resource type="Resource" id="Resource_bubor"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 252.775
duration = 4.12
stream = ExtResource("84_wojor")
text = "白露的药，他给减了一半。病历上写的是“观察反应”。"

[sub_resource type="Resource" id="Resource_n7s5b"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 257.295
duration = 7.68
stream = ExtResource("85_jtljt")
text = "这两个礼拜，白露开始画画了。你知道她画的是什么？一扇门。门上全是手印。"

[sub_resource type="Resource" id="Resource_q621t"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 265.375
duration = 1.16
stream = ExtResource("86_qhqnp")
text = "（低声）……她想起来了？"
loudness = 0.3

[sub_resource type="Resource" id="Resource_6hd5c"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 266.935
duration = 4.92
stream = ExtResource("87_y7yua")
text = "还没全想起来。所以今晚，不能再等了。给她打七号，三支。"

[sub_resource type="Resource" id="Resource_pvifj"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 272.255
duration = 6.4
stream = ExtResource("88_nnshs")
text = "三支？院长，一支已经是上限，三支打下去，她就醒不过来了。"

[sub_resource type="Resource" id="Resource_xfb88"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 279.055
duration = 4.76
stream = ExtResource("89_us1bo")
text = "醒不过来，就什么都不会说了。她十年前就该跟她们一起走的。"

[sub_resource type="Resource" id="Resource_llwgk"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 284.215
duration = 6.16
stream = ExtResource("90_f1lgh")
text = "（颤抖）她只是个孩子。当年她才十二岁。"

[sub_resource type="Resource" id="Resource_mi1r7"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 290.775
duration = 6.36
stream = ExtResource("91_rqqc3")
text = "当年你可没这么心软。秀英，十年前西翼的门，是谁锁的？"

[sub_resource type="Resource" id="Resource_1pag0"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 297.535
duration = 5.0
stream = ExtResource("92_2dutl")
text = "是你让我锁的！你说，一个都不许跑出来乱说！"

[sub_resource type="Resource" id="Resource_map83"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 302.935
duration = 4.24
stream = ExtResource("93_k7da3")
text = "我让你锁？钥匙在谁手里？锁是谁的手拧上的？"

[sub_resource type="Resource" id="Resource_axoax"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 307.714
duration = 3.32
stream = ExtResource("94_bkxa3")
text = "顾教授，老金，还没休息？"

[sub_resource type="Resource" id="Resource_4wv5w"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 309.575
duration = 6.08
stream = ExtResource("95_3yis8")
text = "我们两个，是拴在一根绳子上的蚂蚱。我掉下去，你也跑不了。"

[sub_resource type="Resource" id="Resource_xb812"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 311.434
duration = 4.68
stream = ExtResource("96_1xt0a")
text = "陈医生。老金睡不着，我也睡不着，两个睡不着的人凑一盘棋。"

[sub_resource type="Resource" id="Resource_s3qac"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 316.055
duration = 3.92
stream = ExtResource("97_0s517")
text = "去配药吧。十一点半之前，我要听到她睡着了。"

[sub_resource type="Resource" id="Resource_ntqt4"]
script = ExtResource("9_0vga1")
speaker = &"E"
start = 316.514
duration = 6.0
stream = ExtResource("98_5mayw")
text = "医生！医生你闻闻，你身上有烟味。那天晚上也是这个味。"

[sub_resource type="Resource" id="Resource_00k4l"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 320.375
duration = 0.92
stream = ExtResource("99_fc051")
text = "（良久）……我知道了。"

[sub_resource type="Resource" id="Resource_qfsxu"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 322.914
duration = 2.84
stream = ExtResource("100_fnrd7")
text = "我刚抽了根烟。老金，哪天晚上？"

[sub_resource type="Resource" id="Resource_lm3iq"]
script = ExtResource("9_0vga1")
speaker = &"E"
start = 326.154
duration = 4.64
stream = ExtResource("101_citim")
text = "着火的那天。西翼烧了一夜，烧得跟白天一样亮。"

[sub_resource type="Resource" id="Resource_tb2j6"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 331.194
duration = 2.68
stream = ExtResource("102_fy13q")
text = "老金，去，给我倒杯热水。"

[sub_resource type="Resource" id="Resource_syv60"]
script = ExtResource("9_0vga1")
speaker = &"E"
start = 334.274
duration = 3.52
stream = ExtResource("103_juyf5")
text = "好嘞，热水，热水。"

[sub_resource type="Resource" id="Resource_pot1r"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 340.194
duration = 4.0
stream = ExtResource("104_24xxf")
text = "陈医生，坐。这盘棋，我下了十年，一直缺一个对手。"

[sub_resource type="Resource" id="Resource_xe5sn"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 344.594
duration = 1.08
stream = ExtResource("105_iqk6k")
text = "我不太会下棋。"

[sub_resource type="Resource" id="Resource_vpumn"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 346.074
duration = 3.88
stream = ExtResource("106_wsmx4")
text = "你会。你下了三个月了。减白露的药，往院长门缝里塞信。"

[sub_resource type="Resource" id="Resource_70wsv"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 350.354
duration = 1.52
stream = ExtResource("107_h21r7")
text = "（一惊）你在说什么？"

[sub_resource type="Resource" id="Resource_wpp1x"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 352.274
duration = 6.44
stream = ExtResource("108_7r4ln")
text = "用左手写字，是个好办法。可你写“该”字，最后那一点总是往上挑。病历上也是这样。"

[sub_resource type="Resource" id="Resource_bqmy6"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 359.114
duration = 1.4
stream = ExtResource("109_uuvvt")
text = "……你想怎么样？"

[sub_resource type="Resource" id="Resource_6hm1h"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 360.914
duration = 3.52
stream = ExtResource("110_el7i1")
text = "我不想怎么样。我想看看，你笑起来是什么样子。"

[sub_resource type="Resource" id="Resource_63m3c"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 364.834
duration = 0.72
stream = ExtResource("111_i2iug")
text = "什么？"

[sub_resource type="Resource" id="Resource_q45il"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 365.954
duration = 5.04
stream = ExtResource("112_jb3f8")
text = "你刚才进门的时候笑了一下。我愣了半天。你笑起来，跟她一模一样。"

[sub_resource type="Resource" id="Resource_qy7m2"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 373.394
duration = 3.72
stream = ExtResource("113_aoqta")
text = "许晴。西翼七号床。手腕上总是系着一根红绳。"

[sub_resource type="Resource" id="Resource_og6qu"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 377.514
duration = 2.84
stream = ExtResource("114_v0dut")
text = "（声音发哑）……我叫许致远。她是我妹妹。"

[sub_resource type="Resource" id="Resource_bd6sl"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 380.754
duration = 2.16
stream = ExtResource("115_o1quc")
text = "我就知道。她给家里写过信吗？"

[sub_resource type="Resource" id="Resource_g57sp"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 383.314
duration = 10.08
stream = ExtResource("116_afey4")
text = "写过一封，信里说，医生给她们吃一种新药，吃了以后整夜整夜地做噩梦。信寄到的第三天，疗养院就发来了死亡通知。"

[sub_resource type="Resource" id="Resource_lsknl"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 393.794
duration = 2.44
stream = ExtResource("117_nb7k5")
text = "那种药，叫七号。是我配的。"

[sub_resource type="Resource" id="Resource_g36w1"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 396.634
duration = 0.92
stream = ExtResource("118_npbf6")
text = "你？！"

[sub_resource type="Resource" id="Resource_mphys"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 397.954
duration = 5.08
stream = ExtResource("119_8d2nx")
text = "我配它，是为了治病。宋启年拿它做什么，我是后来才知道的。"

[sub_resource type="Resource" id="Resource_goj08"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 403.434
duration = 8.12
stream = ExtResource("120_0x0hv")
text = "剂量加倍，不签同意书，专挑没有家属来看的病人。我要往上报，他就给我写了一份病历：偏执型妄想。"

[sub_resource type="Resource" id="Resource_68hjj"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 403.648
duration = 2.8
stream = ExtResource("121_t0lwa")
text = "（自言自语）七号……三支……"
loudness = 0.3

[sub_resource type="Resource" id="Resource_namjg"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 407.423
duration = 3.52
stream = ExtResource("122_1es18")
text = "护士长，二楼暖气都查过了，没问题。"

[sub_resource type="Resource" id="Resource_lpfp6"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 411.343
duration = 3.08
stream = ExtResource("123_ct4mn")
text = "嗯。白露那边，你今晚别进去。"

[sub_resource type="Resource" id="Resource_vnbre"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 411.954
duration = 1.8
stream = ExtResource("124_mp3cj")
text = "所以你在这儿关了十年。"

[sub_resource type="Resource" id="Resource_7brh8"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 414.154
duration = 6.68
stream = ExtResource("125_kckjc")
text = "十年。所有的试验记录，他都锁在档案室那只樟木箱里。他舍不得烧，那是他的“成果”。"

[sub_resource type="Resource" id="Resource_3v3om"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 414.823
duration = 7.16
stream = ExtResource("126_uf5r2")
text = "护士长，我刚才翻了柜子里的旧说明，七号药一次最多一支，还要分两次推……"

[sub_resource type="Resource" id="Resource_pxrjh"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 421.234
duration = 1.56
stream = ExtResource("127_kh1r4")
text = "只要拿到那只箱子……"

[sub_resource type="Resource" id="Resource_qkrpq"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 422.383
duration = 1.84
stream = ExtResource("128_p77ha")
text = "谁让你翻柜子的？"

[sub_resource type="Resource" id="Resource_rnog6"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 423.194
duration = 6.24
stream = ExtResource("129_ugii1")
text = "拿到箱子，你就能让他坐牢。可你要小心，他现在很怕。人一怕，就什么都做得出来。"

[sub_resource type="Resource" id="Resource_dh4ie"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 424.623
duration = 5.0
stream = ExtResource("130_aarlw")
text = "我、我就是想多学点……三支下去，她会不会……"

[sub_resource type="Resource" id="Resource_ldxgg"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 429.834
duration = 2.68
stream = ExtResource("131_kauhy")
text = "那场火……真的是意外吗？"

[sub_resource type="Resource" id="Resource_drtrk"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 430.023
duration = 2.76
stream = ExtResource("132_p7rii")
text = "小梅，你来这儿几个月了？"

[sub_resource type="Resource" id="Resource_hbnao"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 432.914
duration = 7.04
stream = ExtResource("133_cbgbd")
text = "火是意外，锅炉管子裂了。可西翼的门，是从外面锁上的。烧死的三个人，指甲都劈了。"

[sub_resource type="Resource" id="Resource_c83a4"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 433.183
duration = 0.88
stream = ExtResource("134_37uiu")
text = "两个月。"

[sub_resource type="Resource" id="Resource_rkd5e"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 434.463
duration = 2.72
stream = ExtResource("135_ner7n")
text = "两个月，就想教我打针？"

[sub_resource type="Resource" id="Resource_b4u76"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 437.583
duration = 1.36
stream = ExtResource("136_ft0hn")
text = "不、不是的……"

[sub_resource type="Resource" id="Resource_rqanf"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 439.343
duration = 4.08
stream = ExtResource("137_0tgos")
text = "（放缓）你不懂。有些病人，睡着了，比醒着好受。"

[sub_resource type="Resource" id="Resource_aq244"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 440.354
duration = 1.32
stream = ExtResource("138_acnv8")
text = "（压抑地）我要去见他。"

[sub_resource type="Resource" id="Resource_udh1v"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 442.074
duration = 2.28
stream = ExtResource("139_abda5")
text = "去吧。别让他看出你知道多少。"

[sub_resource type="Resource" id="Resource_r55ch"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 443.823
duration = 1.28
stream = ExtResource("140_ykim6")
text = "可是……"

[sub_resource type="Resource" id="Resource_qjxlj"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 445.503
duration = 3.72
stream = ExtResource("141_4wyvb")
text = "回值班的椅子上坐着。今晚哪儿也别去。"

[sub_resource type="Resource" id="Resource_aang5"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 451.623
duration = 5.08
stream = ExtResource("142_lay6e")
text = "（自言自语）睡着了比醒着好受……那要是再也醒不过来呢？"
loudness = 0.3

[sub_resource type="Resource" id="Resource_xn13q"]
script = ExtResource("9_0vga1")
speaker = &"E"
start = 498.473
duration = 3.88
stream = ExtResource("143_tqpwc")
text = "（低声）别急，别急，老金来了……"
loudness = 0.3

[sub_resource type="Resource" id="Resource_b5kh6"]
script = ExtResource("9_0vga1")
speaker = &"E"
start = 505.753
duration = 2.12
stream = ExtResource("144_x4tao")
text = "（喃喃）开门了，开门了。出来吧……"
loudness = 0.3

[sub_resource type="Resource" id="Resource_wvgkt"]
script = ExtResource("9_0vga1")
speaker = &"E"
start = 508.273
duration = 5.8
stream = ExtResource("145_shia6")
text = "老金对不起你们。那天锅炉房的管子，是我没看住……"

[sub_resource type="Resource" id="Resource_87b6m"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 512.0
duration = 4.4
stream = ExtResource("146_qe17d")
text = "（自言自语）又来了……咚，咚，咚……"
loudness = 0.3

[sub_resource type="Resource" id="Resource_h4ovs"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 516.8
duration = 3.32
stream = ExtResource("147_2pmx2")
text = "（颤抖）别敲了……求求你们别敲了……"

[sub_resource type="Resource" id="Resource_bflqn"]
script = ExtResource("9_0vga1")
speaker = &"E"
start = 517.473
duration = 6.52
stream = ExtResource("148_5iet2")
text = "小许，你那个红绳子还在不在？我给你收着呢，没敢丢……"

[sub_resource type="Resource" id="Resource_75clj"]
script = ExtResource("9_0vga1")
speaker = &"E"
start = 524.393
duration = 4.64
stream = ExtResource("149_3ep2e")
text = "（啜泣）他们不让我开。白衣服的那个，咔哒一声……"

[sub_resource type="Resource" id="Resource_phoio"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 625.0
duration = 3.24
stream = ExtResource("150_iqev6")
text = "陈医生？这么晚了，有事？"

[sub_resource type="Resource" id="Resource_lgiil"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 629.217
duration = 3.28
stream = ExtResource("151_5agha")
text = "院长，我想跟您谈谈白露的治疗方案。"

[sub_resource type="Resource" id="Resource_veiks"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 632.897
duration = 4.12
stream = ExtResource("152_8t5xu")
text = "白露的方案，我已经定了。明天雪一停，转去省城。"

[sub_resource type="Resource" id="Resource_vmd8a"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 637.417
duration = 3.84
stream = ExtResource("153_umhpg")
text = "转院？她的情况正在好转，这时候转院……"

[sub_resource type="Resource" id="Resource_h0evt"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 641.657
duration = 6.92
stream = ExtResource("154_7t2s1")
text = "好转？她整夜整夜地做噩梦，画一些乱七八糟的东西。陈医生，你减了她的药。"

[sub_resource type="Resource" id="Resource_r8yyb"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 648.977
duration = 3.12
stream = ExtResource("155_2uoph")
text = "我是她的主治医生，我有权调整。"

[sub_resource type="Resource" id="Resource_2b62q"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 652.497
duration = 2.84
stream = ExtResource("156_d8kfx")
text = "在这里，你的权力是我给的。"

[sub_resource type="Resource" id="Resource_s86nu"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 655.737
duration = 2.44
stream = ExtResource("157_bqyp0")
text = "院长，您好像很怕她想起什么。"

[sub_resource type="Resource" id="Resource_d5rvf"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 658.577
duration = 4.84
stream = ExtResource("158_o58ji")
text = "（笑）我怕？我在这里当了二十年院长，什么病人没见过？"

[sub_resource type="Resource" id="Resource_n4q1c"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 663.817
duration = 2.24
stream = ExtResource("159_a0rww")
text = "那您见过西翼那场火吗？"

[sub_resource type="Resource" id="Resource_4xjl6"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 666.457
duration = 2.76
stream = ExtResource("160_65tb5")
text = "……一场事故。报告写得清清楚楚。"

[sub_resource type="Resource" id="Resource_lpuiu"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 669.617
duration = 4.56
stream = ExtResource("161_52eob")
text = "报告上没写，门为什么是从外面锁的。"

[sub_resource type="Resource" id="Resource_lx0y5"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 674.577
duration = 3.64
stream = ExtResource("162_maguw")
text = "（拍桌）谁跟你说的！顾明远？老金？一个疯子，一个傻子！"
loudness = 0.9

[sub_resource type="Resource" id="Resource_dn2yd"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 678.617
duration = 4.0
stream = ExtResource("163_c2w6r")
text = "烧死的三个人，指甲都劈了。她们是在抓门。"

[sub_resource type="Resource" id="Resource_2w3rb"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 681.653
duration = 8.08
stream = ExtResource("164_dbjmx")
text = "（自言自语）樟木箱……就是这个。好家伙，真沉。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_aa7ap"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 683.017
duration = 2.36
stream = ExtResource("165_o4d04")
text = "陈医生，你到底是什么人？"

[sub_resource type="Resource" id="Resource_rh8n1"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 685.777
duration = 0.88
stream = ExtResource("166_7dtv6")
text = "一个医生。"

[sub_resource type="Resource" id="Resource_6bgrq"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 687.057
duration = 3.48
stream = ExtResource("167_7vg0d")
text = "一个医生，不该对十年前的事这么上心。"

[sub_resource type="Resource" id="Resource_a4jbs"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 690.133
duration = 4.04
stream = ExtResource("168_7hitx")
text = "锁着的……院长要烧的东西，肯定比五十块值钱。"

[sub_resource type="Resource" id="Resource_tnpoj"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 690.937
duration = 8.28
stream = ExtResource("169_bkhvv")
text = "我劝你一句，大雪封山，电话也断了。在这栋楼里，病历是我写的，谁疯谁不疯，也是我说了算。"

[sub_resource type="Resource" id="Resource_p50ii"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 699.617
duration = 3.36
stream = ExtResource("170_mu7xm")
text = "（怒吼）你会为她偿命的！你会为她们三个偿命的！"
loudness = 0.9

[sub_resource type="Resource" id="Resource_63ivj"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 699.684
duration = 4.76
stream = ExtResource("171_m2f5y")
text = "（低声）就塞这儿，被单底下。谁会来翻脏被单。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_g6tqx"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 703.377
duration = 0.4
stream = ExtResource("172_im0gp")
text = "（冷笑）出去。"

[sub_resource type="Resource" id="Resource_bk5sp"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 704.844
duration = 4.76
stream = ExtResource("173_kdkmk")
text = "嘿，回头找个识货的，让院长自己出钱买回去。"

[sub_resource type="Resource" id="Resource_mchme"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 712.997
duration = 2.84
stream = ExtResource("174_sas37")
text = "烧几张旧报纸，有个烟，交得了差。"

[sub_resource type="Resource" id="Resource_wbhkj"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 806.0
duration = 4.84
stream = ExtResource("175_s66ft")
text = "陈医生！刚才院长屋里那么大声，出什么事了？"

[sub_resource type="Resource" id="Resource_rgu6j"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 811.24
duration = 3.88
stream = ExtResource("176_ac0dv")
text = "没事。小梅，今晚白露是不是要打针？"

[sub_resource type="Resource" id="Resource_74xl4"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 815.52
duration = 6.04
stream = ExtResource("177_yo0dk")
text = "你怎么知道？护士长说，院长让给她打七号，三支……"

[sub_resource type="Resource" id="Resource_bpkba"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 821.96
duration = 1.88
stream = ExtResource("178_vtvcl")
text = "三支？！谁配的药？"

[sub_resource type="Resource" id="Resource_sfdno"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 824.24
duration = 2.44
stream = ExtResource("179_rxl1k")
text = "护士长亲自配，不让我碰。"

[sub_resource type="Resource" id="Resource_jx52m"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 825.0
duration = 1.04
stream = ExtResource("180_dqgmx")
text = "配好了？"

[sub_resource type="Resource" id="Resource_h535i"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 827.08
duration = 6.68
stream = ExtResource("181_7y0bk")
text = "小梅，你听我说。三支七号推进去，她的心脏会停。这不是治病，这是要她的命。"

[sub_resource type="Resource" id="Resource_gp610"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 827.989
duration = 1.64
stream = ExtResource("182_mxpsd")
text = "配好了。三支。"

[sub_resource type="Resource" id="Resource_g0kmy"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 830.029
duration = 4.48
stream = ExtResource("183_rvrak")
text = "给我看看。……嗯。十一点半，打完了来告诉我。"

[sub_resource type="Resource" id="Resource_8m5di"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 834.16
duration = 3.64
stream = ExtResource("184_0pqa0")
text = "（倒吸一口气）不、不会吧……护士长不会的……"

[sub_resource type="Resource" id="Resource_qmckp"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 834.909
duration = 1.88
stream = ExtResource("185_7tc0e")
text = "院长……我还有一句话。"

[sub_resource type="Resource" id="Resource_vcw3p"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 837.189
duration = 0.8
stream = ExtResource("186_4eoj4")
text = "说。"

[sub_resource type="Resource" id="Resource_h5kur"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 838.2
duration = 8.84
stream = ExtResource("187_48ky3")
text = "我现在没法跟你解释。你上楼，守在三号病房，谁来打针都拦着，就说是我的医嘱。"

[sub_resource type="Resource" id="Resource_kvopr"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 838.389
duration = 9.28
stream = ExtResource("188_v5ybx")
text = "十年前我锁了那扇门，又折回去砸窗户。我只拉出来一个。我这十年，每天夜里都听见她们在抓门。"

[sub_resource type="Resource" id="Resource_7inir"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 847.44
duration = 2.8
stream = ExtResource("189_ei8qm")
text = "可护士长让我哪儿都别去……"

[sub_resource type="Resource" id="Resource_45tpq"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 848.069
duration = 1.04
stream = ExtResource("190_a4lq2")
text = "所以呢？"

[sub_resource type="Resource" id="Resource_f8dly"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 849.509
duration = 2.6
stream = ExtResource("191_lxd47")
text = "所以我求你，别让我再锁一次门。"

[sub_resource type="Resource" id="Resource_8ru8k"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 850.64
duration = 2.28
stream = ExtResource("192_u28eo")
text = "出了事，我担着。去！"

[sub_resource type="Resource" id="Resource_82y4w"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 852.509
duration = 4.44
stream = ExtResource("193_ntkch")
text = "（叹气）秀英，你跟了我二十年，我一直把你当自己人。"

[sub_resource type="Resource" id="Resource_5p51h"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 853.32
duration = 1.8
stream = ExtResource("194_l6v33")
text = "我、我这就去。"

[sub_resource type="Resource" id="Resource_qxpvf"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 857.349
duration = 1.36
stream = ExtResource("195_frmt7")
text = "你来看看这个。"

[sub_resource type="Resource" id="Resource_amro8"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 859.109
duration = 1.32
stream = ExtResource("196_bvyiv")
text = "这是……"

[sub_resource type="Resource" id="Resource_oa0pc"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 860.829
duration = 9.12
stream = ExtResource("197_sqlrd")
text = "我写的证词，签了字，按了手印。“西翼之门，系护士长冯秀英擅自锁闭，本人事后方知。”"

[sub_resource type="Resource" id="Resource_l3d7r"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 870.349
duration = 4.92
stream = ExtResource("198_acrdn")
text = "（声音发抖）你……你早就写好了？"

[sub_resource type="Resource" id="Resource_w8qjo"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 875.669
duration = 5.4
stream = ExtResource("199_fy380")
text = "写好了，锁在保险柜里。今晚你心软，明天这张纸就到公安局。"

[sub_resource type="Resource" id="Resource_u6p07"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 881.469
duration = 5.88
stream = ExtResource("200_eeujf")
text = "你要是听话，这张纸就永远在保险柜里睡觉。跟白露一样。"

[sub_resource type="Resource" id="Resource_w2g5x"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 887.749
duration = 2.92
stream = ExtResource("201_xgnq5")
text = "……二十年。我替你挡了二十年。"

[sub_resource type="Resource" id="Resource_7dwi1"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 891.069
duration = 2.04
stream = ExtResource("202_bod71")
text = "去吧。别让我等太久。"

[sub_resource type="Resource" id="Resource_sfnwb"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 903.406
duration = 2.24
stream = ExtResource("203_13a4i")
text = "陈医生，借一步说话。"

[sub_resource type="Resource" id="Resource_o25i1"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 906.046
duration = 0.96
stream = ExtResource("204_tu0sa")
text = "什么事？"

[sub_resource type="Resource" id="Resource_aaokk"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 907.406
duration = 5.96
stream = ExtResource("205_huxlc")
text = "刚才您跟院长吵的，我在走廊上都听见了。您对那个西翼的事，挺上心啊。"

[sub_resource type="Resource" id="Resource_otdv7"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 913.766
duration = 1.48
stream = ExtResource("206_3s06g")
text = "你想说什么？"

[sub_resource type="Resource" id="Resource_ni41g"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 915.646
duration = 7.16
stream = ExtResource("207_i01w1")
text = "院长让我烧一只箱子，樟木的，从档案室搬出来。我没烧。"

[sub_resource type="Resource" id="Resource_b0xk2"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 923.206
duration = 0.92
stream = ExtResource("208_4d0c4")
text = "（压低声音）箱子在哪？"
loudness = 0.3

[sub_resource type="Resource" id="Resource_h45pp"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 924.526
duration = 1.8
stream = ExtResource("209_0jlmh")
text = "走，到洗衣房说。"

[sub_resource type="Resource" id="Resource_00axk"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 928.643
duration = 3.56
stream = ExtResource("210_1js1q")
text = "就在这堆被单底下。锁着呢，我没打开。"

[sub_resource type="Resource" id="Resource_wwpgx"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 932.603
duration = 1.84
stream = ExtResource("211_iuu5r")
text = "你知道里面是什么吗？"

[sub_resource type="Resource" id="Resource_rarc6"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 934.843
duration = 4.56
stream = ExtResource("212_481bh")
text = "不知道。院长要烧，又不让问，那肯定是要命的东西。"

[sub_resource type="Resource" id="Resource_j7ybq"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 938.0
duration = 4.96
stream = ExtResource("213_50vsq")
text = "白露，是我，小梅。陈医生让我来陪你。"

[sub_resource type="Resource" id="Resource_bt5cv"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 939.803
duration = 1.44
stream = ExtResource("214_j63eh")
text = "是三条人命。"

[sub_resource type="Resource" id="Resource_0usvv"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 941.643
duration = 1.8
stream = ExtResource("215_26f1k")
text = "（愣住）……三条？"

[sub_resource type="Resource" id="Resource_xgosm"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 943.36
duration = 3.84
stream = ExtResource("216_ly28v")
text = "小梅姐……你听见了吗，刚才那个敲门声。"

[sub_resource type="Resource" id="Resource_g4x02"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 943.843
duration = 4.8
stream = ExtResource("217_71asx")
text = "十年前西翼烧死的三个人。里面是他拿病人做试验的记录。"

[sub_resource type="Resource" id="Resource_uw03b"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 947.6
duration = 4.0
stream = ExtResource("218_muuu4")
text = "听见了。别怕，我在这儿。"

[sub_resource type="Resource" id="Resource_rxtma"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 949.043
duration = 6.84
stream = ExtResource("219_5cb8f")
text = "那……那它更值钱了。五百，陈医生，五百块，箱子归你。"

[sub_resource type="Resource" id="Resource_gtp80"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 952.0
duration = 3.96
stream = ExtResource("220_e0p3i")
text = "小梅姐，你相信人能记起被忘掉的事吗？"

[sub_resource type="Resource" id="Resource_0llbk"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 956.283
duration = 1.32
stream = ExtResource("221_jtn6i")
text = "我没有五百块。"

[sub_resource type="Resource" id="Resource_rs5wy"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 956.36
duration = 1.36
stream = ExtResource("222_xogs2")
text = "你想起什么了？"

[sub_resource type="Resource" id="Resource_jjr3i"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 958.003
duration = 2.84
stream = ExtResource("223_55bx1")
text = "那我只好等院长出价了。他出得起三倍。"

[sub_resource type="Resource" id="Resource_1ch41"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 958.12
duration = 5.08
stream = ExtResource("224_uib63")
text = "那天晚上，门外面的人锁门的时候，我从门缝里闻到一股味道。"

[sub_resource type="Resource" id="Resource_2j7k2"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 961.243
duration = 4.76
stream = ExtResource("225_0sc6l")
text = "阿强，你把它卖回给院长，就等于帮他把那三个人再烧一遍。"

[sub_resource type="Resource" id="Resource_m5v7g"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 963.6
duration = 4.4
stream = ExtResource("226_4xg51")
text = "后来，从窗户把我拉出去的人，身上也是这个味道。"

[sub_resource type="Resource" id="Resource_8p7gh"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 966.403
duration = 5.92
stream = ExtResource("227_6yjsv")
text = "我……我一个月就挣三十块！我娘还在床上躺着！"

[sub_resource type="Resource" id="Resource_rr6cu"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 968.4
duration = 0.88
stream = ExtResource("228_wexy5")
text = "什么味道？"

[sub_resource type="Resource" id="Resource_18lkq"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 969.68
duration = 5.84
stream = ExtResource("229_6hvkg")
text = "桂花头油。甜甜的，很好闻。锁门的人，和救我的人，是同一个味道。"

[sub_resource type="Resource" id="Resource_y07um"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 972.723
duration = 5.04
stream = ExtResource("230_c80hk")
text = "等雪化了，我带你下山作证。该你拿的，一分不会少。"

[sub_resource type="Resource" id="Resource_xroao"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 975.92
duration = 2.24
stream = ExtResource("231_1okcy")
text = "（愣住）桂花头油……"

[sub_resource type="Resource" id="Resource_qp580"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 978.163
duration = 4.72
stream = ExtResource("232_2ey4i")
text = "（犹豫）……让我想想。天亮之前，箱子我不动。"

[sub_resource type="Resource" id="Resource_1nqxk"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 978.56
duration = 1.8
stream = ExtResource("233_ynxfe")
text = "你知道是谁？"

[sub_resource type="Resource" id="Resource_6umka"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 980.76
duration = 6.08
stream = ExtResource("234_1jphr")
text = "护士长……护士长每天早上都抹桂花头油。整个院里，就她一个人用。"

[sub_resource type="Resource" id="Resource_ognd0"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 983.283
duration = 2.92
stream = ExtResource("235_tn0nh")
text = "好。被单底下，别让任何人知道。"

[sub_resource type="Resource" id="Resource_xua28"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 987.24
duration = 1.08
stream = ExtResource("236_6xxes")
text = "（颤抖）护士长……"

[sub_resource type="Resource" id="Resource_aq3xm"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 988.72
duration = 2.92
stream = ExtResource("237_8mpr5")
text = "不、不会的，也许是巧合……"

[sub_resource type="Resource" id="Resource_271ej"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 1012.0
duration = 4.8
stream = ExtResource("238_oqh40")
text = "护士长……陈医生说，今晚不让给白露打针……"

[sub_resource type="Resource" id="Resource_i6p42"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1017.2
duration = 4.0
stream = ExtResource("239_kjufa")
text = "陈医生说？这个院里，什么时候轮到他说了？"

[sub_resource type="Resource" id="Resource_mo1pq"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 1021.6
duration = 2.96
stream = ExtResource("240_p2ctw")
text = "他说，三支会要了她的命……"

[sub_resource type="Resource" id="Resource_sx5ki"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1024.96
duration = 2.96
stream = ExtResource("241_yuq22")
text = "出去。在门口站着，没叫你别进来。"

[sub_resource type="Resource" id="Resource_lnriq"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1028.32
duration = 1.84
stream = ExtResource("242_s4oe0")
text = "白露，还没睡？"

[sub_resource type="Resource" id="Resource_qnghl"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 1030.56
duration = 2.92
stream = ExtResource("243_eulf6")
text = "护士长……你手里拿的是什么？"

[sub_resource type="Resource" id="Resource_lxg2f"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1033.88
duration = 3.48
stream = ExtResource("244_njdcu")
text = "安神的针。打了，就不做噩梦了。"

[sub_resource type="Resource" id="Resource_a5bnu"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 1037.76
duration = 3.52
stream = ExtResource("245_mg37o")
text = "你走近一点……你身上……是桂花的味道。"

[sub_resource type="Resource" id="Resource_shpfp"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 1043.68
duration = 5.8
stream = ExtResource("246_irofs")
text = "那天晚上，是你。是你把窗户砸开，把我从火里拖出去的。"

[sub_resource type="Resource" id="Resource_3rlwc"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1049.88
duration = 1.76
stream = ExtResource("247_1mfer")
text = "你……你记得？"

[sub_resource type="Resource" id="Resource_f3nyw"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 1050.0
duration = 4.68
stream = ExtResource("248_32hku")
text = "教授，箱子找到了。阿强没烧，藏在洗衣房。"

[sub_resource type="Resource" id="Resource_ikgsf"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 1052.04
duration = 4.92
stream = ExtResource("249_hw2xq")
text = "我记得你的手，全是血，玻璃扎的。你一边拖我，一边哭。"

[sub_resource type="Resource" id="Resource_np70u"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 1055.08
duration = 3.36
stream = ExtResource("250_uew1m")
text = "好。老宋啊老宋，你连个护工都收买不住。"

[sub_resource type="Resource" id="Resource_5v2ub"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1057.36
duration = 2.16
stream = ExtResource("251_yftjt")
text = "（哽咽）……我以为你什么都不记得了。"

[sub_resource type="Resource" id="Resource_xerkh"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 1058.84
duration = 5.96
stream = ExtResource("252_77x16")
text = "还有一件事。院长让护士长今晚给白露打七号，三支。"

[sub_resource type="Resource" id="Resource_vlnvh"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 1059.92
duration = 3.2
stream = ExtResource("253_aj4wb")
text = "可是锁门的……也是你，对不对？"

[sub_resource type="Resource" id="Resource_18jyt"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1063.52
duration = 0.52
stream = ExtResource("254_hbmua")
text = "（良久）是我。"

[sub_resource type="Resource" id="Resource_bahyn"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 1064.44
duration = 0.8
stream = ExtResource("255_wtyu7")
text = "为什么？"

[sub_resource type="Resource" id="Resource_mhik2"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 1065.2
duration = 1.28
stream = ExtResource("256_fjb84")
text = "（手里的棋子掉了）三支？"

[sub_resource type="Resource" id="Resource_avqak"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1065.64
duration = 10.52
stream = ExtResource("257_xg4k0")
text = "有人让我锁。我锁完，走到楼梯口，听见里面在喊。我又跑回去，门打不开了，钥匙拧不动，我只砸开了一扇窗户。"

[sub_resource type="Resource" id="Resource_gfon0"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 1066.88
duration = 8.28
stream = ExtResource("258_038sh")
text = "三支七号，心脏会像被一只手攥住，一点一点停下来。半个钟头以后，什么都查不出来，只像一次心肌梗死。"

[sub_resource type="Resource" id="Resource_odcwi"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 1075.56
duration = 1.92
stream = ExtResource("259_of30y")
text = "我让小梅上去守着了。"

[sub_resource type="Resource" id="Resource_qle5e"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1076.56
duration = 3.0
stream = ExtResource("260_rbubi")
text = "窗户太小，只够塞进一个孩子。"

[sub_resource type="Resource" id="Resource_knkp8"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 1077.88
duration = 1.72
stream = ExtResource("261_ko71v")
text = "小梅拦不住冯秀英。"

[sub_resource type="Resource" id="Resource_3og1j"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 1079.96
duration = 4.52
stream = ExtResource("262_cnrao")
text = "许姐姐……许姐姐把我举到窗户上。她说，小露，低头。"

[sub_resource type="Resource" id="Resource_jnqqv"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 1080.0
duration = 1.16
stream = ExtResource("263_3ajfe")
text = "那我上去。"

[sub_resource type="Resource" id="Resource_nuxgy"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 1081.56
duration = 6.28
stream = ExtResource("264_fqyvj")
text = "别急。冯秀英这个人，我看了十年。她不是宋启年。十年前那扇门，她是哭着锁的。"

[sub_resource type="Resource" id="Resource_hn3k3"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1084.88
duration = 7.2
stream = ExtResource("265_aa407")
text = "（痛哭）对不起……对不起……"

[sub_resource type="Resource" id="Resource_1agm4"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 1088.24
duration = 3.48
stream = ExtResource("266_5b2fo")
text = "哭着锁的，门也锁上了。"

[sub_resource type="Resource" id="Resource_pdrvd"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 1092.12
duration = 1.68
stream = ExtResource("267_e80fo")
text = "是啊……锁上了。"

[sub_resource type="Resource" id="Resource_wtjik"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 1092.48
duration = 4.04
stream = ExtResource("268_8vt33")
text = "护士长，你今晚是来……让我睡过去的吗？"

[sub_resource type="Resource" id="Resource_rcmtm"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 1094.2
duration = 5.24
stream = ExtResource("269_ok75g")
text = "我去值班室把病历整理出来。天一亮，雪一停，我就带着箱子下山。"

[sub_resource type="Resource" id="Resource_4tyia"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1096.92
duration = 3.56
stream = ExtResource("270_1au0h")
text = "（停顿）……不是。睡吧，今晚没有针。"

[sub_resource type="Resource" id="Resource_mccwc"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 1100.88
duration = 0.92
stream = ExtResource("271_68y8e")
text = "真的？"

[sub_resource type="Resource" id="Resource_1dxsm"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1102.2
duration = 4.36
stream = ExtResource("272_hs8oi")
text = "真的。好好睡，明天早上，太阳会出来的。"

[sub_resource type="Resource" id="Resource_f5rjd"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 1106.96
duration = 2.48
stream = ExtResource("273_474sq")
text = "护士长……针……"

[sub_resource type="Resource" id="Resource_ddrtr"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1109.84
duration = 2.92
stream = ExtResource("274_w2edu")
text = "没打。今晚的事，你烂在肚子里。"

[sub_resource type="Resource" id="Resource_uw7u2"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 1113.16
duration = 1.72
stream = ExtResource("275_oin00")
text = "那院长那边……"

[sub_resource type="Resource" id="Resource_7b6ex"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1115.28
duration = 1.76
stream = ExtResource("276_17atw")
text = "院长那边，我去说。"

[sub_resource type="Resource" id="Resource_i6ysj"]
script = ExtResource("9_0vga1")
speaker = &"E"
start = 1170.757
duration = 4.56
stream = ExtResource("277_0r3i1")
text = "（自言自语）白衣服的……又下来了……"
loudness = 0.3

[sub_resource type="Resource" id="Resource_1quxw"]
script = ExtResource("9_0vga1")
speaker = &"E"
start = 1175.717
duration = 3.72
stream = ExtResource("278_xnami")
text = "手里拿个亮晶晶的……进院长屋了……"

[sub_resource type="Resource" id="Resource_tgb5h"]
script = ExtResource("9_0vga1")
speaker = &"E"
start = 1179.837
duration = 2.16
stream = ExtResource("279_sf4dp")
text = "跟那天一样，脸是白的……"

[sub_resource type="Resource" id="Resource_5j2hn"]
script = ExtResource("9_0vga1")
speaker = &"E"
start = 1185.423
duration = 3.84
stream = ExtResource("280_f35nf")
text = "教授！白衣服的又来了！她进了院长的屋！"

[sub_resource type="Resource" id="Resource_oqdrs"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 1189.663
duration = 2.24
stream = ExtResource("281_kipas")
text = "老金，慢点说。谁？"

[sub_resource type="Resource" id="Resource_8dcbw"]
script = ExtResource("9_0vga1")
speaker = &"E"
start = 1192.303
duration = 9.6
stream = ExtResource("282_4grju")
text = "白衣服的，护士长！手里拿着针管子，亮晶晶的。脸白得吓人，跟那天锁门的时候一模一样！"

[sub_resource type="Resource" id="Resource_1qj6y"]
script = ExtResource("9_0vga1")
speaker = &"E"
start = 1204.303
duration = 4.16
stream = ExtResource("283_xthiw")
text = "教授，你说她又要锁谁？"

[sub_resource type="Resource" id="Resource_f7op8"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 1208.863
duration = 3.12
stream = ExtResource("284_flcta")
text = "老金，坐下。今晚，哪儿也别去了。"

[sub_resource type="Resource" id="Resource_yey1u"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 1225.0
duration = 0.64
stream = ExtResource("285_6eli8")
text = "打了？"

[sub_resource type="Resource" id="Resource_nyc3g"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1226.04
duration = 0.96
stream = ExtResource("286_6xsx4")
text = "打了。"

[sub_resource type="Resource" id="Resource_b2a6d"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 1227.4
stream = ExtResource("287_04byq")
text = "睡着了？"

[sub_resource type="Resource" id="Resource_jnbn4"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1228.8
duration = 2.48
stream = ExtResource("288_stlxb")
text = "睡着了。睡得很安稳。"

[sub_resource type="Resource" id="Resource_5bqs2"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 1231.68
duration = 4.4
stream = ExtResource("289_dv0ya")
text = "好。好。这事过去了，秀英，我不会亏待你。"

[sub_resource type="Resource" id="Resource_3blxb"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 1236.48
duration = 4.28
stream = ExtResource("290_5oehx")
text = "给我倒杯水。心口有点闷，这两天总是睡不好。"

[sub_resource type="Resource" id="Resource_6u7p5"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1241.16
duration = 3.84
stream = ExtResource("291_akj64")
text = "院长，您还记得西翼那扇门锁上的声音吗？"

[sub_resource type="Resource" id="Resource_0h5ce"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 1245.4
duration = 1.36
stream = ExtResource("292_skaet")
text = "什么声音？"

[sub_resource type="Resource" id="Resource_u37w6"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1247.16
duration = 3.36
stream = ExtResource("293_72nkr")
text = "咔哒。很轻。就像这样。"

[sub_resource type="Resource" id="Resource_j17l6"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 1250.92
duration = 3.88
stream = ExtResource("294_en8dn")
text = "你干什么——你手里拿的……那是给白露的……"

[sub_resource type="Resource" id="Resource_yh8n8"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1255.2
duration = 2.76
stream = ExtResource("295_guxjd")
text = "（低声）这一针，是替她们三个打的。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_ab3en"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 1258.36
duration = 4.68
stream = ExtResource("296_24uym")
text = "（惊叫）冯秀英！你、你疯了……来……来人……"

[sub_resource type="Resource" id="Resource_3chb0"]
script = ExtResource("9_0vga1")
speaker = &"A"
start = 1263.44
duration = 2.92
stream = ExtResource("297_87m37")
text = "（喘息）秀英……我的心口……"

[sub_resource type="Resource" id="Resource_lal12"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1266.76
duration = 4.4
stream = ExtResource("298_81gyc")
text = "一点一点停下来，不疼。顾教授说的。"

[sub_resource type="Resource" id="Resource_0qe4w"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1275.56
duration = 5.16
stream = ExtResource("299_e64am")
text = "（低声）十年了，西翼的门该开了。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_8uxi1"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1281.12
duration = 2.16
stream = ExtResource("300_221sg")
text = "这张纸，我替你收着。"

[sub_resource type="Resource" id="Resource_jxadl"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 1338.0
duration = 2.4
stream = ExtResource("301_qxcs7")
text = "护士长？这么晚来锅炉房？"

[sub_resource type="Resource" id="Resource_35xqx"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1340.8
duration = 1.48
stream = ExtResource("302_r4143")
text = "烧点东西。"

[sub_resource type="Resource" id="Resource_hbwpc"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 1342.68
duration = 4.8
stream = ExtResource("303_ay8um")
text = "那是……院长的信纸？上面还有红手印……"

[sub_resource type="Resource" id="Resource_u4m3k"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1347.88
duration = 2.0
stream = ExtResource("304_oj1gp")
text = "你什么都没看见。"

[sub_resource type="Resource" id="Resource_0tqwr"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 1350.28
duration = 0.92
stream = ExtResource("305_y1y8d")
text = "我……"

[sub_resource type="Resource" id="Resource_ts0q6"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1351.6
duration = 4.04
stream = ExtResource("306_kygt3")
text = "洗衣房被单底下那只樟木箱，我也什么都没看见。"

[sub_resource type="Resource" id="Resource_p5rmd"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 1356.04
duration = 1.44
stream = ExtResource("307_bwp44")
text = "（一惊）你、你怎么知道……"

[sub_resource type="Resource" id="Resource_gqbe3"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1357.88
duration = 3.64
stream = ExtResource("308_gjjnk")
text = "二十年，这栋楼里没有我不知道的事。"

[sub_resource type="Resource" id="Resource_yn1ej"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1361.92
duration = 2.96
stream = ExtResource("309_23rgk")
text = "阿强，那只箱子，别卖。交给陈医生。"

[sub_resource type="Resource" id="Resource_7hdaf"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 1365.28
duration = 2.12
stream = ExtResource("310_skef0")
text = "护士长，你……"

[sub_resource type="Resource" id="Resource_tbl65"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1367.8
duration = 3.84
stream = ExtResource("311_n8upe")
text = "炉子烧得真旺。十年前，西翼也是这么旺。"

[sub_resource type="Resource" id="Resource_72mkn"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1375.788
duration = 0.92
stream = ExtResource("312_1jy0n")
text = "（自言自语）都烧干净了。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_ikfea"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 1461.675
duration = 3.64
stream = ExtResource("313_kec1x")
text = "院长，我们需要再谈谈白露——"

[sub_resource type="Resource" id="Resource_v6ym5"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 1465.715
duration = 0.72
stream = ExtResource("314_cwmwa")
text = "院长？"

[sub_resource type="Resource" id="Resource_1hug2"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 1466.835
duration = 2.88
stream = ExtResource("315_gpi34")
text = "院长！你怎么了？院长！"

[sub_resource type="Resource" id="Resource_2bqpk"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 1470.115
duration = 3.96
stream = ExtResource("316_lkndh")
text = "（大喊）来人！快来人！院长出事了！"
loudness = 0.9

[sub_resource type="Resource" id="Resource_x5ras"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1476.158
duration = 0.76
stream = ExtResource("317_cyphg")
text = "怎么了？"

[sub_resource type="Resource" id="Resource_5og6q"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 1477.318
duration = 5.52
stream = ExtResource("318_q01mh")
text = "没有呼吸了，瞳孔散了。护士长，快拿强心针！"

[sub_resource type="Resource" id="Resource_iffj0"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1483.238
duration = 2.8
stream = ExtResource("319_ogmc1")
text = "（平静地）不用了。他心脏一直不好，我早劝过他。"

[sub_resource type="Resource" id="Resource_0qpg4"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 1486.438
duration = 3.8
stream = ExtResource("320_qyatr")
text = "心脏不好？下午他还好好的！"

[sub_resource type="Resource" id="Resource_rm1sg"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1490.638
duration = 2.84
stream = ExtResource("321_bs4n4")
text = "心肌梗死，来得快。"

[sub_resource type="Resource" id="Resource_uf1gt"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 1496.574
duration = 5.16
stream = ExtResource("322_i3856")
text = "（尖叫）啊——院长！院长他……"
loudness = 0.9

[sub_resource type="Resource" id="Resource_ckxlt"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 1502.134
duration = 3.2
stream = ExtResource("323_l2j7o")
text = "小梅，别碰任何东西。"

[sub_resource type="Resource" id="Resource_dcg7q"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 1505.734
duration = 5.04
stream = ExtResource("324_86ftw")
text = "等等……脖子这里，有一个针眼。新的。"

[sub_resource type="Resource" id="Resource_57bkq"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1511.174
duration = 2.12
stream = ExtResource("325_yw3ur")
text = "下午我给他打过降压针。"

[sub_resource type="Resource" id="Resource_ka8u7"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 1513.694
duration = 3.68
stream = ExtResource("326_e352b")
text = "降压针打在胳膊上，不打在脖子上。"

[sub_resource type="Resource" id="Resource_4vtib"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 1517.774
duration = 7.24
stream = ExtResource("327_crvq4")
text = "护士长……那管配好的七号，三支的……刚才在楼上，针管就是满的……"

[sub_resource type="Resource" id="Resource_6hdx0"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1525.414
duration = 1.24
stream = ExtResource("328_kkkp1")
text = "小梅。"

[sub_resource type="Resource" id="Resource_ooq7i"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 1527.054
duration = 3.6
stream = ExtResource("329_7d8di")
text = "可现在……它在院长桌子上……空了。"

[sub_resource type="Resource" id="Resource_b7jp6"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 1531.054
duration = 2.88
stream = ExtResource("330_18eyp")
text = "（缓缓地）护士长，三支七号，你给了谁？"

[sub_resource type="Resource" id="Resource_k3fqg"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 1537.901
duration = 1.64
stream = ExtResource("331_nrl3h")
text = "不用问了。"

[sub_resource type="Resource" id="Resource_r7tov"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 1539.941
duration = 6.48
stream = ExtResource("332_18lnb")
text = "三支七号，心脏像被一只手攥住，一点一点停下来。查出来，就是心肌梗死。"

[sub_resource type="Resource" id="Resource_2rw24"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 1546.821
duration = 5.2
stream = ExtResource("333_nalqp")
text = "这是十年前，我写在报告里的。全院知道这句话的，只有三个人。"

[sub_resource type="Resource" id="Resource_tonsa"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 1552.421
duration = 3.28
stream = ExtResource("334_ra1nx")
text = "我，宋启年，还有你，冯秀英。"

[sub_resource type="Resource" id="Resource_tusqx"]
script = ExtResource("9_0vga1")
speaker = &"E"
start = 1556.101
duration = 7.44
stream = ExtResource("335_ycuvy")
text = "白衣服的……白衣服的进了院长屋……我看见了，我看见了！"

[sub_resource type="Resource" id="Resource_pton5"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 1570.902
duration = 3.24
stream = ExtResource("336_45p24")
text = "陈医生……我想好了。箱子……我交给你。"

[sub_resource type="Resource" id="Resource_is53c"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 1574.542
duration = 3.68
stream = ExtResource("337_jpue1")
text = "院长让我烧的，我没烧。在洗衣房被单底下。"

[sub_resource type="Resource" id="Resource_7b3j4"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 1578.622
duration = 2.6
stream = ExtResource("338_kp67l")
text = "谢谢你，阿强。"

[sub_resource type="Resource" id="Resource_m2ogl"]
script = ExtResource("9_0vga1")
speaker = &"F"
start = 1581.622
duration = 5.04
stream = ExtResource("339_5dvfp")
text = "还有……刚才护士长在锅炉房烧了一张纸，上面有院长的红手印。"

[sub_resource type="Resource" id="Resource_wkhe5"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1587.062
duration = 4.92
stream = ExtResource("340_qfbd5")
text = "（平静）是证词。他写的，说十年前西翼的门，是我擅自锁的。"

[sub_resource type="Resource" id="Resource_41fvb"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 1592.382
duration = 1.4
stream = ExtResource("341_pnucx")
text = "是你锁的吗？"

[sub_resource type="Resource" id="Resource_b07qp"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1594.182
duration = 2.6
stream = ExtResource("342_copvx")
text = "是我锁的。是他让我锁的。"

[sub_resource type="Resource" id="Resource_ctoeo"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1597.182
duration = 5.8
stream = ExtResource("343_t1hh4")
text = "他今晚又让我去锁一次门。锁在一个十二岁就该死掉的孩子身上。"

[sub_resource type="Resource" id="Resource_y3lsv"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1603.382
duration = 1.76
stream = ExtResource("344_prgi8")
text = "我锁不动了。"

[sub_resource type="Resource" id="Resource_qmi5w"]
script = ExtResource("9_0vga1")
speaker = &"G"
start = 1605.542
duration = 0.84
stream = ExtResource("345_8ap0e")
text = "（哭）护士长……"

[sub_resource type="Resource" id="Resource_gwplj"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 1612.303
duration = 1.68
stream = ExtResource("346_xxei0")
text = "护士长。"

[sub_resource type="Resource" id="Resource_ldy3b"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1614.383
duration = 2.04
stream = ExtResource("347_srmdo")
text = "白露？你怎么下来了？"

[sub_resource type="Resource" id="Resource_tewbd"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 1616.823
duration = 3.92
stream = ExtResource("348_ryqy4")
text = "我听见楼下在喊。小梅姐不在门口，我就下来了。"

[sub_resource type="Resource" id="Resource_qtswd"]
script = ExtResource("9_0vga1")
speaker = &"D"
start = 1621.143
duration = 5.76
stream = ExtResource("349_kbla0")
text = "陈医生，是她锁的门。可也是她，回来砸开窗户，把我拖出来的。"

[sub_resource type="Resource" id="Resource_0f0vn"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 1627.303
duration = 0.48
stream = ExtResource("350_ita7a")
text = "（低声）……我知道。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_w3jif"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 1628.183
duration = 3.96
stream = ExtResource("351_uuxc7")
text = "冯护士长，那一扇窗户，换不回我妹妹。"

[sub_resource type="Resource" id="Resource_jl7t6"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1632.543
duration = 3.6
stream = ExtResource("352_ntevg")
text = "我知道。许晴……你是许晴的哥哥？"

[sub_resource type="Resource" id="Resource_vhdo6"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 1636.543
duration = 1.24
stream = ExtResource("353_hobas")
text = "许致远。"

[sub_resource type="Resource" id="Resource_cvn4w"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1638.183
duration = 4.84
stream = ExtResource("354_qvfjm")
text = "你们的眼睛长得一样。她那天晚上……一直在喊“哥哥”。"

[sub_resource type="Resource" id="Resource_tewsd"]
script = ExtResource("9_0vga1")
speaker = &"H"
start = 1645.423
duration = 6.44
stream = ExtResource("355_g6icv")
text = "致远，箱子里的东西，够让他在地底下也不得安生了。剩下的，交给山下的人吧。"

[sub_resource type="Resource" id="Resource_cni6s"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1652.263
duration = 5.32
stream = ExtResource("356_rfeub")
text = "雪停了，你们就带我下山。在那之前……让我去西翼看一看。"

[sub_resource type="Resource" id="Resource_s3cdp"]
script = ExtResource("9_0vga1")
speaker = &"C"
start = 1657.983
duration = 1.04
stream = ExtResource("357_hhvhq")
text = "你要去哪？"

[sub_resource type="Resource" id="Resource_anp7q"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1659.423
duration = 2.56
stream = ExtResource("358_f1efb")
text = "去开门。十年了，一直没人去开。"

[sub_resource type="Resource" id="Resource_bomb3"]
script = ExtResource("9_0vga1")
speaker = &"E"
start = 1662.383
duration = 4.08
stream = ExtResource("359_ihvu3")
text = "我跟你去……我有钥匙，我一直留着……"

[sub_resource type="Resource" id="Resource_oq84o"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1674.417
duration = 3.84
stream = ExtResource("360_21jea")
text = "（低声）小晴，小周，阿芬……我来开门了。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_4qyh3"]
script = ExtResource("9_0vga1")
speaker = &"E"
start = 1678.657
duration = 3.2
stream = ExtResource("361_ke5l6")
text = "（低声）门开了……出来吧，都出来吧……"
loudness = 0.3

[sub_resource type="Resource" id="Resource_qn56t"]
script = ExtResource("9_0vga1")
speaker = &"B"
start = 1682.257
duration = 2.72
stream = ExtResource("362_l2qsq")
text = "（低声）外面下雪了。很干净。"
loudness = 0.3

[resource]
script = ExtResource("5_8errn")
id = &"case8"
title = "白桦岭疗养院"
description = "1987年冬，大雪封山。白桦岭疗养院的电话线断了，楼里只剩下八个人。
十年前，西翼病房的一场大火烧死了三个病人；最近，每到深夜，总有人去敲西翼那扇早已封死的门。
今晚十一点，你就在这栋楼里。"
