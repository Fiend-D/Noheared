speaker = &"F"
start = 9.72
duration = 5.88
stream = ExtResource("9_ld20a")
text = "方叔，我亲眼看见的。音乐厅侧幕站着一个女人，脸蒙着纱。"

[sub_resource type="Resource" id="Resource_ou6dh"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 16.0
duration = 6.12
stream = ExtResource("10_6i2kx")
text = "林晚宁还在化妆间。纱不是她。今晚是她的独奏，别自己吓自己。"

[sub_resource type="Resource" id="Resource_chwec"]
script = ExtResource("7_wfn1y")
speaker = &"F"
start = 22.52
duration = 4.96
stream = ExtResource("11_x1jut")
text = "不是林晚宁。那人身量矮一截，白纱是旧道具箱里的。"

[sub_resource type="Resource" id="Resource_10r8q"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 27.88
duration = 5.12
stream = ExtResource("12_6ecvd")
text = "旧纱是梵音的。人都走了这么多年，石伯别再提那个名字。"

[sub_resource type="Resource" id="Resource_lg25n"]
script = ExtResource("7_wfn1y")
speaker = &"F"
start = 33.4
duration = 6.64
stream = ExtResource("13_ncgw8")
text = "梵音的名字是你不让提。清洁工石伯只负责把看见的说出来。"

[sub_resource type="Resource" id="Resource_5ctv5"]
script = ExtResource("7_wfn1y")
speaker = &"G"
start = 40.44
duration = 4.48
stream = ExtResource("14_efubo")
text = "阿凯在舞台上对灯。林晚宁一上台，侧幕必须是空的。"

[sub_resource type="Resource" id="Resource_2xs41"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 45.32
duration = 5.36
stream = ExtResource("15_6kxxd")
text = "空着。乔安把这场独奏抢到谱风剧院，砸了招牌我负责不起。"

[sub_resource type="Resource" id="Resource_tnl15"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 58.124
duration = 5.12
stream = ExtResource("16_2yhrn")
text = "方叔，嘉宾已经进音乐厅了。林晚宁的水，我让人放在化妆间。"

[sub_resource type="Resource" id="Resource_5ct7n"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 63.644
duration = 4.0
stream = ExtResource("17_hix24")
text = "乔安你少指挥到后台。水杯的事让阮琪管。"

[sub_resource type="Resource" id="Resource_uxvvs"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 68.044
duration = 4.44
stream = ExtResource("18_5g4cf")
text = "阮琪管琴，不管水。我放一杯温的，林晚宁喝了润手。"

[sub_resource type="Resource" id="Resource_16l1f"]
script = ExtResource("7_wfn1y")
speaker = &"F"
start = 72.884
duration = 5.16
stream = ExtResource("19_ppfr6")
text = "乔安先生，你经过侧幕的时候，有没有看见白纱？"

[sub_resource type="Resource" id="Resource_ux1es"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 78.444
duration = 5.52
stream = ExtResource("20_5sxc5")
text = "没有。石伯眼睛花了。白纱是道具室的布，罗茵在那儿整理。"

[sub_resource type="Resource" id="Resource_ctu75"]
script = ExtResource("7_wfn1y")
speaker = &"A"
start = 84.364
duration = 4.68
stream = ExtResource("21_loial")
text = "阮琪老师，手还是冷。林晚宁想先在琴上坐五分钟。"

[sub_resource type="Resource" id="Resource_lxdh4"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 91.678
duration = 6.12
stream = ExtResource("22_878oa")
text = "坐。水杯在右手边，乔安说是温的。你润一口再上台。"

[sub_resource type="Resource" id="Resource_6m1q2"]
script = ExtResource("7_wfn1y")
speaker = &"A"
start = 98.198
duration = 5.08
stream = ExtResource("23_s4may")
text = "我不喝别人倒的。林晚宁自己倒，阮琪你知道的。"

[sub_resource type="Resource" id="Resource_16hdj"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 103.678
duration = 4.36
stream = ExtResource("24_5j3va")
text = "今天例外。乔安办的这场，方叔把后台都让给他了。"

[sub_resource type="Resource" id="Resource_ychel"]
script = ExtResource("7_wfn1y")
speaker = &"C"
start = 108.438
duration = 5.16
stream = ExtResource("25_l6jw8")
text = "（低声）纱在道具室。林晚宁要是出来，罗茵就先躲到侧幕后面。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_ie8rh"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 117.312
duration = 3.2
stream = ExtResource("26_xei66")
text = "晚宁，喝一口。上台之前别让嘴唇干。"

[sub_resource type="Resource" id="Resource_b0kk7"]
script = ExtResource("7_wfn1y")
speaker = &"A"
start = 120.912
duration = 5.28
stream = ExtResource("27_0cl80")
text = "乔安，杯子是你放的？那我等阮琪老师喝过第一口。"

[sub_resource type="Resource" id="Resource_bogyf"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 126.592
duration = 5.4
stream = ExtResource("28_lixuh")
text = "我不喝。学员的水，导师不抢。林晚宁你自己决定。"

[sub_resource type="Resource" id="Resource_sjtgi"]
script = ExtResource("7_wfn1y")
speaker = &"A"
start = 132.392
duration = 4.64
stream = ExtResource("29_5ahrs")
text = "那就一口。谢了，乔安。剩下的我彩排完再喝。"

[sub_resource type="Resource" id="Resource_fiomw"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 137.432
duration = 4.24
stream = ExtResource("30_qj1tr")
text = "她喝了。阮琪在化妆间看着那杯子，水面齐了一线。"

[sub_resource type="Resource" id="Resource_40wx5"]
script = ExtResource("7_wfn1y")
speaker = &"G"
start = 142.072
duration = 4.44
stream = ExtResource("31_do0xy")
text = "林晚宁上台了。阿凯把追光压低，别打到侧幕。"

[sub_resource type="Resource" id="Resource_q0nch"]
script = ExtResource("7_wfn1y")
speaker = &"F"
start = 151.663
duration = 5.84
stream = ExtResource("32_cl6ep")
text = "舞台上是林晚宁。可音乐厅侧幕刚才又动了一下白纱。"

[sub_resource type="Resource" id="Resource_itnlb"]
script = ExtResource("7_wfn1y")
speaker = &"G"
start = 157.903
duration = 4.56
stream = ExtResource("33_vrl5w")
text = "石伯你站好。侧幕归阿凯看，你别挡灯。"

[sub_resource type="Resource" id="Resource_o26ue"]
script = ExtResource("7_wfn1y")
speaker = &"C"
start = 162.863
duration = 4.88
stream = ExtResource("34_vocc2")
text = "（低声）乔安，粉已经在杯底了。她喝下去，半个时辰内会倒。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_fdp25"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 168.143
duration = 5.08
stream = ExtResource("35_y8bt6")
text = "青矾散无色。罗茵你别在这儿打开纸包，见了空气会发绿。"

[sub_resource type="Resource" id="Resource_8l6cg"]
script = ExtResource("7_wfn1y")
speaker = &"C"
start = 173.623
duration = 4.16
stream = ExtResource("36_v184a")
text = "发绿就发绿。我要的是你选我，不是选林晚宁。"

[sub_resource type="Resource" id="Resource_n2tm5"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 178.183
duration = 4.52
stream = ExtResource("37_nnda5")
text = "录音那句你别再放。昨夜你说只能留一个，我听见了。"

[sub_resource type="Resource" id="Resource_6qykt"]
script = ExtResource("7_wfn1y")
speaker = &"C"
start = 183.103
duration = 5.0
stream = ExtResource("38_m5lws")
text = "那就今晚留我。梵音的纱我披上，方叔一看见就不敢问。"

[sub_resource type="Resource" id="Resource_xo612"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 188.503
duration = 4.08
stream = ExtResource("39_ev74k")
text = "方叔怕的不是鬼，是当年那份压下去的验尸。"

[sub_resource type="Resource" id="Resource_s7lo4"]
script = ExtResource("7_wfn1y")
speaker = &"C"
start = 192.983
duration = 6.8
stream = ExtResource("40_2027n")
text = "验尸写服毒。乔安你把梵音推上她扛不住的第一场，她自己喝的。"

[sub_resource type="Resource" id="Resource_l06vx"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 200.183
duration = 4.64
stream = ExtResource("41_21ri7")
text = "是她自己喝的。可条子要是见报，谱风剧院就没有下一季。"

[sub_resource type="Resource" id="Resource_i56q5"]
script = ExtResource("7_wfn1y")
speaker = &"C"
start = 205.223
duration = 6.36
stream = ExtResource("42_p8eqk")
text = "所以白纱还得出现。罗茵去音乐厅绕一圈，你去办公室看着方叔。"

[sub_resource type="Resource" id="Resource_xc5dr"]
script = ExtResource("7_wfn1y")
speaker = &"F"
start = 211.983
duration = 5.84
stream = ExtResource("43_iow7n")
text = "音乐厅侧幕又是白纱。石伯可以发誓，林晚宁人在舞台上。"

[sub_resource type="Resource" id="Resource_qo7ih"]
script = ExtResource("7_wfn1y")
speaker = &"G"
start = 218.223
duration = 5.04
stream = ExtResource("44_dfkbx")
text = "阿凯也看见了。白纱比林晚宁矮，裙摆是道具室那条旧的。"

[sub_resource type="Resource" id="Resource_pgb5s"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 231.029
duration = 5.96
stream = ExtResource("45_0mwpi")
text = "晚宁，右手别抖。阮琪在侧幕听着，你只弹开头那一段。"

[sub_resource type="Resource" id="Resource_gjw8d"]
script = ExtResource("7_wfn1y")
speaker = &"A"
start = 237.389
duration = 4.84
stream = ExtResource("46_na1mr")
text = "头晕。水杯里有一股说不上来的涩，林晚宁想吐。"

[sub_resource type="Resource" id="Resource_w1f3l"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 242.629
duration = 4.64
stream = ExtResource("47_xnew3")
text = "先别吐在琴上。你下来，阮琪扶你回化妆间。"

[sub_resource type="Resource" id="Resource_4pchi"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 247.669
duration = 5.0
stream = ExtResource("48_jrsds")
text = "乔安，办公室的门我锁过。你又把梵音的旧档从档案室调走了？"

[sub_resource type="Resource" id="Resource_jam7y"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 253.069
duration = 5.16
stream = ExtResource("49_j12cw")
text = "调走是为了你好。方叔，当年的验尸不要在独奏的晚上被人翻到。"

[sub_resource type="Resource" id="Resource_utoqv"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 258.629
duration = 5.6
stream = ExtResource("50_aw4gn")
text = "梵音是服毒自杀。我压下它，是怕剧院被说成逼死新人。"

[sub_resource type="Resource" id="Resource_nckym"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 264.629
duration = 5.6
stream = ExtResource("51_7ovli")
text = "你压得对。从那以后，谱风剧院有一半的场子不收我的场租。"

[sub_resource type="Resource" id="Resource_1du1r"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 270.629
duration = 5.48
stream = ExtResource("52_is2gn")
text = "那不叫合作，叫要挟。乔安，白纱要是你安排的，今晚就收。"

[sub_resource type="Resource" id="Resource_tud4c"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 276.509
duration = 5.04
stream = ExtResource("53_yax14")
text = "白纱不是我。你要是报警，我就把梵音的遗书交给记者。"

[sub_resource type="Resource" id="Resource_u2h6e"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 281.949
duration = 4.0
stream = ExtResource("54_33erx")
text = "遗书在你手里？方叔这些年白养了你这份沉默。"

[sub_resource type="Resource" id="Resource_bge75"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 286.349
duration = 5.16
stream = ExtResource("55_ugrmu")
text = "沉默继续。林晚宁这场完了，你仍然什么都没看见。"

[sub_resource type="Resource" id="Resource_uimxu"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 291.909
duration = 4.12
stream = ExtResource("56_0rcqe")
text = "晚宁，躺一下。水杯我带回来了，你别再碰。"

[sub_resource type="Resource" id="Resource_j46jh"]
script = ExtResource("7_wfn1y")
speaker = &"A"
start = 296.429
duration = 5.72
stream = ExtResource("57_65vqb")
text = "阮琪老师，眼睛发花。林晚宁彩排还没完，不能倒在化妆间。"

[sub_resource type="Resource" id="Resource_ob6yf"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 302.549
duration = 5.32
stream = ExtResource("58_05sm6")
text = "能倒也得让人看见是病，不是舞台上的事故。你听我的。"

[sub_resource type="Resource" id="Resource_m3dq4"]
script = ExtResource("7_wfn1y")
speaker = &"A"
start = 308.269
duration = 4.36
stream = ExtResource("59_vsnwi")
text = "杯底怎么有一点绿？刚才喝的时候是清的。"

[sub_resource type="Resource" id="Resource_1grnu"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 313.029
duration = 4.12
stream = ExtResource("60_0h57p")
text = "绿？阮琪看看。乔安倒的这杯，见了空气在变色。"

[sub_resource type="Resource" id="Resource_p0183"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 317.549
duration = 5.12
stream = ExtResource("61_fhe0n")
text = "阮琪先看着杯。阿凯上去调录音，绿还在往上浮。"

[sub_resource type="Resource" id="Resource_r0j3k"]
script = ExtResource("7_wfn1y")
speaker = &"A"
start = 323.069
duration = 5.16
stream = ExtResource("62_0noa1")
text = "林晚宁哪儿也不去。化妆间的门别锁死，我还能答应。"

[sub_resource type="Resource" id="Resource_5bnkt"]
script = ExtResource("7_wfn1y")
speaker = &"F"
start = 328.629
duration = 5.36
stream = ExtResource("63_ke1xu")
text = "石伯在侧幕。白纱那一下，我可以再比一次身高。"

[sub_resource type="Resource" id="Resource_3iy7j"]
script = ExtResource("7_wfn1y")
speaker = &"G"
start = 334.389
duration = 4.16
stream = ExtResource("64_f5ukv")
text = "阿凯上灯光机房。昨夜的板录还在，有个女人的声音。"

[sub_resource type="Resource" id="Resource_2b333"]
script = ExtResource("7_wfn1y")
speaker = &"F"
start = 348.0
duration = 6.2
stream = ExtResource("65_u6pi0")
text = "石伯也上去。值班室的日志要写上：白纱出现时，林晚宁在舞台。"

[sub_resource type="Resource" id="Resource_c8yii"]
script = ExtResource("7_wfn1y")
speaker = &"C"
start = 357.245
duration = 5.92
stream = ExtResource("66_t44iw")
text = "（低声）纱摘了。罗茵在道具室。音乐厅那一圈，够方叔不敢出声。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_1qdyy"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 368.643
duration = 4.32
stream = ExtResource("67_05wmu")
text = "她喝了半口。青矾散进了胃，你别再去化妆间。"

[sub_resource type="Resource" id="Resource_7rbqn"]
script = ExtResource("7_wfn1y")
speaker = &"C"
start = 373.363
duration = 5.32
stream = ExtResource("68_4x1j2")
text = "我不去。林晚宁倒下来的时候，你人要在办公室，别在杯旁边。"

[sub_resource type="Resource" id="Resource_n4w0a"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 379.083
duration = 4.04
stream = ExtResource("69_k5g18")
text = "办公室有方叔看着。乔安中途出去过，他会说。"

[sub_resource type="Resource" id="Resource_ww26i"]
script = ExtResource("7_wfn1y")
speaker = &"C"
start = 383.523
duration = 4.8
stream = ExtResource("70_4y6yn")
text = "就说去了厕所。罗茵谁也不是，名册上没有我。"

[sub_resource type="Resource" id="Resource_m252e"]
script = ExtResource("7_wfn1y")
speaker = &"G"
start = 388.723
duration = 4.36
stream = ExtResource("71_e70kl")
text = "灯光机房这部录音，时间是昨夜凌晨。阿凯放到最小。"

[sub_resource type="Resource" id="Resource_wyx0o"]
script = ExtResource("7_wfn1y")
speaker = &"G"
start = 393.483
duration = 6.2
stream = ExtResource("72_1vlny")
text = "女人说：你只能在我和她之间选一个。声音年轻，不是阮琪。"

[sub_resource type="Resource" id="Resource_v700t"]
script = ExtResource("7_wfn1y")
speaker = &"F"
start = 400.083
duration = 6.24
stream = ExtResource("73_2053a")
text = "值班室的本子我写好了。石伯看见白纱的时候，舞台上是林晚宁。"

[sub_resource type="Resource" id="Resource_auych"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 410.196
duration = 6.32
stream = ExtResource("74_x6pjr")
text = "档案室不该上锁。阮琪记得梵音的档就在这层柜子。"

[sub_resource type="Resource" id="Resource_eqnyn"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 424.816
duration = 5.24
stream = ExtResource("75_4kwfc")
text = "阮琪你慢点。方叔把钥匙带来了，别撬档案室的门。"

[sub_resource type="Resource" id="Resource_dx1k5"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 430.456
duration = 5.68
stream = ExtResource("76_67wv6")
text = "验尸意见在。梵音，演出失败当晚服毒自杀。见证人栏是空的。"

[sub_resource type="Resource" id="Resource_68e6c"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 436.536
duration = 4.04
stream = ExtResource("77_xqujd")
text = "见证人是我抽掉的。乔安说，空着比写着安全。"

[sub_resource type="Resource" id="Resource_dck3n"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 440.976
duration = 6.0
stream = ExtResource("78_jb5ke")
text = "方叔，林晚宁杯底发绿。旧档如果也是毒，就不是两次碰巧。"

[sub_resource type="Resource" id="Resource_x6r2i"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 447.376
duration = 5.0
stream = ExtResource("79_11veg")
text = "青矾散。当年后台有人这么叫过那种粉。无色，过后发绿。"

[sub_resource type="Resource" id="Resource_5qvj5"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 452.776
duration = 3.8
stream = ExtResource("80_y1k8a")
text = "阮琪没带过这种东西。倒水的人是乔安。"

[sub_resource type="Resource" id="Resource_2o3rx"]
script = ExtResource("7_wfn1y")
speaker = &"A"
start = 456.976
duration = 5.92
stream = ExtResource("81_r2t4p")
text = "（低声）阮琪老师，我还在化妆间。手心全是汗，琴声都听不见了。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_nrhrc"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 463.296
duration = 4.84
stream = ExtResource("82_almtu")
text = "你别动。我们马上下来。林晚宁，杯子不要倒掉。"

[sub_resource type="Resource" id="Resource_lw4jq"]
script = ExtResource("7_wfn1y")
speaker = &"C"
start = 468.536
duration = 7.12
stream = ExtResource("83_0fcvi")
text = "乔安你走。道具室留下白纱就行，罗茵从后门……后门没有，我等灯暗。"

[sub_resource type="Resource" id="Resource_ihl4h"]
script = ExtResource("7_wfn1y")
speaker = &"G"
start = 479.824
duration = 4.28
stream = ExtResource("84_gc0ks")
text = "录音我拷出来了。阿凯要放给阮琪听，不是放给全场。"

[sub_resource type="Resource" id="Resource_t4hr2"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 484.504
duration = 6.12
stream = ExtResource("85_0trov")
text = "阮琪把绿指给晚宁看。这种粉我在旧笔记里见过，叫青矾散。"

[sub_resource type="Resource" id="Resource_h54m1"]
script = ExtResource("7_wfn1y")
speaker = &"A"
start = 491.024
duration = 4.08
stream = ExtResource("86_w5ew8")
text = "笔记上怎么写？林晚宁要知道自己喝进去的是什么。"

[sub_resource type="Resource" id="Resource_t6jdd"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 495.504
duration = 5.44
stream = ExtResource("87_5dgyl")
text = "无色，进了胃才发作，杯子放着会慢慢发绿。催吐已经晚了。"

[sub_resource type="Resource" id="Resource_nyi7e"]
script = ExtResource("7_wfn1y")
speaker = &"A"
start = 501.344
duration = 4.4
stream = ExtResource("88_l5w8i")
text = "是乔安倒的。除了那一口，林晚宁今晚没吃别的。"

[sub_resource type="Resource" id="Resource_tsdab"]
script = ExtResource("7_wfn1y")
speaker = &"F"
start = 506.144
duration = 4.76
stream = ExtResource("89_b1o8x")
text = "石伯从舞台下来了。阿凯说侧幕没有第二双鞋印。"

[sub_resource type="Resource" id="Resource_lh7mv"]
script = ExtResource("7_wfn1y")
speaker = &"G"
start = 511.304
duration = 6.04
stream = ExtResource("90_bjoqc")
text = "阿凯可以证明。灯光机房对着侧幕，只有一个矮身影走过。"

[sub_resource type="Resource" id="Resource_3w0b5"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 517.744
duration = 5.16
stream = ExtResource("91_7a7s8")
text = "方叔问一句。矮身影进道具室没有？纱如果归位，人就在里面。"

[sub_resource type="Resource" id="Resource_42xoq"]
script = ExtResource("7_wfn1y")
speaker = &"C"
start = 523.304
duration = 7.08
stream = ExtResource("92_ipcj5")
text = "（低声）归位了。罗茵把纱搭回箱子。进门先看见纱，看不见脸。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_lrrss"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 530.784
duration = 4.28
stream = ExtResource("93_xmti1")
text = "乔安还在办公室。方叔现在去道具室，什么也问不出来。"

[sub_resource type="Resource" id="Resource_ddij1"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 535.464
duration = 4.72
stream = ExtResource("94_kr26d")
text = "我晚一点去。先让阮琪把杯子保住，林晚宁别喝第二口。"

[sub_resource type="Resource" id="Resource_f8b7q"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 540.584
duration = 4.52
stream = ExtResource("95_23l44")
text = "没有第二口。阮琪把杯子扣在托盘上，绿朝下。"

[sub_resource type="Resource" id="Resource_syarn"]
script = ExtResource("7_wfn1y")
speaker = &"A"
start = 545.504
duration = 5.36
stream = ExtResource("96_lrllk")
text = "头晕变成恶心。林晚宁按你说的躺着，舞台上的琴不要了。"

[sub_resource type="Resource" id="Resource_ggkee"]
script = ExtResource("7_wfn1y")
speaker = &"G"
start = 551.264
duration = 4.08
stream = ExtResource("97_8k43l")
text = "琴有阿凯看着。追光灭了，侧幕现在是黑的。"

[sub_resource type="Resource" id="Resource_hae2m"]
script = ExtResource("7_wfn1y")
speaker = &"F"
start = 555.744
duration = 7.24
stream = ExtResource("98_1yaeu")
text = "石伯把日志补上。白纱消失，和林晚宁进化妆间，是前后脚。"

[sub_resource type="Resource" id="Resource_2hr0o"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 563.384
duration = 4.2
stream = ExtResource("99_ovvjn")
text = "前后脚说明不了毒。方叔要的是谁把粉带进剧院。"

[sub_resource type="Resource" id="Resource_bn63v"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 567.984
duration = 5.28
stream = ExtResource("100_8pe8c")
text = "粉不是剧院的库存。乔安可以这么说，你爱信不信。"

[sub_resource type="Resource" id="Resource_isdxj"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 573.664
duration = 6.24
stream = ExtResource("101_fe6na")
text = "阮琪不信。梵音的档如果也写着这种绿，两次就不是碰巧。"

[sub_resource type="Resource" id="Resource_danu4"]
script = ExtResource("7_wfn1y")
speaker = &"A"
start = 580.304
duration = 6.16
stream = ExtResource("102_rvlbh")
text = "梵音是谁？林晚宁进团的时候，这个名字就被人拦着不提。"

[sub_resource type="Resource" id="Resource_01qnp"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 586.864
duration = 5.84
stream = ExtResource("103_4guib")
text = "拦着的是方叔。上一任新人被推上台，演砸了，当晚没了。"

[sub_resource type="Resource" id="Resource_c4nq5"]
script = ExtResource("7_wfn1y")
speaker = &"F"
start = 593.104
duration = 6.4
stream = ExtResource("104_bl5kb")
text = "石伯扫过她的化妆间。杯也是绿的。那年没人让我写进日志。"

[sub_resource type="Resource" id="Resource_x4tm0"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 599.904
duration = 3.88
stream = ExtResource("105_jprhq")
text = "因为我让你别写。方叔错在这儿，不在今晚这杯水。"

[sub_resource type="Resource" id="Resource_6l5dy"]
script = ExtResource("7_wfn1y")
speaker = &"G"
start = 604.184
duration = 4.24
stream = ExtResource("106_aq3fa")
text = "阿凯把旧板录留着。梵音那场的后半段，麦克风是静的。"

[sub_resource type="Resource" id="Resource_pyjau"]
script = ExtResource("7_wfn1y")
speaker = &"C"
start = 608.824
duration = 6.52
stream = ExtResource("107_rfp10")
text = "静的是人已经不唱了。罗茵没见过梵音，纱是乔安翻给我的。"

[sub_resource type="Resource" id="Resource_m24rh"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 615.744
duration = 4.08
stream = ExtResource("108_0uxbt")
text = "翻给你是为了吓方叔，不是为了教你下毒。这句别记错。"

[sub_resource type="Resource" id="Resource_ltvdq"]
script = ExtResource("7_wfn1y")
speaker = &"C"
start = 620.224
duration = 5.4
stream = ExtResource("109_xkdoc")
text = "我没下。纸包一直在你手上。罗茵只负责让音乐厅有鬼。"

[sub_resource type="Resource" id="Resource_r0w5k"]
script = ExtResource("7_wfn1y")
speaker = &"F"
start = 626.024
duration = 6.4
stream = ExtResource("110_nk451")
text = "鬼我看见了。石伯能指认身量，指认不了脸，纱太厚。"

[sub_resource type="Resource" id="Resource_xle4m"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 632.824
duration = 6.72
stream = ExtResource("111_qx2hi")
text = "脸等摘纱再认。阮琪现在只问杯。乔安，纸包在不在身上？"

[sub_resource type="Resource" id="Resource_i78wu"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 639.944
duration = 4.04
stream = ExtResource("112_w5w5u")
text = "不在。乔安换过外套。你要搜，等林晚宁这阵过去。"

[sub_resource type="Resource" id="Resource_5cnup"]
script = ExtResource("7_wfn1y")
speaker = &"A"
start = 644.384
duration = 4.84
stream = ExtResource("113_rkylp")
text = "别等过去。林晚宁要是说不成话，杯子就是唯一的嘴。"

[sub_resource type="Resource" id="Resource_7vpm5"]
script = ExtResource("7_wfn1y")
speaker = &"A"
start = 654.0
duration = 4.36
stream = ExtResource("114_uitjn")
text = "（大喊）阮琪老师……林晚宁在化妆间站不住了！"
loudness = 0.9

[sub_resource type="Resource" id="Resource_ra8md"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 661.618
duration = 4.92
stream = ExtResource("115_ebwi7")
text = "晚宁！眼睛睁开。阮琪在。杯里的绿已经沉到底了。"

[sub_resource type="Resource" id="Resource_kou52"]
script = ExtResource("7_wfn1y")
speaker = &"A"
start = 666.938
duration = 5.44
stream = ExtResource("116_cmvvy")
text = "是乔安倒的水。林晚宁只喝了一口。告诉方叔，别让他走。"

[sub_resource type="Resource" id="Resource_xgtdq"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 672.778
duration = 5.56
stream = ExtResource("117_xr88m")
text = "你省着力气。绿是后上来的，喝的时候看不见。这是青矾散。"

[sub_resource type="Resource" id="Resource_63yy2"]
script = ExtResource("7_wfn1y")
speaker = &"G"
start = 683.353
duration = 5.6
stream = ExtResource("118_bqvo1")
text = "阿凯把昨夜的录音带来了。林晚宁先别说话，听这一句。"

[sub_resource type="Resource" id="Resource_ehglf"]
script = ExtResource("7_wfn1y")
speaker = &"G"
start = 689.353
duration = 5.92
stream = ExtResource("119_umqng")
text = "录音里的女人说，只能在我和她之间选一个。林晚宁，这不是你的声音。"

[sub_resource type="Resource" id="Resource_0t42w"]
script = ExtResource("7_wfn1y")
speaker = &"A"
start = 695.673
duration = 3.52
stream = ExtResource("120_767om")
text = "不是。我没有说过这种话。乔安身边……还有别人。"

[sub_resource type="Resource" id="Resource_dluve"]
script = ExtResource("7_wfn1y")
speaker = &"C"
start = 699.593
duration = 9.52
stream = ExtResource("121_7xrbt")
text = "（低声）纱在箱子里。罗茵谁也没看见脸。乔安答应过，倒了就结束。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_eoq7w"]
script = ExtResource("7_wfn1y")
speaker = &"F"
start = 716.837
duration = 6.12
stream = ExtResource("122_c1jcy")
text = "石伯再确认一次。白纱在音乐厅的时候，舞台上的人是林晚宁。"

[sub_resource type="Resource" id="Resource_ak4yn"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 730.004
duration = 4.56
stream = ExtResource("123_3t74i")
text = "乔安，你给我留在办公室。方叔数过，你中途出去了两回。"

[sub_resource type="Resource" id="Resource_sj8tw"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 734.964
duration = 5.2
stream = ExtResource("124_18npe")
text = "出去接了个电话。林晚宁的水是温水，我没往里加任何东西。"

[sub_resource type="Resource" id="Resource_r1ihm"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 740.564
duration = 5.6
stream = ExtResource("125_s0m18")
text = "电话可以以后再查。人倒在化妆间，杯子是你放上去的。"

[sub_resource type="Resource" id="Resource_78cmn"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 752.0
duration = 5.12
stream = ExtResource("126_y3shf")
text = "都到化妆间门口，别挤进来。林晚宁还有气，杯不能洗。"

[sub_resource type="Resource" id="Resource_rk1g4"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 761.099
duration = 6.88
stream = ExtResource("127_wpqto")
text = "杯底是绿的。青矾散无色，见空气才显。喝下去才伤胃。"

[sub_resource type="Resource" id="Resource_27bry"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 768.379
duration = 4.6
stream = ExtResource("128_iw2es")
text = "方叔听过这个名字。梵音那年，后台也有人提过青矾散。"

[sub_resource type="Resource" id="Resource_nae2m"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 773.379
duration = 4.12
stream = ExtResource("129_s6oux")
text = "提过不等于我带了。乔安办演出，倒杯水不算证据。"

[sub_resource type="Resource" id="Resource_jqhq0"]
script = ExtResource("7_wfn1y")
speaker = &"G"
start = 777.899
duration = 4.64
stream = ExtResource("130_hyi5r")
text = "阿凯这儿有昨夜的录音。女人逼乔安在两个人里选一个。"

[sub_resource type="Resource" id="Resource_ca2lr"]
script = ExtResource("7_wfn1y")
speaker = &"F"
start = 782.939
duration = 7.56
stream = ExtResource("131_bt35x")
text = "石伯补充。白纱出现时林晚宁在舞台上，纱比她矮，是旧道具。"

[sub_resource type="Resource" id="Resource_yxkw8"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 790.899
duration = 6.84
stream = ExtResource("132_0ffuw")
text = "旧纱是梵音的。阮琪看过档案，梵音是演出失败后服毒自杀。"

[sub_resource type="Resource" id="Resource_ff0i7"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 798.139
duration = 5.52
stream = ExtResource("133_dablm")
text = "见证人是我抽掉的。乔安拿遗书要挟我，场租这些年也没好好收。"

[sub_resource type="Resource" id="Resource_u2b2b"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 804.059
duration = 5.2
stream = ExtResource("134_43avt")
text = "方叔你自己怕上报。要挟是你给的口实，不是乔安求的。"

[sub_resource type="Resource" id="Resource_14gqt"]
script = ExtResource("7_wfn1y")
speaker = &"G"
start = 809.659
duration = 6.4
stream = ExtResource("135_5rnbc")
text = "录音里那个女人还说，错过今晚就没有下一次。乔安你回她了。"

[sub_resource type="Resource" id="Resource_c2dlr"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 816.459
duration = 3.96
stream = ExtResource("136_x66bv")
text = "回的是气话。罗茵……我是说，那个人不是剧团的。"

[sub_resource type="Resource" id="Resource_g524t"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 820.819
duration = 5.48
stream = ExtResource("137_jain4")
text = "你说出罗茵了。阮琪要听清楚，是不是她让你在杯子里动手。"

[sub_resource type="Resource" id="Resource_tgvjv"]
script = ExtResource("7_wfn1y")
speaker = &"C"
start = 826.699
duration = 4.64
stream = ExtResource("138_athvm")
text = "（低声）不要接。罗茵还在道具室，名册上没有这个名字。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_ylbx4"]
script = ExtResource("7_wfn1y")
speaker = &"F"
start = 831.739
duration = 6.56
stream = ExtResource("139_t0mue")
text = "道具室有人声。石伯去看的时候，白纱就搭在箱子上，人还在。"

[sub_resource type="Resource" id="Resource_mmn7q"]
script = ExtResource("7_wfn1y")
speaker = &"F"
start = 841.737
duration = 7.68
stream = ExtResource("140_qkx5h")
text = "纱在。人也在。你是谁？音乐厅的白纱是不是你披的？"

[sub_resource type="Resource" id="Resource_241wd"]
script = ExtResource("7_wfn1y")
speaker = &"C"
start = 849.817
duration = 4.28
stream = ExtResource("141_hk1u3")
text = "是罗茵。纱是我披的。我只想吓方叔，没有进化妆间。"

[sub_resource type="Resource" id="Resource_tve0b"]
script = ExtResource("7_wfn1y")
speaker = &"F"
start = 854.497
duration = 4.88
stream = ExtResource("142_tocly")
text = "吓他做什么？石伯要一句实话，不听鬼故事。"

[sub_resource type="Resource" id="Resource_k1fkm"]
script = ExtResource("7_wfn1y")
speaker = &"C"
start = 859.777
duration = 5.76
stream = ExtResource("143_hfsfr")
text = "乔安答应在我和林晚宁之间选。他要是反悔，纱就继续出现。"

[sub_resource type="Resource" id="Resource_y15yo"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 867.843
duration = 5.24
stream = ExtResource("144_kqwqw")
text = "罗茵你闭嘴。披纱是你自己要的，杯子的事别往我身上揽。"

[sub_resource type="Resource" id="Resource_88fbi"]
script = ExtResource("7_wfn1y")
speaker = &"C"
start = 873.483
duration = 6.12
stream = ExtResource("145_vuwuh")
text = "粉是你放的。青矾散的纸包还在你外套内侧，我看见你抖进去的。"

[sub_resource type="Resource" id="Resource_jke1j"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 881.644
duration = 5.4
stream = ExtResource("146_r5dfq")
text = "纸包留下。阮琪可以认颜色。林晚宁只喝了乔安那一杯。"

[sub_resource type="Resource" id="Resource_l4r1n"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 889.581
duration = 6.2
stream = ExtResource("147_l8ypm")
text = "方叔把话说完。梵音的遗书在乔安手里，所以我这些年不敢查白纱。"

[sub_resource type="Resource" id="Resource_mdseg"]
script = ExtResource("7_wfn1y")
speaker = &"G"
start = 899.35
duration = 5.16
stream = ExtResource("148_5cuyj")
text = "阿凯把录音时间对上了。昨夜说话的就是这个声音，罗茵。"

[sub_resource type="Resource" id="Resource_r1sga"]
script = ExtResource("7_wfn1y")
speaker = &"C"
start = 904.91
duration = 5.28
stream = ExtResource("149_205yy")
text = "我说了只能留一个。我没说用毒。用毒是乔安自己决定的。"

[sub_resource type="Resource" id="Resource_ue6lg"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 910.59
duration = 5.24
stream = ExtResource("150_bjthh")
text = "你说错过今晚就没有下一次。乔安没有别的办法让这场消失。"

[sub_resource type="Resource" id="Resource_kebpk"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 916.23
duration = 5.36
stream = ExtResource("151_fpiy8")
text = "办法不是让林晚宁消失。阮琪把杯子扣上，谁也别再碰。"

[sub_resource type="Resource" id="Resource_o64i7"]
script = ExtResource("7_wfn1y")
speaker = &"F"
start = 921.99
duration = 6.48
stream = ExtResource("152_qumi7")
text = "石伯的日志写着：白纱在音乐厅，林晚宁在舞台。两件事同时。"

[sub_resource type="Resource" id="Resource_qacp0"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 928.87
duration = 5.68
stream = ExtResource("153_qixx3")
text = "所以鬼是人扮的。罗茵，纱留下。乔安，纸包交出来。"

[sub_resource type="Resource" id="Resource_fhwrc"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 934.95
duration = 5.8
stream = ExtResource("154_alik7")
text = "纸包在内侧。青矾散是我下的。她要我选，我选了让林晚宁上不了台。"

[sub_resource type="Resource" id="Resource_ueg7j"]
script = ExtResource("7_wfn1y")
speaker = &"C"
start = 941.15
duration = 6.28
stream = ExtResource("155_asgmq")
text = "罗茵只披了纱，只放了话。可这句话把乔安推进了化妆间。"

[sub_resource type="Resource" id="Resource_tmfde"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 947.83
duration = 5.2
stream = ExtResource("156_xibs5")
text = "晚宁还在屋里。阮琪守着她。剩下的账，等她能开口再对。"

[sub_resource type="Resource" id="Resource_fvy7b"]
script = ExtResource("7_wfn1y")
speaker = &"G"
start = 953.43
duration = 5.0
stream = ExtResource("157_1c0wl")
text = "录音、日志、发绿的杯子、纸包。阿凯四样都标了时间。"

[sub_resource type="Resource" id="Resource_oud2t"]
script = ExtResource("7_wfn1y")
speaker = &"F"
start = 958.83
duration = 5.28
stream = ExtResource("158_d5fss")
text = "石伯把白纱锁进道具室的箱子。别再让它自己走到音乐厅去。"

[sub_resource type="Resource" id="Resource_8b6bb"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 964.51
duration = 5.64
stream = ExtResource("159_lrxmm")
text = "方叔今晚把梵音的档放回档案室。见证人那一栏，我补自己的名字。"

[sub_resource type="Resource" id="Resource_tr88w"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 970.55
duration = 4.72
stream = ExtResource("160_65paq")
text = "补你的名字也改变不了杯子。乔安已经说了，粉是我抖的。"

[sub_resource type="Resource" id="Resource_qgykp"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 975.67
duration = 4.48
stream = ExtResource("161_kr1r3")
text = "听见了。林晚宁喝的那口，是乔安倒的。罗茵的纱，另算。"

[sub_resource type="Resource" id="Resource_npcpa"]
script = ExtResource("7_wfn1y")
speaker = &"A"
start = 980.55
duration = 6.2
stream = ExtResource("162_7i3o4")
text = "（低声）阮琪老师，我还听得见。那口我吐出来了，可劲已经使完。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_eg7cl"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 987.15
duration = 4.4
stream = ExtResource("163_l5p10")
text = "听见就好。你别起来。剩下的话有我们说。"

[sub_resource type="Resource" id="Resource_7gsio"]
script = ExtResource("7_wfn1y")
speaker = &"G"
start = 991.95
duration = 5.36
stream = ExtResource("164_n33cw")
text = "阿凯再放一遍录音的头。罗茵，你听是不是自己的声音。"

[sub_resource type="Resource" id="Resource_rxuyf"]
script = ExtResource("7_wfn1y")
speaker = &"C"
start = 997.71
duration = 4.68
stream = ExtResource("165_m6c0v")
text = "是我。只能留一个，是我说的。粉不是我撒的。"

[sub_resource type="Resource" id="Resource_fb6xd"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 1002.79
duration = 3.84
stream = ExtResource("166_2t1vq")
text = "粉是我撒的。乔安把这句重复到你们不用再问。"

[sub_resource type="Resource" id="Resource_eq8ef"]
script = ExtResource("7_wfn1y")
speaker = &"F"
start = 1007.03
duration = 6.72
stream = ExtResource("167_76uuo")
text = "石伯不用再问。日志、白纱、身量，三样对得上罗茵。"

[sub_resource type="Resource" id="Resource_l2rpk"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 1014.15
duration = 4.72
stream = ExtResource("168_bmbi7")
text = "方叔要补的是旧账。梵音的见证人，今晚写回档案室。"

[sub_resource type="Resource" id="Resource_7bdmo"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 1019.27
duration = 6.2
stream = ExtResource("169_wd0x7")
text = "新账是这杯。青矾散、发绿、乔安的手。阮琪按这个顺序写。"

[sub_resource type="Resource" id="Resource_2kfy5"]
script = ExtResource("7_wfn1y")
speaker = &"G"
start = 1025.87
duration = 7.08
stream = ExtResource("170_gm6j1")
text = "阿凯把四样东西的时间对齐。录音在前，喝水在后，发绿在喝完之后。"

[sub_resource type="Resource" id="Resource_ov7xp"]
script = ExtResource("7_wfn1y")
speaker = &"F"
start = 1033.35
duration = 7.6
stream = ExtResource("171_pchi5")
text = "石伯的日志夹在最后。白纱和舞台上的人，两行并排，不是先后。"

[sub_resource type="Resource" id="Resource_6k5xo"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 1041.35
duration = 5.48
stream = ExtResource("172_igtgv")
text = "方叔把遗书交出来。要挟到今晚为止，谱风剧院不再替乔安瞒。"

[sub_resource type="Resource" id="Resource_xw86u"]
script = ExtResource("7_wfn1y")
speaker = &"C"
start = 1047.23
duration = 4.88
stream = ExtResource("173_gve7c")
text = "罗茵的纱锁上。我认装鬼，不认下毒。这句话单独写。"

[sub_resource type="Resource" id="Resource_tgju4"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 1052.51
duration = 4.72
stream = ExtResource("174_rtf0i")
text = "下毒不用你认。乔安已经说了，纸包是我的，水是我倒的。"

[sub_resource type="Resource" id="Resource_758d6"]
script = ExtResource("7_wfn1y")
speaker = &"A"
start = 1057.63
duration = 5.64
stream = ExtResource("175_o5h1q")
text = "（低声）林晚宁听见了。杯子扣着就好，阮琪老师别让人再打开。"
loudness = 0.3

[sub_resource type="Resource" id="Resource_8wybh"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 1063.67
duration = 5.0
stream = ExtResource("176_h1o2k")
text = "阮琪再写一遍。林晚宁只喝了乔安倒的那一口。"

[sub_resource type="Resource" id="Resource_llngc"]
script = ExtResource("7_wfn1y")
speaker = &"A"
start = 1069.07
duration = 4.92
stream = ExtResource("177_d3qop")
text = "就一口。剩下的还在杯子里，绿已经沉到底，我没有再碰。"

[sub_resource type="Resource" id="Resource_e7roc"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 1074.39
duration = 5.32
stream = ExtResource("178_o0t4p")
text = "沉到底是药的性子。乔安早知道会发绿，所以才让你快喝。"

[sub_resource type="Resource" id="Resource_uq8xi"]
script = ExtResource("7_wfn1y")
speaker = &"C"
start = 1080.11
duration = 4.96
stream = ExtResource("179_m1ddt")
text = "发绿是你告诉我的。罗茵没进过化妆间，纱也没带进去。"

[sub_resource type="Resource" id="Resource_cq867"]
script = ExtResource("7_wfn1y")
speaker = &"F"
start = 1085.47
duration = 5.76
stream = ExtResource("180_e8kl4")
text = "石伯再写一行。白纱回到道具室，晚于林晚宁上台。"

[sub_resource type="Resource" id="Resource_e23jx"]
script = ExtResource("7_wfn1y")
speaker = &"G"
start = 1091.63
duration = 5.12
stream = ExtResource("181_lnop6")
text = "阿凯把侧幕录像停在那个身影上。身高和罗茵站在这儿一样。"

[sub_resource type="Resource" id="Resource_pg1x0"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 1097.15
duration = 5.2
stream = ExtResource("182_rg34q")
text = "方叔把梵音的见证人补完了。空栏是我抽的，字现在补回去。"

[sub_resource type="Resource" id="Resource_f13r7"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 1102.75
duration = 5.08
stream = ExtResource("183_n65tu")
text = "两次发绿，一种粉。梵音那年没写成案子，今晚不能再漏。"

[sub_resource type="Resource" id="Resource_crnyb"]
script = ExtResource("7_wfn1y")
speaker = &"A"
start = 1108.23
duration = 5.96
stream = ExtResource("184_5oqgu")
text = "林晚宁还头晕，可话已经说完。杯子交给阮琪，我在化妆间等。"

[sub_resource type="Resource" id="Resource_fk2ms"]
script = ExtResource("7_wfn1y")
speaker = &"G"
start = 1114.59
duration = 5.72
stream = ExtResource("185_7kx8f")
text = "阿凯把录音再标一个点。昨夜那句“只能留一个”，对过罗茵。"

[sub_resource type="Resource" id="Resource_jsicp"]
script = ExtResource("7_wfn1y")
speaker = &"C"
start = 1120.71
duration = 4.88
stream = ExtResource("186_jntqb")
text = "声纹不用对。那句是我说的。我认。粉的纸包我没碰过。"

[sub_resource type="Resource" id="Resource_cca0q"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 1125.99
duration = 4.2
stream = ExtResource("187_2qhv7")
text = "纸包在外套内侧，已经交出。乔安没有第二包。"

[sub_resource type="Resource" id="Resource_lpeme"]
script = ExtResource("7_wfn1y")
speaker = &"F"
start = 1130.59
duration = 5.96
stream = ExtResource("188_0xjna")
text = "石伯把旧纱和纸包分开放。装鬼是一件，下毒是另一件。"

[sub_resource type="Resource" id="Resource_itymi"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 1136.95
duration = 4.64
stream = ExtResource("189_ilwmw")
text = "遗书也分开。方叔交出来的是梵音的，不是林晚宁的。"

[sub_resource type="Resource" id="Resource_8ovgv"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 1141.99
duration = 5.72
stream = ExtResource("190_r4tur")
text = "林晚宁的只有这只杯。谁再要求冲洗，阮琪不答应。"

[sub_resource type="Resource" id="Resource_cwsbg"]
script = ExtResource("7_wfn1y")
speaker = &"A"
start = 1148.11
duration = 5.28
stream = ExtResource("191_p56nb")
text = "不要冲洗。我想看看绿变成什么样，才知道自己喝了什么。"

[sub_resource type="Resource" id="Resource_j57k4"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 1153.79
duration = 5.12
stream = ExtResource("192_ylybi")
text = "变成这样就是青矾散。进了胃才发作，所以上台时你还站得住。"

[sub_resource type="Resource" id="Resource_vpbt6"]
script = ExtResource("7_wfn1y")
speaker = &"C"
start = 1159.31
duration = 5.56
stream = ExtResource("193_ycp6e")
text = "你站得住的那段，音乐厅里的白纱是我。罗茵把时间对给你听。"

[sub_resource type="Resource" id="Resource_kpjbo"]
script = ExtResource("7_wfn1y")
speaker = &"G"
start = 1165.27
duration = 5.16
stream = ExtResource("194_pgg7r")
text = "对得上。阿凯的灯控日志里，追光打在舞台时，侧幕有人。"

[sub_resource type="Resource" id="Resource_x5acs"]
script = ExtResource("7_wfn1y")
speaker = &"F"
start = 1170.83
duration = 5.64
stream = ExtResource("195_g5qah")
text = "侧幕那个人比林晚宁矮。石伯量过纱的下摆，是道具箱里那条。"

[sub_resource type="Resource" id="Resource_0o80j"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 1176.87
duration = 5.04
stream = ExtResource("196_85uk4")
text = "道具箱的锁是坏的。方叔认，这些年是我默许乔安来翻。"

[sub_resource type="Resource" id="Resource_l0as2"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 1182.31
duration = 6.56
stream = ExtResource("197_tncm3")
text = "默许到今晚为止。档案室的钥匙回来，档不再过夜放在办公室。"

[sub_resource type="Resource" id="Resource_btaph"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 1189.27
duration = 5.0
stream = ExtResource("198_gg15j")
text = "办公室没有第二份档。乔安调走的那份，已经回到方叔手上。"

[sub_resource type="Resource" id="Resource_a8iox"]
script = ExtResource("7_wfn1y")
speaker = &"A"
start = 1194.67
duration = 4.84
stream = ExtResource("199_bb8hq")
text = "林晚宁不想听档。我只问一句：杯子是不是唯一的毒。"

[sub_resource type="Resource" id="Resource_y6a5i"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 1199.91
duration = 5.0
stream = ExtResource("200_gfcrj")
text = "是唯一的。阮琪查过琴、门厅的水和休息室，都没有这股涩。"

[sub_resource type="Resource" id="Resource_qxqu1"]
script = ExtResource("7_wfn1y")
speaker = &"G"
start = 1205.31
duration = 4.36
stream = ExtResource("201_hmmg0")
text = "阿凯也闻过侧幕。没有粉的味道，粉只在那只杯子里。"

[sub_resource type="Resource" id="Resource_kcokt"]
script = ExtResource("7_wfn1y")
speaker = &"C"
start = 1210.07
duration = 5.24
stream = ExtResource("202_hxvcp")
text = "那就只记杯子。罗茵的罪是纱和那句话，不是这口绿。"

[sub_resource type="Resource" id="Resource_rc4vr"]
script = ExtResource("7_wfn1y")
speaker = &"F"
start = 1215.71
duration = 4.68
stream = ExtResource("203_x1s5q")
text = "石伯写完最后一行。日志合上，白纱锁进箱子。"

[sub_resource type="Resource" id="Resource_4k76g"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 1220.79
duration = 5.16
stream = ExtResource("204_y7g6q")
text = "方叔今晚不送客。音乐厅的门先关，等人把杯子取走。"

[sub_resource type="Resource" id="Resource_r56ml"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 1226.35
duration = 4.96
stream = ExtResource("205_hw5g2")
text = "乔安不再解释。水是我倒的，粉是我抖的，选是我选的。"

[sub_resource type="Resource" id="Resource_5fcd5"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 1231.71
duration = 6.24
stream = ExtResource("206_2kop2")
text = "阮琪把顺序再念一遍。先录音，后倒水，再发绿，最后是你倒下。"

[sub_resource type="Resource" id="Resource_02trx"]
script = ExtResource("7_wfn1y")
speaker = &"A"
start = 1238.35
duration = 5.44
stream = ExtResource("207_une66")
text = "顺序我记住了。倒下之前我一直在化妆间，没有回过舞台。"

[sub_resource type="Resource" id="Resource_f1ean"]
script = ExtResource("7_wfn1y")
speaker = &"G"
start = 1244.19
duration = 4.52
stream = ExtResource("208_rm77s")
text = "舞台是空的。阿凯关掉追光之后，没有第三人上去。"

[sub_resource type="Resource" id="Resource_lcr4c"]
script = ExtResource("7_wfn1y")
speaker = &"F"
start = 1249.11
duration = 5.12
stream = ExtResource("209_16up4")
text = "石伯守着音乐厅。白纱离开之后，侧幕没有再动。"

[sub_resource type="Resource" id="Resource_h3drv"]
script = ExtResource("7_wfn1y")
speaker = &"E"
start = 1254.63
duration = 4.28
stream = ExtResource("210_221f3")
text = "办公室的门我锁了。乔安出去的两回，都对得上他不在我眼前。"

[sub_resource type="Resource" id="Resource_304hd"]
script = ExtResource("7_wfn1y")
speaker = &"C"
start = 1259.31
duration = 4.96
stream = ExtResource("211_qxiv7")
text = "其中一回是来道具室看我。罗茵让他别留在杯子旁边。"

[sub_resource type="Resource" id="Resource_rymam"]
script = ExtResource("7_wfn1y")
speaker = &"B"
start = 1264.67
duration = 4.64
stream = ExtResource("212_g32t5")
text = "另一回就是去倒水。两回我都认了，没有第三回。"

[sub_resource type="Resource" id="Resource_enweb"]
script = ExtResource("7_wfn1y")
speaker = &"D"
start = 1269.71
duration = 5.56
stream = ExtResource("213_dwj2b")
text = "没有第三回就够。阮琪守着人，也守着杯。今晚到这儿。"

[resource]
script = ExtResource("5_nduvm")
id = &"case2"
title = "剧院魅影"
description = "谱风剧院今晚是林晚宁的钢琴独奏。彩排还没完，侧幕里有人看见白纱。你在楼里走，只能靠声音弄清谁在装鬼，谁在杯子里动了手脚。"
duration = 1284.0
map_scene = ExtResource("3_ned3d")
characters = Array[ExtResource("1_ts2jt")]([SubResource("Resource_cidhe"), SubResource("Resource_cime8"), SubResource("Resource_nj7k1"), SubResource("Resource_u65t4"), SubResource("Resource_uvsv7"), SubResource("Resource_arbsy"), SubResource("Resource_lorsc")])
